function HopeJob_OnSelect takes nothing returns nothing
local integer kind=GetUnitTypeId(GetTriggerUnit())
if IsUnitHidden(GetTriggerUnit()) or GetWidgetLife(GetTriggerUnit())<=.405 then
return
endif
if kind=='n008' then
call HopeJob_Show(GetTriggerPlayer(),1)
elseif kind=='n019' or kind=='n01C' then
call HopeJob_Show(GetTriggerPlayer(),2)
endif
if kind=='n008' or kind=='n019' or kind=='n01C' then
if GetTriggerPlayer()==GetLocalPlayer() and udg_hero[GetPlayerId(GetTriggerPlayer())+1]!=null then
call SelectUnitForPlayerSingle(udg_hero[GetPlayerId(GetTriggerPlayer())+1],GetTriggerPlayer())
endif
endif
endfunction
function HopeJob_RemoveStock takes nothing returns nothing
local unit u=GetEnumUnit()
local integer kind=GetUnitTypeId(u)
local integer index=0
if kind=='n008' or kind=='n019' or kind=='n01C' then
loop
exitwhen index>=24
call RemoveItemFromStock(u,HopeJob_Item[index])
set index=index+1
endloop
call RemoveUnitFromStock(u,'H000')
endif
set u=null
endfunction
function HopeJob_RefreshContent takes nothing returns nothing
local player p=GetLocalPlayer()
local integer i=GetPlayerId(p)+1
local integer index=0
local integer row=0
local integer typ=GetUnitTypeId(udg_hero[i])
local integer chosen=HopeJob_Selected
local boolean room=HopeJob_InRoom(p)
local boolean available=room and (typ=='H000' or HopeReclass_Can(i) or HopeJob_AdvancedOpen())
local boolean picking=HopeChoice_HasPending() and not HopeChoice_Hidden
local string detail=""
local string block=""
local string level=""
local string current=GetUnitName(udg_hero[i])
local integer count=0
if HopeJob_Panel==0 then
set p=null
return
endif
call HopeJob_ShowFrame(HopeJob_OpenButton,available and not picking)
// Entering the fountain only reveals the manual entry button.
if not room or (HopeJob_Entry==2 and not HopeJob_AdvancedOpen()) then
set HopeJob_Expanded=false
endif
if HopeQoL_Expanded or HopeArchive_Expanded or HopeGift_Expanded or HopeRelic_Expanded or HopeRoute_Details then
set HopeJob_Expanded=false
endif
call HopeJob_ShowFrame(HopeJob_Panel,HopeJob_Expanded and not picking)
if not HopeJob_Expanded or i>6 then
set p=null
return
endif
if HopeJob_LastType!=typ then
set chosen=-1
set HopeJob_Selected=-1
set HopeJob_Page=0
set HopeJob_DetailPage=0
set HopeJob_LastType=typ
endif
if chosen>=0 and not HopeJob_InPanel(chosen,i) then
set chosen=-1
set HopeJob_Selected=-1
set HopeJob_Page=0
set HopeJob_DetailPage=0
endif
loop
exitwhen index>=HopeJob_Count
call HopeJob_ShowFrame(HopeJob_Row[index],HopeJob_InPanel(index,i))
call HopeJob_ShowFrame(HopeJob_Confirm[index],false)
if HopeJob_InPanel(index,i) then
if HopeJob_Row[index]!=0 then
call DzFrameSetPoint(HopeJob_Row[index],0,HopeJob_Panel,0,.012,-.078-.030*I2R(row))
endif
if chosen==-1 then
set chosen=index
set HopeJob_Selected=index
endif
set row=row+1
endif
set index=index+1
endloop
if HopeJob_Awakened[i] then
set current=HopeJob_Name[HopeJob_AwakenOption[i]]
endif
if HopeJob_Entry==1 then
if HopeReclass_Can(i) then
call HopeJob_SetText(HopeJob_Title,"|cffd2b879重新转职 · 10存档积分|r · "+current)
else
call HopeJob_SetText(HopeJob_Title,"|cffd2b879一转职业|r · "+current)
endif
else
call HopeJob_SetText(HopeJob_Title,"|cffd2b879二转 / 三转|r · "+current)
endif
call HopeJob_SetText(HopeJob_Status,"当前第 "+I2S(HopeJob_Round())+" 轮 · 二转第3轮 · 三转第4轮 / 30木+1000金")
if chosen>=0 then
set block=HopeJob_Blocker(chosen,p)
if HopeJob_Page==0 then
set level="等级 "+I2S(HopeJob_Level[chosen])+"；基础力量 "+I2S(HopeJob_Str[chosen])+" / 敏捷 "+I2S(HopeJob_Agi[chosen])+" / 智力 "+I2S(HopeJob_Int[chosen])
if HopeJob_Stage[chosen]==3 then
set level="已完成二转；进入第4轮；在原二转建筑办理。|n三转费用："+I2S(HopeJob_WoodCost(chosen))+" 木材+1000金币；当前木材："+I2S(GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER))+"。"
elseif HopeJob_Stage[chosen]==2 then
set level=level+"；第3轮二转建筑出现后开放。"
endif
set detail="|cffd2b879"+HopeJob_Name[chosen]+" · "+I2S(HopeJob_Stage[chosen])+"转|r|n|n"+HopeJob_Role[chosen]+"|n|n|cffd2b879转职条件|r|n"+level+"|n|n属性门槛按基础值判断，装备与临时加成不计。|n一转沿用原规则；二转保留英雄等级。|n三转保留二转技能、修炼、装备和本局成长。"
if HopeJob_Entry==1 and HopeReclass_Can(i) then
set detail="|cffd2b879重新转职："+HopeJob_Name[chosen]+"|r|n费用：10存档积分；当前 "+I2S(udg_Wj_jf[i])+"。|n仅一转可用，二转后关闭。|n|n所需基础力量 "+I2S(HopeJob_Str[chosen])+" / 敏捷 "+I2S(HopeJob_Agi[chosen])+" / 智力 "+I2S(HopeJob_Int[chosen])+"。|n扣费前移除旧修炼复核，属性不足不扣费。|n保留等级、既得升级收益与装备；旧职业被动移除，返还职业技能点。|n牧师同级赠药不重复领取。|n随机10%隐藏；抽到同职业也消耗积分。"
endif
elseif HopeJob_Page==1 then
set count=HopeJob_SkillCount[chosen]
set detail=HopeJob_DetailText[chosen*16+HopeJob_DetailPage]
else
set count=HopeJob_PassiveCount[chosen]
set detail=HopeJob_DetailText[chosen*16+8+HopeJob_DetailPage]
endif
call HopeJob_ShowFrame(HopeJob_PrevButton,count>1 and HopeJob_DetailPage>0)
call HopeJob_ShowFrame(HopeJob_NextButton,count>1 and HopeJob_DetailPage+1<count)
call HopeJob_ShowFrame(HopeJob_PageLabel,count>1)
call HopeJob_SetText(HopeJob_PageLabel,I2S(HopeJob_DetailPage+1)+" / "+I2S(count))
if HopeJob_Page==0 and HopeJob_Awakened[i] and chosen==HopeJob_AwakenOption[i] then
set detail="|cffd2b879"+HopeJob_Name[chosen]+" · 已完成三转|r|n|n"+HopeJob_Role[chosen]
if HopeThird_Passive[chosen] then
set detail=detail+"|n|n|cffd2b879专属被动研习|r|n当前 "+I2S(HopeThird_Level(udg_hero[i]))+"/3级；可用技能点 "+I2S(GetHeroSkillPoints(udg_hero[i]))+"。|n|n每提升1级消耗1技能点，不再消耗木材或金币。|n原有及后续升级获得的技能点均可使用。|n请在泉水房间点击下方研习按钮。|n技能页可查看各级效果。"
else
set detail=detail+"|n|n专属觉醒技能已获得；按Z使用。|n查看技能页了解效果与行动点消耗。|n三转奖励已发放，无需再次支付转职费用。"
endif
endif
call HopeJob_SetText(HopeJob_Detail,detail)
call HopeJob_ShowFrame(HopeJob_Confirm[chosen],true)
if block=="" then
if HopeJob_Entry==1 and HopeReclass_Can(i) then
call HopeJob_SetText(HopeJob_Confirm[chosen],"确认重转："+HopeJob_Name[chosen]+"（10存档积分）")
elseif HopeJob_Stage[chosen]==3 then
call HopeJob_SetText(HopeJob_Confirm[chosen],"确认："+HopeJob_Name[chosen]+"（30木+1000金）")
else
call HopeJob_SetText(HopeJob_Confirm[chosen],"确认："+HopeJob_Name[chosen])
endif
if HopeJob_Entry==1 and HopeReclass_Can(i) then
set block="确认即扣10积分并换职业；二转后不能重新转职。"
elseif HopeJob_Stage[chosen]==1 then
set block="首次转职免费；一转期间可花10积分重新转职。"
else
set block="条件已满足。转职确认后本局不可撤销。"
endif
else
if HopeJob_Stage[chosen]==3 then
call HopeJob_SetText(HopeJob_Confirm[chosen],"需30木材+1000金币")
else
call HopeJob_SetText(HopeJob_Confirm[chosen],"暂不可转职：查看下方条件")
endif
endif
if HopeJob_Awakened[i] and chosen==HopeJob_AwakenOption[i] then
if HopeThird_Passive[chosen] then
call HopeJob_SetText(HopeJob_Status,"专属被动 "+I2S(HopeThird_Level(udg_hero[i]))+"/3级 · 技能点 "+I2S(GetHeroSkillPoints(udg_hero[i])))
if HopeThird_Level(udg_hero[i])<3 then
call HopeJob_SetText(HopeJob_Confirm[chosen],"研习至 "+I2S(HopeThird_Level(udg_hero[i])+1)+" 级（1技能点）")
else
call HopeJob_SetText(HopeJob_Confirm[chosen],"专属被动已满级")
endif
set block=HopeThird_StudyBlock(chosen,p)
if block=="" then
set block="每次仅消耗1技能点；后续升级获得的技能点也可研习。"
endif
else
call HopeJob_SetText(HopeJob_Confirm[chosen],"已完成三转")
set block="专属觉醒技能已获得；查看技能页了解用法。"
endif
endif
call HopeJob_SetText(HopeJob_Footer,block)
else
call HopeJob_ShowFrame(HopeJob_PrevButton,false)
call HopeJob_ShowFrame(HopeJob_NextButton,false)
call HopeJob_ShowFrame(HopeJob_PageLabel,false)
call HopeJob_SetText(HopeJob_Footer,"")
if HopeJob_Entry==1 and typ!='H000' then
call HopeJob_SetText(HopeJob_Detail,"你已完成一转。请在二转建筑出现后，前往该建筑继续二转或三转。")
elseif HopeJob_Entry==2 and typ=='H000' then
call HopeJob_SetText(HopeJob_Detail,"请先在一转建筑完成一转，再来选择本职业的二转路线。")
else
call HopeJob_SetText(HopeJob_Detail,"当前没有可用的进阶路线。")
endif
endif
set p=null
endfunction
function HopeJob_Refresh takes nothing returns nothing
call HopeJob_RefreshContent()
call HopeLayout_Apply()
endfunction
