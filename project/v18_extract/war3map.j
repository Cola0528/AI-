function HopeMeta_Close takes nothing returns nothing
set HopeMeta_Open=false
endfunction
function HopeMeta_Show takes nothing returns nothing
set HopeMeta_Open=true
call HopeLayout_Focus(15)
endfunction
function HopeMeta_Toggle takes nothing returns nothing
if HopeMeta_Open then
call HopeMeta_Close()
else
call HopeMeta_Show()
endif
endfunction
function HopeMeta_Prev takes nothing returns nothing
set HopeMeta_Page=IMaxBJ(0,HopeMeta_Page-1)
endfunction
function HopeMeta_Next takes nothing returns nothing
set HopeMeta_Page=HopeMeta_Page+1
endfunction
function HopeMeta_ResetClick takes nothing returns nothing
call HopeMeta_Reset(DzGetTriggerUIEventPlayer())
endfunction
function HopeMeta_RelicIndex takes integer itemId returns integer
local integer j=0
loop
exitwhen j>=44
if HopeRelic_Item(j)==itemId then
return j
endif
set j=j+1
endloop
return -1
endfunction
function HopeMeta_FillSeed takes integer i,boolean original returns nothing
local integer slot=0
local integer attempts=0
local integer candidate=-1
local integer j=0
local integer itemId=0
local integer limit=IMinBJ(4,44-HopeRelic_Total(Player(i)))
local boolean duplicate=false
local item drawn=null
set HopeMeta_SeedCount[i]=0
loop
exitwhen slot>=limit or attempts>=32
set attempts=attempts+1
if original and attempts<=3 then
set itemId=HopeMeta_SupplyItem[attempts-1]
else
set drawn=PlaceRandomItem(udg_YiwuChi[i+1],2706.,2100.)
if drawn==null then
exitwhen true
endif
set itemId=GetItemTypeId(drawn)
call RemoveItem(drawn)
set drawn=null
endif
set candidate=HopeMeta_RelicIndex(itemId)
set duplicate=candidate<0
if candidate>=0 and HopeRelic_Owned(Player(i),candidate) then
set duplicate=true
endif
set j=0
loop
exitwhen j>=slot
if HopeMeta_SeedCandidate[i*4+j]==candidate then
set duplicate=true
endif
set j=j+1
endloop
if not duplicate then
set HopeMeta_SeedCandidate[i*4+slot]=candidate
set slot=slot+1
set HopeMeta_SeedCount[i]=slot
endif
endloop
set drawn=null
endfunction
function HopeMeta_OfferRelic takes nothing returns nothing
local integer i=HopeMeta_SupplyOwner
local player p=Player(i)
local integer j=0
local string fallback=""
if i<0 or i>=6 or not HopeMeta_Started[i] or HopeMeta_FirstRelic[i]>0 or udg_YiwuChi[i+1]==null then
set p=null
return
endif
if not HaveSavedInteger(YDHT,GetHandleId(udg_Youxi_xzgq),$FB89B46C) then
set p=null
return
endif
if HopeMeta_Tal(i,13)<=0 and HopeMeta_RunKey[i]!=3 and not HopeMeta_Has(HopeMeta_RunAbyss[i],2) then
set p=null
return
endif
call HopeMeta_FillSeed(i,true)
if HopeMeta_SeedCount[i]<=0 then
set p=null
return
endif
set HopeMeta_FirstRelic[i]=1
set HopeMeta_SeedPending[i]=true
set HopeMeta_SeedCharges[i]=IMaxBJ(0,HopeMeta_Tal(i,13)-1)
if HopeMeta_RunKey[i]==3 then
set HopeMeta_SeedCharges[i]=HopeMeta_SeedCharges[i]+1
endif
// Consume the original claim token on every peer. This pending picker replaces
// its three buttons; it never creates a second independent relic reward.
call SaveBoolean(YDHT,GetHandleId(p),$AB392274,true)
if p==GetLocalPlayer() then
if HopeMeta_Panel==0 then
loop
exitwhen j>=HopeMeta_SeedCount[i]
set fallback=fallback+I2S(j+1)+". "+HopeRelic_Name(HopeMeta_SeedCandidate[i*4+j])+"|n"
set j=j+1
endloop
call DisplayTimedTextToPlayer(p,0,0,30.,"遗物选择界面未能创建。输入 -relic 1（或其他序号）领取：|n"+fallback)
endif
set HopeMeta_Open=true
set HopeMeta_Tab=6
set HopeMeta_Page=0
call HopeLayout_Focus(15)
endif
set p=null
endfunction
function HopeMeta_SeedTake takes player p,integer slot returns nothing
local integer i=GetPlayerId(p)
local integer index=0
local item gift=null
if i<0 or i>=6 or not HopeMeta_SeedPending[i] or udg_ZhandouZhong or udg_Yiwu_danwei[i+1]==null then
return
endif
if slot<0 or slot>=HopeMeta_SeedCount[i] then
return
endif
set index=HopeMeta_SeedCandidate[i*4+slot]
// Grant via the original relic holder and pickup handler; all original effects
// and permanent discovery mapping use the same path as ordinary relic rewards.
set HopeMeta_SeedPending[i]=false
set gift=UnitAddItemById(udg_Yiwu_danwei[i+1],HopeRelic_Item(index))
if gift==null then
set HopeMeta_SeedPending[i]=true
call DisplayTextToPlayer(p,0,0,"遗物未能发放，请清理遗物单位的物品位后重试。")
else
call DisplayTextToPlayer(p,0,0,"遗物先机："+HopeRelic_Name(index)+"。")
endif
set gift=null
endfunction
function HopeMeta_SeedChat takes nothing returns nothing
// Synchronized recovery path if a client cannot create the choice frames.
call HopeMeta_SeedTake(GetTriggerPlayer(),S2I(SubString(GetEventPlayerChatString(),7,8))-1)
endfunction
function HopeMeta_SeedReroll takes nothing returns nothing
local player p=DzGetTriggerUIEventPlayer()
local integer i=GetPlayerId(p)
if i>=0 and i<6 and HopeMeta_SeedPending[i] and HopeMeta_SeedCharges[i]>0 and not udg_ZhandouZhong then
set HopeMeta_SeedCharges[i]=HopeMeta_SeedCharges[i]-1
call HopeMeta_FillSeed(i,false)
endif
set p=null
endfunction
function HopeMeta_SeedLeave takes nothing returns nothing
set HopeMeta_SeedHover=-1
endfunction
function HopeMeta_Refresh takes nothing returns nothing
local integer i=GetPlayerId(GetLocalPlayer())
local integer j=0
local integer node=0
local integer level=0
local integer pages=1
local integer count=0
local real off=1.
local real def=1.
local string text=""
local string line=""
local string flag=""
local integer catalog=0
local integer prereq=0
if HopeMeta_Panel==0 or i<0 or i>=6 then
return
endif
call HopeLayout_Show(HopeMeta_Panel,HopeMeta_Open)
call HopeLayout_Show(HopeMeta_Entry,not HopeMeta_Open)
call HopeLayout_Show(HopeMeta_SeedInfoPanel,HopeMeta_Open and HopeMeta_Tab==6 and HopeMeta_SeedPending[i])
if HopeMeta_Open and HopeMeta_Tab==6 and HopeMeta_SeedPending[i] and HopeMeta_SeedHover>=0 and HopeMeta_SeedHover<HopeMeta_SeedCount[i] then
set catalog=HopeMeta_SeedCandidate[i*4+HopeMeta_SeedHover]
call HopeJob_SetText(HopeMeta_SeedInfoText,"|cffd2b879"+HopeRelic_Name(catalog)+"|r|n|n"+HopeRelic_Description(catalog,0)+"|n"+HopeRelic_Description(catalog,1))
else
call HopeJob_SetText(HopeMeta_SeedInfoText,"将鼠标移到左侧候选，|n这里会显示完整遗物效果。|n|n关闭面板不会领取或丢弃奖励；|n可先查看角色，再回来选择。")
endif
if not HopeMeta_Open then
return
endif
if HopeMeta_Tab==1 then
set pages=2
elseif HopeMeta_Tab==3 then
set pages=3
elseif HopeMeta_Tab==4 then
set pages=44
elseif HopeMeta_Tab==5 then
set pages=6
endif
set HopeMeta_Page=IMaxBJ(0,IMinBJ(pages-1,HopeMeta_Page))
call HopeJob_SetText(HopeMeta_Heading,"|cffd2b879局外成长 · 1.0.4 UI2|r  积分 "+I2S(udg_Wj_jf[i+1])+" / 魂晶 "+I2S(HopeMeta_Soul[i]))
loop
exitwhen j>=24
call HopeLayout_Show(HopeMeta_BuyButton[j],false)
set j=j+1
endloop
set j=0
loop
exitwhen j>=4
call HopeLayout_Show(HopeMeta_SeedButton[j],false)
set j=j+1
endloop
set j=0
loop
exitwhen j>=3
call HopeLayout_Show(HopeMeta_TreeHeading[j],HopeMeta_Loaded[i] and HopeMeta_Tab==1 and HopeMeta_Page==0)
set j=j+1
endloop
call HopeLayout_Show(HopeMeta_ResetButton,HopeMeta_Loaded[i] and HopeMeta_Tab==1)
call HopeLayout_Show(HopeMeta_SeedRerollButton,HopeMeta_Tab==6 and HopeMeta_SeedPending[i] and HopeMeta_SeedCharges[i]>0)
if HopeMeta_Loaded[i] and HopeMeta_Tab==6 and HopeMeta_SeedPending[i] then
call HopeMeta_Size(HopeMeta_Body,.548,.043)
else
call HopeMeta_Size(HopeMeta_Body,.548,.263)
endif
if not HopeMeta_Loaded[i] then
set text="云档未就绪。请从KK RPG大厅或作者测试大厅启动。|n旧档读取失败时不创建新档、不覆盖旧余额。|n本局仍可进行普通战斗，但永久成长不可购买。|n|n输入 -save 可查看平台载入诊断。"
elseif HopeMeta_Tab==0 then
set text="|cffd2b879爬塔等级 "+I2S(1+R2I(SquareRoot(I2R(HopeMeta_Xp[i])/100.)))+"|r · 累计已记录积分 "+I2S(HopeMeta_Xp[i])+"|n|n已购基础成长 · 在原存档页购买|n"
set j=0
loop
exitwhen j>=10
set level=HopeArchive_Count(Player(i),j)
set text=text+GetAbilityName(HopeArchive_Ability(j))+" "+I2S(level)+"/5次"
if ModuloInteger(j,2)==0 then
set text=text+"    "
else
set text=text+"|n"
endif
set j=j+1
endloop
set catalog=HopeMeta_Count(HopeMeta_Relic[i*2])+HopeMeta_Count(HopeMeta_Relic[i*2+1])
set text=text+"|n成就 "+I2S(HopeMeta_Count(HopeMeta_Ach[i]))+"/24 · 图鉴 "+I2S(catalog)+"/44 · 无限最高 "+I2S(HopeMeta_Best[i])+"轮|n"
if HopeMeta_Started[i] then
set off=HopeMeta_Out(i,true,true,true)
set def=Pow(HopeMeta_RawDef(i),HopeMeta_Exponent(i))
set text=text+"本局新增伤害上限 +"+I2S(R2I((off-1.)*100.))+"% · 新增防护 +"+I2S(R2I((def-1.)*100.))+"%|n"
endif
set text=text+"|n天赋 / 基石 / 深渊：购买与重置均在下一局生效。|n旧档余额与购买完整保留；未知历史花费不计入累计。"
elseif HopeMeta_Tab==1 then
if HopeMeta_Page==0 then
set j=0
loop
exitwhen j>=15
set level=HopeMeta_Level(HopeMeta_Talent[i*3+j/5],ModuloInteger(j,5))
set prereq=HopeMeta_NodePrereq[j]
set line="无需前置"
if prereq>=0 then
set line="前置："+HopeMeta_NodeName[prereq]
if HopeMeta_Level(HopeMeta_Talent[i*3+prereq/5],ModuloInteger(prereq,5))<=0 then
set line="|cffdf9c85"+line+"（未学）|r"
else
set line="|cff9ddbaf"+line+"（已学）|r"
endif
endif
call HopeLayout_Show(HopeMeta_BuyButton[j],true)
if level>=3 then
set flag="|cff9ddbaf已满级|r"
else
set flag="升级："+I2S(HopeMeta_NodeCost[j]*(level+1))+"积分"
endif
call HopeJob_SetText(HopeMeta_BuyText[j],"|cffd2b879"+HopeMeta_NodeName[j]+" · "+I2S(level)+"/3|r|n"+HopeMeta_NodeBrief[j]+"|n"+line+"|n"+flag)
set j=j+1
endloop
// The three mutually exclusive keystones appear together on the second page.
else
set text="|cffd2b879基石 · 三选一|r|n三者互斥，购买下一局生效；重置天赋会同时返还基石花费。"
set j=21
loop
exitwhen j>=24
call HopeLayout_Show(HopeMeta_BuyButton[j],true)
if j==21 then
set line="先阵|r|n|n每场首回合获得4%生命护盾；|n首个命中回复2魔法。"
elseif j==22 then
set line="休整|r|n|n每场胜利额外回复2%生命。"
else
set line="探索|r|n|n首次正常遗物奖励4选1；|n免费重选候选一次。"
endif
set flag="80积分 · 选择"
if HopeMeta_Keystone[i]==j-20 then
set flag="|cff9ddbaf已选择|r"
elseif HopeMeta_Keystone[i]>0 then
set flag="已选择其他基石"
endif
call HopeJob_SetText(HopeMeta_BuyText[j],"|cffd2b879"+line+"|n|n"+flag)
set j=j+1
endloop
endif
set pages=2
elseif HopeMeta_Tab==2 then
set text="消耗魂晶解锁，下一局生效；已解锁的项目不会重复扣费。"
set j=0
loop
exitwhen j>=6
set flag="未解锁"
if HopeMeta_Has(HopeMeta_Abyss[i],j) then
set flag="已解锁"
endif
call HopeLayout_Show(HopeMeta_BuyButton[15+j],true)
call HopeJob_SetText(HopeMeta_BuyText[15+j],"|cffd2b879"+HopeMeta_AbyssName[j]+" · "+flag+"|r|n|n"+HopeMeta_AbyssDesc[j]+"|n|n"+I2S(HopeMeta_AbyssCost[j])+"魂晶 · 解锁")
set j=j+1
endloop
elseif HopeMeta_Tab==3 then
set pages=3
set j=HopeMeta_Page*8
loop
exitwhen j>=24 or j>=(HopeMeta_Page+1)*8
set flag="未完成"
if HopeMeta_Has(HopeMeta_Ach[i],j) then
set flag="|cff9ddbaf已完成|r"
endif
set text=text+I2S(j+1)+". "+HopeMeta_AchName[j]+" · "+flag+"|n|n"
set j=j+1
endloop
set text=text+"每项首次完成奖励5积分；20项是里程碑，24项才全收集。"
elseif HopeMeta_Tab==4 then
set pages=44
set j=HopeMeta_Page
set flag="未发现"
if HopeMeta_Has(HopeMeta_Relic[i*2+j/22],ModuloInteger(j,22)) then
set flag="|cff9ddbaf已发现|r"
endif
set text="|cffd2b879"+I2S(j+1)+". "+HopeRelic_Name(j)+"|r · "+flag+"|n|n"+HopeRelic_Description(j,0)+"|n"+HopeRelic_Description(j,1)+"|n|n首次获得即记录图鉴；本页不代表本局持有。"
elseif HopeMeta_Tab==5 then
set pages=6
set j=HopeMeta_Page*8
loop
exitwhen j>=43 or j>=(HopeMeta_Page+1)*8
set level=IMinBJ(5,HopeMeta_Mastery[i*43+j]/5)
set text=text+HopeJob_Name[j]+" · 精通 "+I2S(level)+"/5 · 守门人经验 "+I2S(HopeMeta_Mastery[i*43+j])+"|n|n"
set j=j+1
endloop
set text=text+"每5次BOSS结算升1级；当前职业伤害每级+0.4%，满级2%。|n零熟练度无需补刷；三转单独记录；下局载入成长。"
elseif HopeMeta_Tab==6 then
if HopeMeta_SeedPending[i] then
set text="首次遗物奖励 · "+I2S(HopeMeta_SeedCount[i])+"选1|n悬停看右侧完整效果；免费重选 "+I2S(HopeMeta_SeedCharges[i])+"次。"
set count=HopeMeta_SeedCount[i]
set j=0
loop
exitwhen j>=count
set catalog=HopeMeta_SeedCandidate[i*4+j]
call HopeLayout_Show(HopeMeta_SeedButton[j],true)
call HopeMeta_Texture(HopeMeta_SeedIcon[j],HopeRelic_IconPath(catalog),0)
call HopeJob_SetText(HopeMeta_SeedText[j],"|cffd2b879"+HopeRelic_Name(catalog)+"|r|n悬停查看效果 · 点击领取")
set j=j+1
endloop
else
set text="本局没有待选遗物先机。|n资源系先机、探索基石、深渊先机任选一种即可解锁。|n第一次正常遗物奖励3选1变4选1，不会额外赠送遗物。|n资源天赋2/3级额外允许1/2次候选重选。|n其他普通遗物奖励沿用原版选择流程。"
endif
endif
set HopeMeta_Page=IMaxBJ(0,IMinBJ(pages-1,HopeMeta_Page))
call HopeJob_SetText(HopeMeta_Body,text)
call HopeJob_SetText(HopeMeta_Status,"页 "+I2S(HopeMeta_Page+1)+"/"+I2S(pages)+" · "+HopeCloud_Status(Player(i)))
endfunction
function HopeMarket_Trade takes player p,integer kind returns nothing
local integer i=GetPlayerId(p)
local integer quantity=1
local integer n=0
local integer gold=0
local integer wood=0
local integer price=0
local string text=""
local string result=""
if i<0 or i>=6 or kind<0 or kind>=6 or not HopeWood_Allowed(gg_unit_n00Q_0028,udg_hero[i+1]) then
call DisplayTextToPlayer(p,0,0,"请沿路线进入能力商店关卡后交易；战斗中或角色阵亡时不可使用。")
return
endif
// Availability follows synchronized room entry, never a local UI selection.
set gold=GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)
set wood=GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)
if kind==1 then
set quantity=10
elseif kind==3 or kind==5 then
set quantity=5
endif
if kind<=1 then
if wood<quantity then
call DisplayTextToPlayer(p,0,0,"木材不足。")
return
endif
set HopeDraw_Busy[i]=true
call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,wood-quantity)
loop
exitwhen n>=quantity
set result="谢谢惠顾"
if GetRandomInt(1,100)>50 then
set result=HopeDraw_Reward(p)
endif
set text=text+I2S(n+1)+". "+result+"|n"
set n=n+1
endloop
call HopeDraw_SaveRecord(p,"木材抽奖 · 消耗"+I2S(quantity)+"木材",text,true)
set HopeDraw_Busy[i]=false
elseif kind<=3 then
set price=HopeMarket_GoldCost*quantity
if gold<price or wood>2000000000-quantity then
call DisplayTextToPlayer(p,0,0,"金币不足或木材已达安全上限。")
return
endif
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,gold-price)
call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,wood+quantity)
call DisplayTextToPlayer(p,0,0,"兑换完成：消耗"+I2S(price)+"金币，获得"+I2S(quantity)+"木材。")
else
set price=HopeMarket_GoldReward*quantity
if wood<quantity or gold>2000000000-price then
call DisplayTextToPlayer(p,0,0,"木材不足或金币已达安全上限。")
return
endif
call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,wood-quantity)
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,gold+price)
call DisplayTextToPlayer(p,0,0,"兑换完成：消耗"+I2S(quantity)+"木材，获得"+I2S(price)+"金币。")
endif
endfunction
function HopeMarket_Close takes nothing returns nothing
set HopeMarket_Open=false
endfunction
function HopeMarket_Show takes nothing returns nothing
local player p=GetLocalPlayer()
local integer i=GetPlayerId(p)
if i<0 or i>=6 then
set p=null
return
endif
if not HopeWood_Allowed(gg_unit_n00Q_0028,udg_hero[i+1]) then
set HopeMarket_Open=false
call DisplayTextToPlayer(p,0,0,"能力商店只在沿路线进入商店关卡后开放。")
set p=null
return
endif
set HopeMarket_Open=true
call HopeLayout_Focus(16)
set p=null
endfunction
function HopeMarket_Refresh takes nothing returns nothing
local player p=GetLocalPlayer()
local integer i=GetPlayerId(p)
local boolean available=false
if i>=0 and i<6 then
set available=HopeWood_Allowed(gg_unit_n00Q_0028,udg_hero[i+1])
endif
call HopeLayout_Show(HopeMarket_Entry,available and not HopeMeta_Open)
if not available then
set HopeMarket_Open=false
endif
if HopeMarket_Panel==0 then
set p=null
return
endif
call HopeLayout_Show(HopeMarket_Panel,HopeMarket_Open)
if HopeMarket_Open then
call HopeJob_SetText(HopeMarket_Body,"金币 "+I2S(GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD))+" · 木材 "+I2S(GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER))+"|n木材单抽/十连：每次独立50%空签，保留原奖池。|n购1木材 "+I2S(HopeMarket_GoldCost)+"金；售1木材 "+I2S(HopeMarket_GoldReward)+"金；每轮兑换损失26金。")
endif
set p=null
endfunction
