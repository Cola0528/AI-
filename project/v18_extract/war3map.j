function HopeRelic_Refresh takes nothing returns nothing
local player p=GetLocalPlayer()
local integer total=0
local integer pageCount=1
local integer index=0
local integer ordinal=0
local integer row=0
local integer first=-1
local boolean selectedVisible=false
local boolean show=false
local string title=""
if not HopeRelic_UIReady then
set p=null
return
endif
set show=HopeRelic_Expanded and not (HopeChoice_HasPending() and not HopeChoice_Hidden)
if HopeQoL_Expanded or HopeArchive_Expanded or HopeGift_Expanded or HopeRoute_Details then
set HopeRelic_Expanded=false
set show=false
endif
call DzFrameShow(HopeRelic_Panel,show)
if not show then
set p=null
return
endif
set total=HopeRelic_Total(p)
set pageCount=R2I(I2R(total+5)/6.)
if pageCount<1 then
set pageCount=1
endif
if HopeRelic_Page>=pageCount then
set HopeRelic_Page=pageCount-1
endif
loop
exitwhen row>=6
set HopeRelic_RowIndex[row]=-1
call DzFrameShow(HopeRelic_RowButton[row],false)
set row=row+1
endloop
set row=0
loop
exitwhen index>=44
if HopeRelic_Owned(p,index) then
if ordinal>=HopeRelic_Page*6 and ordinal<(HopeRelic_Page+1)*6 then
set HopeRelic_RowIndex[row]=index
if first==-1 then
set first=index
endif
if index==HopeRelic_Selected then
set selectedVisible=true
endif
set row=row+1
endif
set ordinal=ordinal+1
endif
set index=index+1
endloop
if not selectedVisible then
set HopeRelic_Selected=first
set HopeRelic_DetailPage=0
endif
set row=0
loop
exitwhen row>=6
set index=HopeRelic_RowIndex[row]
if index>=0 then
set title=HopeRelic_Name(index)
if index==HopeRelic_Selected then
set title="|cffffd27a"+title+"|r"
else
set title="|cffdedede"+title+"|r"
endif
call DzFrameSetText(HopeRelic_RowButton[row],title)
call DzFrameShow(HopeRelic_RowButton[row],true)
endif
set row=row+1
endloop
call DzFrameSetText(HopeRelic_Heading,"|cffd2b879本局遗物|r")
call DzFrameSetText(HopeRelic_Summary,"已获得 "+I2S(total)+" 种 · 点击名称查看完整效果")
call DzFrameSetText(HopeRelic_PageText,I2S(HopeRelic_Page+1)+" / "+I2S(pageCount))
call DzFrameShow(HopeRelic_PrevButton,HopeRelic_Page>0)
call DzFrameShow(HopeRelic_NextButton,(HopeRelic_Page+1)*6<total)
set index=HopeRelic_Selected
if index<0 then
call DzFrameShow(HopeRelic_Icon,false)
call DzFrameSetText(HopeRelic_NameText,"尚未获得遗物")
call DzFrameSetText(HopeRelic_StateText,"")
call DzFrameSetText(HopeRelic_DetailText,"在冒险中选择遗物奖励后，可在这里查看名称与完整效果。")
call DzFrameShow(HopeRelic_DetailButton,false)
else
call DzFrameSetTexture(HopeRelic_Icon,HopeRelic_IconPath(index),0)
call DzFrameShow(HopeRelic_Icon,true)
call DzFrameSetText(HopeRelic_NameText,"|cffd2b879"+HopeRelic_Name(index)+"|r")
call DzFrameSetText(HopeRelic_StateText,HopeRelic_State(p,index))
call DzFrameSetText(HopeRelic_DetailText,HopeRelic_Description(index,HopeRelic_DetailPage))
call DzFrameShow(HopeRelic_DetailButton,HopeRelic_DescriptionPages(index)>1)
call DzFrameSetText(HopeRelic_DetailButton,"说明 "+I2S(HopeRelic_DetailPage+1)+"/"+I2S(HopeRelic_DescriptionPages(index))+"  >")
endif
set p=null
endfunction

