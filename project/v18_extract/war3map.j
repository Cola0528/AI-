call UnitRemoveAbilityBJ($41303142,udg_Yiwu_danwei[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)])
call SaveBoolean(YDHT,GetHandleId(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9F0C6E00)),$EA42029E,true)
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
set ydl_timer=null
