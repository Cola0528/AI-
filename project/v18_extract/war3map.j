call ForceRemovePlayerSimple(GetOwningPlayer(GetTriggerUnit()),udg_WJZ_______cunhuo)
call ForceAddPlayerSimple(GetOwningPlayer(GetTriggerUnit()),udg_WJZ_______siwang)
