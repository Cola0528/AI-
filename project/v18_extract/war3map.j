// Meditation keeps real mana and mana capacity independent of the temporary intelligence.

// Keep turn identity separate from the unbounded challenge round counter.

// Count participating human slots, including fallen heroes who can be revived.
// A player who left is excluded at the next room, never partway through a fight.
function HopeName_Step takes string s,integer at returns integer
local integer h=StringHash(SubString(s,at,at+1))
local integer n=StringLength(s)-at
local integer step=1
// Newer engines normalize incomplete UTF-8 slices; widen only up to one character.
if h==1843378377 then
loop
exitwhen step>=4 or step>=n
set step=step+1
exitwhen StringHash(SubString(s,at,at+step))!=h
endloop
return step
endif
// Classic engine hashes byte slices directly. No non-BMP source literals.
if h==-643770102 or h==1697315672 or h==152013319 or h==-1048766234 or h==1817785734 or h==1772290269 or h==224611159 or h==-941949360 or h==-1964233184 or h==-1853905496 or h==-2147421637 or h==-1324312884 or h==-576610362 or h==1790768057 or h==-2099350373 or h==-1266365587 then
return IMinBJ(3,n)
endif
if h==-821046842 or h==1965576605 or h==159638553 or h==1976614787 or h==172358365 or h==-1487094743 or h==852857962 or h==-1499360152 or h==388578373 or h==-466619119 or h==-580057007 or h==-443785825 or h==-635169143 or h==-1421069964 or h==-1232080964 or h==-1195283317 or h==-1145431583 or h==1065729488 or h==2057488321 or h==-42326540 or h==2092530722 or h==701044297 or h==-2016087502 or h==50775334 or h==-1236243595 or h==379765120 or h==1483819556 or h==154860577 or h==-1222483548 or h==847928083 then
return IMinBJ(2,n)
endif
if h==1663769127 or h==1316854887 or h==-2027516833 or h==1910426181 or h==760701047 then
return IMinBJ(4,n)
endif
return 1
endfunction
function HopeName_Clean takes string s returns string
local string result=""
local string c=""
local integer n=StringLength(s)
local integer at=0
local integer step=1
loop
exitwhen at>=n
if SubString(s,at,at+2)=="|c" and at+10<=n then
set at=at+10
elseif SubString(s,at,at+2)=="|r" then
set at=at+2
elseif SubString(s,at,at+2)=="|n" then
set result=result+" "
set at=at+2
else
set step=HopeName_Step(s,at)
set c=SubString(s,at,at+step)
set result=result+c
set at=at+step
endif
endloop
return result
endfunction
function HopeName_CharWidth takes string c returns integer
if StringLength(c)>1 or c=="W" or c=="M" or c=="w" or c=="m" or c=="@" or c=="%" then
return 10
endif
return 7
endfunction
function HopeName_Width takes string s returns integer
local integer at=0
local integer step=1
local integer width=0
loop
exitwhen at>=StringLength(s)
set step=HopeName_Step(s,at)
set width=width+HopeName_CharWidth(SubString(s,at,at+step))
set at=at+step
endloop
return width
endfunction
function HopeName_Clip takes string s,integer limit returns string
local integer at=0
local integer step=1
local integer width=0
local integer next=0
if HopeName_Width(s)<=limit then
return s
endif
loop
exitwhen at>=StringLength(s)
set step=HopeName_Step(s,at)
set next=width+HopeName_CharWidth(SubString(s,at,at+step))
exitwhen next>limit-10
set width=next
set at=at+step
endloop
return SubString(s,0,at)+"…"
endfunction
function HopeName_Refresh takes nothing returns nothing
local integer i=0
local string raw=""
local boolean active=false
loop
exitwhen i>=6
set raw=GetPlayerName(Player(i))
set active=GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING
if raw!=HopeName_Raw[i] or active!=HopeName_Active[i] then
set HopeName_Raw[i]=raw
set HopeName_Plain[i]=HopeName_Clean(raw)
set HopeName_Active[i]=active
set HopeName_Version=HopeName_Version+1
endif
set i=i+1
endloop
endfunction
function HopeName_Label takes player p,integer limit returns string
local integer i=GetPlayerId(p)
local integer j=0
local integer key=0
local string name=""
local string result=""
local string suffix=""
if i<0 or i>=6 then
return GetPlayerName(p)
endif
set limit=IMaxBJ(36,IMinBJ(120,limit))
set key=i*128+limit
call HopeName_Refresh()
if HopeName_Stamp[key]==HopeName_Version then
return HopeName_Cached[key]
endif
set name=HopeName_Plain[i]
if name=="" then
set result="玩家"+I2S(i+1)
else
set result=HopeName_Clip(name,limit)
loop
exitwhen j>=6
if j!=i and HopeName_Active[j] and HopeName_Clip(HopeName_Plain[j],limit)==result then
set suffix="#"+I2S(i+1)
exitwhen true
endif
set j=j+1
endloop
if suffix!="" then
set result=HopeName_Clip(name,limit-HopeName_Width(suffix))+suffix
endif
endif
set HopeName_Cached[key]=result
set HopeName_Stamp[key]=HopeName_Version
return result
endfunction
function HopeInventory_Put takes unit receiver,item it returns boolean
local integer i=GetPlayerId(GetOwningPlayer(receiver))+1
local unit helper=null
if it==null or GetItemTypeId(it)==0 or receiver==null then
return false
endif
if UnitAddItem(receiver,it) then
return true
endif
// A pickup/combine callback may already have consumed the item.
if GetItemTypeId(it)==0 or IsItemOwned(it) then
return true
endif
if i>=1 and i<=6 and (receiver==udg_hero[i] or receiver==udg_Bei_bao_danwei[i]) then
set helper=udg_Bei_bao_danwei[i]
if receiver==helper then
set helper=udg_hero[i]
endif
if helper!=null and GetUnitTypeId(helper)!=0 and UnitAddItem(helper,it) then
call DisplayTimedTextToPlayer(GetOwningPlayer(receiver),0,0,4.,"背包已满：装备已转入另一背包。")
set helper=null
return true
endif
endif
if GetItemTypeId(it)!=0 and not IsItemOwned(it) then
call SetItemPosition(it,GetUnitX(receiver),GetUnitY(receiver))
call DisplayTimedTextToPlayer(GetOwningPlayer(receiver),0,0,5.,"两个背包均无空位：装备已放在领取单位脚下。")
endif
set helper=null
return false
endfunction
function HopeInventory_Give takes integer id,unit receiver returns item
local item it=CreateItem(id,GetUnitX(receiver),GetUnitY(receiver))
call HopeInventory_Put(receiver,it)
set bj_lastCreatedItem=it
set it=null
return bj_lastCreatedItem
endfunction
function HopeEvent_Add takes string text returns nothing
local integer a=0
local integer b=0
local integer n=StringLength(text)
loop
exitwhen b>n
if b==n or SubString(text,b,b+2)=="|n" then
if b>a then
set HopeEvent_Line[ModuloInteger(HopeEvent_Count,512)]=SubString(text,a,b)
set HopeEvent_Count=HopeEvent_Count+1
endif
set b=b+2
set a=b
else
set b=b+1
endif
endloop
endfunction
function HopeEvent_Begin takes nothing returns nothing
set HopeEvent_Sequence=HopeEvent_Sequence+1
set HopeEvent_Start=HopeEvent_Count
call HopeEvent_Add("|cffd2b879问号事件 #"+I2S(HopeEvent_Sequence)+" · 全队可见|r")
endfunction
function HopeLayout_Place takes integer frame,integer parent,real x,real y,real w,real h returns nothing
if frame==0 then
return
endif
call DzFrameClearAllPoints(frame)
if parent==0 then
call DzFrameSetAbsolutePoint(frame,0,x,y)
else
call DzFrameSetPoint(frame,0,parent,0,x,y)
endif
call DzFrameSetSize(frame,w,h)
endfunction
function HopeLayout_Show takes integer frame,boolean show returns nothing
if frame!=0 then
call DzFrameShow(frame,show)
endif
endfunction
// Called exclusively inside local presentation branches, including local parts
// of synchronized actions. Choice pending counts and gameplay stay untouched.
function HopeLayout_Focus takes integer view returns nothing
if view!=1 then
set HopeQoL_Expanded=false
endif
if view!=2 then
set HopeArchive_Expanded=false
endif
if view!=3 then
set HopeGift_Expanded=false
endif
if view!=4 then
set HopeRelic_Expanded=false
endif
if view!=5 then
set HopeJob_Expanded=false
endif
if view!=6 then
set HopeRoute_PickerOpen=false
endif
if view!=7 then
set HopeDraw_Open=false
endif
if view!=9 then
set HopeRoute_Details=false
endif
if view!=14 then
set HopeEvent_Open=false
endif
if view!=15 then
set HopeMeta_Open=false
endif
if view!=16 then
set HopeMarket_Open=false
endif
set HopeChoice_Hidden=true
endfunction

// Canonical run pressure includes encounter HP, attack, count and round count.
// Coefficients are generated/calculated in audit/v19-calibration.py.
function HopeDifficulty_Hp takes integer difficulty returns real
if difficulty==2 then
return 1.1568627451
elseif difficulty==3 then
return 1.1713235294
elseif difficulty==4 then
return 1.5518379121
elseif difficulty>=5 then
return 1.7040094340
endif
return 1.
endfunction
function HopeDifficulty_Attack takes integer difficulty returns real
if difficulty==2 or difficulty==3 then
return 1.02
elseif difficulty==4 then
return 1.04
elseif difficulty>=5 then
return 1.06
endif
return 1.
endfunction

function HopeRewards_Win takes integer difficulty returns integer
if difficulty==1 then
return 4
elseif difficulty==2 then
return 8
elseif difficulty==3 then
return 12
elseif difficulty==4 then
return 22
elseif difficulty==5 then
return 39
endif
return 0
endfunction
function HopeRewards_Boss takes integer difficulty,integer roundIndex returns integer
if difficulty==6 then
return 12+IMinBJ(28,R2I(2.*SquareRoot(I2R(IMaxBJ(0,roundIndex)))))
elseif difficulty==1 then
return 2
elseif difficulty==2 then
return 2
elseif difficulty==3 then
return 3
elseif difficulty==4 then
return 4
elseif difficulty==5 then
return 6
endif
return 2
endfunction

function HopeCoop_CountPlayers takes nothing returns integer
local integer i=0
local integer count=0
loop
exitwhen i>=6
if not HopeRoute_Left[i] and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER and IsPlayerInForce(Player(i),udg_WJZ) and udg_hero[i+1]!=null and GetUnitTypeId(udg_hero[i+1])!=0 then
set count=count+1
endif
set i=i+1
endloop
return IMaxBJ(1,count)
endfunction
function HopeCoop_MonsterCount takes integer players,integer rounds returns integer
local integer base=3+(IMinBJ(6,IMaxBJ(1,players))-1)/3
if udg_Yx_Nd_Dj==6 then
set base=base+IMaxBJ(0,rounds)/3
endif
return IMinBJ(12,base)
endfunction
function HopeCoop_LifeFactor takes integer players,boolean boss returns real
// v19 table (audit/09): mob HP 1.00/1.75/2.40/3.05/3.55/4.10 for 1..6 players;
// boss = mob x 1.15 (v18 boss/mob gap widened with players; v19 keeps it fixed).
local integer n=IMinBJ(6,IMaxBJ(1,players))
local real f=1.
if n==2 then
set f=1.75
elseif n==3 then
set f=2.4
elseif n==4 then
set f=3.05
elseif n==5 then
set f=3.55
elseif n>=6 then
set f=4.1
endif
if boss and n>1 then
set f=f*1.15
endif
return f
endfunction
function HopeCoop_AttackFactor takes integer players returns real
// v19: gentle attack ramp, 6P capped at 1.25 (was 1.50).
return 1.+.05*I2R(IMinBJ(6,IMaxBJ(1,players))-1)
endfunction
function HopeCoop_IsBoss takes unit u returns boolean
local integer kind=GetUnitTypeId(u)
return IsUnitType(u,UNIT_TYPE_HERO) or LoadBoolean(YDHT,kind,$FB89B46C) or kind==udg_BOSS_LX_______DA[1] or kind==udg_BOSS_LX[0] or kind==udg_BOSS_LX[1] or kind==udg_BOSS_LX[2]
endfunction
function HopeCoop_BeginRoom takes nothing returns nothing
local integer players=HopeCoop_CountPlayers()
if not HopeCoop_Started then
// Capture the actual original single-player setting, including default mode.
set HopeCoop_BaseHandicap=GetPlayerHandicapBJ(Player(11))
set HopeCoop_Started=true
endif
// v19: handicap stays at the chosen difficulty; player scaling lives entirely
// in HopeCoop_LifeFactor/AttackFactor (no extra handicap stacking).
call SetPlayerHandicapBJ(Player(11),HopeCoop_BaseHandicap)
set udg_Guaiwu_sl=HopeCoop_MonsterCount(players,udg_quanshu)
if HopeCoop_RoomPlayers!=players or not HopeCoop_Announced then
call DisplayTimedTextToForce(udg_WJZ,10.,"本房按 "+I2S(players)+" 名在场玩家计算：小怪生命最高4.1倍（BOSS再乘1.15）、每多1人攻击力+5%、怪物数量小幅增加。离开人数在下一房重新计算。")
set HopeCoop_Announced=true
endif
set HopeCoop_RoomPlayers=players
endfunction
function HopeCoop_ScaleEnemy takes unit u returns nothing
local integer h=GetHandleId(u)
local real hp=0.
local real attack=0.
if u==null or GetUnitTypeId(u)==0 or GetOwningPlayer(u)!=Player(11) or LoadBoolean(YDHT,h,$487A4302) then
return
endif
call SaveBoolean(YDHT,h,$487A4302,true)
if HopeCoop_RoomPlayers<=1 then
return
endif
set hp=GetUnitState(u,UNIT_STATE_MAX_LIFE)*HopeCoop_LifeFactor(HopeCoop_RoomPlayers,HopeCoop_IsBoss(u))
set attack=GetUnitState(u,ConvertUnitState(18))*HopeCoop_AttackFactor(HopeCoop_RoomPlayers)
if udg_Yx_Nd_Dj>=5 then
// Numeric guards compose with challenge scaling; subsequent boss room bonuses
// remain bounded by the capped monster count. No repeated display-time scaling.
set hp=RMinBJ(10000000.,hp)
set attack=RMinBJ(1000000.,attack)
endif
call SetUnitState(u,UNIT_STATE_MAX_LIFE,hp)
call SetUnitLifePercentBJ(u,100.)
call SetUnitState(u,ConvertUnitState(18),attack)
endfunction

function HopeChallenge_TurnToken takes nothing returns integer
if udg_Yx_Nd_Dj>=5 then
return HopeChallenge_TurnSerial
endif
return udg_quanshu*100000+udg_boci*1000+udg_huihe_s
endfunction
function HopeChallenge_NextTurn takes nothing returns nothing
local integer i=1
if udg_Yx_Nd_Dj<5 then
return
endif
if HopeChallenge_TurnSerial>=2000000000 then
set HopeChallenge_TurnSerial=1
loop
exitwhen i>6
set HopeMeditation_LastCast[i]=-1
set HopeHidden_LastHeal[i]=-1
set HopeHidden_LastDrain[i]=-1
set HopeJob_LastCast[i]=-1
set HopeMonk_LastE[i]=0
set HopeMonk_LastW[i]=0
set HopeMonk_LastZ[i]=0
set i=i+1
endloop
else
set HopeChallenge_TurnSerial=HopeChallenge_TurnSerial+1
endif
endfunction
function HopeChallenge_Won takes nothing returns boolean
if udg_Yx_Nd_Dj==6 then
return false
elseif udg_Yx_Nd_Dj==5 then
return udg_quanshu>=5
elseif udg_Yx_Nd_Dj<3 then
return udg_quanshu>=3
endif
return udg_quanshu>=4
endfunction
function HopeChallenge_BossPoints takes nothing returns integer
return HopeRewards_Boss(udg_Yx_Nd_Dj,udg_quanshu)
endfunction
function HopeChallenge_EnemyHp takes real base returns real
local real q=I2R(IMaxBJ(0,udg_quanshu))
if udg_Yx_Nd_Dj==6 then
return RMinBJ(10000000.,HopeDifficulty_Hp(6)*(base*(1.+.18*q)+80.*q))
endif
return RMinBJ(10000000.,HopeDifficulty_Hp(udg_Yx_Nd_Dj)*(base*(1.+.06*q)+20.*q))
endfunction
function HopeChallenge_EnemyAttack takes real base returns real
if udg_Yx_Nd_Dj==6 then
return RMinBJ(1000000.,base*HopeDifficulty_Attack(6)*(1.+.08*I2R(IMaxBJ(0,udg_quanshu))))
endif
return RMinBJ(1000000.,base*HopeDifficulty_Attack(udg_Yx_Nd_Dj))
endfunction
function HopeChallenge_ScaleEnemy takes unit u returns nothing
if LoadBoolean(YDHT,GetHandleId(u),$487A4301) then
return
endif
call SaveBoolean(YDHT,GetHandleId(u),$487A4301,true)
call SaveReal(YDHT,GetHandleId(u),$3449D65E,RMinBJ(.65,RMaxBJ(0.,LoadReal(YDHT,GetHandleId(u),$3449D65E))))
call SetUnitState(u,UNIT_STATE_MAX_LIFE,HopeChallenge_EnemyHp(GetUnitState(u,UNIT_STATE_MAX_LIFE)))
call SetUnitLifePercentBJ(u,100.)
call SetUnitState(u,ConvertUnitState(18),HopeChallenge_EnemyAttack(GetUnitState(u,ConvertUnitState(18))))
endfunction
function HopeChallenge_NextMonsterCount takes nothing returns nothing
set udg_Guaiwu_sl=HopeCoop_MonsterCount(HopeCoop_CountPlayers(),udg_quanshu)
endfunction
function HopeChallenge_ReleaseNode takes unit u returns nothing
local group links=null
if udg_Yx_Nd_Dj>=5 then
set links=LoadGroupHandle(YDHT,GetHandleId(u),$B5EB8DB8)
if links!=null then
call DestroyGroup(links)
endif
endif
set links=null
endfunction

function HopeMeditation_Clear takes unit u,integer i returns nothing
local real mana=GetUnitState(u,UNIT_STATE_MANA)
local real maximum=GetUnitState(u,UNIT_STATE_MAX_MANA)
local boolean held=HopeMeditation_Active[i] and HopeMeditation_Unit[i]==u
call SetHeroInt(u,GetHeroInt(u,false)-udg_Linshi_Int[i],true)
if held then
call SetUnitState(u,UNIT_STATE_MAX_MANA,maximum)
call SetUnitState(u,UNIT_STATE_MANA,RMinBJ(maximum,mana))
set HopeMeditation_Active[i]=false
set HopeMeditation_Unit[i]=null
endif
endfunction
function HopeMeditation_Apply takes unit u returns nothing
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)+1
local integer token=HopeChallenge_TurnToken()+1
local integer intelligence=GetHeroInt(u,true)
local integer bonus=R2I(I2R(intelligence)*.3)
local real mana=GetUnitState(u,UNIT_STATE_MANA)
local real maximum=GetUnitState(u,UNIT_STATE_MAX_MANA)
local real restored=RMinBJ(RMaxBJ(0.,maximum-mana),3.+I2R(intelligence)/5.)
if i<1 or i>6 or u!=udg_hero[i] or not udg_ZhandouZhong or GetWidgetLife(u)<=.405 then
call DisplayTimedTextToPlayer(p,0,0,4.,"冥想只能由当前英雄在战斗中使用。")
set p=null
return
endif
if udg_xingdong_dian[i]<1 then
call DisplayTimedTextToPlayer(p,0,0,4.,"冥想需要1行动点。")
set p=null
return
endif
if HopeMeditation_LastCast[i]==token or HopeMeditation_Active[i] then
call DisplayTimedTextToPlayer(p,0,0,4.,"冥想每回合只能使用一次。")
set p=null
return
endif
set HopeMeditation_LastCast[i]=token
set udg_xingdong_dian[i]=udg_xingdong_dian[i]-1
set udg_Linshi_Int[i]=udg_Linshi_Int[i]+bonus
set udg_Ls_zj_Int[i]=udg_Ls_zj_Int[i]+bonus
call SetHeroInt(u,GetHeroInt(u,false)+bonus,true)
// Neutralize BOTH the native maximum increase and any native current-mana adjustment.
call SetUnitState(u,UNIT_STATE_MAX_MANA,maximum)
call SetUnitState(u,UNIT_STATE_MANA,RMinBJ(maximum,mana+restored))
set HopeMeditation_Active[i]=true
set HopeMeditation_Unit[i]=u
call DisplayTimedTextToPlayer(p,0,0,4.,"冥想：恢复 "+R2S(restored)+" 魔法，本回合智力 +"+I2S(bonus)+"；行动点 -1。")
set p=null
endfunction

