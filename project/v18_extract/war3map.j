function HopeRoute_Assign takes player p,integer chosen returns boolean
if not HopeRoute_Assigning or GetPlayerId(p)!=HopeRoute_Host() or not HopeRoute_Active(chosen) then
return false
endif
set HopeRoute_ChosenLeader=chosen
set HopeRoute_Assigning=false
call HopeRoute_ClearReady()
call DisplayTextToForce(udg_WJZ,"本局路线由 "+GetPlayerName(Player(chosen))+" 选择；全员准备后，由该玩家点击【出发】。")
return true
endfunction
function HopeRoute_TogglePicker takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeRoute_PickerOpen=not HopeRoute_PickerOpen
if HopeRoute_PickerOpen then
call HopeLayout_Focus(6)
endif
endif
endfunction
function HopeRoute_ChooseSlot takes integer slot returns nothing
local player p=DzGetTriggerUIEventPlayer()
if slot>=1 and slot<=HopeRoute_AvailableCount then
call HopeRoute_Select(p,HopeRoute_Available[slot])
endif
set p=null
endfunction
function HopeRoute_Collect takes nothing returns nothing
local unit u=GetEnumUnit()
local integer i=HopeRoute_AvailableCount
if LoadBoolean(YDHT,GetHandleId(u),$C31B86D5) and LoadInteger(YDHT,GetHandleId(u),$66256FC7)==udg_boci and i<6 then
// Stable left-to-right ordering makes two identical room types distinguishable.
loop
exitwhen i<=0
exitwhen GetUnitX(HopeRoute_Available[i])<=GetUnitX(u)
set HopeRoute_Available[i+1]=HopeRoute_Available[i]
set i=i-1
endloop
set HopeRoute_Available[i+1]=u
set HopeRoute_AvailableCount=HopeRoute_AvailableCount+1
endif
set u=null
endfunction
function HopeRoute_RefreshPicker takes nothing returns nothing
local integer i=1
local integer owner=GetPlayerId(GetLocalPlayer())
local boolean show=false
local group g=CreateGroup()
set HopeRoute_AvailableCount=0
call GroupEnumUnitsOfPlayer(g,Player(PLAYER_NEUTRAL_PASSIVE),null)
call ForGroup(g,function HopeRoute_Collect)
call DestroyGroup(g)
set g=null
if not HopeRoute_Valid() then
call HopeRoute_ClearMarker()
endif
call HopeJob_ShowFrame(HopeRoute_AssignPanel,HopeRoute_Assigning and owner==HopeRoute_Host())
loop
exitwhen i>6
call HopeJob_ShowFrame(HopeRoute_AssignButton[i],HopeRoute_Active(i-1))
call HopeJob_SetText(HopeRoute_AssignButton[i],I2S(i)+" · "+HopeName_Label(Player(i-1),100))
set i=i+1
endloop
set show=not udg_ZhandouZhong and not HopeRoute_Assigning and HopeRoute_AvailableCount>0 and HopeRoute_Active(owner)
call HopeJob_ShowFrame(HopeRoute_Picker,show and HopeRoute_PickerOpen and (HopeChoice_Hidden or not HopeChoice_HasPending()))
call HopeJob_SetText(HopeRoute_PickerTitle,"可达路线（从左到右） · 第"+I2S(udg_boci)+"层")
set i=1
loop
exitwhen i>6
call HopeJob_ShowFrame(HopeRoute_NodeButton[i],i<=HopeRoute_AvailableCount)
if i<=HopeRoute_AvailableCount then
call HopeJob_SetText(HopeRoute_NodeButton[i],I2S(i)+". "+HopeRoute_Title(HopeRoute_Available[i]))
endif
set i=i+1
endloop
endfunction
function HopeRoute_Assign1 takes nothing returns nothing
call HopeRoute_Assign(DzGetTriggerUIEventPlayer(),0)
endfunction
function HopeRoute_Node1 takes nothing returns nothing
call HopeRoute_ChooseSlot(1)
endfunction
function HopeRoute_Assign2 takes nothing returns nothing
call HopeRoute_Assign(DzGetTriggerUIEventPlayer(),1)
endfunction
function HopeRoute_Node2 takes nothing returns nothing
call HopeRoute_ChooseSlot(2)
endfunction
function HopeRoute_Assign3 takes nothing returns nothing
call HopeRoute_Assign(DzGetTriggerUIEventPlayer(),2)
endfunction
function HopeRoute_Node3 takes nothing returns nothing
call HopeRoute_ChooseSlot(3)
endfunction
function HopeRoute_Assign4 takes nothing returns nothing
call HopeRoute_Assign(DzGetTriggerUIEventPlayer(),3)
endfunction
function HopeRoute_Node4 takes nothing returns nothing
call HopeRoute_ChooseSlot(4)
endfunction
function HopeRoute_Assign5 takes nothing returns nothing
call HopeRoute_Assign(DzGetTriggerUIEventPlayer(),4)
endfunction
function HopeRoute_Node5 takes nothing returns nothing
call HopeRoute_ChooseSlot(5)
endfunction
function HopeRoute_Assign6 takes nothing returns nothing
call HopeRoute_Assign(DzGetTriggerUIEventPlayer(),5)
endfunction
function HopeRoute_Node6 takes nothing returns nothing
call HopeRoute_ChooseSlot(6)
endfunction
