call CreateQuestBJ(bj_QUESTTYPE_OPT_DISCOVERED,"各类说明","各类说明
力量敏捷智力生命成长：字面意思
魔力成长：每级增加的英雄技能伤害  专注成长：每级增加的英雄精确打击伤害

玩家1可以输入-bug 强制进入敌方回合（慎用）","ReplaceableTextures\\CommandButtons\\BTNAmbush.blp")
call SetTerrainFogEx(0,100000.,800000.,0,1,1,1)
call SaveBoolean(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$8601CCF1,s__hardware_SetWideScreen())
