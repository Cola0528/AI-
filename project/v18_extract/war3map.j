function HopeMeta_Create takes nothing returns nothing
local integer f=0
local integer i=0
local trigger recovery=CreateTrigger()
call HopeMeta_Config()
call HopeMeta_ConfigBrief()
// Gameplay progression must continue even if the frame backend fails.
call TimerStart(CreateTimer(),.5,true,function HopeMeta_Tick)
call DzTriggerRegisterKeyEventByCode(null,118,1,false,function HopeMeta_Toggle)
loop
exitwhen i>=6
call TriggerRegisterPlayerChatEvent(recovery,Player(i),"-relic ",false)
set i=i+1
endloop
call TriggerAddAction(recovery,function HopeMeta_SeedChat)
set recovery=null
set HopeMeta_Panel=HopeQoL_Surface("HopeMetaPanel",.116,.540,.568,.368)
if HopeMeta_Panel==0 then
return
endif
set HopeMeta_Heading=HopeQoL_Label("HopeMetaHeading",HopeMeta_Panel,.010,-.008,.490,.020,"")
set f=HopeQoL_Button("HopeMetaClose",HopeMeta_Panel,.513,-.007,.045,.021,"关闭")
call HopeQoL_Bind(f,function HopeMeta_Close,false)
set HopeMeta_Body=HopeQoL_Label("HopeMetaBody",HopeMeta_Panel,.010,-.071,.548,.263,"")
call HopeMeta_Font(HopeMeta_Body,"Fonts\\ZiTi.ttf",.0085,0)
