call TriggerRegisterPlayerEventEndCinematic(gg_trg_Esc_____________026,Player(2))
call TriggerRegisterPlayerEventEndCinematic(gg_trg_Esc_____________026,Player(3))
call TriggerRegisterPlayerEventEndCinematic(gg_trg_Esc_____________026,Player(4))
call TriggerRegisterPlayerEventEndCinematic(gg_trg_Esc_____________026,Player(5))
