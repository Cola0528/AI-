// Preserve original platform checks; saved-point draws use a synchronized callback.
function HopeGift_Name takes integer index returns string
if index==0 then
return "内测礼包"
elseif index==1 then
return "金币礼包"
elseif index==2 then
return "木材礼包"
elseif index==3 then
return "预约礼包"
elseif index==4 then
return "首充礼包"
elseif index==5 then
return "重随礼包"
endif
return ""
endfunction

function HopeGift_Effect takes integer index returns string
if index==0 then
return "开局金币 +50|n力量 / 敏捷 / 智力各 +1"
elseif index==1 then
return "开局金币 +50"
elseif index==2 then
return "开局木材 +1"
elseif index==3 then
return "开局木材 +1|n力量 / 敏捷 / 智力各 +1"
elseif index==4 then
return "开局金币 +100|n力量 / 敏捷 / 智力各 +1"
elseif index==5 then
return "开局成长重随次数 +3"
endif
return ""
endfunction


function HopeGift_DrawCost takes nothing returns integer
return 5
endfunction

function HopeGift_Chance takes integer index returns integer
if index==0 or index==3 then
return 4
elseif index==1 then
return 12
elseif index==2 then
return 15
elseif index==4 then
return 2
elseif index==5 then
return 8
endif
return 0
endfunction

// Exactly 100 equally likely outcomes.  Ownership never changes this table.
function HopeGift_DrawIndex takes integer roll returns integer
if roll<1 or roll>100 or roll<=55 then
return -1
elseif roll<=70 then
return 2
elseif roll<=82 then
return 1
elseif roll<=90 then
return 5
elseif roll<=94 then
return 0
elseif roll<=98 then
return 3
endif
return 4
endfunction

function HopeGift_Key takes integer index returns string
if index<0 or index>=6 then
return ""
endif
return "gift_v1_"+I2S(index)
endfunction

function HopeGift_Owned takes player p,integer index returns boolean
local integer i=-1
if p==null or index<0 or index>=6 then
return false
endif
set i=GetPlayerId(p)
if i<0 or i>=6 then
return false
endif
return HopeGift_Applied[i*6+index] or HopeGift_PointOwned[i*6+index] or HopeGift_PlatformOwned[i*6+index]
endfunction

function HopeGift_OwnedCount takes player p returns integer
local integer index=0
local integer count=0
loop
exitwhen index>=6
if HopeGift_Owned(p,index) then
set count=count+1
endif
set index=index+1
endloop
return count
endfunction

// The original .1-second check may predate cloud readiness.  Recheck only
// after the normal .2-second cloud load; never overwrite original raw keys.
function HopeGift_PlatformEntitled takes player p,integer index returns boolean
local integer i=-1
if p==null or index<0 or index>=6 then
return false
endif
set i=GetPlayerId(p)
if i<0 or i>=6 then
return false
endif
if index==0 then
return DzAPI_Map_GetServerValue(p,"maptest2020")=="1"
elseif index==1 then
return DzAPI_Map_HasMallItem(p,"JINBI")
elseif index==2 then
return DzAPI_Map_HasMallItem(p,"MUCAI")
elseif index==3 then
return DzAPI_Map_GetServerValue(p,"prebook2023")=="1"
elseif index==4 then
return DzAPI_Map_HasMallItem(p,"SHOUCHONG")
endif
return DzAPI_Map_HasMallItem(p,"CHONGSUI")
endfunction

// Apply a loaded entitlement once at startup.  A prior platform grant sets
// Applied first, so owning either or both sources never doubles its benefit.
function HopeGift_GrantLoaded takes player p,integer index returns nothing
local integer i=-1
local unit u=null
if p==null or index<0 or index>=6 then
return
endif
set i=GetPlayerId(p)
if i<0 or i>=6 then
return
endif
if GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(p)!=MAP_CONTROL_USER then
return
endif
if not HopeGift_Owned(p,index) or HopeGift_Applied[i*6+index] then
return
endif
set HopeGift_Applied[i*6+index]=true
call SetPlayerTechResearched(p,$52303030+index,1)
if index==0 or index==1 then
call AdjustPlayerStateBJ(50,p,PLAYER_STATE_RESOURCE_GOLD)
elseif index==4 then
call AdjustPlayerStateBJ(100,p,PLAYER_STATE_RESOURCE_GOLD)
elseif index==2 or index==3 then
call AdjustPlayerStateBJ(1,p,PLAYER_STATE_RESOURCE_LUMBER)
elseif index==5 then
set udg_CZ_czcs[i+1]=udg_CZ_czcs[i+1]+3
endif
if index==0 or index==3 or index==4 then
set udg_STR_cs[i+1]=udg_STR_cs[i+1]+1
set udg_AGI_cs[i+1]=udg_AGI_cs[i+1]+1
set udg_INT_cs[i+1]=udg_INT_cs[i+1]+1
// Normally no hero exists at .2 seconds.  If startup order changes, apply
// the loaded bonus to the existing hero instead of leaving it unapplied.
set u=udg_hero[i+1]
if u!=null and GetUnitTypeId(u)!=0 then
call ModifyHeroStat(bj_HEROSTAT_STR,u,bj_MODIFYMETHOD_ADD,1)
call ModifyHeroStat(bj_HEROSTAT_AGI,u,bj_MODIFYMETHOD_ADD,1)
call ModifyHeroStat(bj_HEROSTAT_INT,u,bj_MODIFYMETHOD_ADD,1)
endif
endif
set u=null
endfunction

// A failed cloud load stays read-only this run.  This function never runs
// from the earlier .1-second platform grant or from a lottery callback.
function HopeGift_LoadPoints takes nothing returns nothing
local integer i=0
local integer index=0
local player p=null
loop
exitwhen i>=6
set p=Player(i)
if not HopeGift_Loaded[i] and HopeGift_Checked[i] and HopeCloud_CanWrite(p) then
set index=0
loop
exitwhen index>=6
set HopeGift_PlatformOwned[i*6+index]=HopeGift_Applied[i*6+index] or HopeGift_PlatformEntitled(p,index)
set HopeGift_PointOwned[i*6+index]=DzAPI_Map_GetStoredInteger(p,HopeGift_Key(index))>0
call HopeGift_GrantLoaded(p,index)
set index=index+1
endloop
set HopeGift_Loaded[i]=true
endif
set i=i+1
endloop
set p=null
endfunction

// Only a fixed synchronized UI callback invokes Draw.  Validate all gameplay
// state before spending, and spend successfully before making exactly one roll.
function HopeGift_Draw takes player p returns boolean
local integer i=-1
local integer index=-1
if p==null then
return false
endif
set i=GetPlayerId(p)
if i<0 or i>=6 then
return false
endif
if GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(p)!=MAP_CONTROL_USER then
return false
endif
if HopeGift_Busy[i] then
return false
endif
if not HopeCloud_CanWrite(p) then
call HopeCloud_Report(p)
return false
endif
if not HopeGift_Checked[i] or not HopeGift_Loaded[i] then
call DisplayTextToPlayer(p,0,0,"礼包权益尚未载入，未扣除积分。")
return false
endif
if HopeGift_OwnedCount(p)>=6 then
call DisplayTextToPlayer(p,0,0,"六项礼包已全部拥有，停止抽奖，不扣积分。")
return false
endif
set HopeGift_Busy[i]=true
if not HopePoints_Spend(p,HopeGift_DrawCost()) then
set HopeGift_Busy[i]=false
return false
endif
set index=HopeGift_DrawIndex(GetRandomInt(1,100))
if index<0 then
set HopeGift_LastResult[i]="谢谢惠顾 · 本次未中奖"
elseif HopeGift_Owned(p,index) then
set HopeGift_LastResult[i]="重复："+HopeGift_Name(index)+"|n无新增权益，不重抽"
else
// Spend submitted boss_jf first.  Never refund/retry from the API return bit:
// it is not a durable-save acknowledgement.  New ownership applies next run.
set HopeGift_PointOwned[i*6+index]=true
call DzAPI_Map_StoreInteger(p,HopeGift_Key(index),1)
set HopeGift_LastResult[i]="抽中："+HopeGift_Name(index)+"|n已提交，结算后下局生效"
endif
set HopeGift_Busy[i]=false
call DisplayTextToPlayer(p,0,0,"本次消耗5积分："+HopeGift_LastResult[i]+"。剩余积分 "+I2S(udg_Wj_jf[i+1])+"。")
return true
endfunction

function HopeGift_AppliedCount takes player p returns integer
local integer i=GetPlayerId(p)
local integer index=0
local integer count=0
if p==null or i<0 or i>=6 then
return 0
endif
loop
exitwhen index>=6
if HopeGift_Applied[i*6+index] then
set count=count+1
endif
set index=index+1
endloop
return count
endfunction

function HopeGift_State takes player p,integer index returns string
local integer i=-1
if p==null or index<0 or index>=6 then
return "|cffaaaaaa不可用|r"
endif
set i=GetPlayerId(p)
if i<0 or i>=6 then
return "|cffaaaaaa不可用|r"
endif
if HopeGift_Applied[i*6+index] then
if udg_hero[i+1]==null and (index==0 or index==3 or index==4) then
return "|cffd2b879已拥有 · 待角色初始化|r"
endif
return "|cff9ddbaf已拥有 · 本局已生效|r"
endif
if HopeGift_PointOwned[i*6+index] then
return "|cffd2b879已提交 · 结算后下局生效|r"
endif
if HopeGift_PlatformOwned[i*6+index] then
return "|cff9ddbaf平台已拥有|r"
endif
if not HopeGift_Checked[i] or not HopeCloud_Checked[i] then
return "|cffaaaaaa待载入|r"
endif
if not HopeCloud_Ready[i] then
return "|cffffb878云档未就绪 · 暂不可抽奖|r"
endif
if not HopeGift_Loaded[i] then
return "|cffaaaaaa礼包权益待载入|r"
endif
return "|cffaaaaaa未拥有 · 可通过抽奖获得|r"
endfunction

function HopeGift_OpenFor takes player p returns boolean
local integer i=GetPlayerId(p)
if not HopeGift_UIReady or p==null or i<0 or i>=6 then
return false
endif
if p==GetLocalPlayer() then
if HopeGrowth_Pending[GetPlayerId(p)] then
set HopeChoice_Hidden=true
endif
set HopeGift_Expanded=not HopeGift_Expanded
if HopeGift_Expanded then
call HopeLayout_Focus(3)
endif
set HopeQoL_Expanded=false
set HopeRoute_Details=false
set HopeArchive_Expanded=false
set HopeRelic_Expanded=false
endif
return true
endfunction

function HopeGift_Toggle takes nothing returns nothing
local player p=DzGetTriggerUIEventPlayer()
local integer i=GetPlayerId(p)
if not HopeGift_OpenFor(p) and p==GetLocalPlayer() and i>=0 and i<6 then
if udg_Cundang_danwei[i+1]!=null then
call SelectUnitForPlayerSingle(udg_Cundang_danwei[i+1],p)
endif
endif
set p=null
endfunction

function HopeGift_Close takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeGift_Expanded=false
call DzFrameShow(HopeGift_Panel,false)
endif
endfunction

// The ten original abilities, prices and Chinese GetAbilityName archive keys.
function HopeArchive_Ability takes integer index returns integer
if index<0 or index>9 then
return 0
endif
return $41303330+index
endfunction

function HopeArchive_Price takes integer abilityId returns integer
if abilityId==$41303330 or abilityId==$41303336 or abilityId==$41303337 then
return 10
elseif abilityId==$41303331 or abilityId==$41303332 or abilityId==$41303333 then
return 30
elseif abilityId==$41303334 or abilityId==$41303335 then
return 20
elseif abilityId==$41303338 or abilityId==$41303339 then
return 50
endif
return 0
endfunction

function HopeArchive_Count takes player p,integer index returns integer
local integer i=GetPlayerId(p)
local integer level=0
if i<0 or i>=6 or index<0 or index>9 or udg_Cundang_danwei[i+1]==null then
return 0
endif
set level=GetUnitAbilityLevel(udg_Cundang_danwei[i+1],HopeArchive_Ability(index))
if level<1 or level>6 then
return 0
endif
return level-1
endfunction

function HopeArchive_Total takes player p returns integer
local integer index=0
local integer count=0
loop
exitwhen index>=10
set count=count+HopeArchive_Count(p,index)
set index=index+1
endloop
return count
endfunction

function HopeArchive_NewCount takes player p returns integer
local integer i=GetPlayerId(p)
local integer index=0
local integer count=0
if i<0 or i>=6 or not HopeArchive_Captured[i] then
return 0
endif
loop
exitwhen index>=10
set count=count+HopeArchive_Count(p,index)-HopeArchive_AtLoadCounts[i*10+index]
set index=index+1
endloop
return count
endfunction

function HopeArchive_CaptureAll takes nothing returns nothing
local integer i=0
local integer index=0
loop
exitwhen i>=6
if not HopeArchive_Captured[i] and udg_Cundang_danwei[i+1]!=null then
set index=0
loop
exitwhen index>=10
set HopeArchive_AtLoadCounts[i*10+index]=HopeArchive_Count(Player(i),index)
set index=index+1
endloop
set HopeArchive_Captured[i]=true
endif
set i=i+1
endloop
endfunction

// One transaction path for both native spellbook casts and synchronized UI clicks.
// No gameplay attributes are applied here: the original start trigger applies
// archived ability levels on the next run, including its free HP/MP baseline.
function HopeArchive_Purchase takes player p,unit shop,integer abilityId returns boolean
local integer i=-1
local integer price=HopeArchive_Price(abilityId)
local integer level=0
if p==null then
return false
endif
set i=GetPlayerId(p)
if i<0 or i>=6 or price==0 then
return false
endif
if GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(p)!=MAP_CONTROL_USER then
return false
endif
if shop==null or shop!=udg_Cundang_danwei[i+1] or GetOwningPlayer(shop)!=p or GetUnitTypeId(shop)!=$68303037 then
return false
endif
if HopeArchive_Busy[i] then
return false
endif
if not HopeCloud_CanWrite(p) then
call HopeCloud_Report(p)
return false
endif
if not HaveSavedInteger(YDHT,abilityId,$F1D9C8F3) or LoadInteger(YDHT,abilityId,$F1D9C8F3)!=price then
call DisplayTextToPlayer(p,0,0,"存档商品尚未初始化，稍后再试。")
return false
endif
set level=GetUnitAbilityLevel(shop,abilityId)
if level<1 or level>6 then
call DisplayTextToPlayer(p,0,0,"该存档商品不可用，未扣除积分。")
return false
endif
if level==6 then
call DisplayTextToPlayer(p,0,0,"该项已购买5次，达到上限。")
return false
endif
if udg_Wj_jf[i+1]<price then
call DisplayTextToPlayer(p,0,0,"积分不足：需要 "+I2S(price)+"，当前 "+I2S(udg_Wj_jf[i+1])+"。")
return false
endif
set HopeArchive_Busy[i]=true
call IncUnitAbilityLevelSwapped(abilityId,shop)
if GetUnitAbilityLevel(shop,abilityId)!=level+1 then
set HopeArchive_Busy[i]=false
call DisplayTextToPlayer(p,0,0,"升级未生效，未扣除积分。")
return false
endif
set udg_Wj_jf[i+1]=udg_Wj_jf[i+1]-price
// Keep the original two writes and keys. Never retry from the native return bit.
call DzAPI_Map_StoreInteger(p,"boss_jf",udg_Wj_jf[i+1])
call DzAPI_Map_StoreInteger(p,GetAbilityName(abilityId),GetUnitAbilityLevel(shop,abilityId))
set HopeArchive_Busy[i]=false
call DisplayTextToPlayer(p,0,0,GetAbilityName(abilityId)+"已购买 "+I2S(level)+"/5 次；升级已提交平台，下局生效。剩余积分 "+I2S(udg_Wj_jf[i+1])+"。")
return true
endfunction

function HopeArchive_BuyIndex takes player p,integer index returns nothing
local integer i=GetPlayerId(p)
if i>=0 and i<6 then
call HopeArchive_Purchase(p,udg_Cundang_danwei[i+1],HopeArchive_Ability(index))
endif
endfunction

// Legacy callback is defined before the new frame factories, so it only toggles
// local presentation state; periodic refresh paints the already-created panel.
function HopeArchive_OpenFor takes player p returns boolean
if not HopeArchive_UIReady then
return false
endif
if p==GetLocalPlayer() then
if HopeGrowth_Pending[GetPlayerId(p)] then
set HopeChoice_Hidden=true
endif
set HopeArchive_Expanded=not HopeArchive_Expanded
if HopeArchive_Expanded then
call HopeLayout_Focus(2)
endif
set HopeQoL_Expanded=false
set HopeRoute_Details=false
set HopeGift_Expanded=false
set HopeRelic_Expanded=false
endif
return true
endfunction

function HopeArchive_Toggle takes nothing returns nothing
call HopeArchive_OpenFor(DzGetTriggerUIEventPlayer())
endfunction

function HopeArchive_Close takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeArchive_Expanded=false
call DzFrameShow(HopeArchive_Panel,false)
endif
endfunction

function HopeArchive_Legacy takes nothing returns nothing
local player p=DzGetTriggerUIEventPlayer()
local integer i=GetPlayerId(p)
if HopeGift_OpenFor(p) then
set p=null
return
endif
if p==GetLocalPlayer() and i>=0 and i<6 then
set HopeArchive_Expanded=false
call DzFrameShow(HopeArchive_Panel,false)
call SelectUnitForPlayerSingle(udg_Cundang_danwei[i+1],p)
endif
set p=null
endfunction

function Trig_______SD_017Func012003 takes nothing returns nothing
if HopeArchive_OpenFor(DzGetTriggerUIEventPlayer()) then
return
endif
call SelectUnitForPlayerSingle(udg_Cundang_danwei[GetConvertedPlayerId(DzGetTriggerUIEventPlayer())],DzGetTriggerUIEventPlayer())
call HopeCloud_Report(DzGetTriggerUIEventPlayer())
endfunction
function Trig_______SD_017Func023003 takes nothing returns nothing
if HopeRelic_OpenFor(DzGetTriggerUIEventPlayer()) then
return
endif
call SelectUnitForPlayerSingle(udg_Yiwu_danwei[GetConvertedPlayerId(DzGetTriggerUIEventPlayer())],DzGetTriggerUIEventPlayer())
endfunction
function HopeQoL_Button takes string name,integer parent,real x,real y,real w,real h,string value returns integer
local integer f=0
local integer textFrame=0
local integer art=0
local boolean custom=true
if parent==0 then
return 0
endif
set HopeQoL_ButtonIndex=HopeQoL_ButtonIndex+1
// Instantiate the complete blueprint: inherited-by-tag creation can lose
// functional child names, so it cannot verify or configure the button's art.
set f=DzCreateFrame("HopeActionButton",parent,HopeQoL_ButtonIndex)
if f==0 then
set custom=false
// The fallback also avoids direct blueprint creation. Its generic frame can
// still carry text and the existing synchronized action if templates fail.
set f=DzCreateFrameByTagName("GLUETEXTBUTTON",name,parent,"ScriptDialogButton",HopeQoL_ButtonIndex)
set HopeQoL_UIFallbacks=HopeQoL_UIFallbacks+1
endif
if f==0 then
return 0
endif
if parent==DzGetGameUI() then
call DzFrameSetAbsolutePoint(f,0,x,y)
else
call DzFrameSetPoint(f,0,parent,0,x,y)
endif
call DzFrameSetSize(f,w,h)
call DzFrameSetFont(f,"Fonts\\ZiTi.ttf",.009,0)
call DzFrameSetText(f,value)
set textFrame=DzFrameFindByName("HopeActionButtonText",HopeQoL_ButtonIndex)
if not custom then
set textFrame=DzFrameFindByName("ScriptDialogButtonText",HopeQoL_ButtonIndex)
endif
if textFrame!=0 then
call DzFrameSetFont(textFrame,"Fonts\\ZiTi.ttf",.009,0)
endif
if custom then
set art=DzFrameFindByName("HopeActionButtonNormal",HopeQoL_ButtonIndex)
if art!=0 then
call DzFrameSetTexture(art,"HopeUI\\button-normal.blp",0)
endif
set art=DzFrameFindByName("HopeActionButtonDown",HopeQoL_ButtonIndex)
if art!=0 then
call DzFrameSetTexture(art,"HopeUI\\button-down.blp",0)
endif
set art=DzFrameFindByName("HopeActionButtonDisabled",HopeQoL_ButtonIndex)
if art!=0 then
call DzFrameSetTexture(art,"HopeUI\\button-disabled.blp",0)
endif
set art=DzFrameFindByName("HopeActionButtonDisabledDown",HopeQoL_ButtonIndex)
if art!=0 then
call DzFrameSetTexture(art,"HopeUI\\button-disabled.blp",0)
endif
endif
call DzFrameShow(f,true)
return f
endfunction
