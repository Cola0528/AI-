function InitTrig___________________0002 takes nothing returns nothing
set gg_trg___________________0002=CreateTrigger()
call TriggerAddAction(gg_trg___________________0002,function Trig___________________0002Actions)
endfunction
function HopeRoute_Active takes integer i returns boolean
return i>=0 and i<6 and not HopeRoute_Left[i] and GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER and IsPlayerInForce(Player(i),udg_WJZ)
endfunction

function HopeRoute_Host takes nothing returns integer
local integer i=0
loop
exitwhen i>=6
if HopeRoute_Active(i) then
return i
endif
set i=i+1
endloop
return -1
endfunction
function HopeRoute_ClearMarker takes nothing returns nothing
if HopeRoute_Marker!=null then
call DestroyEffect(HopeRoute_Marker)
set HopeRoute_Marker=null
endif
if HopeRoute_MarkerText!=null then
call SetTextTagVisibility(HopeRoute_MarkerText,false)
endif
endfunction
function HopeRoute_Mark takes unit node returns nothing
call HopeRoute_ClearMarker()
set HopeRoute_Marker=AddSpecialEffectTarget("Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl",node,"overhead")
if HopeRoute_MarkerText==null then
set HopeRoute_MarkerText=CreateTextTag()
call SetTextTagPermanent(HopeRoute_MarkerText,true)
endif
call SetTextTagText(HopeRoute_MarkerText,"|cffffd060【当前选择】|r",.022)
call SetTextTagPosUnit(HopeRoute_MarkerText,node,180.)
call SetTextTagVisibility(HopeRoute_MarkerText,true)
endfunction
function HopeRoute_Leader takes nothing returns integer
if HopeRoute_Active(HopeRoute_ChosenLeader) then
return HopeRoute_ChosenLeader
endif
return HopeRoute_Host()
endfunction

function HopeRoute_RewardPending takes integer i returns boolean
return HopeChoice_PendingForPlayer(i) or (HaveSavedBoolean(YDHT,GetHandleId(Player(i)),$AB392274) and not LoadBoolean(YDHT,GetHandleId(Player(i)),$AB392274))
endfunction

function HopeRoute_ClearReady takes nothing returns nothing
local integer i=0
loop
exitwhen i>=6
set HopeRoute_Ready[i]=false
set i=i+1
endloop
endfunction

function HopeRoute_Valid takes nothing returns boolean
return HopeRoute_Node!=null and GetUnitTypeId(HopeRoute_Node)!=0 and HopeRoute_Depth==udg_boci and HopeRoute_Chapter==udg_quanshu and LoadBoolean(YDHT,GetHandleId(HopeRoute_Node),$C31B86D5) and LoadInteger(YDHT,GetHandleId(HopeRoute_Node),$66256FC7)==udg_boci
endfunction

function HopeRoute_Status takes nothing returns string
local integer i=0
local integer leader=HopeRoute_Leader()
local string s=""
loop
exitwhen i>=6
if HopeRoute_Active(i) then
set s=s+GetPlayerName(Player(i))
if i==leader then
set s=s+"（选路）"
endif
if HopeRoute_RewardPending(i) then
set s=s+"：|cffffc060待完成选择|r|n"
elseif udg_hero[i+1]==null then
set s=s+"：等待角色初始化|n"
elseif HopeRoute_Ready[i] then
set s=s+"：|cff80ef90已准备|r|n"
else
set s=s+"：未准备|n"
endif
endif
set i=i+1
endloop
return s
endfunction

function HopeRoute_AllReady takes nothing returns boolean
local integer i=0
local integer count=0
loop
exitwhen i>=6
if HopeRoute_Active(i) then
set count=count+1
if not HopeRoute_Ready[i] or HopeRoute_RewardPending(i) or udg_hero[i+1]==null then
return false
endif
endif
set i=i+1
endloop
return count>0
endfunction

function HopeRoute_SetReady takes player p,boolean ready returns nothing
local integer i=GetPlayerId(p)
if not HopeRoute_Active(i) or not HopeRoute_Valid() then
call DisplayTextToPlayer(p,0,0,"请先由路线选择者点击一个可达路线节点，提出本次目的地。")
return
endif
if ready and (HopeRoute_RewardPending(i) or udg_hero[i+1]==null) then
call DisplayTextToPlayer(p,0,0,"请先完成待选项与角色初始化，再确认准备。")
return
endif
set HopeRoute_Ready[i]=ready
if ready then
call DisplayTextToForce(udg_WJZ,GetPlayerName(p)+" 已准备。")
else
call DisplayTextToForce(udg_WJZ,GetPlayerName(p)+" 取消了准备，请等待。")
endif
if HopeRoute_AllReady() then
call DisplayTextToForce(udg_WJZ,"全员已准备：路线选择者可点击准备面板的【出发】。")
endif
endfunction

// Return true only at the original synchronized route-entry event.
function HopeRoute_Select takes player p,unit node returns boolean
local integer leader=HopeRoute_Leader()
if HopeRoute_Assigning or leader<0 or GetPlayerId(p)!=leader then
call DisplayTextToPlayer(p,0,0,"请由指定的路线选择者提出目的地；队友可在准备面板确认。")
return false
endif
if udg_ZhandouZhong or node==null or not LoadBoolean(YDHT,GetHandleId(node),$C31B86D5) or LoadInteger(YDHT,GetHandleId(node),$66256FC7)!=udg_boci then
return false
endif
if not HopeRoute_Valid() or HopeRoute_Node!=node then
set HopeRoute_Node=node
set HopeRoute_Depth=udg_boci
set HopeRoute_Chapter=udg_quanshu
call HopeRoute_ClearReady()
call HopeRoute_Mark(node)
call DisplayTextToForce(udg_WJZ,GetPlayerName(p)+" 选择了："+GetUnitName(node)+"。地图上的金色标识为目的地；全员准备后点击【出发】。")
endif
set HopeRoute_Ready[leader]=not HopeRoute_RewardPending(leader) and udg_hero[leader+1]!=null
return false
endfunction

function HopeRoute_ReadyClick takes nothing returns nothing
call HopeRoute_SetReady(DzGetTriggerUIEventPlayer(),true)
endfunction

function HopeRoute_WaitClick takes nothing returns nothing
call HopeRoute_SetReady(DzGetTriggerUIEventPlayer(),false)
endfunction

function HopeRoute_Chat takes nothing returns nothing
if GetEventPlayerChatString()=="-ready" then
call HopeRoute_SetReady(GetTriggerPlayer(),true)
elseif GetEventPlayerChatString()=="-wait" then
call HopeRoute_SetReady(GetTriggerPlayer(),false)
elseif HopeRoute_Valid() then
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"提议路线："+GetUnitName(HopeRoute_Node)+"|n"+HopeRoute_Status())
else
call DisplayTextToPlayer(GetTriggerPlayer(),0,0,"还没有有效的路线提议。请由当前路线选择者点击可达节点。")
endif
endfunction

function HopeRoute_Leave takes nothing returns nothing
local integer i=GetPlayerId(GetTriggerPlayer())
set HopeRoute_Left[i]=true
call HopeRoute_ClearReady()
if i==HopeRoute_ChosenLeader then
set HopeRoute_ChosenLeader=HopeRoute_Host()
endif
if HopeRoute_Valid() then
call DisplayTextToForce(udg_WJZ,GetPlayerName(GetTriggerPlayer())+" 已离开，不再计入路线等待人数。其余玩家请重新确认准备；路线选择者离开时，自动交给编号最小的在线玩家。")
endif
endfunction

function HopeReward_DrawRelic takes integer i returns item
local item drawn=null
local integer attempts=0
local integer id=0
local integer j=0
local boolean duplicate=false
loop
exitwhen attempts>=32
set attempts=attempts+1
set drawn=PlaceRandomItem(udg_YiwuChi[i],2706.,2100.)
if drawn==null then
exitwhen true
endif
set id=GetItemTypeId(drawn)
set duplicate=false
set j=0
loop
exitwhen j>=HopeReward_DrawCount[i]
if HopeReward_DrawId[i*3+j]==id then
set duplicate=true
endif
set j=j+1
endloop
if not duplicate then
exitwhen true
endif
call RemoveItem(drawn)
set drawn=null
endloop
if drawn==null then
// The unique relic pool can be exhausted in infinite mode. Offer ordinary
// equipment through the existing claim dispatcher instead of item id zero.
set drawn=CreateItem(udg_wp[GetRandomInt(5,27)],2706.,2100.)
endif
set HopeReward_DrawId[i*3+HopeReward_DrawCount[i]]=GetItemTypeId(drawn)
set HopeReward_DrawCount[i]=HopeReward_DrawCount[i]+1
return drawn
endfunction

