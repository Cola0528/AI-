// KK official loading diagnostics. ErrorCode is a LOAD result, not a save receipt.
function HopeCloud_CheckLoad takes player p returns nothing
local integer i=GetPlayerId(p)
if i<0 or i>5 then
return
endif
if HopeCloud_Checked[i] then
return
endif
set HopeCloud_Checked[i]=true
if GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(p)!=MAP_CONTROL_USER then
return
endif
set HopeCloud_Lobby[i]=RequestExtraBooleanData(10,null,null,null,false,0,0,0)
set HopeCloud_Test[i]=RequestExtraBooleanData(74,null,null,null,false,0,0,0)
if not HopeCloud_Lobby[i] and not HopeCloud_Test[i] then
return
endif
set HopeCloud_LoadError[i]=DzAPI_Map_GetServerValueErrorCode(p)
set HopeCloud_Ready[i]=HopeCloud_LoadError[i]==0
endfunction

function HopeCloud_CanWrite takes player p returns boolean
local integer i=GetPlayerId(p)
if i<0 or i>5 then
return false
endif
return HopeCloud_Checked[i] and HopeCloud_Ready[i] and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER
endfunction

function HopeCloud_Status takes player p returns string
local integer i=GetPlayerId(p)
if i<0 or i>5 or not HopeCloud_Checked[i] then
return "|cffffd36a云存档：尚未读取|r"
endif
if not HopeCloud_Lobby[i] and not HopeCloud_Test[i] then
return "|cffffd36a云存档：本地自定义局，仅本局进度|r"
endif
if not HopeCloud_Ready[i] then
return "|cffff8080云存档载入失败："+I2S(HopeCloud_LoadError[i])+"；本局禁止永久写入|r"
endif
if HopeCloud_Submissions[i]>0 then
return "|cff80ef90云档已载入|r · 已提交 "+I2S(HopeCloud_Submissions[i])+" 次（结算以平台为准）"
endif
return "|cff80ef90云档已载入|r · 尚无进度提交"
endfunction

function HopeCloud_Report takes player p returns nothing
local integer i=GetPlayerId(p)
if i<0 or i>5 then
return
endif
call DisplayTimedTextToPlayer(p,0,0,15.,HopeCloud_Status(p))
if not HopeCloud_Checked[i] then
return
endif
if not HopeCloud_Lobby[i] and not HopeCloud_Test[i] then
call DisplayTimedTextToPlayer(p,0,0,15.,"请从 KK 已上传地图的 RPG 大厅或测试大厅启动；自定义房选择本地文件无法使用此地图的云存档。")
elseif not HopeCloud_Ready[i] then
call DisplayTimedTextToPlayer(p,0,0,15.,"平台未能加载该玩家云档。请退出并重开一局，避免空档覆盖旧档；本局积分不能兑换永久升级。")
else
if HopeCloud_Test[i] then
call DisplayTimedTextToPlayer(p,0,0,15.,"环境：KK 地图测试服。载入积分："+I2S(HopeCloud_LoadedPoints[i])+"；本局积分："+I2S(udg_Wj_jf[i+1])+"。")
else
call DisplayTimedTextToPlayer(p,0,0,15.,"环境：KK RPG 大厅。载入积分："+I2S(HopeCloud_LoadedPoints[i])+"；本局积分："+I2S(udg_Wj_jf[i+1])+"。")
endif
if HopeCloud_Submissions[i]>0 then
call DisplayTimedTextToPlayer(p,0,0,15.,"最后提交："+HopeCloud_LastKey[i]+" = "+I2S(HopeCloud_LastValue[i])+"。接口提交不代表落库成功；若平台提示失败，请记录其完整错误码并在作者后台检查。")
else
call DisplayTimedTextToPlayer(p,0,0,15.,"尚未触发积分奖励或升级兑换；此命令只查询状态，不写入、不刷分。")
endif
endif
endfunction

function HopeCloud_Chat takes nothing returns nothing
call HopeCloud_Report(GetTriggerPlayer())
endfunction

function HopeCloud_Announce takes nothing returns nothing
local integer i=0
loop
exitwhen i>=6
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(Player(i))==MAP_CONTROL_USER then
call DisplayTimedTextToPlayer(Player(i),0,0,12.,HopeCloud_Status(Player(i))+"。输入 -save 查看存档诊断。")
endif
set i=i+1
endloop
call DestroyTimer(GetExpiredTimer())
endfunction

function HopeCloud_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i>=6
call TriggerRegisterPlayerChatEvent(t,Player(i),"-save",true)
call TriggerRegisterPlayerChatEvent(t,Player(i),"-存档",true)
set i=i+1
endloop
call TriggerAddAction(t,function HopeCloud_Chat)
call TimerStart(CreateTimer(),3.5,false,function HopeCloud_Announce)
set t=null
endfunction

function DzAPI_Map_StoreInteger takes player whichPlayer,string key,integer value returns nothing
local integer i=GetPlayerId(whichPlayer)
if not HopeCloud_CanWrite(whichPlayer) then
return
endif
set key="I"+key
call DzAPI_Map_SaveServerValue(whichPlayer,key,I2S(value))
set HopeCloud_Submissions[i]=HopeCloud_Submissions[i]+1
set HopeCloud_LastKey[i]=key
set HopeCloud_LastValue[i]=value
set key=null
set whichPlayer=null
endfunction
function DzAPI_Map_GetStoredInteger takes player whichPlayer,string key returns integer
local integer value
call HopeCloud_CheckLoad(whichPlayer)
if not HopeCloud_CanWrite(whichPlayer) then
return 0
endif
set key="I"+key
set value=S2I(DzAPI_Map_GetServerValue(whichPlayer,key))
if key=="Iboss_jf" then
set HopeCloud_LoadedPoints[GetPlayerId(whichPlayer)]=value
endif
set key=null
set whichPlayer=null
return value
endfunction
// The original cloud interface submits writes; it is not a commit receipt.
// Call only from synchronized gameplay callbacks, never from local UI refresh.
function HopePoints_Spend takes player p,integer price returns boolean
local integer i=-1
if p==null then
return false
endif
set i=GetPlayerId(p)
if i<0 or i>=6 or price<=0 then
return false
endif
if GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(p)!=MAP_CONTROL_USER then
return false
endif
if HopePoints_Busy[i] or HopeArchive_Busy[i] then
return false
endif
if not HopeCloud_CanWrite(p) then
call HopeCloud_Report(p)
return false
endif
if udg_Wj_jf[i+1]<price then
call DisplayTextToPlayer(p,0,0,"存档积分不足：需要 "+I2S(price)+"，当前 "+I2S(udg_Wj_jf[i+1])+"。")
return false
endif
set HopePoints_Busy[i]=true
set udg_Wj_jf[i+1]=udg_Wj_jf[i+1]-price
call DzAPI_Map_StoreInteger(p,"boss_jf",udg_Wj_jf[i+1])
set HopePoints_Busy[i]=false
return true
endfunction

function YDTriggerSaveLoadSystem___Init takes nothing returns nothing
set YDHT=InitHashtable()
set YDLOC=InitHashtable()
endfunction
// Generated from the original ability object data at build time.
function HopeSkill_Supported takes integer id returns boolean
return id=='A000' or id=='A001' or id=='A002' or id=='A00D' or id=='A00E' or id=='A00F' or id=='A00I' or id=='A00J' or id=='A00K' or id=='A00L' or id=='A00N' or id=='A00Q' or id=='A00X' or id=='A00Y' or id=='A00Z' or id=='A010' or id=='A011' or id=='A012' or id=='A013' or id=='A014' or id=='A015' or id=='A01C' or id=='A01D' or id=='A01H' or id=='A01I' or id=='A01J' or id=='A01K' or id=='A01N' or id=='A01O' or id=='A01R' or id=='A01S' or id=='A01T' or id=='A020' or id=='A021' or id=='A02S' or id=='A02T' or id=='A02U' or id=='A03B' or id=='A03C' or id=='A03D' or id=='A03F' or id=='A03J' or id=='A03L' or id=='A03Y' or id=='A03Z' or id=='A045' or id=='A04C' or id=='A04I' or id=='A04K' or id=='A04P' or id=='A04R' or id=='A04U' or id=='A04W' or id=='A04X' or id=='A04Y' or id=='A050' or id=='A051' or id=='A052' or id=='A053' or id=='A054' or id=='A056' or id=='A057' or id=='A058' or id=='A059' or id=='A05B' or id=='A05C' or id=='A05F' or id=='A05I'
endfunction
// v15 per-hero awakenings. Gameplay helpers run only in synchronized callbacks.
// Battle-scoped marks: child key 0 stores the battle generation; stale handles read as 0.
function HopeThird_Get takes integer h,integer k returns integer
if LoadInteger(HopeThird_Data,h,0)!=HopeThird_Gen then
return 0
endif
return LoadInteger(HopeThird_Data,h,k)
endfunction
function HopeThird_Put takes integer h,integer k,integer v returns nothing
if LoadInteger(HopeThird_Data,h,0)!=HopeThird_Gen then
call FlushChildHashtable(HopeThird_Data,h)
call SaveInteger(HopeThird_Data,h,0,HopeThird_Gen)
endif
call SaveInteger(HopeThird_Data,h,k,v)
endfunction
function HopeThird_Level takes unit u returns integer
local integer p=GetPlayerId(GetOwningPlayer(u))+1
if p<1 or p>6 or u!=udg_hero[p] or not HopeJob_Awakened[p] then
return 0
endif
return GetUnitAbilityLevel(u,HopeThird_Ability[HopeJob_AwakenOption[p]])
endfunction
function HopeThird_Enemy takes unit target,player p returns boolean
return target!=null and GetWidgetLife(target)>.405 and IsUnitInGroup(target,udg_Guaiwu_dwz) and IsUnitEnemy(target,p)
endfunction
function HopeThird_Heal takes unit u,real amount,boolean overflow returns nothing
local real missing=RMaxBJ(0.,GetUnitState(u,UNIT_STATE_MAX_LIFE)-GetWidgetLife(u))
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+RMinBJ(missing,amount))
if overflow and amount>missing then
call SetUnitState(u,ConvertUnitState(32),GetUnitState(u,ConvertUnitState(32))+amount-missing)
endif
endfunction
function HopeThird_Refund takes integer p returns nothing
set udg_xingdong_dian[p]=IMinBJ(udg_xingdong_dianSx[p],udg_xingdong_dian[p]+1)
endfunction
function HopeThird_Reset takes nothing returns nothing
local integer p=1
set HopeThird_Gen=HopeThird_Gen+1
loop
exitwhen p>6
set HopeThird_Cavalry[p]=false
set HopeThird_ComboToken[p]=-1
set HopeThird_PressureToken[p]=-1
set HopeThird_HitsToken[p]=-1
set HopeThird_HiddenToken[p]=-1
set HopeThird_FireTarget[p]=null
set HopeThird_PressureTarget[p]=null
set p=p+1
endloop
endfunction
function HopeThird_HiddenAction takes unit u,integer aid returns nothing
local integer p=GetPlayerId(GetOwningPlayer(u))+1
local integer level=HopeThird_Level(u)
local integer token=HopeChallenge_TurnToken()
local integer mask=0
if level<=0 or GetUnitTypeId(u)!='HZ03' then
return
endif
if HopeThird_HiddenToken[p]!=token then
set HopeThird_HiddenToken[p]=token
set HopeThird_HiddenMask[p]=0
endif
set mask=HopeThird_HiddenMask[p]
if mask>=8 then
return
endif
if aid=='AZH3' and ModuloInteger(mask,2)==0 then
set mask=mask+1
elseif aid=='AZHR' and ModuloInteger(mask,4)<2 then
set mask=mask+2
elseif aid=='AZHD' and mask<4 then
set mask=mask+4
endif
set HopeThird_HiddenMask[p]=mask
if ModuloInteger(mask,2)+ModuloInteger(mask/2,2)+mask/4>=2 then
set HopeThird_HiddenMask[p]=mask+8
call HopeThird_Refund(p)
call HopeThird_Heal(u,I2R(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))*(.05+.05*I2R(level)),false)
endif
endfunction
function HopeThird_AfterAction takes unit u,integer aid,unit target returns nothing
local integer p=GetPlayerId(GetOwningPlayer(u))+1
local integer level=HopeThird_Level(u)
local integer kind=GetUnitTypeId(u)
local integer token=HopeChallenge_TurnToken()
local integer limit=0
local integer count=0
local group g=null
local unit enemy=null
if level<=0 or not udg_ZhandouZhong then
return
endif
if kind=='H008' and aid=='A00E' then
call SetUnitState(u,ConvertUnitState(32),GetUnitState(u,ConvertUnitState(32))+I2R(GetHeroStr(u,true))*(.25+.25*I2R(level)))
elseif kind=='H00D' and aid=='A04I' then
set HopeThird_Cavalry[p]=true
elseif kind=='N018' and aid=='A00I' and HopeThird_Enemy(target,GetOwningPlayer(u)) then
if HopeThird_ComboToken[p]!=token then
set HopeThird_ComboToken[p]=token
set HopeThird_ComboCount[p]=0
set HopeThird_ComboPaid[p]=false
endif
set HopeThird_ComboCount[p]=HopeThird_ComboCount[p]+1
set limit=2
if level==1 then
set limit=3
endif
if not HopeThird_ComboPaid[p] and HopeThird_ComboCount[p]>=limit then
set HopeThird_ComboPaid[p]=true
call HopeThird_Refund(p)
if level==3 then
call SetUnitState(u,UNIT_STATE_MANA,RMinBJ(GetUnitState(u,UNIT_STATE_MAX_MANA),GetUnitState(u,UNIT_STATE_MANA)+2.))
endif
endif
elseif kind=='E00S' and aid=='A00D' and HopeThird_Enemy(target,GetOwningPlayer(u)) then
set limit=IMinBJ(2,level)
set g=CreateGroup()
call GroupAddGroup(udg_Guaiwu_dwz,g)
loop
set enemy=FirstOfGroup(g)
exitwhen enemy==null or count>=limit
call GroupRemoveUnit(g,enemy)
if enemy!=target and HopeThird_Enemy(enemy,GetOwningPlayer(u)) then
if level==3 then
call UnitDamageTarget(u,enemy,I2R(GetHeroAgi(u,true))*1.6*udg_Skill_Dm[p],true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
else
call UnitDamageTarget(u,enemy,I2R(GetHeroAgi(u,true))*1.2*udg_Skill_Dm[p],true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Arrow\\ArrowMissile.mdl",enemy,"origin"))
set count=count+1
endif
endloop
call DestroyGroup(g)
elseif kind=='N01E' and aid=='A00F' and HopeThird_Enemy(target,GetOwningPlayer(u)) then
call HopeThird_Put(GetHandleId(target),p,IMinBJ(3,HopeThird_Get(GetHandleId(target),p)+1))
set HopeThird_FireTarget[p]=target
endif
set enemy=null
set g=null
endfunction
function HopeThird_Base takes unit u,integer aid,real amount,boolean consume returns real
local integer p=GetPlayerId(GetOwningPlayer(u))+1
local integer level=HopeThird_Level(u)
local integer kind=GetUnitTypeId(u)
if level<=0 then
return amount
endif
if kind=='H008' and aid=='A03D' then
return amount+RMaxBJ(0.,GetUnitState(u,ConvertUnitState(32)))*(.25+.25*I2R(level))
elseif kind=='H00D' and aid=='A000' and HopeThird_Cavalry[p] then
if consume then
set HopeThird_Cavalry[p]=false
endif
return amount*(1.+.25+.25*I2R(level))
elseif kind=='N01A' and aid=='A01R' and GetUnitState(u,UNIT_STATE_MAX_LIFE)>0. then
return amount*(1.+RMaxBJ(0.,1.-GetWidgetLife(u)/GetUnitState(u,UNIT_STATE_MAX_LIFE))*(.2+.2*I2R(level)))
endif
return amount
endfunction
function HopeThird_Embers takes unit u,unit target returns real
local integer p=GetPlayerId(GetOwningPlayer(u))+1
local integer level=HopeThird_Level(u)
local integer count=0
if level<=0 or GetUnitTypeId(u)!='N01E' or not udg_ZhandouZhong or not HopeThird_Enemy(target,GetOwningPlayer(u)) then
return 0.
endif
set count=HopeThird_Get(GetHandleId(target),p)
call HopeThird_Put(GetHandleId(target),p,0)
return I2R(count*GetHeroInt(u,true))*(.4+.4*I2R(level))
endfunction
function HopeMeta_Bit takes integer index returns integer
local integer n=1
loop
exitwhen index<=0
set n=n*2
set index=index-1
endloop
return n
endfunction
function HopeMeta_Has takes integer mask,integer index returns boolean
return ModuloInteger(mask/HopeMeta_Bit(index),2)==1
endfunction
function HopeMeta_Count takes integer mask returns integer
local integer n=0
loop
exitwhen mask<=0
set n=n+ModuloInteger(mask,2)
set mask=mask/2
endloop
return n
endfunction
function HopeMeta_Level takes integer packed,integer node returns integer
return ModuloInteger(packed/HopeMeta_Bit(2*node),4)
endfunction
function HopeMeta_Tal takes integer i,integer node returns integer
return HopeMeta_Level(HopeMeta_RunTalent[i*3+node/5],ModuloInteger(node,5))
endfunction
function HopeMeta_Learned takes integer i returns integer
local integer node=0
local integer count=0
loop
exitwhen node>=15
if HopeMeta_Level(HopeMeta_Talent[i*3+node/5],ModuloInteger(node,5))>0 then
set count=count+1
endif
set node=node+1
endloop
return count
endfunction
function HopeMeta_Price takes integer node returns integer
if node==1 or node==2 or node==3 then
return 30
elseif node==4 or node==5 then
return 20
elseif node==8 or node==9 then
return 50
endif
return 10
endfunction
function HopeMeta_AddXp takes integer i,integer n returns nothing
if n<=0 or not HopeMeta_Loaded[i] then
return
endif
set HopeMeta_Xp[i]=IMinBJ(2000000000,HopeMeta_Xp[i]+IMinBJ(100000,n))
call DzAPI_Map_StoreInteger(Player(i),"xp_v1",HopeMeta_Xp[i])
endfunction
function HopeMeta_Achieve takes integer i,integer index returns nothing
if i<0 or i>=6 or not HopeMeta_Loaded[i] or index<0 or index>=24 or HopeMeta_Has(HopeMeta_Ach[i],index) then
return
endif
set HopeMeta_Ach[i]=HopeMeta_Ach[i]+HopeMeta_Bit(index)
call DzAPI_Map_StoreInteger(Player(i),"ach_v1",HopeMeta_Ach[i])
// A small one-off discovery reward; never a repeatable points multiplier.
set udg_Wj_jf[i+1]=IMinBJ(2000000000,udg_Wj_jf[i+1]+5)
call DzAPI_Map_StoreInteger(Player(i),"boss_jf",udg_Wj_jf[i+1])
call HopeMeta_AddXp(i,5)
call DisplayTimedTextToPlayer(Player(i),0,0,5.,"成就解锁："+HopeMeta_AchName[index]+" · +5存档积分（已提交）")
endfunction
function HopeMeta_Job takes integer i returns integer
local integer j=0
local integer kind=GetUnitTypeId(udg_hero[i+1])
if HopeJob_Awakened[i+1] then
return HopeJob_AwakenOption[i+1]
endif
if kind=='HZ01' then
return 24
endif
loop
exitwhen j>=26
if j!=24 and HopeJob_Target[j]==kind then
return j
endif
set j=j+1
endloop
return -1
endfunction
function HopeMeta_SaveMastery takes integer i,integer job returns nothing
local integer groupId=job/4
local integer j=groupId*4
local integer value=0
local integer power=1
loop
exitwhen j>=groupId*4+4 or j>=43
set value=value+HopeMeta_Mastery[i*43+j]*power
set power=power*64
set j=j+1
endloop
call DzAPI_Map_StoreInteger(Player(i),"mast_v1_"+I2S(groupId),value)
endfunction
function HopeMeta_Earn takes player p,integer points,boolean boss returns nothing
local integer i=GetPlayerId(p)
local integer j=0
local integer soul=0
if i<0 or i>=6 or not HopeMeta_Loaded[i] then
return
endif
call HopeMeta_AddXp(i,points)
if boss then
set HopeMeta_Bosses[i]=HopeMeta_Bosses[i]+1
call HopeMeta_Achieve(i,0)
set j=HopeMeta_Job(i)
if j>=0 and j<43 then
set HopeMeta_Mastery[i*43+j]=IMinBJ(63,HopeMeta_Mastery[i*43+j]+1)
call HopeMeta_SaveMastery(i,j)
if HopeMeta_Mastery[i*43+j]>=25 then
call HopeMeta_Achieve(i,20)
endif
endif
if udg_Yx_Nd_Dj>=4 then
set soul=1
if udg_Yx_Nd_Dj==5 then
set soul=2
elseif udg_Yx_Nd_Dj==6 then
set soul=1+IMinBJ(5,udg_quanshu/5)
endif
set HopeMeta_Soul[i]=IMinBJ(2000000000,HopeMeta_Soul[i]+soul)
call DzAPI_Map_StoreInteger(p,"soul_v1",HopeMeta_Soul[i])
endif
if udg_Yx_Nd_Dj==6 then
set HopeMeta_Best[i]=IMaxBJ(HopeMeta_Best[i],udg_quanshu+1)
call DzAPI_Map_StoreInteger(p,"best_v1",HopeMeta_Best[i])
set j=0
loop
exitwhen j>=4
if HopeMeta_Best[i]>=5*HopeMeta_Bit(j) then
// Thresholds 5/10/20/30: final threshold handled explicitly.
if j<3 or HopeMeta_Best[i]>=30 then
call HopeMeta_Achieve(i,6+j)
endif
endif
set j=j+1
endloop
if HopeMeta_Best[i]>=30 then
call HopeMeta_Achieve(i,9)
endif
endif
if HopeMeta_Xp[i]>=1000 then
call HopeMeta_Achieve(i,22)
endif
if HopeMeta_Count(HopeMeta_Ach[i])>=20 then
call HopeMeta_Achieve(i,23)
endif
endif
endfunction
function HopeMeta_Catalog takes integer i,integer index returns nothing
local integer groupId=index/22
local integer bit=ModuloInteger(index,22)
local integer count=0
if not HopeMeta_Loaded[i] or HopeMeta_Has(HopeMeta_Relic[i*2+groupId],bit) then
return
endif
set HopeMeta_Relic[i*2+groupId]=HopeMeta_Relic[i*2+groupId]+HopeMeta_Bit(bit)
call DzAPI_Map_StoreInteger(Player(i),"relic_v1_"+I2S(groupId),HopeMeta_Relic[i*2+groupId])
set count=HopeMeta_Count(HopeMeta_Relic[i*2])+HopeMeta_Count(HopeMeta_Relic[i*2+1])
call HopeMeta_Achieve(i,16)
if count>=10 then
call HopeMeta_Achieve(i,17)
endif
if count>=20 then
call HopeMeta_Achieve(i,18)
endif
if count>=44 then
call HopeMeta_Achieve(i,19)
endif
endfunction
function HopeMeta_Load takes integer i returns nothing
local player p=Player(i)
local integer j=0
local integer k=0
local integer value=0
local integer lower=IMaxBJ(0,udg_Wj_jf[i+1])
local integer schema=0
if HopeMeta_Loaded[i] or not HopeCloud_CanWrite(p) or udg_Cundang_danwei[i+1]==null then
set p=null
return
endif
set schema=DzAPI_Map_GetStoredInteger(p,"v19_schema")
loop
exitwhen j>=10
// Snapshot actual purchased levels: do not reinterpret zero as a purchase.
set value=IMaxBJ(0,GetUnitAbilityLevel(udg_Cundang_danwei[i+1],$41303330+j)-1)
set HopeMeta_BaseLevel[i*10+j]=value
set lower=IMinBJ(2000000000,lower+value*HopeMeta_Price(j))
set j=j+1
endloop
set HopeMeta_Xp[i]=IMaxBJ(lower,DzAPI_Map_GetStoredInteger(p,"xp_v1"))
set HopeMeta_Soul[i]=IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"soul_v1"))
set HopeMeta_Ach[i]=ModuloInteger(IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"ach_v1")),16777216)
set HopeMeta_Abyss[i]=ModuloInteger(IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"abyss_v1")),64)
set HopeMeta_RunAbyss[i]=HopeMeta_Abyss[i]
set HopeMeta_Keystone[i]=IMaxBJ(0,IMinBJ(3,DzAPI_Map_GetStoredInteger(p,"key_v1")))
set HopeMeta_RunKey[i]=HopeMeta_Keystone[i]
set HopeMeta_Best[i]=IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"best_v1"))
set HopeMeta_Relic[i*2]=ModuloInteger(IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"relic_v1_0")),4194304)
set HopeMeta_Relic[i*2+1]=ModuloInteger(IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"relic_v1_1")),4194304)
set HopeMeta_Talent[i*3]=ModuloInteger(IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"tal_v1_a")),1024)
set HopeMeta_Talent[i*3+1]=ModuloInteger(IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"tal_v1_b")),1024)
set HopeMeta_Talent[i*3+2]=ModuloInteger(IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"tal_v1_c")),1024)
set j=0
loop
exitwhen j>=3
set HopeMeta_RunTalent[i*3+j]=HopeMeta_Talent[i*3+j]
set j=j+1
endloop
set j=0
loop
exitwhen j>=11
set value=IMaxBJ(0,DzAPI_Map_GetStoredInteger(p,"mast_v1_"+I2S(j)))
set k=0
loop
exitwhen k>=4 or j*4+k>=43
set HopeMeta_Mastery[i*43+j*4+k]=ModuloInteger(value,64)
set HopeMeta_RunMastery[i*43+j*4+k]=ModuloInteger(value,64)
set value=value/64
set k=k+1
endloop
set j=j+1
endloop
set HopeMeta_LastTurn[i]=-1
set HopeMeta_Loaded[i]=true
if schema<1 then
call DzAPI_Map_StoreInteger(p,"xp_v1",HopeMeta_Xp[i])
call DzAPI_Map_StoreInteger(p,"v19_schema",1)
call DisplayTextToPlayer(p,0,0,"v19存档已迁移：旧余额和已购成长保留；累计积分仅记录可追溯下限。")
endif
set p=null
endfunction
function HopeMeta_CanBuy takes player p returns boolean
local integer i=GetPlayerId(p)
return i>=0 and i<6 and HopeMeta_Loaded[i] and HopeCloud_CanWrite(p) and not udg_ZhandouZhong and not HopeRoute_Left[i]
endfunction
function HopeMeta_BuyTalent takes player p,integer node returns nothing
local integer i=GetPlayerId(p)
local integer groupId=node/5
local integer level=0
local integer cost=0
local integer prerequisite=0
local string key="tal_v1_a"
if node<0 or node>=15 or not HopeMeta_CanBuy(p) then
call DisplayTextToPlayer(p,0,0,"非战斗且云档就绪后，才能购买；下局生效。")
return
endif
set level=HopeMeta_Level(HopeMeta_Talent[i*3+groupId],ModuloInteger(node,5))
set prerequisite=HopeMeta_NodePrereq[node]
if level>=3 or (prerequisite>=0 and HopeMeta_Level(HopeMeta_Talent[i*3+groupId],ModuloInteger(prerequisite,5))<1) then
call DisplayTextToPlayer(p,0,0,"该节点已满级，或尚未满足前置。")
return
endif
set cost=HopeMeta_NodeCost[node]*(level+1)
if not HopePoints_Spend(p,cost) then
return
endif
set HopeMeta_Talent[i*3+groupId]=HopeMeta_Talent[i*3+groupId]+HopeMeta_Bit(2*ModuloInteger(node,5))
if groupId==1 then
set key="tal_v1_b"
elseif groupId==2 then
set key="tal_v1_c"
endif
call DzAPI_Map_StoreInteger(p,key,HopeMeta_Talent[i*3+groupId])
if HopeMeta_Learned(i)>=5 then
call HopeMeta_Achieve(i,21)
endif
endfunction
function HopeMeta_BuyAbyss takes player p,integer node returns nothing
local integer i=GetPlayerId(p)
local integer price=0
if node<0 or node>=6 or not HopeMeta_CanBuy(p) then
return
endif
set price=HopeMeta_AbyssCost[node]
if HopeMeta_Has(HopeMeta_Abyss[i],node) or HopeMeta_Soul[i]<price then
call DisplayTextToPlayer(p,0,0,"已解锁或魂晶不足；魂晶仅从极难、炼狱和无限BOSS获取。")
return
endif
set HopeMeta_Soul[i]=HopeMeta_Soul[i]-price
set HopeMeta_Abyss[i]=HopeMeta_Abyss[i]+HopeMeta_Bit(node)
call DzAPI_Map_StoreInteger(p,"soul_v1",HopeMeta_Soul[i])
call DzAPI_Map_StoreInteger(p,"abyss_v1",HopeMeta_Abyss[i])
endfunction
function HopeMeta_Key takes player p,integer key returns nothing
local integer i=GetPlayerId(p)
if key<1 or key>3 or not HopeMeta_CanBuy(p) or HopeMeta_Keystone[i]!=0 then
call DisplayTextToPlayer(p,0,0,"基石三选一；已有基石时须先重置天赋。")
return
endif
if not HopePoints_Spend(p,80) then
return
endif
set HopeMeta_Keystone[i]=key
call DzAPI_Map_StoreInteger(p,"key_v1",key)
endfunction
function HopeMeta_Reset takes player p returns nothing
local integer i=GetPlayerId(p)
local integer node=0
local integer level=0
local integer refund=0
if not HopeMeta_CanBuy(p) then
return
endif
if HopeMeta_Keystone[i]>0 then
set refund=80
endif
loop
exitwhen node>=15
set level=HopeMeta_Level(HopeMeta_Talent[i*3+node/5],ModuloInteger(node,5))
set refund=refund+HopeMeta_NodeCost[node]*level*(level+1)/2
set node=node+1
endloop
if refund==0 or not HopePoints_Spend(p,10) then
return
endif
set udg_Wj_jf[i+1]=IMinBJ(2000000000,udg_Wj_jf[i+1]+refund)
set HopeMeta_Talent[i*3]=0
set HopeMeta_Talent[i*3+1]=0
set HopeMeta_Talent[i*3+2]=0
set HopeMeta_Keystone[i]=0
call DzAPI_Map_StoreInteger(p,"tal_v1_a",0)
call DzAPI_Map_StoreInteger(p,"tal_v1_b",0)
call DzAPI_Map_StoreInteger(p,"tal_v1_c",0)
call DzAPI_Map_StoreInteger(p,"key_v1",0)
call DzAPI_Map_StoreInteger(p,"boss_jf",udg_Wj_jf[i+1])
call DisplayTextToPlayer(p,0,0,"天赋重置已提交：返还购买积分，收取10积分；本局已载入效果保持，下局换构筑。")
endfunction
// Conservative legacy bound at the current level, including flat stats, HP,
// crit and skill. New numeric growth spends only the remaining 28% envelope.
// Old purchased stats are never reduced, even if their early-game ratio >28%.
function HopeMeta_LegacyRatio takes integer i returns real
local unit u=udg_hero[i+1]
local real atk=GetUnitState(u,ConvertUnitState(20))
local real hp=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real stats=I2R(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))
local real flat=I2R(HopeMeta_BaseLevel[i*10])
local real attr=I2R(HopeMeta_BaseLevel[i*10+1]+HopeMeta_BaseLevel[i*10+2]+HopeMeta_BaseLevel[i*10+3])
local real off=RMaxBJ(atk/RMaxBJ(1.,atk-flat-attr),stats/RMaxBJ(1.,stats-attr))
local real crit=I2R(HopeMeta_BaseLevel[i*10+8])*.01
local real cd=RMaxBJ(0.,udg_Baoji_Damage[i+1]-1.)
local real skill=.01*I2R(HopeMeta_BaseLevel[i*10+9])
local real life=10.*I2R(HopeMeta_BaseLevel[i*10+4])+2.*I2R(HopeMeta_BaseLevel[i*10+1])
set off=off*(1.+.01*I2R(udg_Baoji_Lv[i+1])*cd)/RMaxBJ(1.,1.+(.01*I2R(udg_Baoji_Lv[i+1])-crit)*cd)
set off=off*udg_Skill_Dm[i+1]/RMaxBJ(.01,udg_Skill_Dm[i+1]-skill)
set off=off*hp/RMaxBJ(1.,hp-life)
set u=null
return RMaxBJ(1.,off)
endfunction
function HopeMeta_RawOff takes integer i returns real
local integer j=HopeMeta_Job(i)
local real bonus=.01*I2R(HopeMeta_Tal(i,0)+HopeMeta_Tal(i,1)+HopeMeta_Tal(i,2)+HopeMeta_Tal(i,3)+HopeMeta_Tal(i,4))
if HopeMeta_Has(HopeMeta_RunAbyss[i],0) then
set bonus=bonus+.02
endif
if j>=0 and j<43 then
set bonus=bonus+.004*I2R(IMinBJ(5,HopeMeta_RunMastery[i*43+j]/5))
endif
return 1.+bonus
endfunction
function HopeMeta_RawDef takes integer i returns real
local real bonus=.01*I2R(HopeMeta_Tal(i,5)+HopeMeta_Tal(i,6))
if HopeMeta_Has(HopeMeta_RunAbyss[i],1) then
set bonus=bonus+.02
endif
return 1.+bonus
endfunction
function HopeMeta_Exponent takes integer i returns real
local real lo=0.
local real hi=1.
local real mid=0.
local real raw=HopeMeta_RawOff(i)*HopeMeta_RawDef(i)
local real sustain=.01*I2R(HopeMeta_Tal(i,7)+2*HopeMeta_Tal(i,9))
local real allowance=RMaxBJ(1.,1.28/HopeMeta_LegacyRatio(i))
local integer j=0
if HopeMeta_RunKey[i]==1 then
set sustain=sustain+.04
elseif HopeMeta_RunKey[i]==2 then
set sustain=sustain+.02
endif
if HopeMeta_Has(HopeMeta_RunAbyss[i],4) then
set sustain=sustain+.01
endif
if HopeMeta_Has(HopeMeta_RunAbyss[i],5) then
set sustain=sustain+.01
endif
if raw*(1.+sustain)<=allowance then
return 1.
endif
loop
exitwhen j>=12
set mid=(lo+hi)*.5
if Pow(raw,mid)*(1.+sustain*mid)<=allowance then
set lo=mid
else
set hi=mid
endif
set j=j+1
endloop
return lo
endfunction
function HopeMeta_Out takes integer i,boolean spell,boolean boss,boolean critical returns real
local real raw=HopeMeta_RawOff(i)
if i<0 or i>=6 or not HopeMeta_Started[i] then
return 1.
endif
if not spell then
set raw=raw-.01*I2R(HopeMeta_Tal(i,1))
endif
if not boss then
set raw=raw-.01*I2R(HopeMeta_Tal(i,2))
endif
if not critical then
set raw=raw-.01*I2R(HopeMeta_Tal(i,3))
endif
if udg_huihe_s!=1 then
set raw=raw-.01*I2R(HopeMeta_Tal(i,4))
endif
// Critical training is a bounded expected-damage modifier, not free crit rolls.
return Pow(RMaxBJ(1.,raw),HopeMeta_Exponent(i))
endfunction
function HopeMeta_CheckTurn takes integer i returns nothing
local unit u=udg_hero[i+1]
local integer turn=HopeChallenge_TurnToken()
local real hp=0.
if i<0 or i>=6 or not HopeMeta_Started[i] or not udg_ZhandouZhong or u==null or GetWidgetLife(u)<=.405 then
set u=null
return
endif
if HopeMeta_LastTurn[i]!=turn then
set HopeMeta_LastTurn[i]=turn
set HopeMeta_Hits[i]=0
set HopeMeta_Shield[i]=0.
if udg_huihe_s==1 then
set HopeMeta_LowUsed[i]=false
set hp=.01*I2R(HopeMeta_Tal(i,9))
if HopeMeta_RunKey[i]==1 then
set hp=hp+.04
endif
if HopeMeta_Has(HopeMeta_RunAbyss[i],5) then
set hp=hp+.01
endif
set HopeMeta_Shield[i]=GetUnitState(u,UNIT_STATE_MAX_LIFE)*hp*HopeMeta_Exponent(i)
endif
endif
if not HopeMeta_LowUsed[i] and GetWidgetLife(u)<GetUnitState(u,UNIT_STATE_MAX_LIFE)*.25 and HopeMeta_Tal(i,9)>0 then
set HopeMeta_LowUsed[i]=true
set HopeMeta_Shield[i]=HopeMeta_Shield[i]+GetUnitState(u,UNIT_STATE_MAX_LIFE)*.01*I2R(HopeMeta_Tal(i,9))*HopeMeta_Exponent(i)
endif
set u=null
endfunction
function HopeMeta_PostRoom takes nothing returns nothing
local integer i=0
local unit u=null
local real heal=0.
loop
exitwhen i>=6
set u=udg_hero[i+1]
if HopeMeta_Started[i] and u!=null and GetWidgetLife(u)>.405 and not HopeRoute_Left[i] then
set heal=.01*I2R(HopeMeta_Tal(i,7))
if HopeMeta_RunKey[i]==2 then
set heal=heal+.02
endif
if HopeMeta_Has(HopeMeta_RunAbyss[i],4) then
set heal=heal+.01
endif
call SetWidgetLife(u,RMinBJ(GetUnitState(u,UNIT_STATE_MAX_LIFE),GetWidgetLife(u)+GetUnitState(u,UNIT_STATE_MAX_LIFE)*heal*HopeMeta_Exponent(i)))
call SetUnitState(u,UNIT_STATE_MANA,RMinBJ(GetUnitState(u,UNIT_STATE_MAX_MANA),GetUnitState(u,UNIT_STATE_MANA)+I2R(HopeMeta_Tal(i,8))))
call AdjustPlayerStateBJ(3*HopeMeta_Tal(i,14),Player(i),PLAYER_STATE_RESOURCE_GOLD)
endif
set i=i+1
endloop
set u=null
endfunction
function HopeMeta_Win takes integer players returns nothing
local integer i=0
local integer bonus=HopeRewards_Win(udg_Yx_Nd_Dj)
loop
exitwhen i>=6
if HopeMeta_Started[i] and not HopeMeta_Finished[i] and not HopeRoute_Left[i] then
set HopeMeta_Finished[i]=true
set udg_Wj_jf[i+1]=udg_Wj_jf[i+1]+bonus
call DzAPI_Map_StoreInteger(Player(i),"boss_jf",udg_Wj_jf[i+1])
call HopeMeta_Earn(Player(i),bonus,false)
call HopeMeta_Achieve(i,udg_Yx_Nd_Dj)
if players==1 then
call HopeMeta_Achieve(i,13)
endif
if players>=2 then
call HopeMeta_Achieve(i,10)
endif
if players>=4 then
call HopeMeta_Achieve(i,11)
endif
if players>=6 then
call HopeMeta_Achieve(i,12)
endif
endif
set i=i+1
endloop
endfunction
function HopeMeta_Tick takes nothing returns nothing
local integer i=0
local integer j=0
local unit u=null
local real hp=0.
local integer turn=0
loop
exitwhen i>=6
call HopeMeta_Load(i)
set u=udg_hero[i+1]
if HopeMeta_Loaded[i] and u!=null and GetUnitTypeId(u)!=0 and not HopeRoute_Left[i] then
if not HopeMeta_Started[i] then
set HopeMeta_Started[i]=true
if HopeMeta_Has(HopeMeta_RunAbyss[i],3) then
set udg_CZ_czcs[i+1]=udg_CZ_czcs[i+1]+1
endif
call AdjustPlayerStateBJ(10*HopeMeta_Tal(i,10),Player(i),PLAYER_STATE_RESOURCE_GOLD)
call AdjustPlayerStateBJ(HopeMeta_Tal(i,11),Player(i),PLAYER_STATE_RESOURCE_LUMBER)
endif
set j=HopeMeta_Job(i)
if j>=0 and j<43 and HopeJob_Stage[j]>=1 then
call HopeMeta_Achieve(i,14)
endif
if HopeJob_Awakened[i+1] then
call HopeMeta_Achieve(i,15)
endif
call HopeMeta_CheckTurn(i)
endif
set i=i+1
endloop
set u=null
endfunction

function HopeThird_Damage takes unit u,unit target,real amount returns real
local integer p=GetPlayerId(GetOwningPlayer(u))+1
local integer owner=GetPlayerId(GetOwningPlayer(target))+1
local integer kind=GetUnitTypeId(u)
local integer level=HopeThird_Level(u)
local integer token=HopeChallenge_TurnToken()
local integer h=GetHandleId(target)
local integer marks=0
if amount<=0. or not udg_ZhandouZhong then
return amount
endif
// Frost affects the marked enemy's next positive damage event against a hero.
if owner>=1 and owner<=6 and target==udg_hero[owner] and IsUnitEnemy(u,GetOwningPlayer(target)) and HopeThird_Get(GetHandleId(u),101)>0 then
call HopeThird_Put(GetHandleId(u),101,0)
set amount=amount*.5
endif
if p<1 or p>6 or u!=udg_hero[p] or not HopeThird_Enemy(target,GetOwningPlayer(u)) then
return amount
endif
// Hunt belongs to the target: teammates also benefit, one charge per damage event.
set marks=HopeThird_Get(h,102)
if marks>0 then
call HopeThird_Put(h,102,marks-1)
set amount=amount*1.25
call AdjustPlayerStateBJ(10,GetOwningPlayer(u),PLAYER_STATE_RESOURCE_GOLD)
endif
if level<=0 then
return amount
endif
if kind=='H004' then
if HopeThird_PressureToken[p]!=token or HopeThird_PressureTarget[p]!=target then
set HopeThird_PressureToken[p]=token
set HopeThird_PressureTarget[p]=target
set HopeThird_Pressure[p]=0
endif
set amount=amount*(1.+I2R(HopeThird_Pressure[p])*(.04+.04*I2R(level)))
set HopeThird_Pressure[p]=IMinBJ(3,HopeThird_Pressure[p]+1)
elseif kind=='O006' then
if HopeThird_HitsToken[p]!=token then
set HopeThird_HitsToken[p]=token
set HopeThird_Hits[p]=0
set HopeThird_HealCount[p]=0
endif
if HopeThird_HealCount[p]<2 then
set HopeThird_Hits[p]=HopeThird_Hits[p]+1
if HopeThird_Hits[p]>=3 then
set HopeThird_Hits[p]=0
set HopeThird_HealCount[p]=HopeThird_HealCount[p]+1
call HopeThird_Heal(u,I2R(GetHeroStr(u,true)+GetHeroAgi(u,true))*(.1+.1*I2R(level)),true)
endif
endif
endif
return amount
endfunction

function HopeSkill_InitIds takes nothing returns nothing
set HopeSkill_Ids[0]='A000'
set HopeSkill_Ids[1]='A001'
set HopeSkill_Ids[2]='A002'
set HopeSkill_Ids[3]='A00D'
set HopeSkill_Ids[4]='A00E'
set HopeSkill_Ids[5]='A00F'
set HopeSkill_Ids[6]='A00I'
set HopeSkill_Ids[7]='A00J'
set HopeSkill_Ids[8]='A00K'
set HopeSkill_Ids[9]='A00L'
set HopeSkill_Ids[10]='A00N'
set HopeSkill_Ids[11]='A00Q'
set HopeSkill_Ids[12]='A00X'
set HopeSkill_Ids[13]='A00Y'
set HopeSkill_Ids[14]='A00Z'
set HopeSkill_Ids[15]='A010'
set HopeSkill_Ids[16]='A011'
set HopeSkill_Ids[17]='A012'
set HopeSkill_Ids[18]='A013'
set HopeSkill_Ids[19]='A014'
set HopeSkill_Ids[20]='A015'
