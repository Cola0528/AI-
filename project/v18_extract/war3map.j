call SaveBoolean(YDHT,GetHandleId(LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$32A9E4C8)),$AB392274,true)
if HaveSavedInteger(YDHT,udg_wp[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$A1614B4D)],$E6440B6)==true then
call UnitAddItemByIdSwapped(udg_wp[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$A1614B4D)],udg_Yiwu_danwei[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$6F96F2D2)])
else
call HopeInventory_Give(udg_wp[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$A1614B4D)],udg_hero[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$6F96F2D2)])
