function HopeV8_RefreshContent takes nothing returns nothing
call HopeModern_Refresh()
call HopeRoute_RefreshPicker()
call HopeLayout_Assignment()
call HopeDraw_Refresh()
call HopeDamage_Refresh()
call HopeMeta_Refresh()
call HopeMarket_Refresh()
endfunction
function HopeV8_Refresh takes nothing returns nothing
call HopeV8_RefreshContent()
call HopeLayout_Apply()
endfunction
function HopeWood_Sold takes nothing returns nothing
local item sold=GetSoldItem()
local integer kind=GetItemTypeId(sold)
local unit shop=GetSellingUnit()
local unit buyer=GetBuyingUnit()
local player p=GetOwningPlayer(buyer)
local integer i=GetPlayerId(p)
local integer count=1
local integer n=1
local string result=""
local string text=""
if kind!='IZWD' and kind!='IZWT' then
set sold=null
set shop=null
set buyer=null
set p=null
return
endif
if kind=='IZWT' then
set count=10
endif
// The native shop already charged count wood; script never charges again.
call RemoveItem(sold)
if shop==gg_unit_n00Q_0028 then
call RemoveItemFromStock(shop,kind)
call AddItemToStock(shop,kind,1,1)
endif
if HopeWood_Allowed(shop,buyer) then
set HopeDraw_Busy[i]=true
loop
exitwhen n>count
set result=HopeDraw_Quality("谢谢惠顾（未获得奖励）")
if GetRandomInt(1,100)>50 then
set result=HopeDraw_Reward(p)
endif
if count>1 then
set text=text+I2S(n)+". "+result+"|n"
else
set text=result
endif
set n=n+1
endloop
if count==10 then
call HopeDraw_SaveRecord(p,"木材十连结果 · 消耗10木材",text+"|n每次独立50%谢谢惠顾；其余沿用原奖池。",true)
else
call HopeDraw_SaveRecord(p,"木材抽取结果 · 消耗1木材",text+"|n|n木材抽取50%谢谢惠顾；未抽空时沿用十连奖池。",false)
call DisplayTimedTextToPlayer(p,0,0,5.,"木材抽奖（1木材）："+result+"。可在抽取记录中回看。")
endif
set HopeDraw_Busy[i]=false
elseif buyer!=null then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)+count)
call DisplayTextToPlayer(p,0,0,"当前不能进行木材抽奖，已退回"+I2S(count)+"木材。请在非战斗时由能力商人购买。")
endif
set sold=null
set shop=null
set buyer=null
set p=null
endfunction
function HopeWood_Init takes nothing returns nothing
local trigger t=CreateTrigger()
// These two items are dynamic stock only, never also in static Sellitems.
call RemoveItemFromStock(gg_unit_n00Q_0028,'IZWD')
call RemoveItemFromStock(gg_unit_n00Q_0028,'IZWT')
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddAction(t,function HopeWood_Sold)
set t=null
endfunction

function HopeExchange_GoldToWoodCost takes nothing returns integer
return HopeMarket_GoldCost
endfunction
function HopeExchange_WoodToGoldReward takes nothing returns integer
return HopeMarket_GoldReward
endfunction
function HopeExchange_Sold takes nothing returns nothing
local item sold=GetSoldItem()
local integer kind=GetItemTypeId(sold)
local unit shop=GetSellingUnit()
local unit buyer=GetBuyingUnit()
local player p=GetOwningPlayer(buyer)
local integer wood=0
local integer gold=0
if kind=='IZWU' then
set wood=1
set gold=-HopeExchange_GoldToWoodCost()
elseif kind=='IZWV' then
set wood=5
set gold=-(HopeExchange_GoldToWoodCost()*5)
elseif kind=='IZWW' then
set wood=-1
set gold=HopeExchange_WoodToGoldReward()
elseif kind=='IZWX' then
set wood=-5
set gold=HopeExchange_WoodToGoldReward()*5
else
set sold=null
set shop=null
set buyer=null
set p=null
return
endif
// The native shop already charged gold or wood per ItemData cost; script never charges again.
call RemoveItem(sold)
if shop==gg_unit_n00Q_0028 then
call RemoveItemFromStock(shop,kind)
call AddItemToStock(shop,kind,1,1)
endif
if HopeWood_Allowed(shop,buyer) then
if wood>0 then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)+wood)
call DisplayTimedTextToPlayer(p,0,0,5.,"兑换成功：支付"+I2S(-gold)+"金币，获得"+I2S(wood)+"木材。")
else
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)+gold)
call DisplayTimedTextToPlayer(p,0,0,5.,"兑换成功：交出"+I2S(-wood)+"木材，获得"+I2S(gold)+"金币。")
endif
elseif buyer!=null then
if gold<0 then
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-gold)
call DisplayTextToPlayer(p,0,0,"当前不能兑换，已退回"+I2S(-gold)+"金币。请在非战斗时于能力商人处操作。")
else
call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)-wood)
call DisplayTextToPlayer(p,0,0,"当前不能兑换，已退回"+I2S(-wood)+"木材。请在非战斗时于能力商人处操作。")
endif
endif
set sold=null
set shop=null
set buyer=null
set p=null
endfunction
function HopeExchange_Init takes nothing returns nothing
local trigger t=CreateTrigger()
// Exchange items are dynamic stock only, never also in static Sellitems.
call RemoveItemFromStock(gg_unit_n00Q_0028,'IZWU')
call RemoveItemFromStock(gg_unit_n00Q_0028,'IZWV')
call RemoveItemFromStock(gg_unit_n00Q_0028,'IZWW')
call RemoveItemFromStock(gg_unit_n00Q_0028,'IZWX')
call TriggerRegisterAnyUnitEventBJ(t,EVENT_PLAYER_UNIT_SELL_ITEM)
call TriggerAddAction(t,function HopeExchange_Sold)
set t=null
endfunction

function HopeEvent_Close takes nothing returns nothing
