call HopeQoL_Bind(f,function HopeEvent_Close,false)
set viewport=HopeQoL_Button("HopeEventViewport",HopeEvent_Panel,.010,-.035,.292,.153,"")
call DzFrameSetScriptByCode(viewport,2,function HopeEvent_Enter,false)
call DzFrameSetScriptByCode(viewport,3,function HopeScroll_Leave,false)
set HopeEvent_Body=HopeQoL_Label("HopeEventBody",viewport,.005,-.004,.282,.145,"")
call DzFrameSetFont(HopeEvent_Body,"Fonts\\ZiTi.ttf",.0085,0)
set f=HopeQoL_Button("HopeEventUp",HopeEvent_Panel,.010,-.196,.036,.023,"上")
call HopeQoL_Bind(f,function HopeEvent_Up,false)
set f=HopeQoL_Button("HopeEventDown",HopeEvent_Panel,.050,-.196,.036,.023,"下")
call HopeQoL_Bind(f,function HopeEvent_Down,false)
set HopeEvent_Status=HopeQoL_Label("HopeEventStatus",HopeEvent_Panel,.092,-.201,.210,.016,"")
call DzFrameSetFont(HopeEvent_Status,"Fonts\\ZiTi.ttf",.008,0)
set HopeEvent_Button=HopeQoL_Button("HopeEventEntry",DzGetGameUI(),.160,.222,.100,.021,"问号事件")
call HopeQoL_Bind(HopeEvent_Button,function HopeEvent_Show,false)
call HopeJob_ShowFrame(HopeEvent_Panel,false)
endfunction

