function HopeDamage_Battle takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeDamage_Run=false
endif
endfunction
function HopeDamage_RunClick takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeDamage_Run=true
endif
endfunction
function HopeDamage_Value takes integer i returns real
if HopeDamage_Run then
return HopeDamage_Total[i]
endif
return udg_Shuchu_dm_tj[i]
endfunction
function HopeDamage_Number takes real value returns string
local integer exponent=0
if value<10000. then
return R2SW(value,1,0)
elseif value<100000000. then
return R2SW(value/10000.,1,1)+"万"
elseif value<1000000000000. then
return R2SW(value/100000000.,1,1)+"亿"
endif
loop
exitwhen value<1000. or exponent>=36
set value=value/1000.
set exponent=exponent+3
endloop
return R2SW(value,1,1)+"e"+I2S(exponent)
endfunction
function HopeDamage_Refresh takes nothing returns nothing
local integer i=1
local integer j=0
local integer count=0
local integer id=0
local real amount=0.
local real sum=0.
local string text=""
local string name=""
local string line=""
loop
exitwhen i>6
if udg_hero[i]!=null or HopeDamage_Total[i]>0. then
set j=count
loop
exitwhen j<=0
exitwhen HopeDamage_Value(HopeDamage_Order[j])>=HopeDamage_Value(i)
set HopeDamage_Order[j+1]=HopeDamage_Order[j]
set j=j-1
endloop
set HopeDamage_Order[j+1]=i
set count=count+1
set sum=sum+HopeDamage_Value(i)
endif
set i=i+1
endloop
set i=1
loop
exitwhen i>count
set id=HopeDamage_Order[i]
set name=HopeName_Label(Player(id-1),50)
set amount=HopeDamage_Value(id)
set line=I2S(i)+". "+name+" "+HopeDamage_Number(amount)
if sum>0. then
if amount/sum>=0.9995 then
set line=line+" 100%"
else
set line=line+" "+R2SW(amount/sum*100.,1,1)+"%"
endif
endif
set text=text+YDWEGetPlayerColorString(Player(id-1),line)+"|n"
set i=i+1
endloop
if count==0 then
set text="等待英雄进入本局。|n"
endif
set text=text+"|cff999999结算伤害含溢出|r"
call HopeLayout_Place(HopeDamage_Panel,0,.642,.574,.144,.051+.011*I2R(count))
call HopeLayout_Place(HopeDamage_Text,HopeDamage_Panel,.007,-.029,.130,.015+.011*I2R(count))
call HopeJob_SetText(HopeDamage_Text,text)
if HopeDamage_Run then
call HopeJob_SetText(HopeDamage_BattleButton,"本场")
call HopeJob_SetText(HopeDamage_TotalButton,"|cffffd060本局|r")
else
call HopeJob_SetText(HopeDamage_BattleButton,"|cffffd060本场|r")
call HopeJob_SetText(HopeDamage_TotalButton,"本局")
endif
endfunction
