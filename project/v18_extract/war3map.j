set HopeThird_Ability[32]='AT06'
set HopeThird_Passive[32]=false
set HopeThird_Ability[33]='AT07'
set HopeThird_Passive[33]=true
set HopeThird_Ability[34]='AT08'
set HopeThird_Passive[34]=false
set HopeThird_Ability[35]='AT09'
set HopeThird_Passive[35]=true
set HopeThird_Ability[36]='AT10'
set HopeThird_Passive[36]=false
