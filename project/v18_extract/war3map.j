function Trig____________________015Actions takes nothing returns nothing
local integer ydul_XA
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4,GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit())))
call SaveItemHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$D14F34A9,GetManipulatedItem())
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$B0497EE9,GetItemTypeId(GetManipulatedItem()))
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$B4CEFD02,LoadInteger(YDHT,GetItemTypeId(GetManipulatedItem()),$9F99B0F9))
set ydul_XA=1
loop
exitwhen ydul_XA>6
if GetItemTypeId(GetManipulatedItem())==GetItemTypeId(UnitItemInSlotBJ(GetTriggerUnit(),ydul_XA)) and UnitItemInSlotBJ(GetTriggerUnit(),ydul_XA)!=GetManipulatedItem() then
call RemoveItem(LoadItemHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$D14F34A9))
call RemoveItem(UnitItemInSlotBJ(GetTriggerUnit(),ydul_XA))
call HopeInventory_Give(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$B4CEFD02),GetTriggerUnit())
call DoNothing()
exitwhen true
else
endif
set ydul_XA=ydul_XA+1
endloop
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
