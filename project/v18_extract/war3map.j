// Pure previews of original combat expressions. Never roll, simulate damage,
// change an ability's numeric fields, or write to a gameplay hashtable.
function HopeSkill_Number takes real v returns string
if v==I2R(R2I(v)) then
return I2S(R2I(v))
endif
return R2SW(v,1,1)
endfunction

function HopeSkill_Range takes real low,real high returns string
if RAbsBJ(low-high)<.05 then
return HopeSkill_Number(low)
endif
return HopeSkill_Number(low)+"~"+HopeSkill_Number(high)
endfunction

function HopeSkill_Rolled takes unit u,integer p,real base,integer lower,integer upper returns string
local integer lo=lower+R2I(I2R(GetHeroAgi(u,true))/2.)
local integer hi=upper+GetHeroStr(u,true)
if lo>hi then
set lo=hi
endif
if LoadBoolean(YDHT,GetHandleId(u),$08E215BC) then
set hi=R2I(I2R(hi)*udg_jingque_Daji_jiacheng[p])
set lo=hi
endif
return HopeSkill_Range(base*I2R(lo)*.01*udg_Zuizhong_Dm[p]*HopeMeta_Out(p-1,true,false,false),base*I2R(hi)*.01*udg_Zuizhong_Dm[p]*HopeMeta_Out(p-1,true,false,false))
endfunction

function HopeSkill_IsDamage takes integer id returns boolean
return id=='A000' or id=='A00I' or id=='A01R' or id=='A05F' or id=='A03D' or id=='A058' or id=='A00J' or id=='A03F' or id=='A04C' or id=='A04P' or id=='A00D' or id=='A02T' or id=='A057' or id=='A00F' or id=='A03J' or id=='A04K' or id=='A00K' or id=='A059' or id=='A04W' or id=='A056' or id=='A04I' or id=='A03L' or id=='A05I' or id=='A00Q' or id=='A00L' or id=='A04U' or id=='A014' or id=='A021' or id=='A015' or id=='A01I' or id=='A01K' or id=='A045' or id=='A03Z' or id=='A03C' or id=='A03Y' or id=='A03B' or id=='A050' or id=='A01C' or id=='A04X' or id=='A054' or id=='A04Y' or id=='A00X' or id=='A02S'
endfunction

function HopeSkill_IsPotion takes integer id returns boolean
return id=='A00Y' or id=='A00Z' or id=='A010' or id=='A011' or id=='A012' or id=='A013'
endfunction

function HopeSkill_PotionDescription takes unit u returns string
local integer p=GetPlayerId(GetOwningPlayer(u))+1
local string percent="30%"
if GetUnitAbilityLevel(udg_Yiwu_danwei[p],'A049')==1 then
set percent="50%"
endif
// Inventory is authoritative. Original object text says one bottle forever,
// and several original inventory mutations never rewrite that text.
return "恢复最大生命的"+percent+"和最大魔法的50%。|n消耗1瓶；不消耗行动点与魔法；冷却1秒。|n|cffffd98a剩余药剂："+I2S(udg_Yaoshui_shenyu_cs[p])+"瓶|r"
endfunction

function HopeSkill_Preview takes unit u,integer id,integer level returns string
local integer p=GetPlayerId(GetOwningPlayer(u))+1
local real a=GetUnitState(u,ConvertUnitState(20))
local real s=I2R(GetHeroStr(u,true))
local real d=I2R(GetHeroAgi(u,true))
local real i=I2R(GetHeroInt(u,true))
local real k=udg_Skill_Dm[p]
local real f=udg_Fashang_Dm[p]
local real z=udg_Zuizhong_Dm[p]
local real l=I2R(level)
local real b=0.
local real mana=GetUnitState(u,UNIT_STATE_MANA)
local real hp=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local string result=""
set z=z*HopeMeta_Out(p-1,true,false,false)
if id=='AT03' then
return "每人恢复：自身生命上限25% + "+HopeSkill_Number(i*1.5)+"；回蓝2|n溢疗护甲上限 "+HopeSkill_Number(i*.8)
elseif id=='AT06' then
return "普通目标 "+HopeSkill_Number((s+d)*4.*k*z)+"；低血目标 "+HopeSkill_Number((s+d)*6.*k*z)+"|n击杀后返还1行动点"
elseif id=='AT08' then
return "主目标 "+HopeSkill_Number((a*4.+s*2.)*k*z)+"；贯穿副目标 "+HopeSkill_Number((a*4.+s*2.)*.7*k*z)+"|n长2000，宽240；只命中射线内敌人"
elseif id=='AT10' then
set b=(a*5.+d*3.)*k*z
if LoadBoolean(YDHT,GetHandleId(u),$08E215BC) then
set b=b*udg_jingque_Daji_jiacheng[p]
endif
if LoadInteger(YDHT,GetHandleId(u),$EE28B8AD)>0 then
set b=b*udg_Baoji_Damage[p]
return "必暴重狙 "+HopeSkill_Number(b)+"；剩余 "+I2S(LoadInteger(YDHT,GetHandleId(u),$30720CCD))+" 发|n消耗1发；空弹需Q装填，伤害不随机落空"
endif
return "单体重狙 "+HopeSkill_Number(b)+"；剩余 "+I2S(LoadInteger(YDHT,GetHandleId(u),$30720CCD))+" 发|n消耗1发；可配合爆头，伤害不随机落空"
elseif id=='AT11' then
return "区域每目标 "+HopeSkill_Number(i*4.*k*f*z)+"；范围450|n敌人下一次对英雄伤害 -50%"
elseif id=='AT13' then
return "每层自身毒基值 "+HopeSkill_Number(a*.3*I2R(GetUnitAbilityLevel(u,'A02U'))*k*z)+"|n施放时乘以目标自己的毒层；自身恢复 "+HopeSkill_Number(hp*.1)
elseif id=='AT16' then
return "全队接下来的3次命中 +25%伤害|n每次命中玩家获得10金币；1行动点、3魔法"
elseif id=='AZ36' then
return "敌人各受 "+HopeSkill_Number((s+d+i)*1.1*k*f*z)+" 法术伤害|n队友各回复 "+HopeSkill_Number((s+d+i)*.25)+"、护甲 +"+HopeSkill_Number((s+d+i)*.1)+"；气补至3"
endif
if id=='A000' then
set b=a
if GetUnitAbilityLevel(u,'A04I')>0 then
set b=b*(1.+.2*I2R(LoadInteger(YDHT,GetHandleId(u),$94AFB9D6)))
endif
return "本次伤害 "+HopeSkill_Rolled(u,p,HopeThird_Base(u,id,b,false),90,120)
elseif id=='A00I' then
set b=a
if GetUnitAbilityLevel(u,'A04I')>0 then
set b=b*(1.+.2*I2R(LoadInteger(YDHT,GetHandleId(u),$94AFB9D6)))
endif
set result="主段 "+HopeSkill_Rolled(u,p,b,90,120)
if mana>.8 then
return result+"；追加 "+HopeSkill_Number(d*(1.+.2*I2R(GetUnitAbilityLevel(u,'A00P')))*z)+"（耗1蓝）"
endif
return result+"；缺蓝，无追加段"
elseif id=='A01R' or id=='A05F' then
set b=(a+.5*s)*(1.+.15*I2R(GetUnitAbilityLevel(u,'A03M')))
if id=='A05F' then
set b=(1.2*a+s)*(1.+.15*I2R(GetUnitAbilityLevel(u,'A03M')))
endif
if GetUnitAbilityLevel(u,'A03M')>1 and udg_Zhongkan_cs[p]>=14 then
return "本次伤害 "+HopeSkill_Rolled(u,p,HopeThird_Base(u,id,b,false),50,151)+"；本次修炼力量 +1"
endif
return "本次伤害 "+HopeSkill_Rolled(u,p,HopeThird_Base(u,id,b,false),50,150)
elseif id=='A03D' then
return "本次伤害 "+HopeSkill_Rolled(u,p,HopeThird_Base(u,id,a+GetUnitState(u,ConvertUnitState(32)),false),50,150)
elseif id=='A058' then
return "伤害基值 "+HopeSkill_Number(a*.8+(s+d+i)*.9)+"；当前气 "+I2S(HopeMonk_Qi[p])+"/3"
elseif id=='A00J' then
return "本次伤害 "+HopeSkill_Rolled(u,p,1.2*a,30,200)
elseif id=='A03F' then
return "每段 "+HopeSkill_Rolled(u,p,.8*a,30,200)+" ×3段"
elseif id=='A04C' then
return "本次伤害 "+HopeSkill_Rolled(u,p,299.,99,299)
elseif id=='A04P' then
if LoadInteger(YDHT,GetHandleId(u),$30720CCD)<=0 then
return "本次装填，不造成伤害；装满 "+I2S(GetUnitAbilityLevel(u,'A04Q')+1)+" 发"
endif
return "命中伤害 "+HopeSkill_Rolled(u,p,3.*a,125,200)+"|n剩余 "+I2S(LoadInteger(YDHT,GetHandleId(u),$30720CCD))+" 发；非专注时30%落空"
elseif id=='A00D' then
return "命中参考 "+HopeSkill_Rolled(u,p,1.3*a,65+10*GetUnitAbilityLevel(u,'A00O'),110+10*GetUnitAbilityLevel(u,'A00O'))+"|n另有伤害骰1~3（自身倍率前）"
elseif id=='A04K' then
return "贯穿每目标 "+HopeSkill_Rolled(u,p,3.5*a,100+7*GetUnitAbilityLevel(u,'A00O'),150+7*GetUnitAbilityLevel(u,'A00O'))
elseif id=='A02T' or id=='A057' then
set b=.8*(a+s)
if id=='A057' then
set b=.8*(a+d)
endif
return "命中参考 "+HopeSkill_Rolled(u,p,b,80,100)+"|n另有伤害骰1~3（自身倍率前）"
elseif id=='A00F' then
return "本次伤害 "+HopeSkill_Rolled(u,p,(.5*a+i)*(1.+.1*I2R(GetUnitAbilityLevel(u,'A04V')))*f,75,120)
elseif id=='A03J' then
return "一般目标 "+HopeSkill_Rolled(u,p,HopePriest_BaseDamage(i)*f,75,120)+"；亡灵 "+HopeSkill_Rolled(u,p,HopePriest_BaseDamage(i)*1.25*f,75,120)
elseif id=='A00K' then
return "范围每目标 "+HopeSkill_Number(s*(1.+.5*l)*k*z)
elseif id=='A059' then
return "法术基值 "+HopeSkill_Number((s+d+i)*(.8+I2R(level)*.4)*(1.+I2R(HopeMonk_Qi[p])*.15))+"；治疗 "+HopeSkill_Number((s+d+i)*(.25+I2R(HopeMonk_Qi[p])*.15))+"|n当前气 "+I2S(HopeMonk_Qi[p])+"/3；消耗1行动点、3魔法"
elseif id=='A04W' then
set b=HopePriest_BaseDamage(.2*RMaxBJ(0.,mana-HopeSkill_ManaCost(id,level))+i)*k*f*z
set result="主目标 "+HopeSkill_Number(b)+"；亡灵 "+HopeSkill_Number(b*1.25)
if level==2 then
return result+"|n另1目标 "+HopeSkill_Number(b)+"；亡灵 "+HopeSkill_Number(b*1.25)
elseif level==3 then
return result+"|n最多3个次目标各 "+HopeSkill_Number(b)+"；亡灵 "+HopeSkill_Number(b*1.25)
endif
return result
elseif id=='A00Q' then
return "每目标 "+HopeSkill_Number(a*(1.+l)*k*f*z)+"；最多3个目标"
elseif id=='A056' then
return "伤害 "+HopeSkill_Number((s+d)*(2.+l)*k*z)+"；命中后护甲 -"+I2S(2+level)
elseif id=='A04U' then
set b=i*(1.5+1.5*l)*k*f*z
return "无火种主目标 "+HopeSkill_Number(b)+"；周围每目标 "+HopeSkill_Number(b*.5)+"|n觉醒后额外火种伤害按目标自己的层数结算"
elseif id=='A04I' then
set b=s*.5*l*k*z
return "速度1时 "+HopeSkill_Number(b)+"；速度8时 "+HopeSkill_Number(b*8.)+"|n按碰撞时速度结算；同一目标一次"
elseif id=='A00L' then
set b=i*(2.+l)*k*f*z
if GetUnitAbilityLevel(u,'A03G')>0 then
set b=b*(1.+.2*I2R(GetUnitAbilityLevel(u,'A01D')))
endif
return "范围每目标 "+HopeSkill_Number(b)
elseif id=='A002' or id=='A00E' or id=='A05C' or id=='A053' then
set b=10.+udg_Defend_fangyu[p]
if id=='A00E' then
set b=10.+3.*udg_Defend_fangyu[p]
elseif id=='A05C' then
return "全队各获护甲 "+HopeSkill_Number((s+d+i)*(.10+I2R(HopeMonk_Qi[p])*.03)+udg_Defend_fangyu[p])+"；当前气 "+I2S(HopeMonk_Qi[p])+"/3|n消耗1行动点、2魔法，每回合一次"
elseif id=='A053' then
set b=8.+udg_Defend_fangyu[p]
endif
return "本次护甲 +"+HopeSkill_Number(b)+"；施放后 "+HopeSkill_Number(GetUnitState(u,ConvertUnitState(32))+b)
elseif id=='A01T' then
return "每名存活队员护甲 +"+HopeSkill_Number(i*.3)
elseif id=='A03L' or id=='A05I' then
set b=.55*(a+d)*k*(1.+d/200.)*z
if id=='A05I' then
return "每段 "+HopeSkill_Number(b)+" ×5段；各段额外暴击率10~50%"
endif
return "每段 "+HopeSkill_Number(b)+"；随机4~7段，随机选择敌人"
elseif id=='A014' then
return "本次伤害 "+HopeSkill_Number(GetUnitState(u,ConvertUnitState(32))*5.*k*z)
elseif id=='A015' then
return "每目标 "+HopeSkill_Number(i*4.*k*f*z)+"；最多4个目标"
elseif id=='A01I' then
return "下一枚 "+HopeSkill_Number(d*4./Pow(2.,I2R(LoadInteger(YDHT,GetHandleId(u),$146EFD45)))*k*(1.+d/100.)*z)+"；本回合每次减半"
elseif id=='A01K' then
return "一般目标 "+HopeSkill_Number(s*4.*k*z)+"；打断防御/加攻 "+HopeSkill_Number(s*8.*k*z)
elseif id=='A045' then
return "暴击前 "+HopeSkill_Number((5.*d+2.*a)*k*(1.+d/100.)*z)+"；必暴后 "+HopeSkill_Number((5.*d+2.*a)*k*(1.+d/100.)*z*udg_Baoji_Damage[p])
elseif id=='A021' then
return "范围每目标 "+HopeSkill_Number(s*3.5*k*z)
elseif id=='A03B' then
return "箭体每目标 "+HopeSkill_Number(d*1.5*k*(1.+d/100.)*z)+"；额外箭矢由原生弹幕结算"
elseif id=='A01C' then
return "光束每目标 "+HopeSkill_Number(i*6.*k*f*z)
elseif id=='A03Z' then
return "每颗命中 "+HopeSkill_Number(i*3.*k*z)+"；6颗随机落点，可能落空"
elseif id=='A03C' then
return "本次伤害 "+HopeSkill_Range(a*5.*k*z*.01,a*5.*k*z*3.)+"；不受专注改变浮动"
elseif id=='A03Y' then
return "按当前剩余魔法预估 "+HopeSkill_Number(s*7.5*(1.+RMaxBJ(0.,mana-HopeSkill_ManaCost(id,level))*.04)*k*z)+"|n命中时重新读取魔法；施放后耗尽"
elseif id=='A04X' then
return "伤害 "+HopeSkill_Number(a*k*z)+"；护甲 +"+HopeSkill_Number(10.+udg_Defend_fangyu[p])
elseif id=='A054' then
return "每段 "+HopeSkill_Number(a*.85*k*z)+" ×2段"
elseif id=='A04Y' then
return "波形基础 "+HopeSkill_Number(a*1.25*z)+"；命中由原生波形判定"
elseif id=='A050' then
return "范围每目标 "+HopeSkill_Number(a*1.5*k*z)
elseif id=='A00X' then
return "本次伤害 "+HopeSkill_Number(i*1.5*(k+i/200.)*z)
elseif id=='A02S' then
return "本次伤害 "+HopeSkill_Number(GetUnitState(u,ConvertUnitState(21))*z)
elseif id=='A01S' then
return "本次力量 +"+I2S(R2I(s/5.)*level)+"（15秒）；护甲 -10"
elseif id=='A01H' then
return "本次回蓝 "+HopeSkill_Number(RMinBJ(RMaxBJ(0.,GetUnitState(u,UNIT_STATE_MAX_MANA)-mana),3.+i/5.))+"；临时智力 +"+I2S(R2I(i*.3))+"；行动点 -1；魔法上限不变"
elseif id=='A01J' then
return "行动点 +2；护甲 -999；不直接造成伤害"
elseif id=='A01O' then
return "目标护甲非负时 -15；不直接造成伤害"
elseif id=='A04R' then
return "下一次混乱类型伤害必暴；当前暴伤 "+HopeSkill_Number(udg_Baoji_Damage[p]*100.)+"%"
elseif id=='A00N' then
if udg_Yaoshui_shenyu_cs[p]<=0 then
return "剩余药剂 "+I2S(udg_Yaoshui_shenyu_cs[p])+" 瓶；药剂不足，当前无法治疗"
endif
return "自身治疗上限 "+HopeSkill_Number(hp*.25+i)+"；每名队友为其生命上限25% +"+HopeSkill_Number(i)+"|n剩余药剂 "+I2S(udg_Yaoshui_shenyu_cs[p])+" 瓶；实际不超过缺失生命"
elseif HopeSkill_IsPotion(id) then
if udg_Yaoshui_shenyu_cs[p]<=0 then
return "药剂不足，当前无法恢复生命或魔法"
endif
set b=.3
if GetUnitAbilityLevel(udg_Yiwu_danwei[p],'A049')==1 then
set b=.5
endif
return "当前可恢复生命 "+HopeSkill_Number(RMaxBJ(0.,RMinBJ(hp-GetWidgetLife(u),hp*b)))+" / 魔法 "+HopeSkill_Number(RMaxBJ(0.,RMinBJ(GetUnitState(u,UNIT_STATE_MAX_MANA)-mana,GetUnitState(u,UNIT_STATE_MAX_MANA)*.5)))
elseif id=='A01N' then
return "原生加攻30%，持续30秒；按自身当前攻击折算 +"+HopeSkill_Number(a*.3)+"|n实际加成由目标原生攻击与增益叠加规则决定"
elseif id=='A051' then
return "原生加攻15%，持续30秒；按自身当前攻击折算 +"+HopeSkill_Number(a*.15)+"|n实际加成由目标原生攻击与增益叠加规则决定"
elseif id=='A052' then
return "900范围原生攻击光环10%；按自身当前攻击折算 +"+HopeSkill_Number(a*.1)
elseif id=='A05B' then
return "每场胜利恢复20生命；不超过缺失生命"
elseif id=='A020' then
return "装备后暴击率 +15%，暴伤 +50%；当前 "+I2S(udg_Baoji_Lv[p])+"% / "+HopeSkill_Number(udg_Baoji_Damage[p]*100.)+"%"
elseif id=='A01D' then
return "装备后法术 +30%，技能 +20%；当前倍率 "+HopeSkill_Number(f*100.)+"% / "+HopeSkill_Number(k*100.)+"%"
elseif id=='A02U' then
return "每层每个敌方回合的毒伤基值 "+HopeSkill_Number(a*.3*l)+"；各来源独立结算，未计最终倍率与目标减伤"
elseif id=='A001' then
return "结束后护甲 +"+HopeSkill_Number(udg_Defend_HUIHE[p])+"；交出剩余 "+I2S(udg_xingdong_dian[p])+" 行动点"
endif
return ""
endfunction

function HopeSkill_Key takes integer id,integer level returns integer
// All supported rawcodes are A000..A05Z, levels 1..10: exact, no hash collision.
return (id-'A000')*32+level
endfunction

function HopeSkill_Invalidate takes unit u,integer id,integer currentHandle returns nothing
local integer level=1
local integer key=0
loop
exitwhen level>10
set key=HopeSkill_Key(id,level)
call RemoveSavedString(HopeSkill_Rendered,GetHandleId(u),key)
// Preserve a freshly supplied original description for the NEW ability.
if LoadInteger(HopeSkill_Base,GetHandleId(u),key)!=currentHandle then
call RemoveSavedString(HopeSkill_Base,GetHandleId(u),key)
call RemoveSavedInteger(HopeSkill_Base,GetHandleId(u),key)
endif
set level=level+1
endloop
endfunction

function HopeSkill_RefreshOne takes unit u,integer id,ability a returns nothing
local integer level=GetUnitAbilityLevel(u,id)
local integer h=GetHandleId(u)
local integer key=HopeSkill_Key(id,level)
local string base=""
local string preview=""
local string rendered=""
if level<=0 or a==null then
return
endif
set preview=HopeSkill_Preview(u,id,level)
if preview=="" then
return
endif
set base=HopeSkill_Original(id,level)
if HopeSkill_IsPotion(id) then
set base=HopeSkill_PotionDescription(u)
elseif id!='A02U' and id!='A03L' and id!='A05I' and HaveSavedString(HopeSkill_Base,h,key) then
set base=LoadStr(HopeSkill_Base,h,key)
endif
set rendered=base+"|r|n|n|cffffd98a当前预估|r|n"+preview
if HopeSkill_IsDamage(id) then
set rendered=rendered+"|n局外猎王仅对BOSS、会心训练仅对暴击生效；此预估为普通目标非暴击。"
if id=='A045' then
set rendered=rendered+"|n|cffbbbbbb已计自身加成；仅必暴后计入暴击。目标减伤与追击另算。|r"
else
set rendered=rendered+"|n|cffbbbbbb已计自身加成；非暴击、目标减伤前。额外追击另算。|r"
endif
endif
if LoadStr(HopeSkill_Rendered,h,key)!=rendered then
if EXSetAbilityDataString(a,level,218,rendered) then
call SaveStr(HopeSkill_Rendered,h,key,rendered)
endif
endif
endfunction

function HopeSkill_Refresh takes nothing returns nothing
local integer p=1
local integer index=0
local integer slot=0
local integer level=0
local integer abilityHandleId=0
local unit u=null
local ability a=null
if HopeSkill_Base==null or HopeSkill_Rendered==null then
return
endif
// This entry point MUST be called synchronously, before any local UI gates.
// Acquire handles in identical order on all clients, including foreign heroes.
loop
exitwhen p>6
set u=udg_hero[p]
if HopeSkill_LastHero[p]!=u then
if HopeSkill_LastHero[p]!=null then
call FlushChildHashtable(HopeSkill_Base,GetHandleId(HopeSkill_LastHero[p]))
call FlushChildHashtable(HopeSkill_Rendered,GetHandleId(HopeSkill_LastHero[p]))
endif
set HopeSkill_LastHero[p]=u
set index=0
loop
exitwhen index>=HopeSkill_Count
set HopeSkill_LastHandle[p*80+index]=0
set HopeSkill_LastLevel[p*80+index]=0
set index=index+1
endloop
endif
if u!=null and GetUnitTypeId(u)!=0 then
set index=0
loop
exitwhen index>=HopeSkill_Count
set slot=p*80+index
set level=GetUnitAbilityLevel(u,HopeSkill_Ids[index])
set abilityHandleId=0
set a=null
if level>0 then
set a=EXGetUnitAbility(u,HopeSkill_Ids[index])
set abilityHandleId=GetHandleId(a)
endif
if HopeSkill_LastHandle[slot]!=abilityHandleId or HopeSkill_LastLevel[slot]!=level then
call HopeSkill_Invalidate(u,HopeSkill_Ids[index],abilityHandleId)
set HopeSkill_LastHandle[slot]=abilityHandleId
set HopeSkill_LastLevel[slot]=level
endif
if a!=null then
if GetOwningPlayer(u)==GetLocalPlayer() then
call HopeSkill_RefreshOne(u,HopeSkill_Ids[index],a)
endif
endif
set index=index+1
endloop
endif
set p=p+1
endloop
set a=null
set u=null
endfunction

function HopeSkill_Init takes nothing returns nothing
// Called on every client before any original initialization action.
set HopeSkill_Base=InitHashtable()
set HopeSkill_Rendered=InitHashtable()
call HopeSkill_InitIds()
endfunction

function YDWESetUnitAbilityDataReal takes unit u,integer abilcode,integer level,integer data_type,real value returns boolean
return EXSetAbilityDataReal(EXGetUnitAbility(u,abilcode),level,data_type,value)
endfunction
function YDWESetUnitAbilityDataString takes unit u,integer abilcode,integer level,integer data_type,string value returns boolean
local ability hopeSkillAbility=EXGetUnitAbility(u,abilcode)
local boolean hopeSkillResult=false
local integer hopeSkillKey=0
if data_type==218 and HopeSkill_IsPotion(abilcode) then
set value=HopeSkill_PotionDescription(u)
endif
if data_type==218 and HopeSkill_Base!=null and hopeSkillAbility!=null and HopeSkill_Supported(abilcode) then
set hopeSkillKey=HopeSkill_Key(abilcode,level)
call SaveStr(HopeSkill_Base,GetHandleId(u),hopeSkillKey,value)
call SaveInteger(HopeSkill_Base,GetHandleId(u),hopeSkillKey,GetHandleId(hopeSkillAbility))
call RemoveSavedString(HopeSkill_Rendered,GetHandleId(u),hopeSkillKey)
endif
set hopeSkillResult=EXSetAbilityDataString(hopeSkillAbility,level,data_type,value)
set hopeSkillAbility=null
return hopeSkillResult
endfunction
function YDWEGetItemDataString takes integer itemcode,integer data_type returns string
return EXGetItemDataString(itemcode,data_type)
endfunction
function YDWEH2I takes handle h returns integer
return GetHandleId(h)
endfunction
function YDWEFlushMissionByString takes string s returns nothing
call FlushChildHashtable(YDHT,StringHash(s))
endfunction
function YDWEFlushStoredIntegerByString takes string s1,string s2 returns nothing
call RemoveSavedInteger(YDHT,StringHash(s1),StringHash(s2))
endfunction
function YDWEHaveSavedIntegerByString takes string s1,string s2 returns boolean
return HaveSavedInteger(YDHT,StringHash(s1),StringHash(s2))
endfunction
function YDWESaveIntegerByString takes string pTable,string pKey,integer i returns nothing
call SaveInteger(YDHT,StringHash(pTable),StringHash(pKey),i)
endfunction
function YDWEGetIntegerByString takes string pTable,string pKey returns integer
return LoadInteger(YDHT,StringHash(pTable),StringHash(pKey))
endfunction
function YDWESaveRealByString takes string pTable,string pKey,real r returns nothing
call SaveReal(YDHT,StringHash(pTable),StringHash(pKey),r)
endfunction
function YDWEGetRealByString takes string pTable,string pKey returns real
return LoadReal(YDHT,StringHash(pTable),StringHash(pKey))
endfunction
function YDWESaveUnitByString takes string pTable,string pKey,unit u returns nothing
call SaveUnitHandle(YDHT,StringHash(pTable),StringHash(pKey),u)
endfunction
function YDWEGetUnitByString takes string pTable,string pKey returns unit
return LoadUnitHandle(YDHT,StringHash(pTable),StringHash(pKey))
endfunction
function YDWECoordinateX takes real x returns real
return RMinBJ(RMaxBJ(x,yd_MapMinX),yd_MapMaxX)
endfunction
function YDWECoordinateY takes real y returns real
return RMinBJ(RMaxBJ(y,yd_MapMinY),yd_MapMaxY)
endfunction
function YDWEDistanceBetweenUnits takes unit a,unit b returns real
return SquareRoot((GetUnitX(a)-GetUnitX(b))*(GetUnitX(a)-GetUnitX(b))+(GetUnitY(a)-GetUnitY(b))*(GetUnitY(a)-GetUnitY(b)))
endfunction
function YDWEAngleBetweenUnits takes unit fromUnit,unit toUnit returns real
return bj_RADTODEG*Atan2(GetUnitY(toUnit)-GetUnitY(fromUnit),GetUnitX(toUnit)-GetUnitX(fromUnit))
endfunction
function YDWEFlyEnable takes unit u returns nothing
call UnitAddAbility(u,$416D7266)
call UnitRemoveAbility(u,$416D7266)
endfunction
function YDWESyStemAbilityCastingOverTriggerAction takes unit hero,integer index returns nothing
local integer i=0
loop
exitwhen i>=YDWEBase__AbilityCastingOverEventNumber
if YDWEBase__AbilityCastingOverEventType[i]==index then
set bj_lastAbilityCastingUnit=hero
if YDWEBase__AbilityCastingOverEventQueue[i]!=null and TriggerEvaluate(YDWEBase__AbilityCastingOverEventQueue[i]) and IsTriggerEnabled(YDWEBase__AbilityCastingOverEventQueue[i]) then
call TriggerExecute(YDWEBase__AbilityCastingOverEventQueue[i])
endif
endif
set i=i+1
endloop
endfunction
function YDWEPlaceRandomItem takes itempool ip,real x,real y returns nothing
set bj_lastPoolAbstractedItem=PlaceRandomItem(ip,x,y)
endfunction
function YDWEGetLastPoolAbstractedItem takes nothing returns item
return bj_lastPoolAbstractedItem
endfunction
function YDWEGetPlayerColorString takes player p,string s returns string
return YDWEBase__yd_PlayerColor[GetHandleId(GetPlayerColor(p))]+s+"|r"
endfunction
function HopeUI_PlayerText takes player p,string text returns string
local integer color=GetHandleId(GetPlayerColor(p))
local string prefix=YDWEBase__yd_PlayerColor[color]
if color==0 then
set prefix="|cffff6b6b"
elseif color==1 then
set prefix="|cff719fff"
elseif color==3 then
set prefix="|cffbf80ef"
elseif color==10 then
set prefix="|cff6fbea0"
elseif color==11 then
set prefix="|cffc79365"
elseif color>=12 then
set prefix="|cffa8a8a8"
endif
return prefix+text+"|r"
endfunction
function HopeEvent_Write takes player p,string text,boolean colored returns nothing
local integer at=0
local integer step=1
local integer width=0
local integer next=0
local string line=""
local string c=""
loop
exitwhen at>=StringLength(text)
set step=HopeName_Step(text,at)
set c=SubString(text,at,at+step)
set next=width+HopeName_CharWidth(c)
if next>260 and line!="" then
if colored then
call HopeEvent_Add(HopeUI_PlayerText(p,line))
else
call HopeEvent_Add(line)
endif
set line=""
set width=0
endif
set line=line+c
set width=width+HopeName_CharWidth(c)
set at=at+step
endloop
if line!="" then
if colored then
call HopeEvent_Add(HopeUI_PlayerText(p,line))
else
call HopeEvent_Add(line)
endif
endif
endfunction
function HopeEvent_Result takes player p,string result returns nothing
call HopeEvent_Write(p,HopeName_Clean(GetPlayerName(p))+"："+result,true)
endfunction

function YDWEVersion_Display takes nothing returns boolean
call DisplayTimedTextToPlayer(GetTriggerPlayer(),0,0,30,"|cffffd27aAI爬塔|r")
return false
endfunction
function YDWEVersion_Init takes nothing returns nothing
local trigger t=CreateTrigger()
local integer i=0
loop
exitwhen i==12
call TriggerRegisterPlayerChatEvent(t,Player(i),"YDWE Version",true)
set i=i+1
endloop
call TriggerAddCondition(t,Condition(function YDWEVersion_Display))
set t=null
endfunction
function InitializeYD takes nothing returns nothing
set YDHT=InitHashtable()
set yd_MapMinX=GetCameraBoundMinX()-GetCameraMargin(CAMERA_MARGIN_LEFT)
