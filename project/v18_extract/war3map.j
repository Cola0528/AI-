function Trig____________________018Func004Func017Func002A takes nothing returns nothing
call SaveUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2,udg_hero[GetConvertedPlayerId(GetEnumPlayer())])
if GetRandomInt(1,100)<=GetHeroAgi(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),true) then
call HopeEvent_Write(GetEnumPlayer(),HopeName_Clean(GetPlayerName(GetEnumPlayer())),true)
call HopeEvent_Write(GetEnumPlayer(),"身手敏捷躲开了机关！没有受到伤害",false)
call HopeEvent_Write(GetEnumPlayer(),"吓出一身冷汗同时感觉自己的敏捷增加了1点",true)
call ModifyHeroStat(bj_HEROSTAT_AGI,LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),bj_MODIFYMETHOD_ADD,1)
else
if GetRandomInt(1,100)<=50 then
call HopeEvent_Write(GetEnumPlayer(),HopeName_Clean(GetPlayerName(GetEnumPlayer())),true)
call HopeEvent_Write(GetEnumPlayer(),"没躲开机关受了伤",false)
call HopeEvent_Write(GetEnumPlayer()," HP-30",true)
if GetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),UNIT_STATE_LIFE)>31. then
call SetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2))-30.)
else
call SetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),UNIT_STATE_LIFE,1.)
endif
else
call HopeEvent_Write(GetEnumPlayer(),HopeName_Clean(GetPlayerName(GetEnumPlayer())),true)
call HopeEvent_Write(GetEnumPlayer(),"躲开了机关但是用力过猛撞到了头",false)
call HopeEvent_Write(GetEnumPlayer(),"HP-10 智力-1",true)
call ModifyHeroStat(bj_HEROSTAT_INT,LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),bj_MODIFYMETHOD_SUB,1)
if GetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),UNIT_STATE_LIFE)>11. then
call SetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),UNIT_STATE_LIFE,GetUnitStateSwap(UNIT_STATE_LIFE,LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2))-10.)
else
call SetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7),$911D5DC2),UNIT_STATE_LIFE,1.)
endif
endif
endif
call TriggerSleepAction(.5)
endfunction
