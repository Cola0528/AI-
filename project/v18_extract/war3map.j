// Separate spell tokens prevent cooldown resets from granting extra casts.
function HopeHidden_Stage takes unit u returns integer
local integer kind=GetUnitTypeId(u)
if kind=='HZ01' then
return 1
elseif kind=='HZ02' then
return 2
elseif kind=='HZ03' then
return 3
endif
return 0
endfunction
function HopeHidden_HealAmount takes unit u returns real
local real maximum=GetUnitState(u,UNIT_STATE_MAX_LIFE)
local real total=I2R(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))
return RMaxBJ(0.,RMinBJ(maximum-GetWidgetLife(u),RMinBJ(maximum*.30,15.+total*.5)))
endfunction
function HopeHidden_DrainHealing takes unit u,real before,real after returns real
local real actual=RMaxBJ(0.,RMinBJ(before,before-RMaxBJ(0.,after)))
local real maximum=GetUnitState(u,UNIT_STATE_MAX_LIFE)
return RMaxBJ(0.,RMinBJ(maximum-GetWidgetLife(u),RMinBJ(maximum*.15,actual*.25)))
endfunction
function HopeHidden_Cast takes unit u,integer aid,unit target returns nothing
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)+1
local integer stage=HopeHidden_Stage(u)
local integer token=HopeChallenge_TurnToken()+1
local real amount=0.
local real before=0.
if i<1 or i>6 or u!=udg_hero[i] or stage==0 or GetWidgetLife(u)<=.405 or IsUnitPaused(u) or not udg_ZhandouZhong then
call DisplayTimedTextToPlayer(p,0,0,4.,"隐藏职业技能只能由当前英雄在自己的战斗回合使用。")
set p=null
return
endif
if aid=='AZHR' then
set amount=HopeHidden_HealAmount(u)
if amount<=0. then
call DisplayTimedTextToPlayer(p,0,0,4.,"三相回元：生命已满，不消耗资源。")
elseif HopeHidden_LastHeal[i]==token then
call DisplayTimedTextToPlayer(p,0,0,4.,"三相回元每回合只能使用一次。")
elseif udg_xingdong_dian[i]<1 or GetUnitState(u,UNIT_STATE_MANA)<2. then
call DisplayTimedTextToPlayer(p,0,0,4.,"三相回元需要1行动点、2魔法。")
else
set HopeHidden_LastHeal[i]=token
set udg_xingdong_dian[i]=udg_xingdong_dian[i]-1
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-2.)
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+amount)
call HopeThird_HiddenAction(u,aid)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",u,"origin"))
call DisplayTimedTextToPlayer(p,0,0,4.,"三相回元：恢复 "+R2S(amount)+" 生命。")
endif
elseif aid=='AZHD' then
if stage<2 then
call DisplayTimedTextToPlayer(p,0,0,4.,"万象汲取需要完成隐藏二转。")
elseif target==null or not IsUnitInGroup(target,udg_Guaiwu_dwz) or not IsUnitEnemy(target,p) or GetWidgetLife(target)<=.405 then
call DisplayTimedTextToPlayer(p,0,0,4.,"万象汲取：请选择当前战斗中存活的敌人。")
elseif HopeHidden_LastDrain[i]==token then
call DisplayTimedTextToPlayer(p,0,0,4.,"万象汲取每回合只能使用一次。")
elseif udg_xingdong_dian[i]<2 or GetUnitState(u,UNIT_STATE_MANA)<3. then
call DisplayTimedTextToPlayer(p,0,0,4.,"万象汲取需要2行动点、3魔法。")
else
set HopeHidden_LastDrain[i]=token
set udg_xingdong_dian[i]=udg_xingdong_dian[i]-2
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-3.)
set before=GetWidgetLife(target)
set amount=I2R(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))*1.75*udg_Skill_Dm[i]*udg_Fashang_Dm[i]
// The original damage callback applies final multiplier, criticals and resistance.
call UnitDamageTarget(u,target,amount,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
set amount=HopeHidden_DrainHealing(u,before,GetWidgetLife(target))
if GetWidgetLife(u)>.405 and amount>0. then
call SetUnitState(u,UNIT_STATE_LIFE,GetWidgetLife(u)+amount)
call HopeThird_HiddenAction(u,aid)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",u,"origin"))
endif
call DisplayTimedTextToPlayer(p,0,0,4.,"万象汲取：实际吸取 "+R2S(amount)+" 生命。")
endif
endif
set p=null
endfunction

function HopeThird_Cast takes unit u,integer aid,unit target returns nothing
local player owner=GetOwningPlayer(u)
local integer p=GetPlayerId(owner)+1
local integer token=HopeChallenge_TurnToken()
local integer ap=2
local integer j=1
local integer bullets=0
local real amount=0.
local real cx=GetUnitX(u)
local real cy=GetUnitY(u)
local real tx=0.
local real ty=0.
local real dx=0.
local real dy=0.
local real length=0.
local real along=0.
local real across=0.
local real missing=0.
local group g=null
local unit enemy=null
if p<1 or p>6 or u!=udg_hero[p] or not HopeJob_Awakened[p] or HopeThird_Ability[HopeJob_AwakenOption[p]]!=aid or GetUnitAbilityLevel(u,aid)<=0 or GetWidgetLife(u)<=.405 or IsUnitPaused(u) then
set owner=null
return
endif
if aid=='AT16' then
set ap=1
endif
if not udg_ZhandouZhong or udg_xingdong_dian[p]<ap or GetUnitState(u,UNIT_STATE_MANA)<3. or HopeJob_LastCast[p]==token then
call DisplayTimedTextToPlayer(owner,0,0,3.,"觉醒技能：战斗中每回合一次；行动点或魔法不足，或已经使用。")
set owner=null
return
endif
if aid!='AT03' and not HopeThird_Enemy(target,owner) then
call DisplayTimedTextToPlayer(owner,0,0,3.,"请选择存活的当前敌人。")
set owner=null
return
endif
if aid=='AT10' then
set bullets=LoadInteger(YDHT,GetHandleId(u),$30720CCD)
if bullets<=0 then
call DisplayTimedTextToPlayer(owner,0,0,3.,"子弹不足：请先用Q装填，再使用绝命狙击。")
set owner=null
return
endif
elseif aid=='AT13' and HopeStatus_PoisonSourceBase(target,p-1)<=0. then
call DisplayTimedTextToPlayer(owner,0,0,3.,"目标没有自己的有效毒层，请先用毒矛叠毒。")
set owner=null
return
elseif aid=='AT08' then
set dx=GetUnitX(target)-cx
set dy=GetUnitY(target)-cy
set length=SquareRoot(dx*dx+dy*dy)
if length<1. or length>2000. then
call DisplayTimedTextToPlayer(owner,0,0,3.,"贯城重弩：请选择2000距离内、与自己位置不同的敌人。")
set owner=null
return
endif
set dx=dx/length
set dy=dy/length
endif
set udg_xingdong_dian[p]=udg_xingdong_dian[p]-ap
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-3.)
set HopeJob_LastCast[p]=token
if aid=='AT03' then
loop
exitwhen j>6
set enemy=udg_hero[j]
if enemy!=null and GetWidgetLife(enemy)>.405 and IsUnitAlly(enemy,owner) then
set amount=GetUnitState(enemy,UNIT_STATE_MAX_LIFE)*.25+I2R(GetHeroInt(u,true))*1.5
set missing=RMaxBJ(0.,GetUnitState(enemy,UNIT_STATE_MAX_LIFE)-GetWidgetLife(enemy))
call HopeThird_Heal(enemy,amount,false)
call SetUnitState(enemy,ConvertUnitState(32),GetUnitState(enemy,ConvertUnitState(32))+RMinBJ(I2R(GetHeroInt(u,true))*.8,RMaxBJ(0.,amount-missing)*.5))
call SetUnitState(enemy,UNIT_STATE_MANA,RMinBJ(GetUnitState(enemy,UNIT_STATE_MAX_MANA),GetUnitState(enemy,UNIT_STATE_MANA)+2.))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",enemy,"origin"))
endif
set j=j+1
endloop
elseif aid=='AT06' then
set amount=I2R(GetHeroStr(u,true)+GetHeroAgi(u,true))*4.*udg_Skill_Dm[p]
if GetWidgetLife(target)<=GetUnitState(target,UNIT_STATE_MAX_LIFE)*.4 then
set amount=amount*1.5
endif
call UnitDamageTarget(u,target,amount,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
if GetWidgetLife(target)<=.405 then
call HopeThird_Refund(p)
endif
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Orc\\CriticalStrike\\CriticalStrike.mdl",target,"origin"))
elseif aid=='AT10' then
call SaveInteger(YDHT,GetHandleId(u),$30720CCD,bullets-1)
if LoadTextTagHandle(YDHT,GetHandleId(u),$2CCE269)!=null then
call SetTextTagTextBJ(LoadTextTagHandle(YDHT,GetHandleId(u),$2CCE269),I2S(bullets-1)+"/"+I2S(GetUnitAbilityLevel(u,'A04Q')+1),12.)
endif
set amount=(GetUnitState(u,ConvertUnitState(20))*5.+I2R(GetHeroAgi(u,true))*3.)*udg_Skill_Dm[p]
if LoadBoolean(YDHT,GetHandleId(u),$08E215BC) then
set amount=amount*udg_jingque_Daji_jiacheng[p]
call SaveBoolean(YDHT,GetHandleId(u),$08E215BC,false)
endif
// Chaos attack matches Q so the original headshot flag is consumed by this hit.
call UnitDamageTarget(u,target,amount,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Rifle\\RifleImpact.mdl",target,"origin"))
elseif aid=='AT13' then
set amount=HopeStatus_PoisonSourceBase(target,p-1)*udg_Skill_Dm[p]
call UnitDamageTarget(u,target,amount,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call HopeThird_Heal(u,GetUnitState(u,UNIT_STATE_MAX_LIFE)*.1,false)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",target,"origin"))
elseif aid=='AT16' then
call HopeThird_Put(GetHandleId(target),102,3)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\HowlOfTerror\\HowlTarget.mdl",target,"origin"))
elseif aid=='AT08' or aid=='AT11' then
set tx=GetUnitX(target)
set ty=GetUnitY(target)
set g=CreateGroup()
call GroupAddGroup(udg_Guaiwu_dwz,g)
loop
set enemy=FirstOfGroup(g)
exitwhen enemy==null
call GroupRemoveUnit(g,enemy)
if HopeThird_Enemy(enemy,owner) then
if aid=='AT08' then
set along=(GetUnitX(enemy)-cx)*dx+(GetUnitY(enemy)-cy)*dy
set across=RAbsBJ((GetUnitX(enemy)-cx)*dy-(GetUnitY(enemy)-cy)*dx)
if along>=0. and along<=2000. and across<=120. then
set amount=(GetUnitState(u,ConvertUnitState(20))*4.+I2R(GetHeroStr(u,true))*2.)*udg_Skill_Dm[p]
if enemy!=target then
set amount=amount*.7
endif
call UnitDamageTarget(u,enemy,amount,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Weapons\\Arrow\\ArrowMissile.mdl",enemy,"origin"))
endif
else
set along=GetUnitX(enemy)-tx
set across=GetUnitY(enemy)-ty
if along*along+across*across<=202500. then
call HopeThird_Put(GetHandleId(enemy),101,1)
call UnitDamageTarget(u,enemy,I2R(GetHeroInt(u,true))*4.*udg_Skill_Dm[p]*udg_Fashang_Dm[p],false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\FrostNova\\FrostNovaTarget.mdl",enemy,"origin"))
endif
endif
endif
endloop
call DestroyGroup(g)
endif
set enemy=null
set g=null
set owner=null
endfunction

function HopeJob_Cast takes nothing returns nothing
local integer aid=GetSpellAbilityId()
local unit u=GetTriggerUnit()
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)+1
local integer kind=0
local integer stage=0
local integer token=HopeChallenge_TurnToken()
local integer j=1
local real amount=0.
local real factor=1.
local unit target=GetSpellTargetUnit()
local group g=null
if i<1 or i>6 or u!=udg_hero[i] or GetWidgetLife(u)<=.405 or IsUnitPaused(u) then
set u=null
set target=null
set p=null
return
endif
if aid=='AT03' or aid=='AT06' or aid=='AT08' or aid=='AT10' or aid=='AT11' or aid=='AT13' or aid=='AT16' then
call HopeThird_Cast(u,aid,target)
elseif aid=='AZ36' then
call HopeMonk_Cast(u,aid,target)
elseif aid=='AZHR' or aid=='AZHD' then
call HopeHidden_Cast(u,aid,target)
elseif aid=='AZHA' or aid=='AZH2' or aid=='AZH3' then
if GetUnitTypeId(u)=='HZ01' then
set amount=GetUnitState(u,ConvertUnitState(20))*.60+I2R(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))*.45
elseif GetUnitTypeId(u)=='HZ02' then
set amount=GetUnitState(u,ConvertUnitState(20))*.65+I2R(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))*.65
elseif GetUnitTypeId(u)=='HZ03' then
set amount=GetUnitState(u,ConvertUnitState(20))*.70+I2R(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))*.80
else
set u=null
set target=null
set p=null
return
endif
if not udg_ZhandouZhong or udg_xingdong_dian[i]<1 or target==null or not IsUnitInGroup(target,udg_Guaiwu_dwz) or GetWidgetLife(target)<=.405 then
call DisplayTimedTextToPlayer(p,0,0,4.,"三相打击：需要战斗中、1行动点和存活的当前敌人。")
else
set udg_xingdong_dian[i]=udg_xingdong_dian[i]-1
call HopeThird_HiddenAction(u,aid)
call UnitDamageTarget(u,target,amount*udg_Skill_Dm[i],true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl",target,"origin"))
endif
endif
set g=null
set target=null
set u=null
set p=null
endfunction
function HopeJob_Learn takes nothing returns nothing
local unit u=GetTriggerUnit()
local integer i=GetPlayerId(GetOwningPlayer(u))+1
local integer kind=GetUnitTypeId(u)
if i>=1 and i<=6 and u==udg_hero[i] and GetLearnedSkill()=='AZHP' and (kind=='HZ01' or kind=='HZ02' or kind=='HZ03') then
call HopeJob_AddStats(i,2,2,2)
endif
set u=null
endfunction
