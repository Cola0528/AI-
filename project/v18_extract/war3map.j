function HopeRoute_Depart takes player p returns boolean
local unit node=HopeRoute_Node
if HopeRoute_Assigning or GetPlayerId(p)!=HopeRoute_Leader() or udg_ZhandouZhong or not HopeRoute_Valid() then
set node=null
return false
endif
if not HopeRoute_AllReady() then
call DisplayTextToPlayer(p,0,0,"尚不能出发：|n"+HopeRoute_Status())
set node=null
return false
endif
// Consume proposal before transition; stale/repeated clicks cannot enter twice.
set HopeMarket_InRoom=false
set HopeRoute_Node=null
call HopeRoute_ClearMarker()
call HopeRoute_ClearReady()
call SaveBoolean(YDHT,GetHandleId(node),$C31B86D5,false)
call SetUnitVertexColorBJ(node,50.,0.,0.,0.)
call YDWETimerDestroyEffect(2.,AddSpecialEffectTarget("Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl",node,"origin"))
set udg_Youxi_xzgq=node
call GroupAddUnitSimple(node,udg_zouguo_luxian)
set udg_boci=udg_boci+1
call ConditionalTriggerExecute(gg_trg______________011)
call ForGroupBJ(YDWEGetUnitsOfPlayerAllNull(Player(PLAYER_NEUTRAL_PASSIVE)),function Trig______________012Func001Func008A)
set node=null
return true
endfunction
function HopeRoute_DepartClick takes nothing returns nothing
call HopeRoute_Depart(DzGetTriggerUIEventPlayer())
endfunction

