if GetUnitTypeId(GetTriggerUnit())==LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$297FB89) then
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$2D297D87,LoadInteger(YDHT,GetItemTypeId(GetManipulatedItem()),$89877F57))
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9ABDB814,LoadInteger(YDHT,GetItemTypeId(GetManipulatedItem()),$5A5B203D))
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$57259F3B,LoadInteger(YDHT,GetItemTypeId(GetManipulatedItem()),$BC75CE99))
if HopeJob_RandomPromotion or (GetHeroStr(GetTriggerUnit(),false)>=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$2D297D87) and GetHeroAgi(GetTriggerUnit(),false)>=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9ABDB814) and GetHeroInt(GetTriggerUnit(),false)>=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$57259F3B)) then
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4,GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit())))
call SaveUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9F0C6E00,udg_hero[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)])
call CreateNUnitsAtLoc(1,LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$4A6C3525),GetOwningPlayer(GetTriggerUnit()),GetUnitLoc(udg_hero[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)]),bj_UNIT_FACING)
call SaveUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$CC612AE3,GetLastCreatedUnit())
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=6
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
call UnitAddItem(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$CC612AE3),UnitItemInSlotBJ(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9F0C6E00),bj_forLoopBIndex))
