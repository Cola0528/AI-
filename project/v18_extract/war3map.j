set HopeGrowth_Summary=HopeQoL_Label("HopeGrowthSummary",HopeGrowth_Panel,.014,-.041,.314,.020,"")
set HopeGrowth_UIReady=HopeGrowth_Title!=0 and HopeGrowth_Summary!=0 and f!=0
loop
exitwhen index>=6
if index>=3 then
set x=.178
set y=-.074-I2R(index-3)*.030
else
set x=.014
set y=-.074-I2R(index)*.030
endif
set HopeGrowth_ValueText[index]=HopeQoL_Label("HopeGrowthValue"+I2S(index),HopeGrowth_Panel,x,y,.150,.022,"")
set HopeGrowth_UIReady=HopeGrowth_UIReady and HopeGrowth_ValueText[index]!=0
