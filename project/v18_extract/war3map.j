function HopeChallenge_IsEnemy takes integer id returns boolean
return id=='nZ01' or id=='nZ02' or id=='nZ03' or id=='nZ04' or id=='UZ01' or id=='UZ02'
endfunction
function HopeChallenge_PrepareSkill takes unit u returns nothing
if HopeChallenge_IsEnemy(GetUnitTypeId(u)) and GetWidgetLife(u)>.405 then
call UnitResetCooldown(u)
call SetUnitManaPercentBJ(u,100.)
endif
endfunction
function HopeChallenge_HeroAlive takes unit u returns boolean
return u!=null and GetWidgetLife(u)>.405 and IsPlayerInForce(GetOwningPlayer(u),udg_WJZ_______cunhuo)
endfunction
function HopeChallenge_Heal takes unit u,real amount returns nothing
if u!=null and GetWidgetLife(u)>.405 and amount>0. then
call SetUnitState(u,UNIT_STATE_LIFE,RMinBJ(GetUnitState(u,UNIT_STATE_MAX_LIFE),GetWidgetLife(u)+amount))
endif
endfunction
function HopeChallenge_Ward takes unit u,real amount returns nothing
local real baseline=LoadReal(YDHT,GetUnitTypeId(u),$73299135)
call SetUnitState(u,ConvertUnitState(32),RMaxBJ(GetUnitState(u,ConvertUnitState(32)),baseline+amount))
endfunction
function HopeChallenge_EnemyCast takes unit u returns nothing
local integer id=GetUnitTypeId(u)
local integer i=1
local unit v=null
local unit weakest=null
local group allies=null
local real attack=GetUnitState(u,ConvertUnitState(20))
local real ratio=2.
local real before=0.
local real actual=0.
local real amount=0.
if not HopeChallenge_IsEnemy(id) or GetOwningPlayer(u)!=Player(11) or GetWidgetLife(u)<=.405 or not IsUnitInGroup(u,udg_Guaiwu_dwz) then
return
endif
// This dispatcher is called only by the existing A00U enemy skill event.
if id=='nZ01' or id=='nZ04' then
set allies=CreateGroup()
call GroupAddGroup(udg_Guaiwu_dwz,allies)
loop
set v=FirstOfGroup(allies)
exitwhen v==null
call GroupRemoveUnit(allies,v)
if GetWidgetLife(v)>.405 then
if id=='nZ01' then
call HopeChallenge_Ward(v,10.+2.*I2R(udg_quanshu+1))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl",v,"origin"))
else
call HopeChallenge_Heal(v,GetUnitState(v,UNIT_STATE_MAX_LIFE)*.08+attack*.5)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",v,"origin"))
endif
endif
endloop
call DestroyGroup(allies)
elseif id=='nZ03' then
loop
exitwhen i>6
set v=udg_hero[i]
if HopeChallenge_HeroAlive(v) and GetWidgetLife(v)/RMaxBJ(1.,GetUnitState(v,UNIT_STATE_MAX_LIFE))<ratio then
set ratio=GetWidgetLife(v)/RMaxBJ(1.,GetUnitState(v,UNIT_STATE_MAX_LIFE))
set weakest=v
endif
set i=i+1
endloop
if weakest!=null then
call UnitDamageTarget(u,weakest,attack*1.65,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call SetUnitState(weakest,UNIT_STATE_MANA,RMaxBJ(0.,GetUnitState(weakest,UNIT_STATE_MANA)-2.))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",weakest,"origin"))
endif
else
loop
exitwhen i>6
set v=udg_hero[i]
if HopeChallenge_HeroAlive(v) then
if id=='nZ02' then
call UnitDamageTarget(u,v,attack*.85+I2R(udg_quanshu+1)*3.,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Other\\Incinerate\\FireLordDeathExplode.mdl",v,"origin"))
elseif id=='UZ01' then
call UnitDamageTarget(u,v,attack*1.15,true,false,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\Impale\\ImpaleMissTarget.mdl",v,"origin"))
elseif id=='UZ02' then
set before=RMaxBJ(0.,GetWidgetLife(v))
call UnitDamageTarget(u,v,attack*.9,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
set actual=actual+RMaxBJ(0.,before-RMaxBJ(0.,GetWidgetLife(v)))
call SetUnitState(v,UNIT_STATE_MANA,RMaxBJ(0.,GetUnitState(v,UNIT_STATE_MANA)-3.))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Undead\\DeathCoil\\DeathCoilSpecialArt.mdl",v,"origin"))
endif
endif
set i=i+1
endloop
if id=='UZ01' then
call HopeChallenge_Ward(u,20.)
elseif id=='UZ02' then
set amount=RMinBJ(actual*.25,GetUnitState(u,UNIT_STATE_MAX_LIFE)*.06)
call HopeChallenge_Heal(u,amount)
endif
endif
set v=null
set weakest=null
set allies=null
endfunction

