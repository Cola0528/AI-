// Shared bookkeeping is separate from local visibility. These helpers must be
// defined before the original growth/upgrade/skill dialog actions.
function HopeChoice_PickUnique takes integer i,integer slot returns integer
local integer entry=0
local boolean duplicate=true
local integer start=(i-1)*3
loop
exitwhen not duplicate
set entry=GetRandomInt(1,17)
set duplicate=false
if slot>1 and entry==HopeChoice_UniqueEntry[start] then
set duplicate=true
endif
if slot>2 and entry==HopeChoice_UniqueEntry[start+1] then
set duplicate=true
endif
endloop
set HopeChoice_UniqueEntry[start+slot-1]=entry
return entry
endfunction

function HopeChoice_ValueScore takes integer entryId,real value returns integer
// v19 value-based rating (audit/08-choice-value-calc.py; unit values need
// in-game calibration). Anchor: single stat +3 = 100 = standard B.
// Rating is display only: it never changes the entry pick or tier roll.
local real u=0.
if entryId==1 or entryId==2 or entryId==3 or entryId==6 then
set u=33.3
elseif entryId==4 then
set u=30.
elseif entryId==5 then
set u=1.67
elseif entryId==7 then
set u=65.
elseif entryId==8 then
set u=.22
elseif entryId==9 then
set u=3.33
elseif entryId==10 or entryId==11 or entryId==15 then
set u=1110.
elseif entryId==12 then
set u=25.
elseif entryId==13 then
set u=800.
elseif entryId==14 then
set u=3.33
elseif entryId==16 then
set u=3330.
elseif entryId==17 then
set u=40.
endif
return R2I(u*value+.5)
endfunction
function HopeChoice_RateText takes string text,integer entryId,real value returns string
// v19: color = value-score rating. Thresholds S>135 A111-135 B90-110 C70-89
// D<70. C/B keep the v18 look (green/blue); A=purple, S=gold; D uncolored.
local integer s=HopeChoice_ValueScore(entryId,value)
if s>135 then
return "|cFFFFFC01[S] "+text+"|r"
elseif s>110 then
return "|cffbf80ef[A] "+text+"|r"
elseif s>89 then
return "|cff0042FF[B] "+text+"|r"
elseif s>69 then
return "|cff20C000[C] "+text+"|r"
endif
return "[D] "+text
endfunction


function HopeChoice_PendingForPlayer takes integer i returns boolean
if i<0 or i>=6 then
return false
endif
return HopeMeta_SeedPending[i] or HopeChoice_PlayerPending[i]>0 or HopeChoice_SkillHead[i]<HopeChoice_SkillTail[i]
endfunction

function HopeChoice_LootPending takes nothing returns boolean
local integer key=GetHandleId(GetLocalPlayer())
return HaveSavedBoolean(YDHT,key,$AB392274) and not LoadBoolean(YDHT,key,$AB392274)
endfunction

function HopeChoice_HasPending takes nothing returns boolean
return HopeChoice_LootPending() or HopeChoice_PendingForPlayer(GetPlayerId(GetLocalPlayer()))
endfunction

function HopeChoice_ApplyVisibility takes nothing returns nothing
local integer i=1
local integer newest=0
local integer owner=GetPlayerId(GetLocalPlayer())
// Never show the hover outline by itself. The original hover callbacks own it.
if udg_UI_sg[0]!=0 then
call DzFrameShow(udg_UI_sg[0],false)
endif
if udg_UI_sg[1]!=0 then
call DzFrameShow(udg_UI_sg[1],HopeChoice_LootPending() and not HopeChoice_Hidden)
endif
loop
exitwhen i>HopeChoice_DialogCount
if HopeChoice_DialogPending[i] and HopeChoice_Owner[i]==owner then
call HopeModern_NativeDisplay(GetLocalPlayer(),HopeChoice_Dialog[i],false)
set newest=i
endif
set i=i+1
endloop
// Warcraft displays one native dialog at a time. Other pending choices remain
// registered and can be reopened after the current one is resolved.
if not HopeChoice_Hidden and newest!=0 then
call HopeModern_NativeDisplay(GetLocalPlayer(),HopeChoice_Dialog[newest],true)
set HopeChoice_NativeVisible=newest
else
set HopeChoice_NativeVisible=0
endif
endfunction

function HopeChoice_ToggleLocal takes nothing returns nothing
if not HopeChoice_HasPending() then
set HopeChoice_Hidden=false
return
endif
set HopeChoice_Hidden=not HopeChoice_Hidden
call HopeChoice_ApplyVisibility()
endfunction

function HopeChoice_Toggle takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
call HopeChoice_ToggleLocal()
endif
endfunction


function HopeChoice_ReopenUpgrade takes player p,unit seller,unit sold returns boolean
local integer owner=GetPlayerId(p)
local integer i=HopeChoice_FindDialog(udg_Wj_sj_xz[owner+1])
if i==0 then
return false
endif
if not HopeChoice_DialogPending[i] then
return false
endif
// h00F is a zero-cost invisible selection token. The sell event already took
// stock; restore the unspent upgrade credit and remove only this extra token.
call AddUnitToStockBJ($68303046,seller,udg_shengji_dian[owner+1],udg_shengji_dian[owner+1])
call RemoveUnit(sold)
if p==GetLocalPlayer() then
set HopeChoice_Hidden=false
call HopeChoice_ApplyVisibility()
call HopeModern_NativeDisplay(p,HopeChoice_Dialog[i],true)
set HopeChoice_NativeVisible=i
endif
return true
endfunction

function HopeChoice_DeferSkill takes player p,integer abilityId returns boolean
local integer owner=GetPlayerId(p)
local integer i=HopeChoice_FindDialog(udg_Rskill_shifoutihuan[owner+1])
if i==0 then
return false
endif
if not HopeChoice_DialogPending[i] then
return false
endif
// This path runs in the original synchronized pickup action on all clients.
// Preserve each purchased skill ID; never overwrite the active dialog's ID.
if HopeChoice_SkillQueue==null then
set HopeChoice_SkillQueue=InitHashtable()
endif
set HopeChoice_SkillTail[owner]=HopeChoice_SkillTail[owner]+1
call SaveInteger(HopeChoice_SkillQueue,owner,HopeChoice_SkillTail[owner],abilityId)
call DisplayTextToPlayer(p,0,0,"新的 R 技能已排队；先完成当前选择，随后依次确认。")
return true
endfunction

function HopeChoice_ShowNextSkill takes player p returns nothing
local integer owner=GetPlayerId(p)
local integer abilityId=0
local dialog d=udg_Rskill_shifoutihuan[owner+1]
if HopeChoice_SkillHead[owner]>=HopeChoice_SkillTail[owner] then
set d=null
return
endif
set HopeChoice_SkillHead[owner]=HopeChoice_SkillHead[owner]+1
set abilityId=LoadInteger(HopeChoice_SkillQueue,owner,HopeChoice_SkillHead[owner])
call RemoveSavedInteger(HopeChoice_SkillQueue,owner,HopeChoice_SkillHead[owner])
if HopeChoice_SkillHead[owner]==HopeChoice_SkillTail[owner] then
set HopeChoice_SkillHead[owner]=0
set HopeChoice_SkillTail[owner]=0
endif
// Only present the preserved ID. Original R-skill callbacks still apply all
// learning/replacement effects, including their class-specific adjustments.
call HopeModern_Message(d,"是否替换当前R技能"+GetAbilityName(udg_R_Skill[owner+1]))
call SaveInteger(YDHT,GetHandleId(d),$D59B01E6,abilityId)
call HopeModern_Add(d,"是")
call SaveInteger(YDHT,GetHandleId(GetLastCreatedButtonBJ()),$340FE72,1)
call HopeModern_Add(d,"否（不退还所消耗金钱和木材）")
call SaveInteger(YDHT,GetHandleId(GetLastCreatedButtonBJ()),$340FE72,2)
call HopeChoice_DialogDisplay(p,d,true)
set d=null
endfunction

function HopeChoice_DialogClear takes dialog d returns nothing
local integer i=HopeChoice_FindDialog(d)
if i!=0 then
if HopeChoice_DialogPending[i] then
set HopeChoice_DialogPending[i]=false
set HopeChoice_PlayerPending[HopeChoice_Owner[i]]=HopeChoice_PlayerPending[HopeChoice_Owner[i]]-1
endif
set HopeChoice_FoldButton[i]=null
if HopeChoice_Owner[i]==GetPlayerId(GetLocalPlayer()) and HopeChoice_NativeVisible==i then
set HopeChoice_NativeVisible=0
endif
endif
call HopeModern_Clear(d)
endfunction

function HopeChoice_DialogClicked takes nothing returns boolean
local integer i=HopeChoice_FindDialog(HopeModern_GetDialog())
if i==0 then
return false
endif
if HopeModern_GetButton()==HopeChoice_FoldButton[i] then
if HopeModern_GetPlayer()==GetLocalPlayer() then
set HopeChoice_Hidden=true
call HopeChoice_ApplyVisibility()
endif
// Every client returns from the original callback before random draws,
// DialogClear, learning/replacing a skill, or accepting a growth roll.
return true
endif
if HopeChoice_DialogPending[i] then
set HopeChoice_DialogPending[i]=false
set HopeChoice_PlayerPending[HopeChoice_Owner[i]]=HopeChoice_PlayerPending[HopeChoice_Owner[i]]-1
endif
if HopeModern_GetPlayer()==GetLocalPlayer() and HopeChoice_NativeVisible==i then
set HopeChoice_NativeVisible=0
endif
return false
endfunction

function HopeChoice_RewardIssued takes player p returns nothing
if p==GetLocalPlayer() then
set HopeChoice_Hidden=false
endif
endfunction

function HopeChoice_Refresh takes nothing returns nothing
local boolean pending=HopeChoice_HasPending()
if not pending then
set HopeChoice_Hidden=false
endif
if not HopeChoice_Hidden and HopeChoice_NativeVisible==0 and HopeChoice_PendingForPlayer(GetPlayerId(GetLocalPlayer())) then
call HopeChoice_ApplyVisibility()
endif
if udg_UI_sg[1]!=0 then
call DzFrameShow(udg_UI_sg[1],HopeChoice_LootPending() and not HopeChoice_Hidden)
endif
if udg_UI_sg[0]!=0 and (HopeChoice_Hidden or not HopeChoice_LootPending()) then
call DzFrameShow(udg_UI_sg[0],false)
endif
if HopeChoice_Button!=0 then
call DzFrameShow(HopeChoice_Button,pending)
if HopeChoice_Hidden then
call DzFrameSetText(HopeChoice_Button,"展开待选项")
else
call DzFrameSetText(HopeChoice_Button,"暂时收起选择")
endif
endif
endfunction


// The enter-region event fires during CreateUnit, before udg_hero is assigned.
// Save that unit here; callbacks later require it to be the current hero.
function HopeGrowth_Begin takes unit u returns nothing
local player p=GetOwningPlayer(u)
local integer owner=GetPlayerId(p)
if u==null or owner<0 or owner>=6 or GetUnitTypeId(u)!=$48303030 then
set p=null
return
endif
if GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(p)!=MAP_CONTROL_USER or HopeGrowth_Started[owner] then
set p=null
return
endif
set HopeGrowth_Started[owner]=true
set HopeGrowth_Pending[owner]=true
set HopeGrowth_Hero[owner]=u
set HopeChoice_PlayerPending[owner]=HopeChoice_PlayerPending[owner]+1
if p==GetLocalPlayer() then
set HopeChoice_Hidden=false
set HopeQoL_Expanded=false
set HopeArchive_Expanded=false
set HopeGift_Expanded=false
set HopeRelic_Expanded=false
set HopeRoute_Details=false
set HopeJob_Expanded=false
endif
set p=null
endfunction

function HopeGrowth_CanAct takes player p returns boolean
local integer owner=GetPlayerId(p)
local unit u=null
if p==null or owner<0 or owner>=6 then
return false
endif
if GetPlayerSlotState(p)!=PLAYER_SLOT_STATE_PLAYING or GetPlayerController(p)!=MAP_CONTROL_USER then
return false
endif
if not HopeGrowth_Started[owner] or not HopeGrowth_Pending[owner] then
return false
endif
set u=udg_hero[owner+1]
if u==null or u!=HopeGrowth_Hero[owner] or GetOwningPlayer(u)!=p or GetUnitTypeId(u)!=$48303030 or GetWidgetLife(u)<=.405 then
set u=null
return false
endif
set u=null
return true
endfunction

