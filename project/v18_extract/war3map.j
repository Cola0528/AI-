function Trig____________________033Actions takes nothing returns nothing
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call SavePlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946,GetOwningPlayer(GetKillingUnitBJ()))
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4,GetConvertedPlayerId(LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946)))
if GetUnitTypeId(GetTriggerUnit())==$7530304A then
call DisplayTextToPlayer(LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946),0,0,"击杀小鬼，攻击力+3")
call SetUnitState(GetKillingUnitBJ(),ConvertUnitState(18),GetUnitState(GetKillingUnitBJ(),ConvertUnitState(18))+3.)
else
endif
if GetUnitTypeId(GetTriggerUnit())==$7530304B then
call DisplayTextToPlayer(LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946),0,0,"击杀攻速食尸鬼，攻击速度+20%")
call SetUnitState(GetKillingUnitBJ(),ConvertUnitState(81),GetUnitState(GetKillingUnitBJ(),ConvertUnitState(81))+.2)
else
endif
if GetUnitTypeId(GetTriggerUnit())==$7530304D then
call DisplayTextToPlayer(LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946),0,0,"击杀恢复食尸鬼，生命魔法恢复15%")
call SetUnitLifePercentBJ(GetKillingUnitBJ(),GetUnitLifePercent(GetKillingUnitBJ())+15.)
call SetUnitManaPercentBJ(GetKillingUnitBJ(),GetUnitManaPercent(GetKillingUnitBJ())+15.)
else
endif
if GetUnitTypeId(GetTriggerUnit())==$7530304E then
call DisplayTextToPlayer(LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946),0,0,"击杀分裂食尸鬼，分裂等级+1")
if GetUnitAbilityLevelSwapped($41303544,GetKillingUnitBJ())==0 then
call UnitAddAbilityBJ($41303544,GetKillingUnitBJ())
else
if GetUnitAbilityLevelSwapped($41303544,GetKillingUnitBJ())<10 then
call IncUnitAbilityLevelSwapped($41303544,GetKillingUnitBJ())
else
call DisplayTextToPlayer(LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946),0,0,"击杀分裂食尸鬼，分裂等级已满")
endif
endif
else
endif
if GetUnitTypeId(GetTriggerUnit())==$65303054 then
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$F5D49B57,100*(udg_quanshu+1))
call DisplayTextToPlayer(LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946),0,0,"射中了金币，获得金钱奖励"+YDWEGetPlayerColorString(Player(4),I2S(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$F5D49B57))))
call AdjustPlayerStateBJ(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$F5D49B57),LoadPlayerHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$48656946),PLAYER_STATE_RESOURCE_GOLD)
else
endif
