endloop
set f=HopeQoL_Label("HopeGrowthExplanation",HopeGrowth_Panel,.014,-.167,.314,.044,"以上为每级成长值；三围小数会累积。|n魔力提升技能伤害，专注提升精确打击伤害。|n额外重置每次基础5积分，资源天赋可降至2积分。")
set HopeGrowth_FreeButton=HopeQoL_Button("HopeGrowthFree",HopeGrowth_Panel,.014,-.218,.151,.028,"")
set HopeGrowth_PaidButton=HopeQoL_Button("HopeGrowthPaid",HopeGrowth_Panel,.177,-.218,.151,.028,"积分重置 · 5积分")
set HopeGrowth_AcceptButton=HopeQoL_Button("HopeGrowthAccept",HopeGrowth_Panel,.014,-.253,.314,.028,"以当前成长开始游戏")
call HopeQoL_Bind(HopeGrowth_FreeButton,function HopeGrowth_FreeClick,true)
call HopeQoL_Bind(HopeGrowth_PaidButton,function HopeGrowth_PaidClick,true)
call HopeQoL_Bind(HopeGrowth_AcceptButton,function HopeGrowth_AcceptClick,true)
set HopeGrowth_Footer=HopeQoL_Label("HopeGrowthFooter",HopeGrowth_Panel,.014,-.288,.314,.030,"")
set HopeGrowth_UIReady=HopeGrowth_UIReady and f!=0 and HopeGrowth_FreeButton!=0 and HopeGrowth_PaidButton!=0 and HopeGrowth_AcceptButton!=0 and HopeGrowth_Footer!=0
call DzFrameShow(HopeGrowth_Panel,false)
endfunction

function HopeEvent_Refresh takes nothing returns nothing
local string text=""
local integer j=0
if HopeEvent_Panel==0 then
return
endif
if HopeEvent_Seen!=HopeEvent_Sequence then
set HopeEvent_Seen=HopeEvent_Sequence
set HopeEvent_Offset=HopeEvent_Start
set HopeEvent_Open=true
call HopeLayout_Focus(14)
endif
set j=IMaxBJ(IMaxBJ(0,HopeEvent_Count-512),HopeEvent_Offset)
loop
exitwhen j>=HopeEvent_Count or j>=HopeEvent_Offset+13
if text!="" then
set text=text+"|n"
endif
set text=text+HopeEvent_Line[ModuloInteger(j,512)]
set j=j+1
endloop
call DzFrameSetText(HopeEvent_Body,text)
call DzFrameSetText(HopeEvent_Status,"各自关闭 · "+I2S(HopeEvent_Offset+1)+"-"+I2S(j)+"/"+I2S(HopeEvent_Count)+"行")
endfunction
function HopeLayout_Mode takes nothing returns integer
local integer owner=GetPlayerId(GetLocalPlayer())
local integer i=1
if HopeMeta_Open then
return 15
endif
if HopeMarket_Open then
return 16
endif
if HopeRoute_Assigning then
return 10
endif
if not HopeChoice_Hidden then
if HopeGrowth_Pending[owner] then
return 11
endif
if HopeChoice_LootPending() then
return 12
endif
loop
exitwhen i>HopeChoice_DialogCount
if HopeChoice_DialogPending[i] and HopeChoice_Owner[i]==owner then
return 13
endif
set i=i+1
endloop
endif
if HopeEvent_Open then
return 14
endif
if HopeQoL_Expanded then
return 1
elseif HopeArchive_Expanded then
return 2
elseif HopeGift_Expanded then
return 3
elseif HopeRelic_Expanded then
return 4
elseif HopeJob_Expanded then
return 5
elseif HopeRoute_PickerOpen and not udg_ZhandouZhong and HopeRoute_AvailableCount>0 then
return 6
elseif HopeDraw_Open then
return 7
elseif HopeRoute_Details and HopeRoute_Valid() then
return 9
endif
return 0
endfunction
function HopeLayout_Apply takes nothing returns nothing
local integer mode=0
local integer owner=GetPlayerId(GetLocalPlayer())
local integer i=1
local integer newest=0
local boolean active=owner>=0 and owner<6 and udg_hero[owner+1]!=null
local boolean dock=active and mode<10
call HopeEvent_Refresh()
set mode=HopeLayout_Mode()
set dock=active and mode<10
call HopeLayout_Show(HopeEvent_Panel,mode==14)
call HopeLayout_Show(HopeEvent_Button,dock and HopeEvent_Count>0)
call HopeLayout_Show(HopeQoL_StatsButton,dock)
call HopeLayout_Show(HopeLayout_Save,dock)
call HopeLayout_Show(HopeLayout_Relic,dock)
call HopeLayout_Show(HopeGift_OpenButton,dock)
call HopeLayout_Show(HopeLayout_History,dock)
call HopeLayout_Show(HopeLayout_Route,dock and not udg_ZhandouZhong)
call HopeLayout_Show(HopeQoL_Panel,mode==1 and active)
call HopeLayout_Show(HopeArchive_Panel,mode==2 and HopeArchive_UIReady)
call HopeLayout_Show(HopeGift_Panel,mode==3 and HopeGift_UIReady)
call HopeLayout_Show(HopeRelic_Panel,mode==4 and HopeRelic_UIReady)
call HopeLayout_Show(HopeJob_Panel,mode==5)
call HopeLayout_Show(HopeRoute_Picker,mode==6)
call HopeLayout_Show(HopeDraw_Panel,mode==7)
call HopeLayout_Show(HopeRoute_InfoPanel,mode==9)
call HopeLayout_Show(HopeRoute_AssignPanel,mode==10 and owner==HopeRoute_Host())
call HopeLayout_Show(HopeGrowth_Panel,mode==11 and HopeGrowth_UIReady)
call HopeLayout_Show(udg_UI_sg[1],mode==12)
loop
exitwhen i>HopeChoice_DialogCount
if HopeChoice_DialogPending[i] and HopeChoice_Owner[i]==owner then
set newest=i
endif
set i=i+1
endloop
set i=1
loop
exitwhen i>13
call HopeLayout_Show(HopeModern_Panel[i],mode==13 and i==newest)
set i=i+1
endloop
// Passive readouts yield to overlays, rather than covering their content.
call HopeLayout_Show(HopeDamage_Panel,mode==0 and active)
if mode!=0 then
call HopeLayout_Show(HopeIntent_Panel,false)
call HopeLayout_Show(HopeTurn_Panel,false)
call HopeLayout_Show(HopeJob_OpenButton,false)
endif
endfunction

function HopeThird_Resource takes unit u,integer p returns string
local integer kind=GetUnitTypeId(u)
local integer token=HopeChallenge_TurnToken()
local integer level=HopeThird_Level(u)
local integer count=0
local integer limit=2
local integer mask=0
if level<=0 then
return ""
endif
if kind=='H00D' then
if HopeThird_Cavalry[p] then
return "|cff80ef90骑势就绪 · 下次强化|r"
endif
return "|cffaaaaaa骑势 · 冲锋后蓄势|r"
elseif kind=='N018' then
if level==1 then
set limit=3
endif
if HopeThird_ComboToken[p]==token then
if HopeThird_ComboPaid[p] then
return "|cff80ef90连势 · 本回合已回点|r"
endif
set count=IMinBJ(limit,HopeThird_ComboCount[p])
endif
return "|cffd2b879连势 "+I2S(count)+"/"+I2S(limit)+" · 满后回点|r"
elseif kind=='H004' then
if HopeThird_PressureToken[p]==token then
set count=HopeThird_Pressure[p]
endif
return "|cffd2b879压制 "+I2S(count)+"/3 · 换目标重置|r"
elseif kind=='N01E' then
if HopeThird_FireTarget[p]!=null and GetWidgetLife(HopeThird_FireTarget[p])>.405 then
set count=HopeThird_Get(GetHandleId(HopeThird_FireTarget[p]),p)
endif
return "|cfffe8a0e最近目标火种 "+I2S(count)+"/3|r"
elseif kind=='O006' then
if HopeThird_HitsToken[p]==token then
set count=HopeThird_Hits[p]
if HopeThird_HealCount[p]>=2 then
return "|cff80ef90连环 · 本回合已回复2次|r"
endif
endif
return "|cff68b99a连环 "+I2S(count)+"/3 · 满后回复|r"
elseif kind=='HZ03' then
if HopeThird_HiddenToken[p]==token then
set mask=HopeThird_HiddenMask[p]
endif
if mask>=8 then
return "|cff80ef90三律 · 本回合已贯通|r"
endif
if ModuloInteger(mask,2)==1 then
set count=count+1
endif
if ModuloInteger(mask,4)>=2 then
set count=count+1
endif
if mask>=4 then
set count=count+1
endif
return "|cff76cdd0三律 "+I2S(count)+"/2 · Q D V任选两式|r"
endif
return ""
endfunction

function HopeProfession_Text takes unit u,integer p returns string
local integer kind=0
local integer current=0
local integer capacity=0
if p<1 or p>6 or u==null then
return ""
endif
if HopeMini_Actor[p]!=null then
return ""
endif
set kind=GetUnitTypeId(u)
if kind=='H00E' then
set current=LoadInteger(YDHT,GetHandleId(u),$30720CCD)
set capacity=GetUnitAbilityLevel(u,'A04Q')+1
if current<=0 then
return "|cffff8585子弹 "+I2S(current)+"/"+I2S(capacity)+" · Q装填|r"
endif
return "|cffd2b879子弹 "+I2S(current)+"/"+I2S(capacity)+"|r"
elseif kind=='N01G' then
set current=HopeMonk_Qi[p]
if current>=3 then
return "|cff80ef90气 "+I2S(current)+"/3 · 已满|r"
endif
return "|cff76cdd0气 "+I2S(current)+"/3|r"
elseif kind=='N01A' and GetUnitAbilityLevel(u,'A03M')>1 then
// The live passive starts at rank 2 and awards STR on the 15th heavy chop.
set current=udg_Zhongkan_cs[p]
if current>=14 then
return "|cff80ef90重砍 "+I2S(current)+"/15 · 下次+1力|r"
endif
return "|cffd2b879重砍 "+I2S(current)+"/15|r"
endif
return HopeThird_Resource(u,p)
endfunction

function HopeQoL_RefreshContent takes nothing returns nothing
local integer p=GetPlayerId(GetLocalPlayer())+1
local unit u=udg_hero[p]
local real armor=0.
local integer lo=0
local integer hi=0
local string focus=""
local string detail=""
local string reduction=""
local boolean active=u!=null and p<=6
local boolean picking=HopeChoice_HasPending() and not HopeChoice_Hidden
local unit actor=u
call HopeQoL_RefreshLegacyAP()
call HopeTeam_UpdateAP()
call HopeIntent_RefreshAll()
call HopeSkill_Refresh()
call HopeChoice_Refresh()
call HopeGrowth_Refresh()
call HopeArchive_Refresh()
call HopeGift_Refresh()
call HopeRelic_Refresh()
if not HopeQoL_UIReady then
set u=null
set actor=null
return
endif
call HopeRoute_UpdateUI()
call HopeTurn_UpdateUI()
call HopeIntent_UpdateUI()
// The leftmost reward card overlaps this corner. Temporarily yield to the original choice UI.
call DzFrameShow(HopeQoL_Hud,active and HopeQoL_Visible and not picking)
call DzFrameShow(HopeQoL_Restore,active and not HopeQoL_Visible and not picking)
call DzFrameShow(HopeQoL_Panel,active and HopeQoL_Expanded and not HopeArchive_Expanded and not HopeGift_Expanded and not HopeRelic_Expanded and not picking)
call DzFrameShow(HopeQoL_StatsButton,active and not picking)
call DzFrameShow(HopeGift_OpenButton,active and not picking)
if active then
if LoadBoolean(YDHT,GetHandleId(u),$08E215BC) then
set focus="|cffffd060精确打击就绪|r"
elseif udg_zhuanzhuzhi_sy[p]>=3. then
set focus="|cff80ef90F 启用专注|r"
else
set focus="|cffaaaaaa专注不足 3|r"
endif
call DzFrameSetText(HopeQoL_Resources,"|cffd2b879行动 "+I2S(udg_xingdong_dian[p])+"/"+I2S(udg_xingdong_dianSx[p])+"|r  专注 "+HopeQoL_CompactNumber(udg_zhuanzhuzhi_sy[p])+"/"+HopeQoL_CompactNumber(udg_DEX[p]))
set detail=HopeProfession_Text(u,p)
if detail!="" then
set focus=detail
endif
call DzFrameSetText(HopeQoL_Status,focus+"|n|cffaaaaaa背包 "+I2S(HopeQoL_Slots(u))+"/6 · 助手 "+I2S(HopeQoL_Slots(udg_Bei_bao_danwei[p]))+"/6|r")
if HopeMini_Actor[p]!=null then
set actor=HopeMini_Actor[p]
call DzFrameSetText(HopeQoL_Resources,"|cffd2b879小游戏角色|r")
call DzFrameSetText(HopeQoL_Status,"F3 重新定位小游戏角色|n剩余时间见游戏计时器")
endif
call DzFrameSetText(HopeQoL_LifeText,"|cff68b99a生命 "+I2S(R2I(GetUnitState(actor,UNIT_STATE_LIFE)))+"/"+I2S(R2I(GetUnitState(actor,UNIT_STATE_MAX_LIFE)))+"|r")
call DzFrameSetText(HopeQoL_ManaText,"|cff76a7d0魔法 "+I2S(R2I(GetUnitState(actor,UNIT_STATE_MANA)))+"/"+I2S(R2I(GetUnitState(actor,UNIT_STATE_MAX_MANA)))+"|r")
call HopeQoL_BarValue(HopeQoL_LifeFill,GetUnitState(actor,UNIT_STATE_LIFE),GetUnitState(actor,UNIT_STATE_MAX_LIFE))
call HopeQoL_BarValue(HopeQoL_ManaFill,GetUnitState(actor,UNIT_STATE_MANA),GetUnitState(actor,UNIT_STATE_MAX_MANA))
if HopeQoL_Expanded then
set armor=GetUnitState(u,ConvertUnitState(32))
if armor>=0. then
set reduction="护甲减伤 "+HopeQoL_Number(100.*(.04*armor)/(1.+.04*armor))+"%"
else
set reduction="负护甲：承受额外物理伤害"
endif
set hi=120+GetHeroStr(u,true)
set lo=IMinBJ(hi,90+GetHeroAgi(u,true)/2)
set detail="|cffd2b879战斗属性|r|n"
set detail=detail+"攻击基值  "+HopeQoL_Number(GetUnitState(u,ConvertUnitState(20)))+"|n平砍浮动  "+I2S(lo)+"-"+I2S(hi)+"%|n"
set detail=detail+"护甲  "+HopeQoL_Number(armor)+"|n"+reduction+"|n"
set detail=detail+"暴击率  "+I2S(udg_Baoji_Lv[p])+"%|n暴击伤害  "+HopeQoL_Number(100.*udg_Baoji_Damage[p])+"%|n"
set detail=detail+"法术 / 技能  "+HopeQoL_Number(100.*udg_Fashang_Dm[p])+"% / "+HopeQoL_Number(100.*udg_Skill_Dm[p])+"%|n"
set detail=detail+"精确打击  "+HopeQoL_Number(100.*udg_jingque_Daji_jiacheng[p])+"%|n最终伤害  "+HopeQoL_Number(100.*udg_Zuizhong_Dm[p])+"%|n"
set detail=detail+"回合结束加甲  "+HopeQoL_Number(udg_Defend_HUIHE[p])+"|n防御动作额外护甲  "+HopeQoL_Number(udg_Defend_fangyu[p])
call DzFrameSetText(HopeQoL_Details,detail)
set detail="|cffd2b879基础属性 · Lv."+I2S(GetHeroLevel(u))+"|r|n"
set detail=detail+"力量 "+I2S(GetHeroStr(u,true))+"  敏捷 "+I2S(GetHeroAgi(u,true))+"  智力 "+I2S(GetHeroInt(u,true))+"|n"
set detail=detail+"三围总和  "+I2S(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))+"|n专注上限  "+HopeQoL_Number(udg_DEX[p])+"|n|n"
set detail=detail+"|cffd2b879每级成长|r|n力量  +"+HopeQoL_GradedGrowth(udg_cz1Str_up[p],false)+"|n敏捷  +"+HopeQoL_GradedGrowth(udg_cz2Agi_up[p],false)+"|n智力  +"+HopeQoL_GradedGrowth(udg_cz3Int_up[p],false)+"|n"
set detail=detail+"生命  +"+HopeQoL_GradedGrowth(udg_cz4Hp_up[p],true)+"|n魔力  +"+HopeQoL_GradedGrowth(udg_cz5Mp_up[p],false)+"|n专注  +"+HopeQoL_GradedGrowth(udg_cz6Dex_up[p],false)
call DzFrameSetText(HopeQoL_GrowthDetails,detail)
endif
endif
set u=null
set actor=null
endfunction
function HopeQoL_Refresh takes nothing returns nothing
call HopeQoL_RefreshContent()
call HopeLayout_Apply()
endfunction

// Resource loading is an isolated timer thread. If it aborts, the independent
// construction timer can still build generic containers, text and fallback buttons.
function HopeQoL_LoadUIResources takes nothing returns nothing
call DestroyTimer(GetExpiredTimer())
set HopeQoL_UIResources="加载中"
call DzLoadToc("HopeUI\\modern-ui.toc")
set HopeQoL_UIResources="加载调用已返回"
endfunction

// Only UI allocations occur here, after blocking map initialization is over.
function HopeQoL_CreateUI takes nothing returns nothing
local integer f=0
call DestroyTimer(GetExpiredTimer())
set HopeQoL_UIPhase="创建基础容器"
set HopeQoL_Hud=HopeQoL_Surface("HopeQoLHud",.014,.50,.134,.117)
if HopeQoL_Hud==0 then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,15.,"基础界面创建失败；输入 -ui 查看状态。原生技能、装备及快捷操作保留。")
return
endif
// UI load success must never change synchronized trigger/timer/tag allocation.
set HopeQoL_Modern=HopeQoL_Hud!=0
call HopeConsole_Init()
set HopeRoute_Panel=HopeQoL_Surface("HopeRoutePanel",.014,.375,.134,.100)
set HopeRoute_InfoPanel=HopeQoL_Surface("HopeRouteInfoPanel",.164,.445,.266,.250)
set HopeTurn_Panel=HopeQoL_Surface("HopeTurnPanel",.29,.232,.132,.068)
set HopeQoL_Panel=HopeQoL_Surface("HopeQoLPanel",.24,.53,.34,.285)
set HopeIntent_Panel=HopeQoL_Surface("HopeIntentPanel",.28,.53,.224,.052)
if HopeRoute_Panel==0 or HopeRoute_InfoPanel==0 or HopeTurn_Panel==0 or HopeQoL_Panel==0 or HopeIntent_Panel==0 then
set HopeQoL_UIPhase="部分容器缺失；使用原生操作"
return
endif
set HopeRoute_TitleText=HopeQoL_Label("HopeRouteTitle",HopeRoute_Panel,.007,-.007,.120,.014,"")
set HopeRoute_Text=HopeQoL_Label("HopeRouteText",HopeRoute_Panel,.007,-.052,.120,.036,"")
set f=HopeQoL_Label("HopeRouteInfoTitle",HopeRoute_InfoPanel,.012,-.010,.242,.017,"|cffd2b879关卡说明|r")
set HopeRoute_DescriptionText=HopeQoL_Label("HopeRouteDescription",HopeRoute_InfoPanel,.012,-.039,.242,.199,"")
call DzFrameShow(HopeRoute_InfoPanel,false)
set f=HopeQoL_Button("HopeRouteReady",HopeRoute_Panel,.007,-.023,.077,.025,"准备出发")
set HopeRoute_ReadyButton=f
call HopeQoL_Bind(f,function HopeRoute_ReadyClick,true)
set f=HopeQoL_Button("HopeRouteWait",HopeRoute_Panel,.007,-.023,.077,.025,"已准备 · 取消")
set HopeRoute_WaitButton=f
call HopeQoL_Bind(f,function HopeRoute_WaitClick,true)
set f=HopeQoL_Button("HopeRouteInfo",HopeRoute_Panel,.089,-.025,.038,.022,"说明")
call HopeQoL_Bind(f,function HopeRoute_ToggleDetails,false)
call DzFrameShow(HopeRoute_Panel,false)
set HopeQoL_UIPhase="创建状态文字"
set HopeQoL_LifeText=HopeQoL_Label("HopeQoLLife",HopeQoL_Hud,.007,-.006,.120,.013,"")
set HopeQoL_LifeFill=HopeQoL_Fill("HopeQoLLifeFill",HopeQoL_Hud,.007,-.020,"HopeUI\\life-fill.blp")
set HopeQoL_ManaText=HopeQoL_Label("HopeQoLMana",HopeQoL_Hud,.007,-.024,.120,.013,"")
set HopeQoL_ManaFill=HopeQoL_Fill("HopeQoLManaFill",HopeQoL_Hud,.007,-.038,"HopeUI\\mana-fill.blp")
set HopeQoL_Resources=HopeQoL_Label("HopeQoLResources",HopeQoL_Hud,.007,-.044,.120,.014,"")
set HopeQoL_Status=HopeQoL_Label("HopeQoLStatus",HopeQoL_Hud,.007,-.060,.120,.023,"")
// Keyboard legends are informational text, not redundant mouse buttons.
set f=HopeQoL_Label("HopeQoLHero",HopeQoL_Hud,.007,-.086,.058,.013,"|cffd2b879F3 聚焦|r")
set f=HopeQoL_Label("HopeQoLBag",HopeQoL_Hud,.069,-.086,.058,.013,"|cffd2b879F2 助手|r")
set f=HopeQoL_Label("HopeQoLStats",HopeQoL_Hud,.007,-.100,.058,.013,"|cffd2b879F4 属性|r")
set f=HopeQoL_Label("HopeQoLHide",HopeQoL_Hud,.069,-.100,.058,.013,"|cffaaaaaaF5 收起|r")
set HopeQoL_Restore=HopeQoL_Label("HopeQoLRestore",DzGetGameUI(),.014,-.10,.09,.016,"|cffd6c99bF5 展开速览|r")
call DzFrameClearAllPoints(HopeQoL_Restore)
call DzFrameSetAbsolutePoint(HopeQoL_Restore,0,.014,.50)
call DzFrameShow(HopeQoL_Restore,false)
// Turn controls belong to their own root, so collapsing the corner HUD cannot hide them.
// Stay above the native console and leave the right-side skill tooltip region clear.
set HopeTurn_Text=HopeQoL_Label("HopeTurnText",HopeTurn_Panel,.008,-.006,.116,.029,"")
set HopeTurn_Button=HopeQoL_Button("HopeTurnButton",HopeTurn_Panel,.008,-.037,.116,.025,"结束回合 G")
call HopeQoL_Bind(HopeTurn_Button,function HopeTurn_EndClick,true)
call DzFrameShow(HopeTurn_Panel,false)
set f=HopeQoL_Label("HopeStatsTitle",HopeQoL_Panel,.009,-.007,.18,.017,"|cffffd060当前属性|r")
set f=HopeQoL_Button("HopeStatsClose",HopeQoL_Panel,.276,-.004,.056,.025,"关闭")
call HopeQoL_Bind(f,function HopeQoL_CloseStats,false)
set HopeQoL_Details=HopeQoL_Label("HopeQoLDetails",HopeQoL_Panel,.009,-.033,.157,.153,"")
set HopeQoL_GrowthDetails=HopeQoL_Label("HopeQoLGrowthDetails",HopeQoL_Panel,.177,-.033,.154,.153,"")
set f=HopeQoL_Label("HopeQoLRules",HopeQoL_Panel,.009,-.192,.322,.087,"|cffd2b879属性与成长如何生效|r|n力量：每点 +2 生命、平砍浮动上限 +1%。|n敏捷：每两点 +1 攻击、浮动下限 +1%。|n智力：每点 +1 魔法，每三点 +1% 法伤。|n生命成长直接加生命；主属性每点另加 0.5 攻击。|n魔力 / 专注成长：每级增加成长值 ÷ 2 个百分点的|n技能 / 精确打击伤害。小数累积；特殊技能按其浮动。")
call DzFrameShow(HopeQoL_Panel,false)
// A real, discoverable details action is separate from the F4 keyboard legend.
set HopeQoL_StatsButton=HopeQoL_Button("HopeStatsOpen",DzGetGameUI(),0,0,.115,.023,"属性详情")
call DzFrameClearAllPoints(HopeQoL_StatsButton)
call DzFrameSetAbsolutePoint(HopeQoL_StatsButton,0,.025,.238)
call HopeQoL_Bind(HopeQoL_StatsButton,function HopeQoL_ToggleStats,false)
call DzFrameShow(HopeQoL_StatsButton,false)
set HopeGift_OpenButton=HopeQoL_Button("HopeGiftOpen",DzGetGameUI(),0,0,.035,.024,"抽奖")
if HopeGift_OpenButton!=0 then
call DzFrameClearAllPoints(HopeGift_OpenButton)
call DzFrameSetAbsolutePoint(HopeGift_OpenButton,0,.105,.208)
call HopeQoL_Bind(HopeGift_OpenButton,function HopeGift_Toggle,false)
call DzFrameShow(HopeGift_OpenButton,false)
endif
call DzFrameShow(HopeQoL_Hud,false)
// A compact target readout grows only for effects present on the selected enemy.
// It has no click controls and disappears when that enemy is no longer selected.
set HopeIntent_Title=HopeQoL_Label("HopeIntentTitle",HopeIntent_Panel,.008,-.005,.208,.014,"")
set HopeIntent_Text=HopeQoL_Label("HopeIntentText",HopeIntent_Panel,.008,-.021,.208,.025,"")
set HopeIntent_Status=HopeQoL_Label("HopeIntentStatus",HopeIntent_Panel,.008,-.050,.208,.014,"")
if HopeIntent_Status!=0 then
call DzFrameShow(HopeIntent_Status,false)
endif
call DzFrameShow(HopeIntent_Panel,false)
set HopeChoice_Button=HopeQoL_Button("HopeChoiceToggle",DzGetGameUI(),0,0,.102,.026,"暂时收起选择")
if HopeChoice_Button!=0 then
call DzFrameClearAllPoints(HopeChoice_Button)
call DzFrameSetAbsolutePoint(HopeChoice_Button,0,.165,.557)
call HopeQoL_Bind(HopeChoice_Button,function HopeChoice_Toggle,false)
call DzFrameShow(HopeChoice_Button,false)
endif
call HopeArchive_CreateUI()
call HopeGift_CreateUI()
call HopeRelic_CreateUI()
set HopeQoL_UIReady=HopeQoL_Hud!=0 and HopeRoute_Panel!=0 and HopeTurn_Panel!=0 and HopeQoL_Panel!=0 and HopeQoL_LifeText!=0 and HopeQoL_Details!=0 and HopeQoL_GrowthDetails!=0
if HopeQoL_UIReady then
set HopeQoL_UIPhase="已完成"
else
set HopeQoL_UIPhase="基础控件缺失"
endif
endfunction

function HopeQoL_Diagnostics takes nothing returns nothing
if GetTriggerPlayer()==GetLocalPlayer() then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,20.,"AI爬塔 1.0.4："+HopeQoL_UIPhase+"；按钮回退 "+I2S(HopeQoL_UIFallbacks)+"|n资源："+HopeQoL_UIResources+"|n速览 "+I2S(HopeQoL_Hud)+" / 准备 "+I2S(HopeRoute_Panel)+" / 属性 "+I2S(HopeQoL_Panel)+" / 回合 "+I2S(HopeTurn_Panel)+"|n文字：生命 "+I2S(HopeQoL_LifeText)+" / 属性 "+I2S(HopeQoL_Details))
endif
endfunction

// Allocate synchronized gameplay handles before any optional UI construction.
// A template failure must not remove chat, keys, tags or the refresh timer.
function HopeQoL_Init takes nothing returns nothing
local integer i=0
local trigger chat=CreateTrigger()
local trigger leave=CreateTrigger()
local trigger diagnostic=CreateTrigger()
local quest q=CreateQuest()
loop
exitwhen i>=6
call TriggerRegisterPlayerChatEvent(chat,Player(i),"-ready",true)
call TriggerRegisterPlayerChatEvent(chat,Player(i),"-wait",true)
call TriggerRegisterPlayerChatEvent(chat,Player(i),"-route",true)
call TriggerRegisterPlayerChatEvent(diagnostic,Player(i),"-ui",true)
call TriggerRegisterPlayerEvent(leave,Player(i),EVENT_PLAYER_LEAVE)
set i=i+1
endloop
call TriggerAddAction(chat,function HopeRoute_Chat)
call TriggerAddAction(leave,function HopeRoute_Leave)
call TriggerAddAction(diagnostic,function HopeQoL_Diagnostics)
call DzTriggerRegisterKeyEventByCode(null,113,1,false,function HopeQoL_SelectBag)
call DzTriggerRegisterKeyEventByCode(null,114,1,false,function HopeQoL_SelectHero)
call DzTriggerRegisterKeyEventByCode(null,115,1,false,function HopeQoL_ToggleStats)
call DzTriggerRegisterKeyEventByCode(null,116,1,false,function HopeQoL_ToggleHud)
call DzTriggerRegisterKeyEventByCode(null,117,1,false,function HopeChoice_ToggleLocal)
set i=1
loop
exitwhen i>6
set HopeTeam_APTag[i]=CreateTextTag()
call DzTextTagSetShadowColor(HopeTeam_APTag[i],0)
call SetTextTagPermanent(HopeTeam_APTag[i],true)
call SetTextTagVisibility(HopeTeam_APTag[i],false)
set i=i+1
endloop
call QuestSetTitle(q,"AI爬塔 1.0.4 · 快捷指南")
call QuestSetDescription(q,"速览位于左上头像下，显示生命、魔法、行动点、专注与背包占用。|nF2：定位助手。F3：定位英雄或小游戏角色，保留缩放。|nF4：展开/收起属性。Esc：只关闭已展开的资料面板，不打开属性。|nF5：只收起速览，再按恢复；准备、队友行动点、怪物意图和结束回合仍显示。|nF6：收起/展开战利品、成长、升级与技能替换，保留选项。收起后即可查看其他数据。"+"|nQ 攻击、W 防御、F 专注、G 结束回合、H 药剂、R 镜头锁定、Tab 查看保留。|n右键双击物品可在英雄和助手之间转交；失败时检查格子。防御可重复使用，需足够行动点与魔法。|n小地图上方可直接查看属性、存档、遗物和抽奖；这些入口不受 F5 影响。")
call QuestSetIconPath(q,"ReplaceableTextures\\CommandButtons\\BTNSelectHeroOn.blp")
call QuestSetRequired(q,false)
call QuestSetDiscovered(q,true)
set q=CreateQuest()
call QuestSetTitle(q,"AI爬塔 1.0.4 · 属性与存档")
call QuestSetDescription(q,"点击属性详情或按 F4，查看三围、六项成长与评级、暴击、护甲减伤和伤害倍率。Esc 只关闭已打开的属性或存档面板，也可关闭遗物和礼包抽奖。|n存档显示十项永久成长的累计加成、次数、上限与兑换价格。每项最多 5 次；新购成长在平台结算后于下一局生效。|n生命 +10、魔法 +1 是免费基底，不计入购买。永久数据未载入时暂不能兑换。"+"|n遗物独立显示本局收藏，点击名称查看完整效果，底部翻页。|n礼包抽奖每次5积分，55%谢谢惠顾；六种礼包概率在面板公开。重复结果不叠加、不重抽、不返还，全部拥有后停止抽奖。新礼包永久解锁，提交平台结算后下局生效。|n奖励挡住数据时，点收起或按 F6，再原样展开继续选择。|n选中敌人可看简短行动预告；切回角色后自动收起。")
call QuestSetRequired(q,false)
call QuestSetDiscovered(q,true)
set q=CreateQuest()
call QuestSetTitle(q,"选路、准备与出发")
call QuestSetDescription(q,"开局由主机指定路线选择者。路线选择者点击黄色可达节点或路线列表提出路线，路线选择者选路时自动准备（仍须先领完奖励），其他人完成战利品、购物和背包整理后点击准备。全员准备后，路线选择者点击准备面板的【出发】。|n未选择战利品（或明确放弃）时不能准备；新发放奖励会撤销准备。|n换路线会自动确认路线选择者，队友需重新确认；取消准备立即阻止推进。离开玩家不计入等待人数，其他人重新确认。|n聊天命令：-ready 准备；-wait 取消；-route 查看状态。准备面板独立显示，F5 只收起速览。|n没有超时自动出发或强制跳过队友。")
call QuestSetRequired(q,false)
call QuestSetDiscovered(q,true)
set q=CreateQuest()
call QuestSetTitle(q,"伤害预览与敌人状态")
call QuestSetDescription(q,"不点击也能看头顶简短意图：攻击Cola(20)表示攻击Cola、减伤前伤害20。防御(DEF+10)表示增加10护甲，强化(ATK+3)表示增加3攻击。意图数值按原版取整显示，实际结算遵循原规则。施法和打断分别标记。攻击指向自己时写“你”；昵称按完整字符显示；长名省略，同名或缩写相同时附加编号，队友行动点旁显示相同名字。已出手的敌人等待下一轮预告。|n选中敌人时，面板显示具体意图和当前有效的中毒、破甲与虚弱；没有效果就不占空间。切换目标会收起。|n中毒层数按六名玩家分别结算，面板列出合计层数、你的层数和本轮毒伤参考。参考值按当前属性计算，已计增伤、脚本魔抗和暴击范围；护甲、免疫与追击另计。头顶只保留毒层数，毒伤详情在面板查看。"+"|n上次毒结算净扣血：上一轮六次直接毒伤造成的实际生命净减少，不含稍后触发的追击；没有记录时不显示。|n破甲显示本轮已经降低的护甲量及当前护甲；敌人回合复原护甲后清除。虚弱显示下次攻击降低 30%，攻击预告本身已经计入，不再减第二次。|n鼠标移到技能上查看按当前属性计算的预估。技能说明中保留各自的随机区间、触发条件与资源消耗；预估不额外掷随机数，不提前消耗暴击或精确打击。")
call QuestSetRequired(q,false)
call QuestSetDiscovered(q,true)
call TimerStart(CreateTimer(),.02,false,function HopeQoL_LoadUIResources)
call TimerStart(CreateTimer(),.05,false,function HopeQoL_CreateUI)
call TimerStart(CreateTimer(),.08,false,function HopeGrowth_CreateUI)
call TimerStart(CreateTimer(),.2,true,function HopeQoL_Refresh)
set q=null
set chat=null
set leave=null
set diagnostic=null
endfunction


function HopeJob_ShowFrame takes integer frame,boolean visible returns nothing
if frame!=0 then
call DzFrameShow(frame,visible)
endif
endfunction
function HopeJob_SetText takes integer frame,string value returns nothing
if frame!=0 then
call DzFrameSetText(frame,value)
endif
endfunction

function HopeJob_Round takes nothing returns integer
return udg_quanshu+1
endfunction
function HopeJob_AdvancedOpen takes nothing returns boolean
if udg_quanshu<2 then
return false
endif
if gg_unit_n019_0032!=null and GetUnitTypeId(gg_unit_n019_0032)!=0 and not IsUnitHidden(gg_unit_n019_0032) and GetWidgetLife(gg_unit_n019_0032)>.405 then
return true
endif
return gg_unit_n01C_0003!=null and GetUnitTypeId(gg_unit_n01C_0003)!=0 and not IsUnitHidden(gg_unit_n01C_0003) and GetWidgetLife(gg_unit_n01C_0003)>.405
endfunction
function HopeJob_InRoom takes player p returns boolean
local integer i=GetPlayerId(p)+1
local unit u=udg_hero[i]
local boolean ok=false
if i>=1 and i<=6 and u!=null then
set ok=GetUnitX(u)>=-3328. and GetUnitX(u)<=-1800. and GetUnitY(u)>=1800. and GetUnitY(u)<=3072. and GetWidgetLife(u)>.405 and not udg_ZhandouZhong
endif
set u=null
return ok
endfunction

function HopeReclass_First takes integer kind returns boolean
return kind=='N00D' or kind=='H003' or kind=='H001' or kind=='N007' or kind=='E008' or kind=='N00E' or kind=='O001' or kind=='O003' or kind=='HZ01'
endfunction
function HopeReclass_Can takes integer i returns boolean
return i>=1 and i<=6 and udg_hero[i]!=null and HopeReclass_First(GetUnitTypeId(udg_hero[i])) and not HopeJob_Awakened[i]
endfunction
function HopeReclass_Training takes unit u returns integer
if GetUnitTypeId(u)=='HZ01' then
return GetUnitAbilityLevel(u,'AZHP')*2
endif
return 0
endfunction
function HopeReclass_Points takes unit u returns integer
local integer kind=GetUnitTypeId(u)
if kind=='N00D' then
return GetUnitAbilityLevel(u,'A00P')
elseif kind=='H003' then
return GetUnitAbilityLevel(u,'A00Q')
elseif kind=='H001' then
return GetUnitAbilityLevel(u,'A00K')
elseif kind=='N007' then
return GetUnitAbilityLevel(u,'A00L')
elseif kind=='E008' then
return GetUnitAbilityLevel(u,'A00O')
elseif kind=='N00E' then
return GetUnitAbilityLevel(u,'A00N')+GetUnitAbilityLevel(u,'A04W')
elseif kind=='O001' then
return GetUnitAbilityLevel(u,'A01S')
elseif kind=='O003' then
return GetUnitAbilityLevel(u,'A02U')
elseif kind=='HZ01' then
return GetUnitAbilityLevel(u,'AZHP')
endif
return 0
endfunction
function HopeReclass_Blocker takes integer index,player p returns string
local integer i=GetPlayerId(p)+1
local unit u=udg_hero[i]
local integer deduction=HopeReclass_Training(u)
local string reason=""
if p==null or i<1 or i>6 or not HopeReclass_Can(i) then
set reason="重新转职仅限已一转、尚未二转的英雄。"
elseif index<0 or index>=HopeJob_Count or HopeJob_Stage[index]!=1 then
set reason="无效的重转职业。"
elseif HopeReclass_Busy[i] then
set reason="正在重新转职，请稍候。"
elseif not HopeJob_InRoom(p) then
set reason="请回到原泉水爬塔房间的一转入口。"
elseif HopeRoute_RewardPending(i-1) or HopeChoice_PlayerPending[i-1]>0 then
set reason="请先完成待选奖励。"
elseif udg_Ls_zj_Str[i]!=0 or udg_Ls_zj_Agi[i]!=0 or udg_Ls_zj_Int[i]!=0 or udg_Linshi_Str[i]!=0 or HopeMeditation_Active[i] then
set reason="请等待临时属性效果结束后再重新转职。"
elseif index!=24 and HopeJob_Target[index]==GetUnitTypeId(u) then
set reason="你已经是该职业，不会扣除积分。"
elseif GetHeroStr(u,false)-deduction<HopeJob_Str[index] or GetHeroAgi(u,false)-deduction<HopeJob_Agi[index] or GetHeroInt(u,false)-deduction<HopeJob_Int[index] then
set reason="移除旧职业修炼后的基础属性不足；装备和临时加成不计。"
elseif not HopeCloud_CanWrite(p) then
set reason="存档积分尚未就绪，暂时不能重新转职。"
elseif udg_Wj_jf[i]<10 then
set reason="重新转职需要10存档积分，当前 "+I2S(udg_Wj_jf[i])+"。"
endif
set u=null
return reason
endfunction

function HopeJob_Visible takes integer index,integer i returns boolean
if index<0 or index>=HopeJob_Count or i<1 or i>6 then
return false
endif
if HopeJob_Stage[index]>=2 and not HopeJob_AdvancedOpen() then
return false
endif
if HopeJob_Stage[index]==1 and HopeReclass_Can(i) then
return true
endif
if HopeJob_Awakened[i] and HopeJob_AwakenOption[i]==index then
return true
endif
return udg_hero[i]!=null and HopeJob_Source[index]==GetUnitTypeId(udg_hero[i]) and (not HopeJob_Awakened[i] or HopeJob_AwakenOption[i]==index)
endfunction
// Entrance selection is local presentation state; synchronized promotion never reads it.
function HopeJob_InPanel takes integer index,integer i returns boolean
return HopeJob_Visible(index,i) and ((HopeJob_Entry==1 and HopeJob_Stage[index]==1) or (HopeJob_Entry==2 and HopeJob_Stage[index]>=2))
endfunction
function HopeJob_WoodCost takes integer index returns integer
if index<0 or index>=HopeJob_Count then
return 0
endif
if HopeJob_Stage[index]==3 then
return 30
endif
return 0
endfunction
function HopeThird_StudyBlock takes integer index,player owner returns string
local integer p=GetPlayerId(owner)+1
if p<1 or p>6 or index<0 or index>=HopeJob_Count then
return "无效研习。"
endif
if not HopeJob_Awakened[p] or HopeJob_AwakenOption[p]!=index or not HopeThird_Passive[index] or udg_hero[p]==null then
return "该研习不属于当前三转职业。"
endif
if not HopeJob_InRoom(owner) then
return "请回到原泉水房间研习。"
endif
if HopeRoute_RewardPending(p-1) then
return "请先完成待选奖励。"
endif
if HopeThird_Level(udg_hero[p])>=3 then
return "三转被动已满级（3级）。"
endif
if HopeThird_Level(udg_hero[p])<1 then
return "尚未获得三转被动。"
endif
if GetHeroSkillPoints(udg_hero[p])<1 then
return "技能点不足；每次研习消耗1技能点，后续升级可继续获得技能点。"
endif
return ""
endfunction
function HopeThird_Study takes integer index,player owner returns nothing
local integer p=GetPlayerId(owner)+1
local integer level=0
local string reason=HopeThird_StudyBlock(index,owner)
if reason!="" then
call DisplayTimedTextToPlayer(owner,0,0,4.,reason)
return
endif
set level=HopeThird_Level(udg_hero[p])
call UnitModifySkillPoints(udg_hero[p],-1)
if SetUnitAbilityLevel(udg_hero[p],HopeThird_Ability[index],level+1)!=level+1 then
call UnitModifySkillPoints(udg_hero[p],1)
call DisplayTimedTextToPlayer(owner,0,0,4.,"研习未完成，技能点已退还。")
return
endif
call DisplayTimedTextToPlayer(owner,0,0,4.,"三转被动提升至 "+I2S(level+1)+"/3 级；技能点 -1。")
endfunction
function HopeJob_GoldCost takes integer index returns integer
if index>=0 and index<HopeJob_Count and HopeJob_Stage[index]==3 then
return 1000
endif
return 0
endfunction

function HopeJob_Blocker takes integer index,player p returns string
local integer i=GetPlayerId(p)+1
local unit u=udg_hero[i]
local string s=""
if i>=1 and i<=6 and HopeJob_Awakened[i] and index==HopeJob_AwakenOption[i] and HopeThird_Passive[index] then
set u=null
return HopeThird_StudyBlock(index,p)
endif
if index>=0 and index<HopeJob_Count and HopeJob_Stage[index]==1 and HopeReclass_Can(i) then
set u=null
return HopeReclass_Blocker(index,p)
endif
if index<0 or index>=HopeJob_Count or i<1 or i>6 then
set s="无效的转职选项。"
elseif HopeJob_Stage[index]>=2 and not HopeJob_AdvancedOpen() then
set s="二转建筑尚未开放；第3轮出现后才能办理二转或三转。"
elseif not HopeJob_Visible(index,i) then
set s="该进阶不属于你的职业路线。"
elseif HopeJob_Awakened[i] then
set s="已完成三转，本局不能再次转职。"
elseif not HopeJob_InRoom(p) then
set s="请回到原来的泉水爬塔房间。"
elseif HopeRoute_RewardPending(i-1) then
set s="请先完成待选奖励。"
elseif HopeJob_Stage[index]==3 and HopeJob_Round()<4 then
set s="三转从第4轮开始解锁；完成前3轮即可，不需要通关第4轮。"
elseif HopeJob_Stage[index]==3 and GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)<HopeJob_WoodCost(index) then
set s="木材不足：三转需要 "+I2S(HopeJob_WoodCost(index))+" 木材，当前 "+I2S(GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER))+"。"
elseif HopeJob_Stage[index]==3 and GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<HopeJob_GoldCost(index) then
set s="金币不足：三转需要1000金币，当前 "+I2S(GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD))+"。"
elseif GetHeroLevel(u)<HopeJob_Level[index] then
set s="等级不足，需要等级 "+I2S(HopeJob_Level[index])+"。"
elseif GetHeroStr(u,false)<HopeJob_Str[index] or GetHeroAgi(u,false)<HopeJob_Agi[index] or GetHeroInt(u,false)<HopeJob_Int[index] then
set s="基础属性不足（装备和临时加成不计）。"
endif
set u=null
return s
endfunction
function HopeJob_Close takes nothing returns nothing
set HopeJob_Expanded=false
call HopeJob_ShowFrame(HopeJob_Panel,false)
endfunction
function HopeJob_Show takes player p,integer entry returns nothing
if GetPlayerId(p)<0 or GetPlayerId(p)>=6 or (entry!=1 and entry!=2) or not HopeJob_InRoom(p) then
return
endif
if entry==2 and not HopeJob_AdvancedOpen() then
return
endif
if p==GetLocalPlayer() and GetPlayerId(p)<6 then
if HopeGrowth_Pending[GetPlayerId(p)] then
set HopeChoice_Hidden=true
endif
set HopeJob_Entry=entry
set HopeJob_Selected=-1
set HopeJob_Page=0
set HopeJob_DetailPage=0
set HopeJob_Expanded=true
if HopeJob_Expanded then
call HopeLayout_Focus(5)
endif
set HopeQoL_Expanded=false
set HopeArchive_Expanded=false
set HopeGift_Expanded=false
set HopeRelic_Expanded=false
set HopeRoute_Details=false
call HopeJob_ShowFrame(HopeJob_Panel,true)
endif
endfunction
function HopeJob_Open takes nothing returns nothing
local player p=DzGetTriggerUIEventPlayer()
local integer entry=2
if GetUnitTypeId(udg_hero[GetPlayerId(p)+1])=='H000' or (HopeReclass_Can(GetPlayerId(p)+1) and not HopeJob_AdvancedOpen()) then
set entry=1
endif
call HopeJob_Show(p,entry)
set p=null
endfunction
function HopeJob_Select takes integer option returns nothing
set HopeJob_Selected=option
set HopeJob_Page=0
set HopeJob_DetailPage=0
endfunction
function HopeJob_Page0 takes nothing returns nothing
set HopeJob_Page=0
set HopeJob_DetailPage=0
endfunction
function HopeJob_Page1 takes nothing returns nothing
set HopeJob_Page=1
set HopeJob_DetailPage=0
endfunction
function HopeJob_Page2 takes nothing returns nothing
set HopeJob_Page=2
set HopeJob_DetailPage=0
endfunction
function HopeJob_Prev takes nothing returns nothing
set HopeJob_DetailPage=IMaxBJ(0,HopeJob_DetailPage-1)
endfunction
function HopeJob_Next takes nothing returns nothing
local integer count=0
if HopeJob_Selected<0 then
return
endif
if HopeJob_Page==1 then
set count=HopeJob_SkillCount[HopeJob_Selected]
elseif HopeJob_Page==2 then
set count=HopeJob_PassiveCount[HopeJob_Selected]
endif
set HopeJob_DetailPage=IMinBJ(IMaxBJ(0,count-1),HopeJob_DetailPage+1)
endfunction
// Replace only the hidden lineage. Keep ordinary first/second promotions on the original item triggers.
function HopeJob_ReplaceHidden takes player p,integer kind returns nothing
local integer i=GetPlayerId(p)+1
local unit old=udg_hero[i]
local unit u=CreateUnit(p,kind,GetUnitX(old),GetUnitY(old),GetUnitFacing(old))
local integer slot=0
local item it=null
local integer aid=0
local integer training=GetUnitAbilityLevel(old,'AZHP')
if GetUnitTypeId(old)=='H000' then
call SetHeroXP(u,0,false)
else
call SetHeroXP(u,GetHeroXP(old),false)
endif
call SetHeroStr(u,GetHeroStr(old,false)-udg_Ls_zj_Str[i],true)
call SetHeroAgi(u,GetHeroAgi(old,false)-udg_Ls_zj_Agi[i],true)
call SetHeroInt(u,GetHeroInt(old,false)-udg_Ls_zj_Int[i],true)
set udg_Ls_zj_Str[i]=0
set udg_Ls_zj_Agi[i]=0
set udg_Ls_zj_Int[i]=0
call SetUnitState(u,UNIT_STATE_MAX_LIFE,GetUnitState(old,UNIT_STATE_MAX_LIFE))
call SetUnitState(u,UNIT_STATE_MAX_MANA,GetUnitState(old,UNIT_STATE_MAX_MANA))
loop
exitwhen slot>=6
set it=UnitItemInSlot(old,slot)
if it!=null then
call UnitRemoveItem(old,it)
call UnitAddItem(u,it)
endif
set slot=slot+1
endloop
set aid=LoadInteger(YDHT,i,$412D8AC6)
if aid!=0 then
call UnitAddAbility(u,aid)
endif
set aid=LoadInteger(YDHT,i,$3FB1F9E0)
if aid!=0 then
call UnitAddAbility(u,aid)
endif
set aid=LoadInteger(YDHT,i,$590EE9FB)
if aid!=0 then
call UnitAddAbility(u,aid)
endif
if udg_R_Skill[i]!=0 and udg_R_Skill[i]!=$4130314C then
call UnitAddAbility(u,udg_R_Skill[i])
endif
call SetUnitState(u,ConvertUnitState(18),GetUnitState(u,ConvertUnitState(18))+I2R(udg_Gongjili_Jc[i]))
set udg_Minjie_jiaGong[i]=0
call SetUnitMoveSpeed(u,GetUnitMoveSpeed(old))
if GetUnitTypeId(old)!='H000' then
if training>0 then
call UnitAddAbility(u,'AZHP')
call SetUnitAbilityLevel(u,'AZHP',training)
call UnitMakeAbilityPermanent(u,true,'AZHP')
endif
call UnitModifySkillPoints(u,GetHeroSkillPoints(old)-GetHeroSkillPoints(u))
endif
set udg_hero[i]=u
call RemoveUnit(old)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE))
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA))
call SelectUnitForPlayerSingle(u,p)
set old=null
set u=null
set it=null
endfunction
function HopeJob_AddStats takes integer i,integer strength,integer agility,integer intelligence returns nothing
call SetHeroStr(udg_hero[i],GetHeroStr(udg_hero[i],false)+strength,true)
call SetHeroAgi(udg_hero[i],GetHeroAgi(udg_hero[i],false)+agility,true)
call SetHeroInt(udg_hero[i],GetHeroInt(udg_hero[i],false)+intelligence,true)
endfunction
function HopeThird_Unlock takes integer index,integer p returns nothing
local unit u=udg_hero[p]
local integer aid=HopeThird_Ability[index]
local integer old='AZ31'
loop
exitwhen old>'AZ36'
if old!=aid then
call UnitRemoveAbility(u,old)
endif
set old=old+1
endloop
call UnitAddAbility(u,aid)
call SetUnitAbilityLevel(u,aid,1)
call UnitMakeAbilityPermanent(u,true,aid)
set u=null
endfunction

function HopeJob_Awaken takes integer index,integer i returns nothing
local unit u=udg_hero[i]
local integer kind=0
if index==26 then
call HopeJob_ReplaceHidden(Player(i-1),'HZ03')
set u=udg_hero[i]
call HopeJob_AddStats(i,5,5,5)
set udg_Skill_Dm[i]=udg_Skill_Dm[i]+.15
set kind=5
elseif index==27 then
call HopeJob_AddStats(i,10,0,0)
set kind=1
call SetUnitState(u,UNIT_STATE_MAX_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE)+100.)
set udg_Defend_fangyu[i]=udg_Defend_fangyu[i]+8
elseif index==28 then
call HopeJob_AddStats(i,8,8,0)
set kind=1
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
elseif index==29 then
call HopeJob_AddStats(i,0,0,12)
set kind=4
call SetUnitState(u,UNIT_STATE_MAX_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA)+8.)
set udg_huihe_huilan[i]=udg_huihe_huilan[i]+2
elseif index==30 then
call HopeJob_AddStats(i,8,8,8)
set kind=6
set udg_Defend_fangyu[i]=udg_Defend_fangyu[i]+6
call SetUnitState(u,UNIT_STATE_MAX_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE)+60.)
elseif index==31 then
call HopeJob_AddStats(i,0,12,0)
set kind=2
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
set udg_Baoji_Damage[i]=udg_Baoji_Damage[i]+0.25
elseif index==32 then
call HopeJob_AddStats(i,0,10,0)
set kind=2
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
set udg_DEX[i]=udg_DEX[i]+3
set udg_jingque_Daji_jiacheng[i]=udg_jingque_Daji_jiacheng[i]+0.2
elseif index==33 then
call HopeJob_AddStats(i,0,14,0)
set kind=2
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
set udg_DEX[i]=udg_DEX[i]+2
elseif index==34 then
call HopeJob_AddStats(i,12,10,0)
set kind=2
set udg_Zuizhong_Dm[i]=udg_Zuizhong_Dm[i]+0.1
elseif index==35 then
call HopeJob_AddStats(i,0,10,0)
set kind=2
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
set udg_Skill_Dm[i]=udg_Skill_Dm[i]+0.15
elseif index==36 then
call HopeJob_AddStats(i,0,16,0)
set kind=2
set udg_jingque_Daji_jiacheng[i]=udg_jingque_Daji_jiacheng[i]+0.3
set udg_Baoji_Damage[i]=udg_Baoji_Damage[i]+0.25
elseif index==37 then
call HopeJob_AddStats(i,0,0,12)
set kind=3
call SetUnitState(u,UNIT_STATE_MAX_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA)+12.)
set udg_huihe_huilan[i]=udg_huihe_huilan[i]+2
set udg_Skill_Dm[i]=udg_Skill_Dm[i]+0.15
elseif index==38 then
call HopeJob_AddStats(i,0,0,14)
set kind=3
set udg_Fashang_Dm[i]=udg_Fashang_Dm[i]+0.2
set udg_Baoji_Lv[i]=udg_Baoji_Lv[i]+10
elseif index==39 then
call HopeJob_AddStats(i,12,0,0)
set kind=1
call SetUnitState(u,UNIT_STATE_MAX_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE)+80.)
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
elseif index==40 then
call HopeJob_AddStats(i,10,10,0)
set kind=1
call SetUnitState(u,UNIT_STATE_MAX_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE)+80.)
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
elseif index==41 then
call HopeJob_AddStats(i,18,0,0)
set kind=1
set udg_Baoji_Lv[i]=udg_Baoji_Lv[i]+15
set udg_Baoji_Damage[i]=udg_Baoji_Damage[i]+0.35
elseif index==42 then
call HopeJob_AddStats(i,10,10,0)
set kind=1
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
set udg_Skill_Dm[i]=udg_Skill_Dm[i]+0.15
endif
set HopeJob_Awakened[i]=true
set HopeJob_AwakenOption[i]=index
set HopeJob_UltimateKind[i]=kind
set HopeJob_LastCast[i]=-1
call HopeThird_Unlock(index,i)
call SetUnitState(u,UNIT_STATE_LIFE,GetUnitState(u,UNIT_STATE_MAX_LIFE))
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MAX_MANA))
set udg_xingdong_dian[i]=udg_xingdong_dianSx[i]
set u=null
endfunction

// Eligibility and payment use synchronized player/hero state, never UI selection.
function HopeReclass_Commit takes integer index,player p returns nothing
local integer i=GetPlayerId(p)+1
local string reason=HopeReclass_Blocker(index,p)
local unit old=udg_hero[i]
local unit u=null
local integer oldkind=GetUnitTypeId(old)
local integer pick=index
local integer target=0
local integer passive=0
local integer passivelevel=0
local integer refund=HopeReclass_Points(old)
local integer deduction=HopeReclass_Training(old)
local integer slot=0
local integer aid=0
local integer str=0
local integer agi=0
local integer intel=0
local integer oldpoints=GetHeroSkillPoints(old)
local integer points=oldpoints+refund
local real life=GetUnitState(old,UNIT_STATE_LIFE)
local real mana=GetUnitState(old,UNIT_STATE_MANA)
local real maximumlife=0.
local real maximummana=0.
if reason!="" then
call DisplayTimedTextToPlayer(p,0,0,5.,reason)
set old=null
return
endif
set HopeReclass_Busy[i]=true
// Query attributes after removing the actual native Aamk effect: do not assume
// whether a Warcraft build exposes that modifier through base-stat getters.
if oldkind=='N00D' then
set passive='A00P'
elseif oldkind=='E008' then
set passive='A00O'
endif
if passive!=0 then
set passivelevel=GetUnitAbilityLevel(old,passive)
if passivelevel>0 then
call UnitRemoveAbility(old,passive)
endif
endif
set str=GetHeroStr(old,false)-deduction
set agi=GetHeroAgi(old,false)-deduction
set intel=GetHeroInt(old,false)-deduction
if str<HopeJob_Str[index] or agi<HopeJob_Agi[index] or intel<HopeJob_Int[index] then
set reason="移除旧职业修炼后属性不足，未扣积分。"
else
if index==24 then
if GetRandomInt(1,100)<=10 then
set target='HZ01'
else
set pick=GetRandomInt(0,7)
set target=HopeJob_Target[pick]
endif
else
set target=HopeJob_Target[index]
endif
set u=CreateUnit(p,target,GetUnitX(old),GetUnitY(old),GetUnitFacing(old))
if u==null then
set reason="新职业创建失败，未扣积分，请重试。"
elseif not HopePoints_Spend(p,10) then
set reason="积分扣除未通过，原职业保留。"
call RemoveUnit(u)
set u=null
endif
endif
if reason!="" then
if passivelevel>0 then
call UnitAddAbility(old,passive)
call SetUnitAbilityLevel(old,passive,passivelevel)
endif
call UnitModifySkillPoints(old,oldpoints-GetHeroSkillPoints(old))
call SetUnitState(old,UNIT_STATE_LIFE,RMinBJ(life,GetUnitState(old,UNIT_STATE_MAX_LIFE)))
call SetUnitState(old,UNIT_STATE_MANA,RMinBJ(mana,GetUnitState(old,UNIT_STATE_MAX_MANA)))
set HopeReclass_Busy[i]=false
call DisplayTimedTextToPlayer(p,0,0,5.,reason)
set old=null
set u=null
return
endif
// SetHeroXP normally runs the map's HERO_LEVEL trigger. Suppress only that
// trigger's action while copying XP, preserving every earned global reward.
set HopeReclass_Replacing=true
call SetHeroXP(u,GetHeroXP(old),false)
set HopeReclass_Replacing=false
// Drop on the old hero first, so scripted equipment bonuses are undone once.
loop
exitwhen slot>=6
set HopeReclass_Items[i*6+slot]=UnitItemInSlot(old,slot)
if HopeReclass_Items[i*6+slot]!=null then
call UnitRemoveItem(old,HopeReclass_Items[i*6+slot])
endif
set slot=slot+1
endloop
set maximumlife=GetUnitState(old,UNIT_STATE_MAX_LIFE)
set maximummana=GetUnitState(old,UNIT_STATE_MAX_MANA)
// Remove the scripted hidden training on the old unit, letting the engine adjust
// its capacities before they are copied to the fresh class.
// The old hero is removed below; keep it alive while native capacities change.
if deduction>0 then
call SetUnitState(old,UNIT_STATE_LIFE,GetUnitState(old,UNIT_STATE_MAX_LIFE))
call SetHeroStr(old,GetHeroStr(old,false)-deduction,true)
call SetHeroAgi(old,GetHeroAgi(old,false)-deduction,true)
call SetHeroInt(old,GetHeroInt(old,false)-deduction,true)
set maximumlife=GetUnitState(old,UNIT_STATE_MAX_LIFE)
set maximummana=GetUnitState(old,UNIT_STATE_MAX_MANA)
endif
call SetHeroStr(u,GetHeroStr(old,false),true)
call SetHeroAgi(u,GetHeroAgi(old,false),true)
call SetHeroInt(u,GetHeroInt(old,false),true)
call SetUnitState(u,UNIT_STATE_MAX_LIFE,maximumlife)
call SetUnitState(u,UNIT_STATE_MAX_MANA,maximummana)
if oldkind=='N00D' and passivelevel>0 then
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]-1
set udg_xingdong_dian[i]=IMinBJ(udg_xingdong_dian[i],udg_xingdong_dianSx[i])
endif
if oldkind=='HZ01' then
set udg_cz1Str_up[i]=udg_cz1Str_up[i]-.15
set udg_cz2Agi_up[i]=udg_cz2Agi_up[i]-.15
set udg_cz3Int_up[i]=udg_cz3Int_up[i]-.15
endif
if target=='HZ01' then
set udg_cz1Str_up[i]=udg_cz1Str_up[i]+.15
set udg_cz2Agi_up[i]=udg_cz2Agi_up[i]+.15
set udg_cz3Int_up[i]=udg_cz3Int_up[i]+.15
endif
set aid=LoadInteger(YDHT,i,$412D8AC6)
if aid!=0 then
call UnitAddAbility(u,aid)
endif
set aid=LoadInteger(YDHT,i,$3FB1F9E0)
if aid!=0 then
call UnitAddAbility(u,aid)
endif
set aid=LoadInteger(YDHT,i,$590EE9FB)
if aid!=0 then
call UnitAddAbility(u,aid)
endif
if udg_R_Skill[i]!=0 and udg_R_Skill[i]!=$4130314C then
call UnitAddAbility(u,udg_R_Skill[i])
endif
call SetUnitState(u,ConvertUnitState(18),GetUnitState(u,ConvertUnitState(18))+I2R(udg_Gongjili_Jc[i]))
set udg_Minjie_jiaGong[i]=0
call SetUnitMoveSpeed(u,GetUnitMoveSpeed(old))
call UnitModifySkillPoints(u,points-GetHeroSkillPoints(u))
if udg_shengji_dian[i]>0 then
call UnitAddAbility(u,'Asud')
call AddUnitToStock(u,'h00F',udg_shengji_dian[i],udg_shengji_dian[i])
endif
// Auxiliary spell caster abilities belong to the chosen first profession.
call UnitRemoveAbility(udg_Mj_Danwei[i],'A00G')
call UnitRemoveAbility(udg_Mj_Danwei[i],'A00H')
if target=='N007' then
call UnitAddAbility(udg_Mj_Danwei[i],'A00G')
elseif target=='E008' then
call UnitAddAbility(udg_Mj_Danwei[i],'A00H')
endif
set udg_hero[i]=u
set slot=0
loop
exitwhen slot>=6
if HopeReclass_Items[i*6+slot]!=null then
call UnitAddItem(u,HopeReclass_Items[i*6+slot])
set HopeReclass_Items[i*6+slot]=null
endif
set slot=slot+1
endloop
call RemoveUnit(old)
call SetUnitState(u,UNIT_STATE_LIFE,RMinBJ(life,GetUnitState(u,UNIT_STATE_MAX_LIFE)))
call SetUnitState(u,UNIT_STATE_MANA,RMinBJ(mana,GetUnitState(u,UNIT_STATE_MAX_MANA)))
call SelectUnitForPlayerSingle(u,p)
set HopeRoute_Ready[i-1]=false
set HopeReclass_Busy[i]=false
call DisplayTextToPlayer(p,0,0,"重新转职完成："+GetUnitName(u)+"；消耗10存档积分，返还职业技能点 "+I2S(refund)+"。")
if p==GetLocalPlayer() then
set HopeJob_Expanded=false
call HopeJob_ShowFrame(HopeJob_Panel,false)
endif
set old=null
set u=null
endfunction

function HopeJob_Commit takes integer index returns nothing
local player p=DzGetTriggerUIEventPlayer()
local integer i=GetPlayerId(p)+1
local string blocker=HopeJob_Blocker(index,p)
local integer pick=index
local item it=null
if index>=0 and index<HopeJob_Count and HopeJob_Stage[index]==1 and HopeReclass_Can(i) then
call HopeReclass_Commit(index,p)
set p=null
return
endif
if blocker!="" then
call DisplayTimedTextToPlayer(p,0,0,5.,blocker)
set p=null
return
endif
if HopeJob_Awakened[i] and HopeJob_AwakenOption[i]==index and HopeThird_Passive[index] then
call HopeThird_Study(index,p)
set p=null
return
endif
if index==24 then
// Gameplay RNG runs only in this synchronized callback, never during preview/refresh.
if GetRandomInt(1,100)<=10 then
call HopeJob_ReplaceHidden(p,'HZ01')
set udg_cz1Str_up[i]=udg_cz1Str_up[i]+.15
set udg_cz2Agi_up[i]=udg_cz2Agi_up[i]+.15
set udg_cz3Int_up[i]=udg_cz3Int_up[i]+.15
call DisplayTextToPlayer(p,0,0,"|cffffd36a随机转职：万象行者（隐藏职业）！|r")
else
set pick=GetRandomInt(0,7)
set HopeJob_RandomPromotion=true
set it=CreateItem(HopeJob_Item[pick],GetUnitX(udg_hero[i]),GetUnitY(udg_hero[i]))
call UnitAddItem(udg_hero[i],it)
call RemoveItem(it)
set HopeJob_RandomPromotion=false
call DisplayTextToPlayer(p,0,0,"随机转职："+HopeJob_Name[pick])
endif
elseif index==25 then
call HopeJob_ReplaceHidden(p,'HZ02')
call HopeJob_AddStats(i,3,3,3)
set udg_xingdong_dianSx[i]=udg_xingdong_dianSx[i]+1
set udg_xingdong_dian[i]=udg_xingdong_dianSx[i]
call DisplayTextToPlayer(p,0,0,"已进阶为隐藏二转：万象织法者。")
elseif HopeJob_Stage[index]==3 then
// Eligibility and the current balance were checked in this synchronized callback.
call SetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER,GetPlayerState(p,PLAYER_STATE_RESOURCE_LUMBER)-HopeJob_WoodCost(index))
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-HopeJob_GoldCost(index))
call HopeJob_Awaken(index,i)
if HopeThird_Passive[index] then
call DisplayTextToPlayer(p,0,0,"|cffffd36a三转完成："+HopeJob_Name[index]+"；消耗30木材+1000金币。已获得1级专属被动，在转职窗口花技能点研习。|r")
else
call DisplayTextToPlayer(p,0,0,"|cffffd36a三转完成："+HopeJob_Name[index]+"；消耗30木材+1000金币。按Z使用专属觉醒技能。|r")
endif
else
set it=CreateItem(HopeJob_Item[index],GetUnitX(udg_hero[i]),GetUnitY(udg_hero[i]))
call UnitAddItem(udg_hero[i],it)
call RemoveItem(it)
call SelectUnitForPlayerSingle(udg_hero[i],p)
if GetUnitTypeId(udg_hero[i])==HopeJob_Target[index] then
call DisplayTextToPlayer(p,0,0,"已转职为："+HopeJob_Name[index])
else
call DisplayTextToPlayer(p,0,0,"转职未完成，请检查原职业条件。")
endif
endif
set HopeRoute_Ready[i-1]=false
if p==GetLocalPlayer() then
set HopeJob_Expanded=false
call HopeJob_ShowFrame(HopeJob_Panel,false)
endif
set it=null
set p=null
endfunction
