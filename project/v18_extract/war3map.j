function HopeMeta_Damage takes unit source,unit target,real amount,boolean critical returns real
local integer i=GetPlayerId(GetOwningPlayer(source))
local integer t=GetPlayerId(GetOwningPlayer(target))
local real damage=amount
local real absorbed=0.
if i>=0 and i<6 and GetOwningPlayer(target)==Player(11) and HopeMeta_Started[i] and amount>0. then
call HopeMeta_CheckTurn(i)
set damage=damage*HopeMeta_Out(i,YDWEIsEventAttackType(ATTACK_TYPE_CHAOS) or YDWEIsEventAttackType(ATTACK_TYPE_MAGIC),HopeCoop_IsBoss(target),critical)
if udg_huihe_s==1 and HopeMeta_Hits[i]==0 and HopeMeta_RunKey[i]==1 then
call SetUnitState(udg_hero[i+1],UNIT_STATE_MANA,RMinBJ(GetUnitState(udg_hero[i+1],UNIT_STATE_MAX_MANA),GetUnitState(udg_hero[i+1],UNIT_STATE_MANA)+2.))
endif
set HopeMeta_Hits[i]=HopeMeta_Hits[i]+1
endif
if t>=0 and t<6 and target==udg_hero[t+1] and HopeMeta_Started[t] and GetOwningPlayer(source)==Player(11) then
call HopeMeta_CheckTurn(t)
set damage=damage/Pow(HopeMeta_RawDef(t),HopeMeta_Exponent(t))
set absorbed=RMinBJ(damage,HopeMeta_Shield[t])
set HopeMeta_Shield[t]=HopeMeta_Shield[t]-absorbed
set damage=damage-absorbed
endif
return RMaxBJ(0.,damage)
endfunction

