call ModifyHeroStat(bj_HEROSTAT_INT,LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$CC612AE3),bj_MODIFYMETHOD_SUB,udg_Ls_zj_Int[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)])
set udg_Ls_zj_Int[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)]=0
call SetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$CC612AE3),UNIT_STATE_MAX_LIFE,GetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9F0C6E00),UNIT_STATE_MAX_LIFE))
