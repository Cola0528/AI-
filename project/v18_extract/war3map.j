function HopeDraw_Quality takes string result returns string
local string color=""
if result=="谢谢惠顾（未获得奖励）" then
set color="|cff9aa0a6"
elseif result=="力量 +1" or result=="敏捷 +1" or result=="智力 +1" then
set color="|cff959697"
elseif result=="全属性 +3" then
set color="|cffe4e5e4"
elseif result=="技能伤害 +10% / 法术伤害 +10%" then
set color="|cff719fff"
elseif result=="暴击率 +5% / 暴击伤害 +10%" then
set color="|cffbf80ef"
elseif result=="最终伤害 +10%" then
set color="|cfffe8a0e"
elseif result=="圣剑（英雄满包转入助手；都满才落地）" then
set color="|cfffffc01"
endif
if color=="" then
return result
endif
return color+result+"|r"
endfunction

function HopeDraw_Reward takes player p returns string
local integer i=GetPlayerId(p)+1
local unit u=udg_hero[i]
local string result=""
// Preserve every branch and probability from the original ten-draw table.
if GetRandomInt(1,10)>=6 then
if GetRandomInt(1,3)==1 then
call ModifyHeroStat(bj_HEROSTAT_STR,u,bj_MODIFYMETHOD_ADD,1)
set result="力量 +1"
elseif GetRandomInt(1,2)==1 then
call ModifyHeroStat(bj_HEROSTAT_AGI,u,bj_MODIFYMETHOD_ADD,1)
set result="敏捷 +1"
else
call ModifyHeroStat(bj_HEROSTAT_INT,u,bj_MODIFYMETHOD_ADD,1)
set result="智力 +1"
endif
elseif GetRandomInt(1,5)>=3 then
call ModifyHeroStat(bj_HEROSTAT_STR,u,bj_MODIFYMETHOD_ADD,3)
call ModifyHeroStat(bj_HEROSTAT_AGI,u,bj_MODIFYMETHOD_ADD,3)
call ModifyHeroStat(bj_HEROSTAT_INT,u,bj_MODIFYMETHOD_ADD,3)
set result="全属性 +3"
elseif GetRandomInt(1,5)>=2 then
if GetRandomInt(1,3)==1 then
set udg_Skill_Dm[i]=udg_Skill_Dm[i]+.1
set udg_Fashang_Dm[i]=udg_Fashang_Dm[i]+.1
set result="技能伤害 +10% / 法术伤害 +10%"
elseif GetRandomInt(1,2)==1 then
set udg_Baoji_Damage[i]=udg_Baoji_Damage[i]+.1
set udg_Baoji_Lv[i]=udg_Baoji_Lv[i]+5
set result="暴击率 +5% / 暴击伤害 +10%"
else
set udg_Zuizhong_Dm[i]=udg_Zuizhong_Dm[i]+.1
set result="最终伤害 +10%"
endif
else
call HopeInventory_Give($49303456,u)
set result="圣剑（英雄满包转入助手；都满才落地）"
endif
set u=null
return HopeDraw_Quality(result)
endfunction
function HopeDraw_SaveRecord takes player p,string title,string text,boolean reveal returns nothing
local integer i=GetPlayerId(p)
local integer page=0
set HopeDraw_Count[i]=HopeDraw_Count[i]+1
set page=ModuloInteger(HopeDraw_Count[i],64)*2
call SaveStr(HopeDraw_History,i,page,title)
call SaveStr(HopeDraw_History,i,page+1,text)
set HopeDraw_Serial=HopeDraw_Serial+1
call SaveInteger(HopeDraw_History,i,1000+page,HopeDraw_Serial)
call SaveStr(HopeDraw_History,i,2000+page,HopeName_Clean(GetPlayerName(p)))
if p==GetLocalPlayer() then
set HopeDraw_Page=HopeDraw_Count[i]
if reveal then
set HopeDraw_Team=false
set HopeLog_Cached=-1
set HopeDraw_Open=true
call HopeLayout_Focus(7)
set HopeChoice_Hidden=true
endif
endif
endfunction
function HopeDraw_Record takes player p,string title,string text returns nothing
call HopeDraw_SaveRecord(p,title,text,true)
endfunction
function HopeDraw_Ten takes player p returns boolean
local integer i=GetPlayerId(p)
local integer n=1
local string text=""
if i<0 or i>=6 or HopeDraw_Busy[i] or udg_hero[i+1]==null or GetUnitTypeId(udg_hero[i+1])==0 then
return false
endif
if GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)<648 then
call DisplayTextToPlayer(p,0,0,"十连抽需要648金币，当前金币不足。")
return false
endif
set HopeDraw_Busy[i]=true
call SetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD,GetPlayerState(p,PLAYER_STATE_RESOURCE_GOLD)-648)
loop
exitwhen n>10
set text=text+I2S(n)+". "+HopeDraw_Reward(p)+"|n"
set n=n+1
endloop
call HopeDraw_Record(p,"十连抽结果 · 消耗648金币",text)
set HopeDraw_Busy[i]=false
return true
endfunction



