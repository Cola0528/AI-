// Camera and selection changes are client-local; gameplay state stays synchronized.
// ResetToGameCamera releases a previous unit controller, but also resets the lens.
// Keep every view field so F3, room changes and unlocking never force a new zoom.
function HopeCamera_ResetKeepView takes nothing returns nothing
local real distance=GetCameraField(CAMERA_FIELD_TARGET_DISTANCE)
local real attack=Rad2Deg(GetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK))
local real rotation=Rad2Deg(GetCameraField(CAMERA_FIELD_ROTATION))
local real roll=Rad2Deg(GetCameraField(CAMERA_FIELD_ROLL))
local real fov=Rad2Deg(GetCameraField(CAMERA_FIELD_FIELD_OF_VIEW))
local real z=GetCameraField(CAMERA_FIELD_ZOFFSET)
local real farz=GetCameraField(CAMERA_FIELD_FARZ)
call ResetToGameCamera(0.)
call SetCameraField(CAMERA_FIELD_TARGET_DISTANCE,distance,0.)
call SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK,attack,0.)
call SetCameraField(CAMERA_FIELD_ROTATION,rotation,0.)
call SetCameraField(CAMERA_FIELD_ROLL,roll,0.)
call SetCameraField(CAMERA_FIELD_FIELD_OF_VIEW,fov,0.)
call SetCameraField(CAMERA_FIELD_ZOFFSET,z,0.)
call SetCameraField(CAMERA_FIELD_FARZ,farz,0.)
endfunction

function HopeCamera_FocusUnit takes player p,unit u,boolean follow returns nothing
if p==GetLocalPlayer() and u!=null and GetUnitTypeId(u)!=0 then
call HopeCamera_ResetKeepView()
call ClearSelection()
call SelectUnit(u,true)
call PanCameraToTimed(GetUnitX(u),GetUnitY(u),0.)
if follow then
call SetCameraTargetController(u,0.,0.,false)
endif
endif
endfunction

function HopeMini_Focus takes player p returns nothing
call HopeCamera_FocusUnit(p,HopeMini_Actor[GetPlayerId(p)+1],true)
endfunction

// The generic room-entry callback runs after the minigame creation trigger.
// It must not pan back to the old, inactive hero after a minigame actor exists.
function HopeCamera_EnterRoom takes player p returns nothing
if HopeMini_Actor[GetPlayerId(p)+1]!=null then
call HopeMini_Focus(p)
else
call HopeCamera_FocusUnit(p,udg_hero[GetPlayerId(p)+1],LoadBoolean(YDHT,GetHandleId(udg_hero[GetPlayerId(p)+1]),$799151CA))
endif
endfunction

// One synchronized next-frame correction handles same-frame camera transitions.
// Do not keep recentering every UI tick: players can still inspect the arena.
function HopeMini_FocusAfterEntry takes nothing returns nothing
local timer t=GetExpiredTimer()
local player p=LoadPlayerHandle(YDHT,GetHandleId(t),0)
local unit u=LoadUnitHandle(YDHT,GetHandleId(t),1)
if u!=null and HopeMini_Actor[GetPlayerId(p)+1]==u and GetUnitTypeId(u)!=0 then
call HopeMini_Focus(p)
endif
call FlushChildHashtable(YDHT,GetHandleId(t))
call DestroyTimer(t)
set u=null
set p=null
set t=null
endfunction

function HopeMini_Attach takes player p,unit u returns nothing
local timer t=null
set HopeMini_Actor[GetPlayerId(p)+1]=u
call SaveBoolean(YDHT,GetHandleId(udg_hero[GetPlayerId(p)+1]),$799151CA,false)
call HopeMini_Focus(p)
if u!=null then
set t=CreateTimer()
call SavePlayerHandle(YDHT,GetHandleId(t),0,p)
call SaveUnitHandle(YDHT,GetHandleId(t),1,u)
call TimerStart(t,.03,false,function HopeMini_FocusAfterEntry)
endif
set t=null
endfunction

function HopeMini_Detach takes player p returns nothing
set HopeMini_Actor[GetPlayerId(p)+1]=null
call HopeCamera_FocusUnit(p,udg_hero[GetPlayerId(p)+1],false)
endfunction

// A02U poison has six separate source stacks in the original enemy hashtable.
// These getters never infer damage from the sum or mutate any combat state.
function HopeStatus_Init takes nothing returns nothing
if HopeStatus_History==null then
set HopeStatus_History=InitHashtable()
endif
endfunction

function HopeStatus_ClearHistory takes unit u returns nothing
if HopeStatus_History!=null and u!=null then
call FlushChildHashtable(HopeStatus_History,GetHandleId(u))
endif
endfunction

function HopeStatus_RecordPoison takes unit u,real amount returns nothing
if HopeStatus_History!=null and u!=null and GetUnitTypeId(u)!=0 and IsUnitAliveBJ(u) then
call SaveReal(HopeStatus_History,GetHandleId(u),1,RMaxBJ(0.,amount))
call SaveInteger(HopeStatus_History,GetHandleId(u),2,udg_huihe_s)
endif
endfunction

// Format only after the real calculation; never cast large damage to integer.
function HopeStatus_Number takes real value returns string
local real magnitude=RAbsBJ(value)
// Avoid real literals whose integer part exceeds signed-32-bit validation.
// Build this unit from safe real operands; never write a trillion literal.
local real trillion=100000000.*10000.
if magnitude>=trillion then
return R2SW(value/trillion,1,1)+"万亿"
elseif magnitude>=100000000. then
return R2SW(value/100000000.,1,1)+"亿"
elseif magnitude>=10000. then
return R2SW(value/10000.,1,1)+"万"
elseif value==I2R(R2I(value)) then
return I2S(R2I(value))
elseif magnitude<.001 then
if value>0. then
return "<0.001"
endif
return ">-0.001"
elseif magnitude<.01 then
return R2SW(value,1,3)
elseif magnitude<.1 then
return R2SW(value,1,2)
endif
return R2SW(value,1,1)
endfunction

function HopeStatus_PoisonLastLine takes unit u returns string
if HopeStatus_History==null or u==null then
return ""
endif
if not HaveSavedReal(HopeStatus_History,GetHandleId(u),1) then
return ""
endif
return "上次毒结算净扣血 "+HopeStatus_Number(LoadReal(HopeStatus_History,GetHandleId(u),1))
endfunction

function HopeStatus_PoisonKey takes integer playerIndex returns integer
if playerIndex==0 then
return $E9A9F8D3
elseif playerIndex==1 then
return $3011B666
elseif playerIndex==2 then
return $161A4BE6
elseif playerIndex==3 then
return $4088962
elseif playerIndex==4 then
return $C0E295B1
elseif playerIndex==5 then
return $60AEA644
endif
return 0
endfunction

function HopeStatus_PoisonCount takes unit u,integer playerIndex returns integer
local integer count=0
if u==null or playerIndex<0 or playerIndex>=6 then
return 0
endif
if GetUnitTypeId(u)==0 or not IsUnitAliveBJ(u) then
return 0
endif
set count=LoadInteger(YDHT,GetHandleId(u),HopeStatus_PoisonKey(playerIndex))
if count<0 then
return 0
endif
return count
endfunction

function HopeStatus_PoisonTotal takes unit u returns integer
local integer i=0
local integer total=0
loop
exitwhen i>=6
set total=total+HopeStatus_PoisonCount(u,i)
set i=i+1
endloop
return total
endfunction

function HopeStatus_PoisonSourceBase takes unit u,integer playerIndex returns real
local integer count=HopeStatus_PoisonCount(u,playerIndex)
local real amount=0.
local unit source=null
if count<=0 then
return 0.
endif
set source=udg_hero[playerIndex+1]
if source!=null then
set amount=I2R(count)*GetUnitState(source,ConvertUnitState(20))*.3*I2R(GetUnitAbilityLevel(source,$41303255))
endif
set source=null
if amount<=0. then
return 0.
endif
return amount
endfunction

// The exact sum of the six original pre-engine damage calls at current stats.
// Final health loss may also depend on native mitigation and damage triggers.
function HopeStatus_PoisonBase takes unit u returns real
local integer i=0
local real amount=0.
loop
exitwhen i>=6
set amount=amount+HopeStatus_PoisonSourceBase(u,i)
set i=i+1
endloop
return amount
endfunction

// Known script multipliers only. Native armor/immune rules and asynchronous
// follow-up strikes are deliberately not represented as guaranteed HP loss.
function HopeStatus_PoisonSourceReference takes unit u,integer playerIndex,boolean upper returns real
local real normal=HopeStatus_PoisonSourceBase(u,playerIndex)
local real critical=0.
local integer chance=0
if normal<=0. then
return 0.
endif
set normal=RMaxBJ(0.,normal*udg_Zuizhong_Dm[playerIndex+1]*(1.-LoadReal(YDHT,GetHandleId(u),$3449D65E)))
set chance=udg_Baoji_Lv[playerIndex+1]
set critical=RMaxBJ(0.,normal*udg_Baoji_Damage[playerIndex+1]*HopeMeta_Out(playerIndex,false,HopeCoop_IsBoss(u),true))
set normal=normal*HopeMeta_Out(playerIndex,false,HopeCoop_IsBoss(u),false)
if chance<=0 then
return normal
elseif chance>=100 then
return critical
elseif upper then
return RMaxBJ(normal,critical)
endif
return RMinBJ(normal,critical)
endfunction

function HopeStatus_PoisonReference takes unit u,boolean upper returns real
local integer i=0
local real amount=0.
loop
exitwhen i>=6
set amount=amount+HopeStatus_PoisonSourceReference(u,i,upper)
set i=i+1
endloop
return amount
endfunction

function HopeStatus_PoisonRange takes unit u,boolean compact returns string
local real low=HopeStatus_PoisonReference(u,false)
local real high=HopeStatus_PoisonReference(u,true)
local string left=""
local string right=""
set left=HopeStatus_Number(low)
set right=HopeStatus_Number(high)
if left==right then
return left
endif
// KK fonts may omit the en dash and join both values.
return left+" 至 "+right
endfunction

function HopeStatus_PoisonPreviewLine takes unit u returns string
if HopeStatus_PoisonTotal(u)<=0 then
return ""
endif
return "本轮毒伤参考 "+HopeStatus_PoisonRange(u,false)
endfunction

function HopeStatus_PoisonBaseText takes unit u returns string
if HopeStatus_PoisonTotal(u)<=0 then
return ""
endif
return "原始毒伤基值 "+HopeStatus_Number(HopeStatus_PoisonBase(u))
endfunction

function HopeStatus_PoisonCaveat takes nothing returns string
return "已计增伤/魔抗/暴击|n护甲、免疫与追击另计"
endfunction

function HopeStatus_PoisonDetails takes unit u,player p returns string
local integer total=HopeStatus_PoisonTotal(u)
local integer own=HopeStatus_PoisonCount(u,GetPlayerId(p))
if total<=0 then
return ""
endif
return "|cff8be28b中毒合计 "+I2S(total)+" 层|r · 你的 "+I2S(own)+" 层"
endfunction

// Presentation-only armor reduction history. Original combat setters remain in place.
// Reuse the status display table; keys 1/2 belong to observed poison history.
// Spawn/death/room-exit display cleanup removes the entire per-unit child table.
function HopeDebuff_RecordArmor takes unit u,real beforeArmor returns nothing
local real reduced=0.
if HopeStatus_History!=null and u!=null and GetUnitTypeId(u)!=0 and IsUnitAliveBJ(u) then
set reduced=beforeArmor-GetUnitState(u,ConvertUnitState(32))
if reduced>0.00001 then
call SaveReal(HopeStatus_History,GetHandleId(u),3,LoadReal(HopeStatus_History,GetHandleId(u),3)+reduced)
endif
endif
endfunction

function HopeDebuff_ClearArmor takes unit u returns nothing
if HopeStatus_History!=null and u!=null then
call RemoveSavedReal(HopeStatus_History,GetHandleId(u),3)
endif
endfunction

function HopeDebuff_Armor takes unit u returns real
if HopeStatus_History==null or u==null or GetUnitTypeId(u)==0 or not IsUnitAliveBJ(u) then
return 0.
endif
return LoadReal(HopeStatus_History,GetHandleId(u),3)
endfunction

function HopeDebuff_Weakened takes unit u returns boolean
if u==null or GetUnitTypeId(u)==0 or not IsUnitAliveBJ(u) then
return false
endif
// A canceled attack is already represented by the original intent kind "1".
return LoadStr(YDHT,GetHandleId(u),$9CF3AFFA)=="attack" and LoadBoolean(YDHT,GetHandleId(u),$E5CD2B7)
endfunction

function HopeDebuff_Number takes real value returns string
if RAbsBJ(value-I2R(R2I(value)))<0.00001 then
return I2S(R2I(value))
endif
return R2SW(value,1,1)
endfunction

function HopeDebuff_Lines takes unit u returns integer
local integer count=0
if HopeDebuff_Armor(u)>0.00001 then
set count=count+1
endif
if HopeDebuff_Weakened(u) then
set count=count+1
endif
return count
endfunction

function HopeDebuff_Details takes unit u returns string
local string text=""
local real reduced=HopeDebuff_Armor(u)
if reduced>0.00001 then
set text="|cffffc58b破甲 -"+HopeDebuff_Number(reduced)+" · 当前甲 "+HopeDebuff_Number(GetUnitState(u,ConvertUnitState(32)))+"|r"
endif
if HopeDebuff_Weakened(u) then
if text!="" then
set text=text+"|n"
endif
set text=text+"|cffffc58b虚弱 · 下次攻击 -30%|r"
endif
return text
endfunction

// One persistent label per real combat enemy. Never recreate it on selection.
// No speculative targeting, RNG, orders or writes to the original intent data.
function HopeIntent_SetPhase takes unit u,integer phase returns nothing
if HopeStatus_History!=null and u!=null and GetUnitTypeId(u)!=0 and IsUnitAliveBJ(u) and GetOwningPlayer(u)==Player(11) then
call SaveInteger(HopeStatus_History,GetHandleId(u),4,phase)
endif
endfunction

// Original overhead labels truncate the displayed value, not combat state.
// Keep R2I inside a safe range. Larger native reals have no fractional precision.
function HopeIntent_Number takes real value returns string
if RAbsBJ(value)<1000000000. then
return I2S(R2I(value))
endif
return R2SW(value,1,0)
endfunction

function HopeIntent_SignedNumber takes real value returns string
if value<0. then
return HopeIntent_Number(value)
endif
return "+"+HopeIntent_Number(value)
endfunction

function HopeIntent_PlayerLabel takes player p returns string
return HopeName_Label(p,70)
endfunction

function HopeIntent_Headline takes unit u returns string
local string kind=LoadStr(YDHT,GetHandleId(u),$9CF3AFFA)
local integer phase=LoadInteger(HopeStatus_History,GetHandleId(u),4)
local unit target=null
local player owner=null
local string name="未定"
local string text="|cffb9bec7待定|r"
local integer poison=HopeStatus_PoisonTotal(u)
local boolean fallen=false
if kind=="1" then
set text="|cff9dd4b0打断|r"
elseif phase==2 then
// The original callback is one second after dispatch; delayed spells may remain.
set text="|cffb9bec7已出手|r"
elseif kind=="attack" then
set target=LoadUnitHandle(YDHT,GetHandleId(u),$EFC23552)
if target!=null and GetUnitTypeId(target)!=0 then
set owner=GetOwningPlayer(target)
if owner==GetLocalPlayer() then
set name="你"
else
set name=HopeIntent_PlayerLabel(owner)
endif
set fallen=not IsUnitAliveBJ(target)
set name=YDWEGetPlayerColorString(owner,name)
endif
set text="|cffffce93攻击|r"+name+"|cffffce93("+HopeIntent_Number(RMaxBJ(0.,LoadReal(YDHT,GetHandleId(u),$9375D887)))+")|r"
if fallen then
set text=text+"|cffb9bec7·倒下|r"
endif
elseif kind=="skill" then
if phase==1 then
set text="|cffe2b6ff施放中|r"
else
set text="|cffe2b6ff施法|r"
endif
elseif kind=="defend" then
set text="|cff9cdbff防御(DEF"+HopeIntent_SignedNumber(LoadReal(YDHT,GetHandleId(u),$A3107939))+")|r"
elseif kind=="buff" then
set text="|cffffdc87强化(ATK"+HopeIntent_SignedNumber(LoadReal(YDHT,GetHandleId(u),$17DC6823))+")|r"
endif
if poison>0 then
set text=text+" · |cff99e5a0毒"+I2S(poison)+"|r"
endif
set target=null
set owner=null
return text
endfunction

function HopeIntent_Release takes integer index returns nothing
if HopeIntent_Tags[index]!=null then
call DestroyTextTag(HopeIntent_Tags[index])
endif
set HopeIntent_Tags[index]=null
set HopeIntent_Units[index]=null
set HopeIntent_LastText[index]=""
endfunction

function HopeIntent_Collect takes nothing returns nothing
local unit u=GetEnumUnit()
local integer i=1
local integer slot=0
local texttag tag=null
if u!=null and GetUnitTypeId(u)!=0 and IsUnitAliveBJ(u) and GetOwningPlayer(u)==Player(11) then
loop
exitwhen i>HopeIntent_Count or slot<0
if HopeIntent_Units[i]==u then
set slot=-i
elseif HopeIntent_Units[i]==null and slot==0 then
set slot=i
endif
set i=i+1
endloop
if slot<0 then
set slot=-slot
elseif slot==0 then
set HopeIntent_Count=HopeIntent_Count+1
set slot=HopeIntent_Count
endif
set HopeIntent_Units[slot]=u
// Retry a failed engine allocation on subsequent synchronized ticks.
if HopeIntent_Tags[slot]==null then
set tag=CreateTextTag()
set HopeIntent_Tags[slot]=tag
if tag!=null then
call SetTextTagPermanent(tag,true)
call SetTextTagVelocity(tag,0.,0.)
call SetTextTagVisibility(tag,false)
call SetTextTagColor(tag,255,255,255,255)
call DzTextTagSetShadowColor(tag,0)
set HopeIntent_LastText[slot]=""
endif
endif
endif
set tag=null
set u=null
endfunction

// Keep the native anchor on the actual enemy. Avoidance may change only the
// height among three bounded lanes, never world X/Y or screen-edge positions.
function HopeIntent_Place takes integer index returns nothing
local unit u=HopeIntent_Units[index]
local texttag tag=HopeIntent_Tags[index]
local string text=""
local real x=GetUnitX(u)
local real y=GetUnitY(u)
local real dx=0.
local real dy=0.
local integer j=1
local integer lane=0
local boolean used0=false
local boolean used1=false
local boolean used2=false
local boolean visible=IsUnitVisible(u,GetLocalPlayer()) and HopeMini_Actor[GetPlayerId(GetLocalPlayer())+1]==null
set HopeIntent_Placed[index]=false
if tag==null then
set u=null
return
endif
call SetTextTagVisibility(tag,visible)
if not visible then
set u=null
set tag=null
return
endif
set text=HopeIntent_Headline(u)
if text!=HopeIntent_LastText[index] then
call SetTextTagTextBJ(tag,text,7.)
set HopeIntent_LastText[index]=text
endif
// Only immediate world-space neighbors can reserve a lane. The tag remains
// attached even for a very dense summon pile; extra units reuse these lanes.
loop
exitwhen j>=index
if HopeIntent_Placed[j] then
set dx=x-HopeIntent_X[j]
set dy=y-HopeIntent_Y[j]
if dx*dx+dy*dy<=57600. then
if HopeIntent_Lane[j]==0 then
set used0=true
elseif HopeIntent_Lane[j]==1 then
set used1=true
else
set used2=true
endif
endif
endif
set j=j+1
endloop
if not used0 then
set lane=0
elseif not used1 then
set lane=1
elseif not used2 then
set lane=2
else
set lane=ModuloInteger(index-1,3)
endif
set HopeIntent_X[index]=x
set HopeIntent_Y[index]=y
set HopeIntent_Lane[index]=lane
set HopeIntent_Placed[index]=true
call SetTextTagPosUnit(tag,u,70.+24.*I2R(lane))
set tag=null
set u=null
endfunction

function HopeIntent_RefreshAll takes nothing returns nothing
local integer i=1
local boolean combat=udg_ZhandouZhong and udg_Guaiwu_dwz!=null
// Everything through collection is synchronized, including hidden enemies.
loop
exitwhen i>HopeIntent_Count
if HopeIntent_Units[i]!=null then
if not combat or GetUnitTypeId(HopeIntent_Units[i])==0 or not IsUnitAliveBJ(HopeIntent_Units[i]) or GetOwningPlayer(HopeIntent_Units[i])!=Player(11) or not IsUnitInGroup(HopeIntent_Units[i],udg_Guaiwu_dwz) then
call HopeIntent_Release(i)
endif
endif
set HopeIntent_Placed[i]=false
set i=i+1
endloop
if combat then
call ForGroup(udg_Guaiwu_dwz,function HopeIntent_Collect)
endif
loop
exitwhen HopeIntent_Count<=0 or HopeIntent_Units[HopeIntent_Count]!=null
set HopeIntent_Count=HopeIntent_Count-1
endloop
set i=1
loop
exitwhen i>HopeIntent_Count
if HopeIntent_Units[i]!=null then
call HopeIntent_Place(i)
endif
set i=i+1
endloop
endfunction

function HopeTurn_CanEnd takes player p returns boolean
local integer i=GetPlayerId(p)+1
local unit u=udg_hero[i]
local boolean result=false
if i>=1 and i<=6 and u!=null and HopeMini_Actor[i]==null and udg_ZhandouZhong then
set result=GetOwningPlayer(u)==p and IsUnitAliveBJ(u) and not IsUnitPaused(u) and IsPlayerInForce(p,udg_WJZ_______weizhunbei) and RectContainsUnit(gg_rct______________000,u) and GetUnitAbilityLevel(u,$41303031)>0
endif
set u=null
return result
endfunction

// Synchronized UI event: issue the original ability order; never duplicate its effects.
function HopeTurn_EndClick takes nothing returns nothing
local player p=DzGetTriggerUIEventPlayer()
if HopeTurn_CanEnd(p) then
if not IssueImmediateOrder(udg_hero[GetPlayerId(p)+1],"stasistrap") then
call DisplayTextToPlayer(p,0,0,"暂时无法结束回合，请等当前动作完成后再试，或选中英雄按 G。")
endif
endif
set p=null
endfunction

function HopeTurn_Waiting takes nothing returns integer
local integer i=0
local integer count=0
loop
exitwhen i>=6
if GetPlayerSlotState(Player(i))==PLAYER_SLOT_STATE_PLAYING and IsPlayerInForce(Player(i),udg_WJZ_______weizhunbei) and IsUnitAliveBJ(udg_hero[i+1]) and not IsUnitPaused(udg_hero[i+1]) then
set count=count+1
endif
set i=i+1
endloop
return count
endfunction

function HopeIntent_Select takes player p,unit u returns nothing
if p==GetLocalPlayer() then
set HopeIntent_Selected=u
endif
endfunction

function HopeIntent_Description takes unit u returns string
local string kind=LoadStr(YDHT,GetHandleId(u),$9CF3AFFA)
local unit target=null
local string text="下次行动尚未公布"
if kind=="1" then
set text="|cff80ef90行动已被打断|r"
elseif LoadInteger(HopeStatus_History,GetHandleId(u),4)==2 then
set text="行动已发出，等待下一轮预告"
elseif kind=="attack" then
set target=LoadUnitHandle(YDHT,GetHandleId(u),$EFC23552)
set text="|cffffb080攻击|r"
if target!=null and GetUnitTypeId(target)!=0 then
if GetOwningPlayer(target)==GetLocalPlayer() then
set text=text+" → 你"
else
set text=text+" → "+HopeIntent_PlayerLabel(GetOwningPlayer(target))
endif
else
set text=text+" → 目标未定"
endif
set text=text+"|n基础伤害 "+HopeIntent_Number(RMaxBJ(0.,LoadReal(YDHT,GetHandleId(u),$9375D887)))+" · 减伤前"
elseif kind=="defend" then
set text="|cff80caff防御|r · 护甲 DEF"+HopeIntent_SignedNumber(LoadReal(YDHT,GetHandleId(u),$A3107939))
elseif kind=="buff" then
set text="|cffffd060强化|r · 攻击 ATK"+HopeIntent_SignedNumber(LoadReal(YDHT,GetHandleId(u),$17DC6823))
elseif kind=="skill" then
set text="|cffdbadff施法|r · "+LoadStr(YDHT,GetUnitTypeId(u),$2AAC512D)
endif
set target=null
return text
endfunction

