call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$50BBB8,GetRandomInt(250,350))
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"获得经验"+I2S(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$50BBB8)))
call AddHeroXPSwapped(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$50BBB8),LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9F0C6E00),true)
else
endif
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
