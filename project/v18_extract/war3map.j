function Trig____________________032Func010T takes nothing returns nothing
local group ydl_group
local unit ydl_unit
call SaveInteger(YDLOC,GetHandleId(GetExpiredTimer()),$FBEDEC54,LoadInteger(YDLOC,GetHandleId(GetExpiredTimer()),$FBEDEC54)+1)
if LoadInteger(YDLOC,GetHandleId(GetExpiredTimer()),$FBEDEC54)>=80 then
call DestroyEffect(LoadEffectHandle(YDLOC,GetHandleId(GetExpiredTimer()),$62C50DE6))
call FlushChildHashtable(YDLOC,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
else
call SaveReal(YDLOC,GetHandleId(GetExpiredTimer()),$A99320FA,EXGetEffectX(LoadEffectHandle(YDLOC,GetHandleId(GetExpiredTimer()),$62C50DE6)))
call SaveReal(YDLOC,GetHandleId(GetExpiredTimer()),$FDF65382,EXGetEffectY(LoadEffectHandle(YDLOC,GetHandleId(GetExpiredTimer()),$62C50DE6)))
call SaveReal(YDLOC,GetHandleId(GetExpiredTimer()),$A99320FA,LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$A99320FA)+CosBJ(LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$2D345649))*30.)
call SaveReal(YDLOC,GetHandleId(GetExpiredTimer()),$FDF65382,LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$FDF65382)+SinBJ(LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$2D345649))*30.)
if LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$FDF65382)>3047. then
call SaveReal(YDLOC,GetHandleId(GetExpiredTimer()),$FDF65382,3047.)
else
endif
call EXSetEffectXY(LoadEffectHandle(YDLOC,GetHandleId(GetExpiredTimer()),$62C50DE6),LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$A99320FA),LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$FDF65382))
set ydl_group=CreateGroup()
call GroupEnumUnitsInRange(ydl_group,LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$A99320FA),LoadReal(YDLOC,GetHandleId(GetExpiredTimer()),$FDF65382),90.,null)
loop
set ydl_unit=FirstOfGroup(ydl_group)
exitwhen ydl_unit==null
call GroupRemoveUnit(ydl_group,ydl_unit)
if IsUnitAliveBJ(ydl_unit)==true and GetOwningPlayer(ydl_unit)==Player(10) then
call DestroyEffect(LoadEffectHandle(YDLOC,GetHandleId(GetExpiredTimer()),$62C50DE6))
call UnitDamageTargetBJ(LoadUnitHandle(YDLOC,GetHandleId(GetExpiredTimer()),$9F0C6E00),ydl_unit,200.,ATTACK_TYPE_CHAOS,DAMAGE_TYPE_ENHANCED)
call FlushChildHashtable(YDLOC,GetHandleId(GetExpiredTimer()))
call DestroyTimer(GetExpiredTimer())
else
endif
endloop
call DestroyGroup(ydl_group)
endif
set ydl_group=null
set ydl_unit=null
endfunction
