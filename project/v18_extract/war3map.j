// Priest offense only: restore/support amounts never use these multipliers.
function HopePriest_BaseDamage takes real amount returns real
return amount*.8
endfunction
function HopePriest_TargetDamage takes real amount,unit target returns real
if IsUnitType(target,UNIT_TYPE_UNDEAD) then
return amount*1.25
endif
return amount
endfunction
function HopeMonk_Total takes unit u returns real
return I2R(GetHeroStr(u,true)+GetHeroAgi(u,true)+GetHeroInt(u,true))
endfunction
function HopeMonk_Reset takes nothing returns nothing
local integer i=1
loop
exitwhen i>6
set HopeMonk_Qi[i]=0
set HopeMonk_LastE[i]=0
set HopeMonk_LastW[i]=0
set HopeMonk_LastZ[i]=0
set i=i+1
endloop
endfunction
function HopeMonk_Ally takes unit u,player p returns boolean
return u!=null and GetWidgetLife(u)>.405 and IsUnitAlly(u,p)
endfunction
function HopeMonk_Heal takes unit u,real amount returns nothing
call SetUnitState(u,UNIT_STATE_LIFE,RMinBJ(GetUnitState(u,UNIT_STATE_MAX_LIFE),GetWidgetLife(u)+amount))
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl",u,"origin"))
endfunction
function HopeMonk_Lowest takes player p returns unit
local integer j=1
local unit best=null
local real ratio=1.
local real current=0.
loop
exitwhen j>6
if HopeMonk_Ally(udg_hero[j],p) and GetUnitState(udg_hero[j],UNIT_STATE_MAX_LIFE)>0. then
set current=GetWidgetLife(udg_hero[j])/GetUnitState(udg_hero[j],UNIT_STATE_MAX_LIFE)
if current<ratio then
set ratio=current
set best=udg_hero[j]
endif
endif
set j=j+1
endloop
return best
endfunction
function HopeMonk_Cast takes unit u,integer aid,unit target returns nothing
local player p=GetOwningPlayer(u)
local integer i=GetPlayerId(p)+1
local integer token=HopeChallenge_TurnToken()+1
local integer j=1
local integer qi=0
local integer ap=1
local real mana=0.
local real total=HopeMonk_Total(u)
local real amount=0.
local unit ally=null
local group g=null
if i<1 or i>6 or u!=udg_hero[i] or GetUnitTypeId(u)!='N01G' or GetWidgetLife(u)<=.405 or IsUnitPaused(u) or not udg_ZhandouZhong then
set p=null
return
endif
if aid=='A059' then
set mana=3.
elseif aid=='A05C' then
set mana=2.
elseif aid=='AZ36' then
set mana=3.
set ap=2
elseif aid!='A058' then
set p=null
return
endif
if (aid=='A058' or aid=='A059') and (target==null or not IsUnitInGroup(target,udg_Guaiwu_dwz) or GetWidgetLife(target)<=.405 or not IsUnitEnemy(target,p)) then
call DisplayTimedTextToPlayer(p,0,0,3.,"需要存活的当前敌人。")
set p=null
return
endif
if (aid=='A059' and (GetUnitAbilityLevel(u,aid)<1 or HopeMonk_LastE[i]==token)) or (aid=='A05C' and HopeMonk_LastW[i]==token) or (aid=='AZ36' and (not HopeJob_Awakened[i] or HopeJob_UltimateKind[i]!=6 or HopeMonk_LastZ[i]==token)) then
call DisplayTimedTextToPlayer(p,0,0,3.,"尚未获得该技能，或本回合已经使用。")
set p=null
return
endif
if udg_xingdong_dian[i]<ap or GetUnitState(u,UNIT_STATE_MANA)<mana then
call DisplayTimedTextToPlayer(p,0,0,3.,"行动点或魔法不足。")
set p=null
return
endif
set qi=HopeMonk_Qi[i]
set udg_xingdong_dian[i]=udg_xingdong_dian[i]-ap
call SetUnitState(u,UNIT_STATE_MANA,GetUnitState(u,UNIT_STATE_MANA)-mana)
if aid=='A058' then
set HopeMonk_Qi[i]=IMinBJ(3,qi+1)
set amount=(GetUnitState(u,ConvertUnitState(20))*.8+total*.9)*udg_Skill_Dm[i]
call UnitDamageTarget(u,target,amount,true,false,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL,WEAPON_TYPE_WHOKNOWS)
elseif aid=='A059' then
set HopeMonk_LastE[i]=token
set HopeMonk_Qi[i]=0
set ally=HopeMonk_Lowest(p)
if ally!=null then
call HopeMonk_Heal(ally,total*(.25+I2R(qi)*.15))
endif
set amount=total*(.8+I2R(GetUnitAbilityLevel(u,aid))*.4)*(1.+I2R(qi)*.15)*udg_Skill_Dm[i]*udg_Fashang_Dm[i]
call UnitDamageTarget(u,target,amount,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
elseif aid=='A05C' then
set HopeMonk_LastW[i]=token
set HopeMonk_Qi[i]=0
set amount=total*(.10+I2R(qi)*.03)+udg_Defend_fangyu[i]
loop
exitwhen j>6
set ally=udg_hero[j]
if HopeMonk_Ally(ally,p) then
call SetUnitState(ally,ConvertUnitState(32),GetUnitState(ally,ConvertUnitState(32))+amount)
call DestroyEffect(AddSpecialEffectTarget("Abilities\\Spells\\Human\\Defend\\DefendCaster.mdl",ally,"origin"))
endif
set j=j+1
endloop
else
set HopeMonk_LastZ[i]=token
set HopeMonk_Qi[i]=3
loop
exitwhen j>6
set ally=udg_hero[j]
if HopeMonk_Ally(ally,p) then
call HopeMonk_Heal(ally,total*.25)
call SetUnitState(ally,ConvertUnitState(32),GetUnitState(ally,ConvertUnitState(32))+total*.10)
endif
set j=j+1
endloop
set amount=total*1.1*udg_Skill_Dm[i]*udg_Fashang_Dm[i]
set g=CreateGroup()
call GroupAddGroup(udg_Guaiwu_dwz,g)
loop
set target=FirstOfGroup(g)
exitwhen target==null
call GroupRemoveUnit(g,target)
if GetWidgetLife(target)>.405 and IsUnitEnemy(target,p) then
call UnitDamageTarget(u,target,amount,false,false,ATTACK_TYPE_MAGIC,DAMAGE_TYPE_MAGIC,WEAPON_TYPE_WHOKNOWS)
endif
endloop
call DestroyGroup(g)
endif
set g=null
set ally=null
set p=null
endfunction

function HopeSkill_Original takes integer id,integer level returns string
if id=='AT03' then
return "全体存活队友恢复自身生命上限25%+施法者智力×1.5。|n溢出治疗的50%转为护甲，每人最多获得施法者智力×80%护甲。|n每位队友实际恢复2点魔法，不超过上限。|n消耗2行动点、3魔法；战斗中每回合一次。"
elseif id=='AZ36' then
return "对当前全体敌人造成三围总和×1.1的法术伤害。|n全体存活队友恢复三围总和×0.25生命，并获得三围总和×0.10护甲。|n自身气补至3层，可继续用渡厄击救助或护心诀护队。|n消耗2行动点、3魔法；战斗中每回合一次。|n伤害按技能倍率结算；法术另计法伤，暴击、最终伤害和目标减伤按原战斗规则结算。"
elseif id=='AT06' then
return "选择一名当前敌人，造成（力量+敏捷）×4的物理伤害。|n目标当前生命不高于40%时，伤害提高50%。|n本次击杀目标后返还1行动点，不超过行动点上限。|n消耗2行动点、3魔法；战斗中每回合一次。|n伤害按技能倍率结算；法术另计法伤，暴击、最终伤害和目标减伤按原战斗规则结算。"
elseif id=='AT08' then
return "以所选敌人为方向，射出长2000、宽240的贯穿重弩。|n主目标基础物理伤害=攻击力×4+力量×2；射线内其他敌人各受主伤害的70%。|n只打击当前敌人，每个敌人仅命中一次，不命中射线外或身后的敌人。|n消耗2行动点、3魔法；战斗中每回合一次。|n伤害按技能倍率结算；法术另计法伤，暴击、最终伤害和目标减伤按原战斗规则结算。"
elseif id=='AT10' then
return "消耗1发现有子弹，对一名当前敌人造成攻击力×5+敏捷×3的物理伤害。|n没有普通狙击的30%落空；不附带群伤。|n已有精确打击时消耗它并乘以精确打击倍率；爆头的必暴效果可正常作用于本次射击。|n空弹时不能施放，请用Q装填。|n消耗2行动点、3魔法；战斗中每回合一次。|n伤害按技能倍率结算；法术另计法伤，暴击、最终伤害和目标减伤按原战斗规则结算。"
elseif id=='AT11' then
return "对所选敌人周围450范围内当前敌人造成智力×4的法术伤害，并施加冰封。|n每名被冰封敌人下一次对英雄造成的伤害降低50%，随后解除。|n冰封不叠加，重复施放只刷新；下一场战斗开始清除旧标记。|n消耗2行动点、3魔法；战斗中每回合一次。|n伤害按技能倍率结算；法术另计法伤，暴击、最终伤害和目标减伤按原战斗规则结算。"
elseif id=='AT13' then
return "选择中了自己毒矛的当前敌人，立即结算相当于自身1次毒伤基值的伤害。|n基值=当前攻击力×30%×自身毒层数×毒矛等级。|n不消耗毒层，不触发额外叠毒或推进敌方回合；自身恢复生命上限10%。|n消耗2行动点、3魔法；战斗中每回合一次，无自己的毒层不能施放。|n伤害按技能倍率结算；法术另计法伤，暴击、最终伤害和目标减伤按原战斗规则结算。"
elseif id=='AT16' then
return "标记一名当前敌人，其后受到我方英雄的3次有效伤害提高25%。|n每次消耗标记时，造成伤害的玩家获得10金币；同一次伤害只结算一次悬赏。|n标记不能叠层，重复施放刷新至3次；下一场战斗开始清除。|n消耗1行动点、3魔法；战斗中每回合一次。"
endif
if id=='A000' then
return "基础平砍敌人，保留原版跳字判定。|n基础伤害值：攻击力*1|n普通平砍浮动：90%+敏捷/2（取整） 至 120%+力量；下限不超过上限。|n特殊技能使用各自的浮动区间。|n|c00fffc01行动点消耗:1|r"
