function HopeWood_Allowed takes unit shop,unit buyer returns boolean
local player p=GetOwningPlayer(buyer)
local integer i=GetPlayerId(p)
local boolean allowed=false
if buyer!=null and shop==gg_unit_n00Q_0028 and GetUnitTypeId(shop)=='n00Q' and i>=0 and i<6 then
set allowed=HopeMarket_InRoom and GetPlayerSlotState(p)==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(p)==MAP_CONTROL_USER and not udg_ZhandouZhong and not HopeDraw_Busy[i] and udg_hero[i+1]!=null and GetWidgetLife(udg_hero[i+1])>.405
endif
set p=null
return allowed
endfunction
