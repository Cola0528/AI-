set f=HopeQoL_Label("HopeDamageTitle",HopeDamage_Panel,.007,-.006,.032,.014,"伤害榜")
set HopeDamage_BattleButton=HopeQoL_Button("HopeDamageBattle",HopeDamage_Panel,.045,-.005,.043,.017,"本场")
call HopeQoL_Bind(HopeDamage_BattleButton,function HopeDamage_Battle,false)
set HopeDamage_TotalButton=HopeQoL_Button("HopeDamageTotal",HopeDamage_Panel,.094,-.005,.043,.017,"本局")
