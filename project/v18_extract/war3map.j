function HopeModern_Message takes dialog d,string text returns nothing
call SaveStr(HopeModern_Data,GetHandleId(d),100,text)
endfunction
function HopeModern_Add takes dialog d,string text returns nothing
local integer h=GetHandleId(d)
local integer n=LoadInteger(HopeModern_Data,h,0)+1
set bj_lastCreatedButton=DialogAddButton(d,text,0)
call SaveInteger(HopeModern_Data,h,0,n)
call SaveButtonHandle(HopeModern_Data,h,200+n,bj_lastCreatedButton)
call SaveStr(HopeModern_Data,h,n,text)
endfunction
function HopeModern_Clear takes dialog d returns nothing
call FlushChildHashtable(HopeModern_Data,GetHandleId(d))
call DialogClear(d)
endfunction
function HopeModern_NativeDisplay takes player p,dialog d,boolean show returns nothing
// No native modal is displayed. Shared lifecycle remains in HopeChoice.
endfunction
function HopeModern_GetPlayer takes nothing returns player
if HopeModern_Dispatching then
return HopeModern_Player
endif
return GetTriggerPlayer()
endfunction
function HopeModern_GetDialog takes nothing returns dialog
if HopeModern_Dispatching then
return HopeModern_Dialog
endif
return GetClickedDialogBJ()
endfunction
function HopeModern_GetButton takes nothing returns button
if HopeModern_Dispatching then
return HopeModern_Button
endif
return GetClickedButtonBJ()
endfunction
function HopeChoice_FindDialog takes dialog d returns integer
local integer i=1
loop
exitwhen i>HopeChoice_DialogCount
if HopeChoice_Dialog[i]==d then
return i
endif
set i=i+1
endloop
return 0
endfunction
function HopeChoice_DialogDisplay takes player p,dialog d,boolean show returns nothing
local integer i=HopeChoice_FindDialog(d)
local integer owner=GetPlayerId(p)
if show and i==0 then
set HopeChoice_DialogCount=HopeChoice_DialogCount+1
set i=HopeChoice_DialogCount
set HopeChoice_Dialog[i]=d
set HopeChoice_Owner[i]=owner
endif
if i!=0 then
if show then
// DialogAddButton creates a handle, so this stays outside GetLocalPlayer.
if HopeChoice_FoldButton[i]==null then
// Fold is handled by the modern local button.
endif
if not HopeChoice_DialogPending[i] then
set HopeChoice_DialogPending[i]=true
set HopeChoice_PlayerPending[owner]=HopeChoice_PlayerPending[owner]+1
endif
if p==GetLocalPlayer() then
set HopeChoice_Hidden=false
set HopeChoice_NativeVisible=i
endif
else
if HopeChoice_DialogPending[i] then
set HopeChoice_DialogPending[i]=false
set HopeChoice_PlayerPending[HopeChoice_Owner[i]]=HopeChoice_PlayerPending[HopeChoice_Owner[i]]-1
endif
if p==GetLocalPlayer() and HopeChoice_NativeVisible==i then
set HopeChoice_NativeVisible=0
endif
endif
endif
call HopeModern_NativeDisplay(p,d,show)
endfunction
function Trig____________________003Actions takes nothing returns nothing
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if GetPlayerSlotState(ConvertedPlayer(bj_forLoopAIndex))==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(ConvertedPlayer(bj_forLoopAIndex))==MAP_CONTROL_USER then
call HopeModern_Message(udg_Youxi_ND_XZ,"难度选择")
call HopeModern_Add(udg_Youxi_ND_XZ,"简单")
call SaveInteger(YDHT,GetHandleId(GetLastCreatedButtonBJ()),$340FE72,1)
call HopeModern_Add(udg_Youxi_ND_XZ,"普通")
