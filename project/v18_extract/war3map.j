set HopeJob_Name[42]="荒原狼王"
set HopeJob_Role[42]="全队集火 · 悬赏掠夺"
set HopeJob_Skills[42]="保留二转战斗技能与已学修炼。|n|n|cffd2b879围猎号令（Z）|r|n标记一名当前敌人，其后受到我方英雄的3次有效伤害提高25%。|n每次消耗标记时，造成伤害的玩家获得10金币；同一次伤害只结算一次悬赏。|n标记不能叠层，重复施放刷新至3次；下一场战斗开始清除。|n消耗1行动点、3魔法；战斗中每回合一次。"
set HopeJob_Passive[42]="三转专属奖励：力量 +10，敏捷 +10，行动点上限 +1，技能伤害 +15%。|n|n专属主动：围猎号令，按Z使用。|n三转奖励只发放一次。"
loop
exitwhen i>=6
call TriggerRegisterPlayerUnitEvent(selected,Player(i),EVENT_PLAYER_UNIT_SELECTED,null)
set i=i+1
endloop
call TriggerAddAction(selected,function HopeJob_OnSelect)
call TriggerRegisterAnyUnitEventBJ(spells,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddAction(spells,function HopeJob_Cast)
call TriggerRegisterAnyUnitEventBJ(learning,EVENT_PLAYER_HERO_SKILL)
call TriggerAddAction(learning,function HopeJob_Learn)
call HopeThird_Init()
call GroupEnumUnitsOfPlayer(shops,Player(PLAYER_NEUTRAL_PASSIVE),null)
call ForGroup(shops,function HopeJob_RemoveStock)
call DestroyGroup(shops)
call DzTriggerRegisterKeyEventByCode(null,27,1,false,function HopeJob_Close)
call TimerStart(CreateTimer(),.1,false,function HopeJob_CreateUI)
set selected=null
set spells=null
set learning=null
set shops=null
endfunction

function HopeModern_Choose takes integer index,integer slot returns nothing
local player p=DzGetTriggerUIEventPlayer()
local integer owner=GetPlayerId(p)
local dialog d=null
if index<1 or index>HopeChoice_DialogCount or owner<0 or owner>=6 then
set p=null
return
endif
if HopeModern_Dispatching or not HopeChoice_DialogPending[index] or HopeChoice_Owner[index]!=owner or HopeModern_Tick-HopeModern_LastTick[owner]<3 then
set p=null
return
endif
set d=HopeChoice_Dialog[index]
if slot<1 or slot>LoadInteger(HopeModern_Data,GetHandleId(d),0) then
set p=null
set d=null
return
endif
set HopeModern_LastTick[owner]=HopeModern_Tick
set HopeModern_Player=p
set HopeModern_Dialog=d
set HopeModern_Button=LoadButtonHandle(HopeModern_Data,GetHandleId(d),200+slot)
set HopeModern_Dispatching=true
if d==udg_Youxi_ND_XZ then
if udg_Yx_Nd_Dj==0 then
call Trig____________________006Actions()
call HopeChoice_DialogClear(d)
set HopeRoute_Assigning=true
endif
elseif d==udg_Wj_sj_xz[owner+1] then
call Trig____________________013________2Actions()
elseif d==udg_Rskill_shifoutihuan[owner+1] then
call Trig_R_____________018Actions()
endif
set HopeModern_Dispatching=false
set HopeModern_Player=null
set HopeModern_Dialog=null
set HopeModern_Button=null
set d=null
set p=null
endfunction
function HopeModern_Fold takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeChoice_Hidden=true
endif
endfunction
function HopeLayout_Choice takes integer i,dialog d returns nothing
local integer j=1
local real w=.280
local real h=.155
local real x=0.
local real y=0.
local integer count=LoadInteger(HopeModern_Data,GetHandleId(d),0)
local boolean isR=d==udg_Rskill_shifoutihuan[GetPlayerId(GetLocalPlayer())+1]
if d==udg_Youxi_ND_XZ then
set w=.280
set h=.179
elseif isR then
set w=.268
set h=.155
endif
call HopeLayout_Place(HopeModern_Panel[i],0,(.8-w)/2.,.495,w,h)
call HopeLayout_Place(HopeModern_Title[i],HopeModern_Panel[i],.010,-.009,w-.076,.019)
call HopeLayout_Place(HopeLayout_Fold[i],HopeModern_Panel[i],w-.056,-.007,.046,.021)
call DzFrameSetText(HopeLayout_Fold[i],"收起")
call HopeLayout_Show(HopeR_Viewport[i],isR)
call HopeLayout_Show(HopeR_Up[i],isR)
call HopeLayout_Show(HopeR_Down[i],isR)
call HopeLayout_Show(HopeR_Notice[i],isR)
call HopeLayout_Show(HopeModern_Description[i],not isR)
if not isR then
call HopeLayout_Place(HopeModern_Description[i],HopeModern_Panel[i],.010,-.036,w-.020,.037)
call DzFrameSetFont(HopeModern_Description[i],"Fonts\\ZiTi.ttf",.009,0)
endif
loop
exitwhen j>count
if isR then
set x=.010+I2R(j-1)*.130
call HopeLayout_Place(HopeModern_Row[i*8+j],HopeModern_Panel[i],x,-.123,.118,.023)
if j==1 then
call DzFrameSetText(HopeModern_Row[i*8+j],"替换")
else
call DzFrameSetText(HopeModern_Row[i*8+j],"保留原技能")
endif
else
set x=.010+I2R(ModuloInteger(j-1,2))*.134
set y=-.080-I2R((j-1)/2)*.031
call HopeLayout_Place(HopeModern_Row[i*8+j],HopeModern_Panel[i],x,y,.126,.026)
endif
set j=j+1
endloop
endfunction

function HopeCompact_RText takes integer id returns string
if id=='A014' then
return "对目标敌人造成当前护甲值*5的物理伤害|n行动点消耗:1|n每回合限定使用1次"
elseif id=='A015' then
return "投掷出一道具有攻击力的闪电，可以对4个敌人造成|n伤害，伤害值为英雄智力*4|n每回合限用一次"
elseif id=='A01C' then
return "对一直线敌人造成智力*6的法术伤害|n行动点消耗:1|n每回合限用一次"
elseif id=='A01D' then
return "英雄法伤+30% 技能伤害+20%"
elseif id=='A01H' then
return "恢复施法前3+（智力/5）点魔法，最多补满当前魔|n法上限。|n本回合智力提高30%（取整），不增加魔法上限。|n消耗1行动点、0魔法；每回合一次。|n回合结束移除临时智力，保留已恢复魔法。"
elseif id=='A01I' then
return "丢飞刃攻击敌人造成物理伤害|n基础伤害值：敏捷*4|n每次丢飞刀后伤害减半（可低于1点），回合结束时|n重置|n每点敏捷增加该伤害1%"
elseif id=='A01J' then
return "增加英雄2点行动值|n同时扣除自身999点护甲|n每回合限用一次"
elseif id=='A01K' then
return "向敌人冲锋|n造成力量*4的伤害值|n如果敌人行为是防御或强化攻击则打断其动作并且伤|n害翻倍|n每回合限用一次"
elseif id=='A01N' then
return "增加周围友军单位30%的攻击力。|n持续30秒。|n每回合限用一次"
elseif id=='A01O' then
return "减少目标单位15点的护甲 |n每回合限用一次|n(目标护甲为负时技能无效）"
elseif id=='A020' then
return "英雄暴击率+15% 暴击伤害+50%"
elseif id=='A021' then
return "跳跃过去对目标区域内的所有单位造成力量*3.5的|n物理伤害|n行动点消耗:1|n每回合限用一次"
elseif id=='A03B' then
return "万箭齐发，对所有敌人造成 英雄敏捷*1.5的物理|n伤害|n行动点消耗:1|n每点敏捷增加该伤害1%"
elseif id=='A03C' then
return "对敌人释放一次混沌打击，造成物理伤害|n基础伤害值：攻击力*5|n浮动值1%-300% |n(该浮动不会因为力量敏捷专注而改变)|n行动点消耗:2|n每回合限用一次"
elseif id=='A03Y' then
return "消耗所有MP，对敌人造成巨量物理伤害|n基础伤害值：力量*7.5*（1+消耗魔法值/25)|n行动点消耗:3|n每回合限用一次"
elseif id=='A03Z' then
return "召唤6颗陨石随机对范围内敌人造成法术伤害|n每颗陨石伤害值：智力*3|n行动点消耗:2|n每回合限用一次"
elseif id=='A045' then
return "瞬移到敌人身后对其造成物理伤害|n该伤害必定暴击|n基础伤害值：敏捷值*5+攻击力*2|n行动点消耗：2|n每回合限定使用一次|n每点敏捷增加该伤害1%"
endif
return HopeSkill_Original(id,1)
endfunction
function HopeCompact_RRefresh takes integer i,dialog d,integer abilityId returns nothing
local integer owner=GetPlayerId(GetLocalPlayer())+1
local string current="无"
if HopeR_Key!=abilityId or HopeR_Current!=udg_R_Skill[owner] then
set HopeR_Key=abilityId
set HopeR_Current=udg_R_Skill[owner]
set HopeR_Count=0
set HopeR_Offset=0
if udg_R_Skill[owner]!=0 then
set current=GetAbilityName(udg_R_Skill[owner])
endif
call HopeScroll_Add(2,"当前："+current+"|n新技能："+GetAbilityName(abilityId))
call HopeScroll_Add(2,HopeCompact_RText(abilityId))
endif
set HopeR_Active=i
call HopeJob_SetText(HopeModern_Title[i],"替换 R 技能")
call HopeJob_SetText(HopeR_Body[i],HopeScroll_View(2,HopeR_Offset,5))
call HopeJob_SetText(HopeR_Notice[i],"放弃不退费用 · 滚轮/上下按钮查看详情")
endfunction

function HopeModern_Refresh takes nothing returns nothing
local integer i=1
local integer j=1
local integer owner=GetPlayerId(GetLocalPlayer())
local integer newest=0
local integer h=0
local integer abilityId=0
local dialog d=null
local boolean show=false
local string title=""
local string detail="选择后立即生效；收起 F6 可先查看角色资料。"
set HopeModern_Tick=HopeModern_Tick+1
set HopeR_Active=0
if not HopeModern_Ready then
return
endif
loop
exitwhen i>HopeChoice_DialogCount
if HopeChoice_DialogPending[i] and HopeChoice_Owner[i]==owner then
set newest=i
endif
set i=i+1
endloop
set i=1
loop
exitwhen i>13
set show=i==newest and not HopeChoice_Hidden and not HopeGrowth_Pending[owner] and not HopeRoute_Assigning
call HopeJob_ShowFrame(HopeModern_Panel[i],show)
if show then
set d=HopeChoice_Dialog[i]
set h=GetHandleId(d)
set title=LoadStr(HopeModern_Data,h,100)
if d==udg_Rskill_shifoutihuan[owner+1] then
set abilityId=LoadInteger(YDHT,h,$D59B01E6)
set title="替换 R 技能："+GetAbilityName(abilityId)
set detail="当前："+GetAbilityName(udg_R_Skill[owner+1])+"|n新技能："+HopeSkill_Original(abilityId,1)+"|n放弃不退还本次购买费用。"
elseif d==udg_Youxi_ND_XZ then
set detail="简单/普通：3轮；困难/极难：4轮。|n炼狱：5轮；无限挑战：无限轮。|n选定难度后，再指定本局的路线选择者。"
else
set detail="消耗的升级点已结算；以下奖励三选一。|n放弃不返还升级点；收起 F6 保留当前选项。"
endif
call HopeJob_SetText(HopeModern_Title[i],title)
call HopeJob_SetText(HopeModern_Description[i],detail)
set j=1
loop
exitwhen j>6
call HopeJob_ShowFrame(HopeModern_Row[i*8+j],j<=LoadInteger(HopeModern_Data,h,0))
call HopeJob_SetText(HopeModern_Row[i*8+j],LoadStr(HopeModern_Data,h,j))
set j=j+1
endloop
call HopeLayout_Choice(i,d)
if d==udg_Rskill_shifoutihuan[owner+1] then
call HopeCompact_RRefresh(i,d,abilityId)
endif
endif
set i=i+1
endloop
set d=null
endfunction
