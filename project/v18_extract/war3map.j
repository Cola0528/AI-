endfunction

function HopeLayout_Assignment takes nothing returns nothing
local integer i=0
local integer count=0
local integer slot=0
local real x=0.
local real y=0.
local string name=""
loop
exitwhen i>=6
if HopeRoute_Active(i) then
set count=count+1
endif
set i=i+1
endloop
call HopeLayout_Place(HopeRoute_AssignPanel,0,.249,.500,.302,.074+.034*I2R((count+1)/2))
set i=0
loop
exitwhen i>=6
if HopeRoute_Active(i) then
set x=.012+.144*I2R(ModuloInteger(slot,2))
set y=-.064-.034*I2R(slot/2)
call HopeLayout_Place(HopeRoute_AssignButton[i+1],HopeRoute_AssignPanel,x,y,.134,.027)
set name=I2S(i+1)+" · "+HopeName_Label(Player(i),100)
call DzFrameSetText(HopeRoute_AssignButton[i+1],name)
set slot=slot+1
endif
set i=i+1
endloop
endfunction
