endif
call SetUnitState(GetLastCreatedUnit(),ConvertUnitState(18),GetUnitState(GetLastCreatedUnit(),ConvertUnitState(18))+I2R(udg_Gongjili_Jc[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)]))
