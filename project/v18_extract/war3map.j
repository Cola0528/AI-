function HopeChallenge_SetRoster takes nothing returns nothing
local integer cycle=ModuloInteger(udg_quanshu-4,3)
if udg_Yx_Nd_Dj<5 or udg_quanshu<4 then
return
endif
// Every accessible troop/elite slot has a defined object, on every later round.
if cycle==0 then
set udg_boci_gw_lx[0]='nZ01'
set udg_boci_gw_lx[1]='nZ02'
set udg_boci_gw_lx[2]='nZ03'
set udg_boci_gw_lx[3]='nZ04'
set udg_boci_gw_lx[4]='nZ02'
elseif cycle==1 then
set udg_boci_gw_lx[0]='nZ03'
set udg_boci_gw_lx[1]='nZ04'
set udg_boci_gw_lx[2]='nZ01'
set udg_boci_gw_lx[3]='nZ02'
set udg_boci_gw_lx[4]='nZ03'
else
set udg_boci_gw_lx[0]='nZ02'
set udg_boci_gw_lx[1]='nZ01'
set udg_boci_gw_lx[2]='nZ04'
set udg_boci_gw_lx[3]='nZ03'
set udg_boci_gw_lx[4]='nZ04'
endif
set udg_BOSS_LX[0]='UZ01'
set udg_BOSS_LX[1]='UZ02'
if ModuloInteger(udg_quanshu,2)==0 then
set udg_BOSS_LX[2]='UZ01'
set udg_BOSS_LX_______DA[1]='UZ01'
else
set udg_BOSS_LX[2]='UZ02'
set udg_BOSS_LX_______DA[1]='UZ02'
endif
call SaveStr(YDHT,'nZ01',$2AAC512D,"铁壁结阵：施法回合为所有存活敌军提供10+当前轮数×2护甲，持续到下次敌方回合开始；同类护盾不叠加。")
call SaveReal(YDHT,'nZ01',$73299135,18.0)
call SaveStr(YDHT,'nZ02',$2AAC512D,"焚魂火雨：施法回合对所有存活英雄造成当前攻击×0.85+当前轮数×3的魔法伤害。")
call SaveReal(YDHT,'nZ02',$73299135,5.0)
call SaveStr(YDHT,'nZ03',$2AAC512D,"裂魂狙击：施法回合攻击生命比例最低的存活英雄，造成当前攻击×1.65的物理伤害，并削减2点魔法。")
call SaveReal(YDHT,'nZ03',$73299135,3.0)
call SaveStr(YDHT,'nZ04',$2AAC512D,"血泉复苏：施法回合为所有存活敌军恢复各自生命上限的8%+祭司当前攻击×0.5；不超过缺失生命。")
call SaveReal(YDHT,'nZ04',$73299135,6.0)
call SaveStr(YDHT,'UZ01',$2AAC512D,"熔炉震荡：施法回合对所有存活英雄造成当前攻击×1.15的物理伤害，并获得额外20护甲直到下次敌方回合开始。")
call SaveReal(YDHT,'UZ01',$73299135,25.0)
call SaveStr(YDHT,'UZ02',$2AAC512D,"虚空虹吸：施法回合对所有存活英雄造成当前攻击×0.9的魔法伤害，各削减3点魔法；按实际扣血的25%回复自己，单次至多回复生命上限的6%。")
call SaveReal(YDHT,'UZ02',$73299135,12.0)
call SaveBoolean(YDHT,'UZ01',$FB89B46C,true)
call SaveBoolean(YDHT,'UZ02',$FB89B46C,true)
call SaveStr(YDHT,'nZ02',$8BB4E579,"Abilities\\Weapons\\NecromancerMissile\\NecromancerMissile.mdl")
call SaveStr(YDHT,'nZ03',$8BB4E579,"Abilities\\Weapons\\SkeletalMageMissile\\SkeletalMageMissile.mdl")
call SaveStr(YDHT,'nZ04',$8BB4E579,"Abilities\\Weapons\\FarseerMissile\\FarseerMissile.mdl")
call SaveStr(YDHT,'UZ02',$8BB4E579,"Abilities\\Weapons\\LichMissile\\LichMissile.mdl")
endfunction

function Trig_X_____________004Actions takes nothing returns nothing
local group ydl_group
local unit ydl_unit
call ForGroupBJ(YDWEGetUnitsOfPlayerMatchingNull(Player(PLAYER_NEUTRAL_PASSIVE),Condition(function Trig_X_____________004Func001001002)),function Trig_X_____________004Func001A)
set bj_forLoopAIndex=0
set bj_forLoopAIndexEnd=udg_shandian_sl
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call DestroyLightning(udg_Luxian_shandian[bj_forLoopAIndex])
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_shandian_sl=0
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call AdjustPlayerStateBJ(100*(udg_boci_______boss+1),ConvertedPlayer(bj_forLoopAIndex),PLAYER_STATE_RESOURCE_GOLD)
call AdjustPlayerStateBJ(1*(udg_boci_______boss+1),ConvertedPlayer(bj_forLoopAIndex),PLAYER_STATE_RESOURCE_LUMBER)
call AddHeroXPSwapped(100*(udg_boci_______boss+1),udg_hero[bj_forLoopAIndex],true)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call YDWEPolledWaitNull(3.)
call TriggerExecute(gg_trg_MGCJ__________01)
