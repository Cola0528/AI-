call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4,GetConvertedPlayerId(GetOwningPlayer(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$911D5DC2))))
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$D1145E4E,GetIssuedOrderId())
call SaveItemHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$1769D332,GetOrderTargetItem())
if LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$D1145E4E)>=852002 and LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$D1145E4E)<=852007 then
set ydul_k=0
loop
exitwhen ydul_k>5
if UnitItemInSlot(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$911D5DC2),ydul_k)==LoadItemHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$1769D332) and 852002+ydul_k==LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$D1145E4E) then
if LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$911D5DC2)==udg_hero[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)] then
if UnitAddItem(udg_Bei_bao_danwei[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)],LoadItemHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$1769D332)) then
call DisplayTextToPlayer(ConvertedPlayer(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)),0,0,"|cff80ef90已转交给助手。|r")
else
call DisplayTextToPlayer(ConvertedPlayer(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)),0,0,"|cffff8080转交失败：请检查助手的空格及物品限制。|r")
endif
else
if LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$911D5DC2)==udg_Bei_bao_danwei[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)] then
if UnitAddItem(udg_hero[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)],LoadItemHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$1769D332)) then
call DisplayTextToPlayer(ConvertedPlayer(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)),0,0,"|cff80ef90已转交给英雄。|r")
else
call DisplayTextToPlayer(ConvertedPlayer(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)),0,0,"|cffff8080转交失败：请检查英雄的空格及物品限制。|r")
endif
else
endif
endif
call DoNothing()
exitwhen true
else
endif
set ydul_k=ydul_k+1
endloop
else
endif
call EnableTrigger(GetTriggeringTrigger())
call FlushChildHashtable(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step)
endfunction
