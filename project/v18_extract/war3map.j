call SaveLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9CD60476,GetUnitLoc(GetTriggerUnit()))
call SaveReal(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$BB4B7313,GetUnitState(LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9F0C6E00),ConvertUnitState(32))*5.)
call SaveReal(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$BB4B7313,LoadReal(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$BB4B7313)*udg_Skill_Dm[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)])
call SaveReal(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$38AB9941,YDWEDistanceBetweenUnits(GetTriggerUnit(),GetSpellTargetUnit())-100.)
call YDWETimerPatternRushSlide(GetTriggerUnit(),YDWEAngleBetweenUnits(GetTriggerUnit(),GetSpellTargetUnit()),LoadReal(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$38AB9941)+0,.7,.03,0,false,false,false,"origin","","")
set ydl_timer=CreateTimer()
call SaveLocationHandle(YDLOC,GetHandleId(ydl_timer),$9CD60476,LoadLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9CD60476))
call SaveLocationHandle(YDLOC,GetHandleId(ydl_timer),$B0FD2C34,LoadLocationHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$B0FD2C34))
call SaveReal(YDLOC,GetHandleId(ydl_timer),$BB4B7313,LoadReal(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$BB4B7313))
call SaveUnitHandle(YDLOC,GetHandleId(ydl_timer),$9F0C6E00,LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9F0C6E00))
call SaveReal(YDLOC,GetHandleId(ydl_timer),$38AB9941,LoadReal(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$38AB9941))
call SaveUnitHandle(YDLOC,GetHandleId(ydl_timer),$E1001B12,LoadUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$E1001B12))
call SaveInteger(YDLOC,GetHandleId(ydl_timer),$877546F4,LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4))
call TimerStart(ydl_timer,1.,false,function Trig_RJN_______001Func004Func012T)
else
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"行动点不足")
