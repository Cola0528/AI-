set f=HopeQoL_Button("HopeLogLatest",HopeDraw_Panel,.224,-.197,.046,.020,"最新")
call HopeQoL_Bind(f,function HopeScroll_Latest,false)
set f=HopeQoL_Button("HopeDrawHistory",DzGetGameUI(),0.,0.,.064,.021,"抽取记录")
set HopeLayout_History=f
call DzFrameSetAbsolutePoint(f,0,.084,.196)
call HopeQoL_Bind(f,function HopeDraw_OpenHistory,false)
call HopeJob_ShowFrame(HopeDraw_Panel,false)
