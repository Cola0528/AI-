function HopeDraw_Close takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeDraw_Open=false
endif
endfunction
function HopeDraw_OpenHistory takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeDraw_Open=not HopeDraw_Open
if HopeDraw_Open then
call HopeLayout_Focus(7)
endif
if HopeDraw_Page<=0 then
set HopeDraw_Page=HopeDraw_Count[GetPlayerId(GetLocalPlayer())]
endif
if HopeDraw_Open then
set HopeChoice_Hidden=true
endif
endif
endfunction




function HopeDraw_Mine takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeDraw_Team=false
set HopeLog_Cached=-1
set HopeLog_Offset=0
endif
endfunction
function HopeDraw_Teammates takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeDraw_Team=true
set HopeLog_Cached=-1
set HopeLog_Offset=0
endif
endfunction
function HopeDraw_BuildTeam takes integer owner returns nothing
local integer p=0
local integer n=0
local integer best=0
local integer serial=0
local integer winner=-1
local integer slot=0
local string name=""
loop
exitwhen p>=6
set HopeTeam_Cursor[p]=HopeDraw_Count[p]
set p=p+1
endloop
loop
exitwhen n>=64
set p=0
set best=0
set winner=-1
loop
exitwhen p>=6
if p!=owner and HopeTeam_Cursor[p]>=IMaxBJ(1,HopeDraw_Count[p]-63) then
set slot=ModuloInteger(HopeTeam_Cursor[p],64)*2
set serial=LoadInteger(HopeDraw_History,p,1000+slot)
if serial>best then
set best=serial
set winner=p
endif
endif
set p=p+1
endloop
exitwhen winner<0
set slot=ModuloInteger(HopeTeam_Cursor[winner],64)*2
set name=LoadStr(HopeDraw_History,winner,2000+slot)
if name=="" then
set name=HopeName_Label(Player(winner),100)
else
set name=HopeName_Clip(name,100)
endif
call HopeScroll_Add(1,HopeUI_PlayerText(Player(winner),name+" · #"+I2S(best)))
call HopeScroll_Add(1,"|cffd2b879"+LoadStr(HopeDraw_History,winner,slot)+"|r")
call HopeScroll_Add(1,LoadStr(HopeDraw_History,winner,slot+1))
set HopeTeam_Cursor[winner]=HopeTeam_Cursor[winner]-1
set n=n+1
endloop
endfunction

function HopeDraw_Refresh takes nothing returns nothing
local integer owner=GetPlayerId(GetLocalPlayer())
local integer record=HopeDraw_Count[owner]
local integer slot=0
local integer drawStamp=HopeDraw_Count[owner]
local integer last=IMaxBJ(1,record-63)
local boolean show=HopeDraw_Open and not (HopeChoice_HasPending() and not HopeChoice_Hidden) and not HopeRoute_Assigning
set HopeLog_Visible=show
call HopeJob_ShowFrame(HopeDraw_Panel,show)
if not show then
return
endif
if HopeDraw_Team then
set drawStamp=HopeDraw_Serial-HopeDraw_Count[owner]
endif
if HopeLog_Cached!=drawStamp then
set HopeLog_Count=0
set HopeLog_Offset=0
set HopeLog_Cached=drawStamp
if HopeDraw_Team then
call HopeDraw_BuildTeam(owner)
else
loop
exitwhen record<last
set slot=ModuloInteger(record,64)*2
call HopeScroll_Add(1,"|cffd2b879#"+I2S(record)+" "+LoadStr(HopeDraw_History,owner,slot)+"|r")
call HopeScroll_Add(1,LoadStr(HopeDraw_History,owner,slot+1))
set record=record-1
endloop
endif
endif
call HopeJob_SetText(HopeDraw_Title,"抽取记录")
if HopeDraw_Team then
call HopeJob_SetText(HopeDraw_MyTab,"我的")
call HopeJob_SetText(HopeDraw_TeamTab,"|cffffd060队友|r")
else
call HopeJob_SetText(HopeDraw_MyTab,"|cffffd060我的|r")
call HopeJob_SetText(HopeDraw_TeamTab,"队友")
endif
if HopeLog_Count==0 then
if HopeDraw_Team then
call HopeJob_SetText(HopeDraw_Text,"暂无队友抽奖记录。|n队友的木材抽奖和十连结果将按时间列出。")
else
call HopeJob_SetText(HopeDraw_Text,"暂无记录。|n十连与木材抽奖的结果将连续列在这里。")
endif
call HopeJob_SetText(HopeLog_Status,"滚轮查看 · 保留64次")
else
call HopeJob_SetText(HopeDraw_Text,HopeScroll_View(1,HopeLog_Offset,13))
call HopeJob_SetText(HopeLog_Status,I2S(HopeLog_Offset+1)+"-"+I2S(IMinBJ(HopeLog_Count,HopeLog_Offset+13))+" / "+I2S(HopeLog_Count)+" 行 · 滚轮查看")
endif
endfunction
function HopeDraw_Create takes nothing returns nothing
local integer f=0
