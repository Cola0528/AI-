function Trig____________________009________2Conditions takes nothing returns boolean
return GetItemTypeId(GetManipulatedItem())==$49303059 or GetItemTypeId(GetManipulatedItem())==$49303135
endfunction
function Trig____________________009________2Actions takes nothing returns nothing
local integer ydl_localvar_step=LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76)
set ydl_localvar_step=ydl_localvar_step+3
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$CFDE6C76,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger()),$ECE825E7,ydl_localvar_step)
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4,GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit())))
call SaveUnitHandle(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$9F0C6E00,udg_hero[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)])
if GetItemTypeId(GetManipulatedItem())==$49303059 then
call SaveInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$50BBB8,GetRandomInt(50,200))
call AdjustPlayerStateBJ(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$50BBB8),GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)
call DisplayTextToPlayer(GetOwningPlayer(GetTriggerUnit()),0,0,"获得金钱"+I2S(LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$50BBB8)))
else
endif
