call HopeQoL_Bind(HopeArchive_BuyButton[6],function HopeArchive_Buy6,true)
call HopeQoL_Bind(HopeArchive_BuyButton[7],function HopeArchive_Buy7,true)
call HopeQoL_Bind(HopeArchive_BuyButton[8],function HopeArchive_Buy8,true)
