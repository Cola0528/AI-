function HopeArchive_Effect takes integer index,integer count returns string
if index==4 then
return "生命 +"+I2S(count*10)
elseif index==5 then
return "魔法 +"+I2S(count)
elseif index==6 then
return "开局金币 +"+I2S(count*20)
elseif index==7 then
return "开局木材 +"+I2S(count)
elseif index==8 then
return "暴击率 +"+I2S(count)+"%"
elseif index==9 then
return "技能伤害 +"+I2S(count)+"%"
elseif index==0 then
return "攻击 +"+I2S(count)
elseif index==1 then
return "力量 +"+I2S(count)
elseif index==2 then
return "敏捷 +"+I2S(count)
endif
return "智力 +"+I2S(count)
endfunction

function HopeArchive_Refresh takes nothing returns nothing
local player p=GetLocalPlayer()
local integer i=GetPlayerId(p)
local integer index=0
local integer count=0
local integer price=0
local boolean available=false
local string status=""
if not HopeArchive_UIReady then
set p=null
return
endif
call DzFrameShow(HopeArchive_Panel,HopeArchive_Expanded and not (HopeChoice_HasPending() and not HopeChoice_Hidden))
if not HopeArchive_Expanded or i<0 or i>=6 then
set p=null
return
endif
// When another major panel opens, respect the newer action instead of covering it.
if HopeQoL_Expanded or HopeRoute_Details or HopeGift_Expanded or HopeRelic_Expanded then
set HopeArchive_Expanded=false
call DzFrameShow(HopeArchive_Panel,false)
set p=null
return
endif
set available=HopeCloud_CanWrite(p) and udg_Cundang_danwei[i+1]!=null
if available then
call DzFrameSetText(HopeArchive_Heading,"|cffd2b879存档成长|r  ·  积分 "+I2S(udg_Wj_jf[i+1]))
set status="累计兑换 "+I2S(HopeArchive_Total(p))+" / 50 次 · 以下为购买合计加成"
else
call DzFrameSetText(HopeArchive_Heading,"|cffd2b879存档成长|r  ·  本局积分 "+I2S(udg_Wj_jf[i+1]))
set status="|cffffb878云档未就绪，暂不可兑换；数据以平台载入为准|r"
endif
call DzFrameSetText(HopeArchive_Status,status)
loop
exitwhen index>=10
set count=HopeArchive_Count(p,index)
set price=HopeArchive_Price(HopeArchive_Ability(index))
if not available then
call DzFrameSetText(HopeArchive_ProductText[index],"|cffaaaaaa"+GetAbilityName(HopeArchive_Ability(index))+"  —|r")
call DzFrameSetText(HopeArchive_CountText[index],"待载入 / —")
call DzFrameSetText(HopeArchive_BuyButton[index],"|cff999999未载入|r")
else
call DzFrameSetText(HopeArchive_ProductText[index],"|cffdedede"+HopeArchive_Effect(index,count)+"|r")
call DzFrameSetText(HopeArchive_CountText[index],"已购 "+I2S(count)+" / 5")
if count>=5 then
call DzFrameSetText(HopeArchive_BuyButton[index],"|cff999999已满|r")
elseif udg_Wj_jf[i+1]<price then
call DzFrameSetText(HopeArchive_BuyButton[index],"|cffbb9988"+I2S(price)+" · 不足|r")
else
call DzFrameSetText(HopeArchive_BuyButton[index],"|cffffd27a"+I2S(price)+" 积分|r")
endif
endif
set index=index+1
endloop
if available then
call DzFrameSetText(HopeArchive_Footer,"本局新购 "+I2S(HopeArchive_NewCount(p))+" 次；平台结算后下局生效。|n原图基础生命 +10 / 魔法 +1 不计购买。")
else
call DzFrameSetText(HopeArchive_Footer,"永久数据未载入，当前不显示购买次数和加成。|n礼包抽奖可从上方入口查看；输入 -save 查看存档状态。")
endif
set p=null
endfunction

