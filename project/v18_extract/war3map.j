function Trig_TABFunc007KT takes nothing returns nothing
local integer ydul_i
call SaveInteger(YDLOC,$B719F6EB,$877546F4,GetConvertedPlayerId(GetLocalPlayer()))
call SaveUnitHandle(YDLOC,$B719F6EB,$9F0C6E00,udg_hero[LoadInteger(YDLOC,$B719F6EB,$877546F4)])
call SaveStr(YDLOC,$B719F6EB,$2D1FF186+1,YDWEGetPlayerColorString(Player(0),"暴击率：")+I2S(udg_Baoji_Lv[LoadInteger(YDLOC,$B719F6EB,$877546F4)])+"%")
call SaveStr(YDLOC,$B719F6EB,$2D1FF186+2,YDWEGetPlayerColorString(Player(0),"暴击伤害：")+I2S(R2I(udg_Baoji_Damage[LoadInteger(YDLOC,$B719F6EB,$877546F4)]*100.))+"%")
