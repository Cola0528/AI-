local integer aid=0
local unit u=null
if i>=1 and i<=6 then
set u=udg_hero[i]
if u==null and IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO) then
set u=GetTriggerUnit()
endif
set udg_Yaoshui_shenyu_cs[i]=udg_Yaoshui_shenyu_cs[i]+1
set aid=LoadInteger(YDHT,i,$3FB1F9E0)
if u!=null and aid!=0 then
call YDWESetUnitAbilityDataString(u,aid,1,218,"药水剩余次数："+I2S(udg_Yaoshui_shenyu_cs[i]))
endif
call DisplayTextToPlayer(p,0,0,"药水可用次数+1 当前剩余次数："+I2S(udg_Yaoshui_shenyu_cs[i]))
endif
call RemoveItem(GetManipulatedItem())
set u=null
set p=null
endfunction
