// The engine console owns the complete selection panel, attribute display,
// skill buttons, inventory, experience bar and their visibility hierarchy.
// Preserve that complete hierarchy. Showing a child after HideInterface does
// not restore its hidden parent, and restoring buttons alone loses unit info.
function HopeConsole_Init takes nothing returns nothing
endfunction

function HopeQoL_SelectHero takes nothing returns nothing
local unit u=udg_hero[GetPlayerId(GetLocalPlayer())+1]
if HopeMini_Actor[GetPlayerId(GetLocalPlayer())+1]!=null then
call HopeMini_Focus(GetLocalPlayer())
set u=null
return
endif
if u!=null then
call HopeCamera_FocusUnit(GetLocalPlayer(),u,LoadBoolean(YDHT,GetHandleId(u),$799151CA))
endif
set u=null
endfunction

function HopeQoL_SelectBag takes nothing returns nothing
local unit u=udg_Bei_bao_danwei[GetPlayerId(GetLocalPlayer())+1]
if u!=null then
call HopeCamera_FocusUnit(GetLocalPlayer(),u,false)
endif
set u=null
endfunction

function HopeQoL_ToggleStats takes nothing returns nothing
if not HopeQoL_UIReady then
call DisplayTimedTextToPlayer(GetLocalPlayer(),0,0,8.,"属性窗体尚未就绪；稍后按 F4 重试，输入 -ui 查看状态。")
return
endif
set HopeQoL_Expanded=not HopeQoL_Expanded
if HopeQoL_Expanded then
call HopeLayout_Focus(1)
endif
if HopeGrowth_Pending[GetPlayerId(GetLocalPlayer())] then
set HopeChoice_Hidden=true
endif
set HopeArchive_Expanded=false
set HopeGift_Expanded=false
set HopeRelic_Expanded=false
set HopeRoute_Details=false
endfunction

function HopeQoL_CloseStats takes nothing returns nothing
set HopeQoL_Expanded=false
endfunction

function HopeQoL_ToggleHud takes nothing returns nothing
set HopeQoL_Visible=not HopeQoL_Visible
endfunction

function HopeIntent_Close takes nothing returns nothing
set HopeIntent_Selected=null
endfunction

function HopeRoute_ToggleDetails takes nothing returns nothing
set HopeRoute_Details=not HopeRoute_Details
if HopeRoute_Details then
call HopeLayout_Focus(9)
endif
if HopeRoute_Details then
if HopeGrowth_Pending[GetPlayerId(GetLocalPlayer())] then
set HopeChoice_Hidden=true
endif
set HopeQoL_Expanded=false
set HopeArchive_Expanded=false
set HopeGift_Expanded=false
set HopeRelic_Expanded=false
endif
endfunction

// Compact labels retain UTF-8 characters; the full roster remains available.
// The chat command -route continues to show every complete name.
function HopeRoute_CompactStatus takes nothing returns string
local integer i=0
local string s=""
local string name=""
local integer leader=HopeRoute_Leader()
loop
exitwhen i>=6
if HopeRoute_Active(i) then
set name=HopeName_Label(Player(i),70)
if i==leader then
set name=name+"★"
endif
if HopeRoute_RewardPending(i) then
set s=s+name+" |cffffc060待选择|r|n"
elseif udg_hero[i+1]==null then
set s=s+name+" |cffaaaaaa初始化中|r|n"
elseif HopeRoute_Ready[i] then
set s=s+name+" |cff80ef90已准备|r|n"
else
set s=s+name+" |cffaaaaaa未准备|r|n"
endif
endif
set i=i+1
endloop
return s
endfunction

function HopeQoL_Slots takes unit u returns integer
local integer i=0
local integer n=0
if u==null then
return 0
endif
loop
exitwhen i>=6
if UnitItemInSlot(u,i)!=null then
set n=n+1
endif
set i=i+1
endloop
return n
endfunction

function HopeQoL_Number takes real r returns string
return R2SW(r,1,1)
endfunction

function HopeQoL_Growth takes real r returns string
return R2SW(r,1,2)
endfunction

// Original six growth ratings (Trig______________009Actions), with their color
// families lightened for readable text on the dark panel.
// Life (7,8] originally inherited Intelligence's previous rating by mistake;
// complete its S band as (7,9] without changing any growth value.
function HopeQoL_GrowthGrade takes real r,boolean life returns string
if (life and r<=3.) or (not life and r<=.9) then
return "|cffaaaaaaE|r"
elseif (life and r<=4.) or (not life and r<=1.2) then
return "|cfff1f1f1D|r"
elseif (life and r<=5.) or (not life and r<=1.6) then
return "|cff80ef90C|r"
elseif (life and r<=6.) or (not life and r<=2.) then
return "|cff89c8ffB|r"
elseif (life and r<=7.) or (not life and r<=2.4) then
return "|cffff9696A|r"
elseif (life and r<=9.) or (not life and r<=2.8) then
return "|cffffc060S|r"
endif
return "|cffffe066EX|r"
endfunction

function HopeQoL_GradedGrowth takes real r,boolean life returns string
return HopeQoL_Growth(r)+" "+HopeQoL_GrowthGrade(r,life)
endfunction

function HopeQoL_CompactNumber takes real r returns string
if r==I2R(R2I(r)) then
return I2S(R2I(r))
endif
return HopeQoL_Number(r)
endfunction

// Refresh the legacy value for compatibility, but do not resurrect its duplicate overlay on F5.
function HopeQoL_RefreshLegacyAP takes nothing returns nothing
local integer p=GetPlayerId(GetLocalPlayer())+1
if p>=1 and p<=6 and udg_xingdongdian_xs[p]!=0 then
call DzFrameSetText(udg_xingdongdian_xs[p],"行动点："+I2S(udg_xingdong_dian[p])+"/"+I2S(udg_xingdong_dianSx[p]))
call DzFrameShow(udg_xingdongdian_xs[p],not HopeQoL_UIReady)
endif
endfunction

function HopeTeam_UpdateAP takes nothing returns nothing
local integer i=1
local unit u=null
local string s=""
local boolean show=false
loop
exitwhen i>6
set u=udg_hero[i]
set show=udg_ZhandouZhong and HopeRoute_Active(i-1) and Player(i-1)!=GetLocalPlayer() and u!=null and IsUnitAliveBJ(u) and IsUnitVisible(u,GetLocalPlayer()) and HopeMini_Actor[i]==null
call SetTextTagVisibility(HopeTeam_APTag[i],show)
if show then
if IsPlayerInForce(Player(i-1),udg_WJZ_______weizhunbei) then
set s="行动 "+I2S(udg_xingdong_dian[i])+"/"+I2S(udg_xingdong_dianSx[i])
if IsUnitPaused(u) then
set s=s+" · 进行中"
endif
if udg_xingdong_dian[i]>0 then
call SetTextTagColor(HopeTeam_APTag[i],140,240,155,255)
else
call SetTextTagColor(HopeTeam_APTag[i],255,210,105,255)
endif
elseif HopeTurn_Waiting()>0 then
set s="已结束"
call SetTextTagColor(HopeTeam_APTag[i],180,180,180,255)
else
set s="等待下回合"
call SetTextTagColor(HopeTeam_APTag[i],180,180,180,255)
endif
call SetTextTagTextBJ(HopeTeam_APTag[i],HopeIntent_PlayerLabel(Player(i-1))+" · "+s,5.5)
call SetTextTagPosUnit(HopeTeam_APTag[i],u,105.)
endif
set i=i+1
endloop
set u=null
endfunction

// Informational only: the original transition still draws the random result.
function HopeRoute_Title takes unit node returns string
local integer kind=GetUnitTypeId(node)
if kind==$6E303049 then
return "小怪关卡"
elseif kind==$6E30304A then
return "精英关卡"
elseif kind==$6E30304B then
return "装备商店"
elseif kind==$6E30304C then
return "随机关卡"
elseif kind==$6E30304D then
return "泉水关卡"
elseif kind==$6E30304E then
return "首领关卡"
elseif kind==$6E30304F then
return "小游戏关卡"
endif
return GetUnitName(node)
endfunction

function HopeRoute_Description takes unit node returns string
local integer kind=GetUnitTypeId(node)
if kind==$6E303049 then
return "常规回合战斗。|n留意敌人意图，和队友|n分配攻击、防御与专注。"
elseif kind==$6E30304A then
return "挑战本区域的精英敌人。|n备好补给，确认队伍|n状态后出发。"
elseif kind==$6E30304B then
return "购买装备、技能与属性。|n可付费刷新货物，|n注意金币与背包格子。"
elseif kind==$6E30304C then
return "随机候选：商店、随机命运、|n泉水、小游戏，或敌人|n可复活的小怪战。|n入场时决定实际结果。"
elseif kind==$6E30304D then
return "恢复 30% 最大生命。|n可转职、购买药水，|n整理下一场的补给。"
elseif kind==$6E30304E then
return "挑战本区域首领。|n击败首领后进入下一区域。"
elseif kind==$6E30304F then
return "随机挑战：射箭、割草、|n躲烈焰、溜冰。入场自动|n聚焦；F3 重新定位角色。"
endif
return "完成当前奖励与背包整理，再准备出发。"
endfunction

function HopeRoute_UpdateUI takes nothing returns nothing
local integer owner=GetPlayerId(GetLocalPlayer())
local integer i=0
local integer count=0
local integer slot=0
local integer rows=0
local boolean show=HopeRoute_Valid() and HopeRoute_Active(owner) and not HopeRoute_RewardPending(owner)
local string name=""
local string state=""
local real x=.007
local real y=-.080
local real width=.120
loop
exitwhen i>=6
if HopeRoute_Active(i) then
set count=count+1
endif
call HopeLayout_Show(HopeLayout_Member[i],false)
set i=i+1
endloop
set rows=count
if count>3 then
set rows=(count+1)/2
set width=.058
endif
call HopeLayout_Show(HopeRoute_Panel,show)
if show then
call HopeLayout_Place(HopeRoute_Panel,0,.014,.375,.134,.086+.012*I2R(rows))
call HopeLayout_Show(HopeRoute_Text,false)
call HopeLayout_Show(HopeRoute_ReadyButton,not HopeRoute_Ready[owner])
call HopeLayout_Show(HopeRoute_WaitButton,HopeRoute_Ready[owner])
call HopeLayout_Show(HopeRoute_DepartButton,owner==HopeRoute_Leader())
if HopeRoute_AllReady() then
call DzFrameSetText(HopeRoute_TitleText,"|cffd2b879"+HopeRoute_Title(HopeRoute_Node)+"|r · |cff80ef90已齐|r")
call DzFrameSetText(HopeRoute_DepartButton,"全员已准备 · 出发")
else
call DzFrameSetText(HopeRoute_TitleText,"|cffd2b879"+HopeRoute_Title(HopeRoute_Node)+"|r")
call DzFrameSetText(HopeRoute_DepartButton,"等待队友 · 出发")
endif
set i=0
loop
exitwhen i>=6
if HopeRoute_Active(i) then
if count>3 then
set name=HopeName_Label(Player(i),50)
else
set name=HopeName_Label(Player(i),70)
endif
if i==HopeRoute_Leader() then
set name=name+"*"
endif
if HopeRoute_RewardPending(i) then
set state="|cffffc060…|r"
elseif udg_hero[i+1]==null then
set state="|cffaaaaaa…|r"
elseif HopeRoute_Ready[i] then
set state="|cff80ef90√|r"
else
set state="|cffaaaaaa×|r"
endif
set x=.007
set y=-.080-.012*I2R(slot)
if count>3 then
set x=.007+.064*I2R(ModuloInteger(slot,2))
set y=-.080-.012*I2R(slot/2)
endif
call HopeLayout_Place(HopeLayout_Member[i],HopeRoute_Panel,x,y,width,.011)
if HopeLayout_Member[i]!=0 then
call DzFrameSetText(HopeLayout_Member[i],YDWEGetPlayerColorString(Player(i),name)+" "+state)
endif
call HopeLayout_Show(HopeLayout_Member[i],true)
set slot=slot+1
endif
set i=i+1
endloop
if HopeRoute_LastPreview!=HopeRoute_Node then
set HopeRoute_Details=false
set HopeRoute_LastPreview=HopeRoute_Node
endif
if HopeRoute_Details then
call DzFrameSetText(HopeRoute_DescriptionText,HopeRoute_Description(HopeRoute_Node)+"|n|n完整队伍状态（*为选路玩家）：|n"+HopeRoute_Status())
endif
endif
call HopeLayout_Show(HopeRoute_InfoPanel,show and HopeRoute_Details)
endfunction

function HopeTurn_UpdateUI takes nothing returns nothing
local player p=GetLocalPlayer()
local integer i=GetPlayerId(p)+1
local integer j=0
local integer partySize=0
local integer unfinished=0
local boolean canEnd=HopeTurn_CanEnd(p)
local string text=""
call DzFrameShow(HopeTurn_Panel,udg_hero[i]!=null and udg_ZhandouZhong and HopeMini_Actor[i]==null)
if not udg_ZhandouZhong or HopeMini_Actor[i]!=null then
set HopeTurn_IdleTicks=0
set HopeTurn_Reminded=false
elseif canEnd then
loop
exitwhen j>=6
if HopeRoute_Active(j) then
set partySize=partySize+1
// Paused teammates are still finishing an action, not already done.
if IsPlayerInForce(Player(j),udg_WJZ_______weizhunbei) and IsUnitAliveBJ(udg_hero[j+1]) then
set unfinished=unfinished+1
endif
endif
set j=j+1
endloop
if udg_xingdong_dian[i]<=0 then
set text="|cffffd060行动点已用完|n请结束回合|r"
elseif partySize>1 and unfinished==1 then
set text="|cffffd060队友已完成，等待你|n剩余 "+I2S(udg_xingdong_dian[i])+" 行动点|r"
else
set text="|cff80ef90己方第 "+I2S(udg_huihe_s)+" 回合|n剩余 "+I2S(udg_xingdong_dian[i])+" 行动点|r"
endif
if HopeTurn_LastRound!=udg_huihe_s or HopeTurn_LastAP!=udg_xingdong_dian[i] then
set HopeTurn_IdleTicks=0
if HopeTurn_LastRound!=udg_huihe_s then
set HopeTurn_Reminded=false
endif
endif
if GetUnitCurrentOrder(udg_hero[i])==0 then
set HopeTurn_IdleTicks=HopeTurn_IdleTicks+1
else
set HopeTurn_IdleTicks=0
endif
if HopeTurn_IdleTicks>=100 and not HopeTurn_Reminded then
call DisplayTimedTextToPlayer(p,0,0,6.,"|cffffd060你的回合尚未结束。操作完成后，点击结束回合，或选中英雄按 G。|r")
set HopeTurn_Reminded=true
endif
else
set HopeTurn_IdleTicks=0
if IsUnitAliveBJ(udg_hero[i])==false then
set text="角色已倒地|n等待本场结算"
elseif IsPlayerInForce(p,udg_WJZ_______weizhunbei) and IsUnitPaused(udg_hero[i]) then
set text="当前动作结算中|n稍后可继续操作"
elseif HopeTurn_Waiting()>0 then
set text="已结束回合|n等待 "+I2S(HopeTurn_Waiting())+" 位队友"
else
set text="|cffffb080敌方行动 / 结算中|n等待下回合|r"
endif
endif
set HopeTurn_LastRound=udg_huihe_s
set HopeTurn_LastAP=udg_xingdong_dian[i]
call DzFrameSetText(HopeTurn_Text,text)
call DzFrameShow(HopeTurn_Button,canEnd)
if canEnd and udg_xingdong_dian[i]<=0 then
call DzFrameSetText(HopeTurn_Button,"|cffffd060结束回合 G|r")
else
call DzFrameSetText(HopeTurn_Button,"|cff80ef90结束回合 G|r")
endif
set p=null
endfunction

function HopeIntent_UpdateUI takes nothing returns nothing
local unit u=HopeIntent_Selected
local boolean show=udg_ZhandouZhong and not HopeQoL_Expanded and not HopeArchive_Expanded and not HopeGift_Expanded and not HopeRelic_Expanded and HopeMini_Actor[GetPlayerId(GetLocalPlayer())+1]==null and u!=null and IsUnitAliveBJ(u) and IsUnitVisible(u,GetLocalPlayer()) and IsUnitSelected(u,GetLocalPlayer())
local string status=""
local string line=""
local integer lines=0
if HopeIntent_Panel==0 then
set u=null
return
endif
call DzFrameShow(HopeIntent_Panel,show)
if show then
if HopeIntent_Title!=0 then
if LoadInteger(HopeStatus_History,GetHandleId(u),4)==0 then
call DzFrameSetText(HopeIntent_Title,"|cffd2b879"+GetUnitName(u)+" · 下次行动|r")
else
call DzFrameSetText(HopeIntent_Title,"|cffd2b879"+GetUnitName(u)+" · 当前行动|r")
endif
endif
if HopeIntent_Text!=0 then
call DzFrameSetText(HopeIntent_Text,HopeIntent_Description(u))
endif
if HopeIntent_Status!=0 then
set status=HopeStatus_PoisonDetails(u,GetLocalPlayer())
if status!="" then
set lines=1
endif
set line=HopeStatus_PoisonPreviewLine(u)
if line!="" then
if lines>0 then
set status=status+"|n"
endif
set status=status+line
set lines=lines+1
endif
set line=HopeStatus_PoisonLastLine(u)
if line!="" then
if lines>0 then
set status=status+"|n"
endif
set status=status+line
set lines=lines+1
endif
set line=HopeDebuff_Details(u)
if line!="" then
if lines>0 then
set status=status+"|n"
endif
set status=status+line
set lines=lines+HopeDebuff_Lines(u)
endif
call DzFrameShow(HopeIntent_Status,lines>0)
if lines>0 then
call DzFrameSetText(HopeIntent_Status,status)
call DzFrameSetSize(HopeIntent_Status,.208,.0128*I2R(lines))
call DzFrameSetSize(HopeIntent_Panel,.224,.056+.0128*I2R(lines))
else
call DzFrameSetSize(HopeIntent_Panel,.224,.052)
endif
endif
endif
set u=null
endfunction

function HopeQoL_BarValue takes integer fill,real current,real maximum returns nothing
local real ratio=0.
if fill==0 then
return
endif
if maximum>0. then
set ratio=RMaxBJ(0.,RMinBJ(1.,current/maximum))
endif
call DzFrameShow(fill,ratio>0.)
call DzFrameSetSize(fill,.120*RMaxBJ(.001,ratio),.003)
endfunction


function HopeQoL_Label takes string name,integer parent,real x,real y,real w,real h,string value returns integer
local integer f=0
if parent==0 then
return 0
endif
set f=DzCreateFrameByTagName("TEXT",name,parent,"HopePassText",0)
if f==0 then
return 0
endif
// No template-only creation: text remains independent of a loaded blueprint.
call DzFrameSetPoint(f,0,parent,0,x,y)
call DzFrameSetSize(f,w,h)
call DzFrameSetFont(f,"Fonts\\ZiTi.ttf",.0095,0)
call DzFrameSetText(f,value)
call DzFrameShow(f,true)
return f
endfunction

// The passive text child keeps the entire flat button clickable.




// Decorative lines never receive a click handler. Anchor both ends so a party
// size change resizes the border with its panel rather than stretching a bitmap.
function HopeQoL_Edge takes string name,integer parent,integer first,integer second,boolean horizontal returns nothing
local integer f=DzCreateFrameByTagName("BACKDROP",name,parent,"HopePassBackdrop",0)
if f==0 then
return
endif
call DzFrameSetTexture(f,"HopeUI\\focus-fill.blp",0)
call DzFrameSetAlpha(f,115)
call DzFrameSetPoint(f,first,parent,first,0.,0.)
call DzFrameSetPoint(f,second,parent,second,0.,0.)
if horizontal then
call DzFrameSetSize(f,0.,.00055)
else
call DzFrameSetSize(f,.00055,0.)
endif
endfunction

// Fade only the background sibling, keeping text and controls fully opaque.
function HopeQoL_Surface takes string name,real x,real y,real w,real h returns integer
local integer parent=0
local integer background=0
// Critical parents must not depend on DzLoadToc or blueprint lookup success.
set parent=DzCreateFrameByTagName("FRAME",name,DzGetGameUI(),"HopePassFrame",0)
if parent==0 then
return 0
endif
set background=DzCreateFrameByTagName("BACKDROP",name+"Background",parent,"HopePassBackdrop",0)
call DzFrameSetAbsolutePoint(parent,0,x,y)
call DzFrameSetSize(parent,w,h)
if background!=0 then
call DzFrameSetAllPoints(background,parent)
// This exact built-in texture is used by the reference map's actual console.
// Avoid the old custom JPEG's YCbCr/BGRA color interpretation entirely.
call DzFrameSetTexture(background,"Textures\\Black32.blp",0)
call DzFrameSetAlpha(background,220)
call DzFrameShow(background,true)
endif
call HopeQoL_Edge(name+"Top",parent,0,2,true)
call HopeQoL_Edge(name+"Bottom",parent,6,8,true)
call HopeQoL_Edge(name+"Left",parent,0,6,false)
call HopeQoL_Edge(name+"Right",parent,2,8,false)
// A partially constructed UI must never leave an empty blocker over the map.
// The state refresh shows each completed panel only when it is needed.
call DzFrameShow(parent,false)
return parent
endfunction

function HopeQoL_Fill takes string name,integer parent,real x,real y,string texture returns integer
local integer track=0
local integer fill=0
if parent==0 then
return 0
endif
set track=DzCreateFrameByTagName("BACKDROP",name+"Track",parent,"HopePassBackdrop",0)
set fill=DzCreateFrameByTagName("BACKDROP",name,parent,"HopePassBackdrop",0)
if track!=0 then
call DzFrameSetPoint(track,0,parent,0,x,y)
call DzFrameSetSize(track,.120,.003)
call DzFrameSetTexture(track,"HopeUI\\bar-track.blp",0)
endif
if fill!=0 then
call DzFrameSetPoint(fill,0,parent,0,x,y)
call DzFrameSetSize(fill,.120,.003)
call DzFrameSetTexture(fill,texture,0)
endif
return fill
endfunction

function HopeQoL_Bind takes integer frame,code action,boolean sync returns nothing
if frame!=0 then
call DzFrameSetScriptByCode(frame,1,action,sync)
endif
endfunction

