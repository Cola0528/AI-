set HopeArchive_Footer=HopeQoL_Label("HopeArchiveFooter",HopeArchive_Panel,.009,-.252,.322,.026,"")
set HopeArchive_UIReady=HopeArchive_Heading!=0 and HopeArchive_Status!=0 and HopeArchive_Footer!=0
call DzFrameShow(HopeArchive_Panel,false)
endfunction

// Six fixed lottery outcomes.  Browsing stays local; the Draw action synchronizes.
function HopeGift_DrawClick takes nothing returns nothing
call HopeGift_Draw(DzGetTriggerUIEventPlayer())
endfunction

function HopeGift_Refresh takes nothing returns nothing
local player p=GetLocalPlayer()
local integer i=GetPlayerId(p)
local integer index=0
local boolean available=false
if not HopeGift_UIReady then
set p=null
return
endif
call DzFrameShow(HopeGift_Panel,HopeGift_Expanded and not (HopeChoice_HasPending() and not HopeChoice_Hidden))
if not HopeGift_Expanded or i<0 or i>=6 then
set p=null
return
endif
if HopeQoL_Expanded or HopeRoute_Details or HopeArchive_Expanded or HopeRelic_Expanded then
set HopeGift_Expanded=false
call DzFrameShow(HopeGift_Panel,false)
set p=null
return
endif
set available=HopeGift_Loaded[i] and HopeGift_Checked[i] and HopeCloud_CanWrite(p)
call DzFrameSetText(HopeGift_Heading,"|cffd2b879礼包抽奖|r  ·  积分 "+I2S(udg_Wj_jf[i+1]))
call DzFrameSetText(HopeGift_Summary,"每抽5积分 · 谢谢惠顾55%|n以下礼包概率固定，已拥有的结果仍可能抽中。")
loop
exitwhen index>=6
call DzFrameSetText(HopeGift_StateText[index],HopeGift_State(p,index))
set index=index+1
endloop
if not available then
call DzFrameSetText(HopeGift_DrawButton,"|cff999999云档未就绪|r")
elseif HopeGift_OwnedCount(p)>=6 then
call DzFrameSetText(HopeGift_DrawButton,"|cff999999已集齐 · 停止抽奖|r")
elseif udg_Wj_jf[i+1]<HopeGift_DrawCost() then
call DzFrameSetText(HopeGift_DrawButton,"|cffbb99885 积分 · 不足|r")
else
call DzFrameSetText(HopeGift_DrawButton,"|cffffd27a抽奖 · 5积分|r")
endif
if HopeGift_LastResult[i]==null or HopeGift_LastResult[i]=="" then
call DzFrameSetText(HopeGift_ResultText,"|cffaaaaaa最近结果：本局尚未抽奖|r")
else
call DzFrameSetText(HopeGift_ResultText,HopeGift_LastResult[i])
endif
set p=null
endfunction

