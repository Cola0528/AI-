endfunction

// Called exactly once by the original synchronized pickup action. Does not
// modify the item, ability, pool, stats, rewards or existing pickup control flow.
function HopeRelic_Record takes player p,integer itemId returns nothing
local integer owner=GetPlayerId(p)
local integer index=0
if owner<0 or owner>=6 then
return
endif
loop
exitwhen index>=44
if HopeRelic_Item(index)==itemId then
set HopeRelic_Acquired[owner*44+index]=HopeRelic_Acquired[owner*44+index]+1
call HopeMeta_Catalog(owner,index)
return
endif
set index=index+1
endloop
endfunction

function HopeRelic_Owned takes player p,integer index returns boolean
local integer owner=GetPlayerId(p)
if owner<0 or owner>=6 or index<0 or index>=44 then
return false
endif
// The second original unit is only a duplicate display of relics 12 onward.
// The primary unit remains authoritative for persistent ability state.
return HopeRelic_Acquired[owner*44+index]>0 or GetUnitAbilityLevel(udg_Yiwu_danwei[owner+1],HopeRelic_Ability(index))>0
endfunction

function HopeRelic_Total takes player p returns integer
local integer index=0
local integer count=0
loop
exitwhen index>=44
if HopeRelic_Owned(p,index) then
set count=count+1
endif
set index=index+1
endloop
return count
endfunction

function HopeRelic_OpenFor takes player p returns boolean
if not HopeRelic_UIReady then
return false
endif
if p==GetLocalPlayer() then
if HopeGrowth_Pending[GetPlayerId(p)] then
set HopeChoice_Hidden=true
endif
set HopeRelic_Expanded=not HopeRelic_Expanded
if HopeRelic_Expanded then
call HopeLayout_Focus(4)
endif
set HopeQoL_Expanded=false
set HopeArchive_Expanded=false
set HopeGift_Expanded=false
set HopeRoute_Details=false
endif
return true
endfunction

function HopeRelic_Close takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeRelic_Expanded=false
call DzFrameShow(HopeRelic_Panel,false)
endif
endfunction

function HopeRelic_SelectRow takes integer slot returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() and slot>=0 and slot<6 then
if HopeRelic_RowIndex[slot]>=0 and HopeRelic_RowIndex[slot]<44 then
set HopeRelic_Selected=HopeRelic_RowIndex[slot]
set HopeRelic_DetailPage=0
endif
endif
endfunction

function HopeRelic_Prev takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() and HopeRelic_Page>0 then
set HopeRelic_Page=HopeRelic_Page-1
set HopeRelic_Selected=-1
set HopeRelic_DetailPage=0
endif
endfunction

function HopeRelic_Next takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() and (HopeRelic_Page+1)*6<HopeRelic_Total(GetLocalPlayer()) then
set HopeRelic_Page=HopeRelic_Page+1
set HopeRelic_Selected=-1
set HopeRelic_DetailPage=0
endif
endfunction

function HopeRelic_NextDetail takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() and HopeRelic_Selected>=0 then
set HopeRelic_DetailPage=HopeRelic_DetailPage+1
if HopeRelic_DetailPage>=HopeRelic_DescriptionPages(HopeRelic_Selected) then
set HopeRelic_DetailPage=0
endif
endif
endfunction

function HopeRelic_State takes player p,integer index returns string
local integer owner=GetPlayerId(p)
local integer count=HopeRelic_Acquired[owner*44+index]
local string state="已获得"
if count>0 then
set state="取得 "+I2S(count)+" 次"
endif
if HopeRelic_Ability(index)==$41303142 then
if GetUnitAbilityLevel(udg_Yiwu_danwei[owner+1],$41303142)>0 then
return state+" · 待发动"
elseif HaveSavedBoolean(YDHT,GetHandleId(udg_hero[owner+1]),$EA42029E) then
return state+" · 本场已发动"
endif
return state+" · 已消耗"
endif
return state
endfunction

