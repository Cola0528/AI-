set HopeThird_Passive[42]=false
endfunction

function HopeJob_Init takes nothing returns nothing
local integer i=0
local trigger selected=CreateTrigger()
local trigger spells=CreateTrigger()
local trigger learning=CreateTrigger()
local group shops=CreateGroup()
call DestroyTimer(GetExpiredTimer())
set HopeJob_SkillCount[0]=1
set HopeJob_DetailText[0]="|cffd2b879连斩|r|n攻击敌人|n基础伤害值：攻击力*1|n基础浮动90%~120%；另计敏捷下限与力量上限|n|c00fffc01行动点消耗:1|r|n追加段结算时英雄魔法值大于0.8时，会消耗1点魔法值|n追加一次伤害，伤害值为敏捷×（1+连斩修炼等级×20%）"
set HopeJob_PassiveCount[0]=1
set HopeJob_DetailText[8]="|cffd2b879敏捷修炼|r|n学习后行动点+1 （一次）|n每级敏捷+5 连击追加的伤害每级增加20%*敏捷"
set HopeJob_Source[0]='H000'
