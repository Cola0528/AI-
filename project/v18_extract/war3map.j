function HopeGrowth_Randomize takes integer i returns nothing
local real penalty=I2R(udg_ND_sz)*.1
local real total=0.
set udg_cz1Str_up[i]=GetRandomReal(.8,3.5-penalty)
set udg_cz2Agi_up[i]=GetRandomReal(.8,3.5-penalty)
set udg_cz3Int_up[i]=GetRandomReal(.8,3.5-penalty)
set total=udg_cz1Str_up[i]+udg_cz2Agi_up[i]+udg_cz3Int_up[i]
if total>7. then
set udg_cz1Str_up[i]=GetRandomReal(.8,3.-penalty)
set udg_cz2Agi_up[i]=GetRandomReal(.8,3.-penalty)
set udg_cz3Int_up[i]=GetRandomReal(.8,3.-penalty)
set total=udg_cz1Str_up[i]+udg_cz2Agi_up[i]+udg_cz3Int_up[i]
if total>7. then
set udg_cz1Str_up[i]=GetRandomReal(.8,3.-penalty)
set udg_cz2Agi_up[i]=GetRandomReal(.8,3.-penalty)
set udg_cz3Int_up[i]=GetRandomReal(.8,3.-penalty)
set total=udg_cz1Str_up[i]+udg_cz2Agi_up[i]+udg_cz3Int_up[i]
else
if total>7. then
set udg_cz1Str_up[i]=GetRandomReal(.8,3.-penalty)
set udg_cz2Agi_up[i]=GetRandomReal(.8,3.-penalty)
set udg_cz3Int_up[i]=GetRandomReal(.8,3.-penalty)
set total=udg_cz1Str_up[i]+udg_cz2Agi_up[i]+udg_cz3Int_up[i]
else
endif
endif
else
endif
set udg_cz4Hp_up[i]=GetRandomReal(2.,10.)
set udg_cz5Mp_up[i]=GetRandomReal(.5,3.5)
set udg_cz6Dex_up[i]=GetRandomReal(.5,3.5)
endfunction


function HopeGrowth_UpdateTooltip takes integer i returns nothing
local integer abilityId=LoadInteger(YDHT,i,$412D8AC6)
local string s="力量成长: "+HopeQoL_GradedGrowth(udg_cz1Str_up[i],false)
set s=s+"|n敏捷成长: "+HopeQoL_GradedGrowth(udg_cz2Agi_up[i],false)
set s=s+"|n智力成长: "+HopeQoL_GradedGrowth(udg_cz3Int_up[i],false)
set s=s+"|n生命成长: "+HopeQoL_GradedGrowth(udg_cz4Hp_up[i],true)
set s=s+"|n魔力成长: "+HopeQoL_GradedGrowth(udg_cz5Mp_up[i],false)
set s=s+"|n专注成长: "+HopeQoL_GradedGrowth(udg_cz6Dex_up[i],false)
if udg_hero[i]!=null and abilityId!=0 then
call YDWESetUnitAbilityDataString(udg_hero[i],abilityId,1,218,s)
endif
endfunction

// These transactions are called only from synchronized button events.
// A stale click after confirmation cannot spend points or draw random values.
function HopeGrowth_Roll takes player p,boolean paid returns boolean
local integer i=GetPlayerId(p)+1
if not HopeGrowth_CanAct(p) then
return false
endif
if paid then
if not HopePoints_Spend(p,5-IMinBJ(3,HopeMeta_Tal(GetPlayerId(p),12))) then
return false
endif
else
if udg_CZ_czcs[i]<=0 then
call DisplayTextToPlayer(p,0,0,"免费重置已用完；积分重置费用按当前天赋折扣展示。")
return false
endif
set udg_CZ_czcs[i]=udg_CZ_czcs[i]-1
endif
call HopeGrowth_Randomize(i)
call HopeGrowth_UpdateTooltip(i)
if paid then
call DisplayTextToPlayer(p,0,0,"成长已重置：消耗"+I2S(5-IMinBJ(3,HopeMeta_Tal(i-1,12)))+"存档积分，剩余 "+I2S(udg_Wj_jf[i])+"。")
else
call DisplayTextToPlayer(p,0,0,"成长已重置：剩余免费次数 "+I2S(udg_CZ_czcs[i])+"。")
endif
return true
endfunction

function HopeGrowth_Accept takes player p returns boolean
local integer owner=GetPlayerId(p)
if not HopeGrowth_CanAct(p) then
return false
endif
set HopeGrowth_Pending[owner]=false
set HopeGrowth_Hero[owner]=null
set HopeChoice_PlayerPending[owner]=IMaxBJ(0,HopeChoice_PlayerPending[owner]-1)
call HopeGrowth_UpdateTooltip(owner+1)
call DisplayTextToPlayer(p,0,0,"初始成长已确认，可以准备出发。")
return true
endfunction

function HopeGrowth_FreeClick takes nothing returns nothing
call HopeGrowth_Roll(DzGetTriggerUIEventPlayer(),false)
endfunction
function HopeGrowth_PaidClick takes nothing returns nothing
call HopeGrowth_Roll(DzGetTriggerUIEventPlayer(),true)
endfunction
function HopeGrowth_AcceptClick takes nothing returns nothing
call HopeGrowth_Accept(DzGetTriggerUIEventPlayer())
endfunction

function HopeGrowth_Fold takes nothing returns nothing
if DzGetTriggerUIEventPlayer()==GetLocalPlayer() then
set HopeChoice_Hidden=true
if HopeGrowth_Panel!=0 then
call DzFrameShow(HopeGrowth_Panel,false)
endif
call HopeChoice_ApplyVisibility()
endif
endfunction

function HopeGrowth_Refresh takes nothing returns nothing
local integer owner=GetPlayerId(GetLocalPlayer())
local integer i=owner+1
local boolean show=false
local string status=""
if not HopeGrowth_UIReady or owner<0 or owner>=6 then
return
endif
set show=HopeGrowth_Pending[owner] and not HopeChoice_Hidden and not HopeRoute_Assigning
call DzFrameShow(HopeGrowth_Panel,show)
if not show then
return
endif
// Resuming with F6 returns to this choice and closes any intervening panels.
set HopeQoL_Expanded=false
set HopeArchive_Expanded=false
set HopeGift_Expanded=false
set HopeRelic_Expanded=false
set HopeRoute_Details=false
set HopeJob_Expanded=false
call DzFrameSetText(HopeGrowth_Summary,"存档积分  "+I2S(udg_Wj_jf[i])+"    免费重置  "+I2S(udg_CZ_czcs[i])+" 次")
call DzFrameSetText(HopeGrowth_ValueText[0],"力量  +"+HopeQoL_GradedGrowth(udg_cz1Str_up[i],false))
call DzFrameSetText(HopeGrowth_ValueText[1],"敏捷  +"+HopeQoL_GradedGrowth(udg_cz2Agi_up[i],false))
call DzFrameSetText(HopeGrowth_ValueText[2],"智力  +"+HopeQoL_GradedGrowth(udg_cz3Int_up[i],false))
call DzFrameSetText(HopeGrowth_ValueText[3],"生命  +"+HopeQoL_GradedGrowth(udg_cz4Hp_up[i],true))
call DzFrameSetText(HopeGrowth_ValueText[4],"魔力  +"+HopeQoL_GradedGrowth(udg_cz5Mp_up[i],false))
call DzFrameSetText(HopeGrowth_ValueText[5],"专注  +"+HopeQoL_GradedGrowth(udg_cz6Dex_up[i],false))
call DzFrameSetText(HopeGrowth_FreeButton,"免费重置 · 剩余"+I2S(udg_CZ_czcs[i])+"次")
set status="每次重置全部六项成长；免费与积分次数独立。"
if not HopeCloud_CanWrite(GetLocalPlayer()) then
set status="存档积分暂不可用；仍可免费重置或确认成长。"
elseif udg_Wj_jf[i]<5-IMinBJ(3,HopeMeta_Tal(i-1,12)) then
set status="额外重置需要"+I2S(5-IMinBJ(3,HopeMeta_Tal(i-1,12)))+"积分，当前不足。"
endif
call DzFrameSetText(HopeGrowth_Footer,status+"|n确认后，本局不能再次重置初始成长。")
call DzFrameSetText(HopeGrowth_PaidButton,"积分重置 · "+I2S(5-IMinBJ(3,HopeMeta_Tal(i-1,12)))+"积分")
endfunction

function HopeGrowth_CreateUI takes nothing returns nothing
local integer f=0
local integer index=0
local real x=.014
local real y=-.074
call DestroyTimer(GetExpiredTimer())
set HopeGrowth_Panel=HopeQoL_Surface("HopeGrowthPanel",.229,.535,.342,.323)
if HopeGrowth_Panel==0 then
