call UnitAddAbilityBJ(LoadInteger(YDHT,LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4),$3FB1F9E0),GetLastCreatedUnit())
call UnitAddAbilityBJ(LoadInteger(YDHT,LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4),$590EE9FB),GetLastCreatedUnit())
if udg_R_Skill[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)]!=$4130314C then
call UnitAddAbilityBJ(udg_R_Skill[LoadInteger(YDLOC,GetHandleId(GetTriggeringTrigger())*ydl_localvar_step,$877546F4)],GetLastCreatedUnit())
