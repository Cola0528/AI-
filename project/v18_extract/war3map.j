endfunction
function HopeEvent_Move takes integer delta returns nothing
set HopeEvent_Offset=IMaxBJ(IMaxBJ(0,HopeEvent_Count-512),IMinBJ(IMaxBJ(HopeEvent_Start,HopeEvent_Count-13),HopeEvent_Offset+delta))
endfunction
function HopeEvent_Up takes nothing returns nothing
call HopeEvent_Move(-3)
endfunction
function HopeEvent_Down takes nothing returns nothing
call HopeEvent_Move(3)
endfunction
function HopeEvent_Enter takes nothing returns nothing
set HopeScroll_Hover=3
endfunction

function HopeEvent_Create takes nothing returns nothing
local integer f=0
local integer viewport=0
set HopeEvent_Panel=HopeQoL_Surface("HopeEventPanel",.244,.505,.312,.228)
set f=HopeQoL_Label("HopeEventTitle",HopeEvent_Panel,.010,-.008,.244,.019,"问号事件 · 全队记录")
