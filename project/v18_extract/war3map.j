set HopeDraw_MyTab=HopeQoL_Button("HopeDrawMineTab",HopeDraw_Panel,.110,-.006,.044,.022,"我的")
call HopeQoL_Bind(HopeDraw_MyTab,function HopeDraw_Mine,false)
set HopeDraw_TeamTab=HopeQoL_Button("HopeDrawTeamTab",HopeDraw_Panel,.162,-.006,.044,.022,"队友")
call HopeQoL_Bind(HopeDraw_TeamTab,function HopeDraw_Teammates,false)
set viewport=HopeQoL_Button("HopeLogViewport",HopeDraw_Panel,.010,-.034,.260,.155,"")
call DzFrameSetScriptByCode(viewport,2,function HopeScroll_EnterLog,false)
call DzFrameSetScriptByCode(viewport,3,function HopeScroll_Leave,false)
set HopeDraw_Text=HopeQoL_Label("HopeDrawText",viewport,.006,-.005,.248,.145,"")
call DzFrameSetFont(HopeDraw_Text,"Fonts\\ZiTi.ttf",.0085,0)
set f=HopeQoL_Button("HopeLogUp",HopeDraw_Panel,.010,-.197,.028,.020,"上")
call HopeQoL_Bind(f,function HopeScroll_LogUp,false)
set f=HopeQoL_Button("HopeLogDown",HopeDraw_Panel,.043,-.197,.028,.020,"下")
call HopeQoL_Bind(f,function HopeScroll_LogDown,false)
set HopeLog_Status=HopeQoL_Label("HopeLogStatus",HopeDraw_Panel,.077,-.199,.140,.016,"")
